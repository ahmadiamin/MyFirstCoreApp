@model List<MyFirstCoreApp.Domain.Entities.Tenancy.Tenant>
@{
    ViewData["Title"] = "شرکت‌ها";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>
        <i class="bi bi-building"></i>
        شرکت‌ها
    </h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus"></i>
        ثبت شرکت جدید
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>نام شرکت</th>
                        <th>تلفن</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tenant in Model)
                    {
                        <tr>
                            <td>@tenant.Name</td>
                            <td>@tenant.Phone</td>
                            <td>
                                @if (tenant.IsActive)
                                {
                                    <span class="badge bg-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">غیرفعال</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Select" class="btn btn-sm btn-outline-primary">
                                    ورود به شرکت
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">هنوز هیچ شرکتی ثبت نکرده‌اید.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus"></i>
                    ثبت اولین شرکت
                </a>
            </div>
        }
    </div>
</div>