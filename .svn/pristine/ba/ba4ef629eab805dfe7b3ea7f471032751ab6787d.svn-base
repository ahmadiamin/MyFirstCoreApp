@model MyFirstCoreApp.Models.ViewModels.MenuTreeViewModel

@using MyFirstCoreApp.Authorization
@inject PermissionService PermissionService

<tr class="menu-row @(Model.Level > 0 ? "menu-child" : "menu-parent")">

    <!-- عنوان -->
    <td>

        <div class="menu-title"
             style="padding-right: @(Model.Level * 28)px;">

            @if (Model.Level > 0)
            {
                <span class="menu-tree-line">
                    <i class="fa fa-angle-left"></i>
                </span>
            }
            else
            {
                <span class="menu-root-icon">
                    <i class="fa fa-folder-open"></i>
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Icon))
            {
                <span class="menu-icon">

                    <i class="@Model.Icon"></i>

                </span>
            }

            <span class="menu-name">

                @Model.Title

            </span>

        </div>

    </td>

    <!-- URL -->
    <td>

        @if (!string.IsNullOrWhiteSpace(Model.Url))
        {
            <code class="menu-url">
                @Model.Url
            </code>
        }
        else
        {
            <span class="text-muted">
                -
            </span>
        }

    </td>

    <!-- Icon -->
    <td>

        @if (!string.IsNullOrWhiteSpace(Model.Icon))
        {
            <span class="badge badge-light">

                <i class="@Model.Icon"></i>

                <span class="ml-1">
                    @Model.Icon
                </span>

            </span>
        }
        else
        {
            <span class="text-muted">
                -
            </span>
        }

    </td>

    <!-- Permission -->
    <td>

        @if (!string.IsNullOrWhiteSpace(Model.Permission))
        {
            <span class="badge badge-secondary">

                <i class="fa fa-key"></i>

                @Model.Permission

            </span>
        }
        else
        {
            <span class="text-muted">
                بدون محدودیت
            </span>
        }

    </td>

    <!-- Sort -->
    <td class="text-center">

        <span class="badge badge-light">

            @Model.SortOrder

        </span>

    </td>

    <!-- Status -->
    <td class="text-center">

        @if (Model.IsActive)
        {
            <span class="badge badge-success">

                <i class="fa fa-check"></i>

                فعال

            </span>
        }
        else
        {
            <span class="badge badge-secondary">

                <i class="fa fa-times"></i>

                غیرفعال

            </span>
        }

    </td>

    <!-- Actions -->
    <td class="text-center">

        <div class="btn-group btn-group-sm"
             role="group">

            @if (await PermissionService.HasPermissionAsync(User, "Menu.Edit"))
            {
                <a asp-area="Admin"
                   asp-controller="Menus"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning"
                   title="ویرایش">

                    <i class="fa fa-edit"></i>

                </a>
            }

            @if (await PermissionService.HasPermissionAsync(User, "Menu.Delete"))
            {
                <a asp-area="Admin"
                   asp-controller="Menus"
                   asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-danger"
                   title="حذف">

                    <i class="fa fa-trash"></i>

                </a>
            }

        </div>

    </td>

</tr>

<!-- Children -->
@foreach (var child in Model.Children)
{
    <partial name="_MenuRow"
             model="child" />
}