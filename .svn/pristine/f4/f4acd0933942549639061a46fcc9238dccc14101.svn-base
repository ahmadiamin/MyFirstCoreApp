document.addEventListener("DOMContentLoaded", function () {

    const toggle = document.getElementById("sidebarToggle");

    if (!toggle)
        return;

    toggle.addEventListener("click", function () {

        document.body.classList.toggle(
            "sidebar-collapsed");

    });

});

/* ============================================
   InputMask Global Handler
   ============================================ */
$(document).ready(function () {
    // فعال‌سازی data-mask ها
    $('[data-mask]').inputmask();

    // 🆕 مبلغ با کاما (روش دستی)
    function formatMoney(value) {
        if (value === null || value === undefined) return '';
        // تبدیل به رشته
        value = value.toString();
        // حذف هر چیزی غیر از عدد و منفی
        var num = value.replace(/[^0-9-]/g, '');
        if (num === '' || num === '-') return num;
        // جدا کردن سه‌رقمی
        return num.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    // 🆕 فرمت کردن مقدار اولیه (موقع بارگذاری صفحه)
    $('.input-mask-money').each(function () {
        var val = $(this).val();
        if (val) {
            $(this).val(formatMoney(val));
        }
    });

    // فرمت کردن موقع تایپ
    $(document).on('input', '.input-mask-money', function () {
        var cursorPos = this.selectionStart;
        var oldValue = this.value;
        var newValue = formatMoney(oldValue);

        if (oldValue !== newValue) {
            this.value = newValue;
            // تنظیم مکان کرسر
            var diff = newValue.length - oldValue.length;
            this.setCursorPosition
                ? this.setSelectionRange(cursorPos + diff, cursorPos + diff)
                : null;
        }
    });

    // 🆕 موقع submit، کاماها رو حذف کن
    $(document).on('submit', 'form', function () {
        $(this).find('.input-mask-money').each(function () {
            var val = $(this).val();
            if (val) {
                $(this).val(val.replace(/,/g, ''));
            }
        });
    });

    // موبایل (0912-345-6789)
    $('.input-mask-mobile').inputmask({
        mask: '0999-999-9999',
        placeholder: '',
        clearIncomplete: false,
        showMaskOnHover: false
    });

    // تلفن ثابت (021-12345678)
    $('.input-mask-phone').inputmask({
        mask: '099-99999999',
        placeholder: '',
        clearIncomplete: false,
        showMaskOnHover: false
    });

    // کد پستی (12345-67890)
    $('.input-mask-postal-code').inputmask({
        mask: '99999-99999',
        placeholder: '',
        clearIncomplete: false,
        showMaskOnHover: false
    });

    // کد ملی (10 رقم)
    $('.input-mask-national-id').inputmask({
        mask: '9999999999',
        placeholder: '',
        clearIncomplete: false,
        showMaskOnHover: false
    });

    // کد اقتصادی (12 رقم)
    $('.input-mask-economic-code').inputmask({
        mask: '999999999999',
        placeholder: '',
        clearIncomplete: false,
        showMaskOnHover: false
    });
});


/* ============================================
   اعداد فارسی برای فرم‌ها
   ============================================ */

/* ============================================
   اعداد فارسی + کاما
   ============================================ */

// تبدیل اعداد لاتین به فارسی
function toPersianNumber(input) {
    if (input === null || input === undefined) return '';
    const persianDigits = '۰۱۲۳۴۵۶۷۸۹';
    return input.toString().replace(/\d/g, d => persianDigits[d]);
}

// تبدیل اعداد فارسی به لاتین
function toEnglishNumber(input) {
    if (input === null || input === undefined) return '';
    return input.toString()
        .replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d))
        .replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d));
}

// فرمت کردن عدد با کاما
function formatNumber(value) {
    if (value === null || value === undefined || value === '') return '';

    // تبدیل به لاتین
    let english = toEnglishNumber(value.toString());

    // حذف هر چیزی غیر از عدد و منفی
    english = english.replace(/[^0-9-]/g, '');

    if (english === '' || english === '-') return english;

    // جدا کردن سه‌رقمی
    const parts = english.split('.');
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');

    // تبدیل به فارسی
    return toPersianNumber(parts.join('.'));
}

// تبدیل مقدار input به فرمت قابل ارسال (لاتین بدون کاما)
function normalizeForSubmit(value) {
    if (value === null || value === undefined) return '';
    let english = toEnglishNumber(value.toString());
    english = english.replace(/,/g, '');
    return english;
}

$(document).ready(function () {

    // ---------- فرمت اولیه (موقع بارگذاری) ----------
    $('input.persian-number').each(function () {
        const $input = $(this);
        const val = $input.val();
        if (val) {
            $input.val(formatNumber(val));
        }
    });

    // ---------- فرمت موقع تایپ ----------
    $(document).on('input', 'input.persian-number', function () {
        const $input = $(this);
        const cursorPos = this.selectionStart;
        const oldVal = $input.val();
        const newVal = formatNumber(oldVal);

        if (oldVal !== newVal) {
            $input.val(newVal);
            // تنظیم مکان کرسر
            const diff = newVal.length - oldVal.length;
            this.setSelectionRange(cursorPos + diff, cursorPos + diff);
        }
    });

    // ---------- تبدیل به لاتین موقع submit ----------
    $(document).on('submit', 'form', function () {
        $(this).find('input.persian-number').each(function () {
            const $input = $(this);
            const val = $input.val();
            if (val) {
                $input.val(normalizeForSubmit(val));
            }
        });
    });

});

// موقع submit، اعداد فارسی رو به لاتین برگردون
$(document).on('submit', 'form', function () {
    $(this).find('input.persian-number').each(function () {
        const $input = $(this);
        let val = $input.val();
        if (val) {
            val = toEnglishNumber(val);
            // کاما رو حذف نکن (چون input-mask-money نیست)
            $input.val(val);
        }
    });
});