@model MyFirstCoreApp.Models.Permission

@{
    ViewData["Title"] = "ویرایش دسترسی";
}

<h2>ویرایش دسترسی</h2>

<form asp-area="Admin"
      asp-controller="Permissions"
      asp-action="Edit"
      method="post">

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="form-floating mb-3">
        <input asp-for="Name"
               class="form-control" />

        <label asp-for="Name">
            نام دسترسی
        </label>

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="DisplayName"
               class="form-control" />

        <label asp-for="DisplayName">
            عنوان
        </label>

        <span asp-validation-for="DisplayName"
              class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="GroupName"
               class="form-control" />

        <label asp-for="GroupName">
            گروه
        </label>

        <span asp-validation-for="GroupName"
              class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive"
               class="form-check-input" />

        <label asp-for="IsActive"
               class="form-check-label">
            فعال
        </label>
    </div>

    <button type="submit"
            class="btn btn-primary">
        ذخیره
    </button>

    <a asp-area="Admin"
       asp-controller="Permissions"
       asp-action="Index"
       class="btn btn-secondary">
        انصراف
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}