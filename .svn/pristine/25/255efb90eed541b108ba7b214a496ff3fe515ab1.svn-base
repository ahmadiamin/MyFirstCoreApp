@page

@{
    ViewData["Title"] = "بازیابی کلمه عبور";
}

<div class="row justify-content-center">

    <div class="col-md-6 col-lg-5">

        <div class="card card-primary">

            <div class="card-header text-center">

                <h3 class="card-title float-none">
                    <i class="fa fa-envelope"></i>
                    بررسی ایمیل
                </h3>

            </div>

            <div class="card-body text-center">

                <i class="fa fa-check-circle text-success fa-3x mb-3"></i>

                <h5>
                    درخواست بازیابی ثبت شد
                </h5>

                <p class="text-muted mt-3">
                    اگر حساب کاربری با این ایمیل وجود داشته باشد،
                    دستورالعمل بازیابی کلمه عبور برای شما ارسال خواهد شد.
                </p>

                <a asp-page="./Login"
                   class="btn btn-primary mt-3">

                    <i class="fa fa-sign-in"></i>
                    بازگشت به صفحه ورود

                </a>

            </div>

        </div>

    </div>

</div>