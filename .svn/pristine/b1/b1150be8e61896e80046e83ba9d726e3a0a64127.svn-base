@model List<AccountCategoryListViewModel>

@{
    ViewData["Title"] = "دسته‌بندی حساب‌ها";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i>
        @TempData["Error"]
    </div>
}

<div class="card">

    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-list"></i>
            لیست دسته‌بندی‌ها
        </h3>
        <div class="card-tools">
            <a asp-area="Accounting"
               asp-controller="AccountCategories"
               asp-action="Create"
               class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i>
                دسته‌بندی جدید
            </a>
        </div>
    </div>

    <div class="card-body">

        @if (Model.Any())
        {
            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>نام</th>
                        <th>کد</th>
                        <th>دسته والد</th>
                        <th>نوع پیش‌فرض</th>
                        <th>ترتیب</th>
                        <th>وضعیت</th>
                        <th style="width: 120px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>
                                <i class="fa fa-folder text-warning"></i>
                                <strong>@item.Name</strong>
                            </td>
                            <td>@item.Code</td>
                            <td>@item.ParentName</td>
                            <td>@item.DefaultAccountTypeName</td>
                            <td>@item.SortOrder</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">غیرفعال</span>
                                }
                            </td>
                            <td>
                                <a asp-area="Accounting"
                                   asp-controller="AccountCategories"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary"
                                   title="ویرایش">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <a asp-area="Accounting"
                                   asp-controller="AccountCategories"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   title="حذف">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa fa-folder-open" style="font-size: 4rem; color: #ccc;"></i>
                <h5 class="mt-3 text-muted">هنوز دسته‌بندی‌ای ثبت نشده</h5>
                <a asp-area="Accounting"
                   asp-controller="AccountCategories"
                   asp-action="Create"
                   class="btn btn-primary mt-2">
                    <i class="fa fa-plus"></i>
                    ثبت اولین دسته‌بندی
                </a>
            </div>
        }

    </div>

</div>