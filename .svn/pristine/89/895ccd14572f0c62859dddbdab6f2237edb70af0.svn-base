@using DNTPersianUtils.Core
@model MyFirstCoreApp.Domain.Entities.Accounting.Transaction
@{
    ViewData["Title"] = $"حذف سند شماره {Model.Number}";

    var confirmModel = new MyFirstCoreApp.Models.ViewModels.DeleteConfirmViewModel
    {
        Title = "حذف سند",
        Message = "آیا از حذف این سند مطمئن هستید؟",
        Area = "Accounting",
        Controller = "Transactions",
        Id = Model.Id,
        Items = new()
        {
            new() { Label = "شماره سند", Value = Model.Number.ToString() },
            new() { Label = "تاریخ", Value = Model.Date.ToShortPersianDateString() },
            new() { Label = "شرح", Value = Model.Description },
            new() { Label = "مبلغ کل", Value = Model.TotalAmount.ToString("N0") }
        }
    };
}

<partial name="_DeleteConfirm" model="confirmModel" />