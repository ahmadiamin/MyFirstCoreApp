using Microsoft.AspNetCore.Identity;
using Microsoft.EntityFrameworkCore;
using MyFirstCoreApp.Data;
using MyFirstCoreApp.Models;
using MyFirstCoreApp.Models.ViewModels;
using MyFirstCoreApp.Services.Interfaces;

namespace MyFirstCoreApp.Services
{
    public class UserService : IUserService
    {
        private readonly UserManager<ApplicationUser> _userManager;
        private readonly RoleManager<IdentityRole> _roleManager;
        private readonly ApplicationDbContext _context;
        private readonly IFileService _fileService;

        public UserService(
            UserManager<ApplicationUser> userManager,
            RoleManager<IdentityRole> roleManager,
            ApplicationDbContext context,
            IFileService fileService)
        {
            _userManager = userManager;
            _roleManager = roleManager;
            _context = context;
            _fileService = fileService;
        }

        public async Task<List<UserListViewModel>> GetAllAsync()
        {
            return await _userManager.Users
                .OrderBy(x => x.FullName)
                .Select(user => new UserListViewModel
                {
                    Id = user.Id,
                    FullName = user.FullName,
                    Email = user.Email ?? string.Empty,
                    UserName = user.UserName ?? string.Empty,
                    PhoneNumber = user.PhoneNumber,
                    IsActive = user.IsActive,
                    EmailConfirmed = user.EmailConfirmed,

                    Roles = _context.UserRoles
                        .Where(userRole => userRole.UserId == user.Id)
                        .Join(
                            _context.Roles,
                            userRole => userRole.RoleId,
                            role => role.Id,
                            (userRole, role) => role.Name!)
                        .ToList()
                })
                .ToListAsync();
        }

        public async Task<ApplicationUser?> GetByIdAsync(string id)
        {
            return await _userManager.FindByIdAsync(id);
        }

        public async Task<IdentityResult> CreateAsync(
            ApplicationUser user,
            string password)
        {
            return await _userManager.CreateAsync(user, password);
        }

        public async Task<List<RoleViewModel>> GetRolesForUserAsync(
            ApplicationUser user)
        {
            var userRoles = await _userManager.GetRolesAsync(user);

            return await _roleManager.Roles
                .OrderBy(x => x.Name)
                .Select(x => new RoleViewModel
                {
                    Id = x.Id,
                    Name = x.Name!,
                    Selected = userRoles.Contains(x.Name!)
                })
                .ToListAsync();
        }

        public async Task<List<string>> GetUserRolesAsync(
            ApplicationUser user)
        {
            var roles = await _userManager.GetRolesAsync(user);

            return roles.ToList();
        }

        public async Task<IdentityResult> UpdateAsync(
            ApplicationUser user)
        {
            return await _userManager.UpdateAsync(user);
        }

        public async Task<IdentityResult> UpdateRolesAsync(
            ApplicationUser user,
            IEnumerable<string> selectedRoles)
        {
            var currentRoles =
                await _userManager.GetRolesAsync(user);

            var selected = selectedRoles?.ToList()
                           ?? new List<string>();

            var rolesToRemove = currentRoles
                .Where(role => !selected.Contains(role))
                .ToList();

            if (rolesToRemove.Count > 0)
            {
                var removeResult =
                    await _userManager.RemoveFromRolesAsync(
                        user,
                        rolesToRemove);

                if (!removeResult.Succeeded)
                    return removeResult;
            }

            var rolesToAdd = selected
                .Where(role => !currentRoles.Contains(role))
                .ToList();

            if (rolesToAdd.Count > 0)
            {
                var addResult =
                    await _userManager.AddToRolesAsync(
                        user,
                        rolesToAdd);

                if (!addResult.Succeeded)
                    return addResult;
            }

            return IdentityResult.Success;
        }

        public async Task<IdentityResult> ToggleActiveAsync(
            ApplicationUser user)
        {
            user.IsActive = !user.IsActive;

            return await _userManager.UpdateAsync(user);
        }

        public async Task<List<UserProfileImage>> GetProfileImagesAsync(
            string userId)
        {
            return await _context.UserProfileImages
                .Where(x => x.UserId == userId)
                .OrderByDescending(x => x.IsPrimary)
                .ThenBy(x => x.SortOrder)
                .ThenByDescending(x => x.CreatedAt)
                .ToListAsync();
        }

        public async Task<UserProfileImage?> GetProfileImageAsync(
            int imageId)
        {
            return await _context.UserProfileImages
                .FirstOrDefaultAsync(x => x.Id == imageId);
        }

        public async Task<UserProfileImage> AddProfileImageAsync(
    string userId,
    IFormFile file)
        {
            var images = await _context.UserProfileImages
                .Where(x => x.UserId == userId)
                .ToListAsync();

            // آیا قبلاً تصویر اصلی داریم؟
            var hasPrimary = images.Any(x => x.IsPrimary);

            var relativePath =
                await _fileService.SaveAsync(
                    file,
                    $"Users/Profile/{userId}");

            var image = new UserProfileImage
            {
                UserId = userId,
                FileName = relativePath,
                OriginalFileName = Path.GetFileName(file.FileName),
                ContentType = file.ContentType,
                FileSize = file.Length,

                // فقط اگر هیچ تصویر اصلی وجود ندارد
                // این تصویر اصلی شود
                IsPrimary = !hasPrimary,

                SortOrder = images.Count,
                CreatedAt = DateTime.UtcNow
            };

            _context.UserProfileImages.Add(image);

            await _context.SaveChangesAsync();

            return image;
        }

        public async Task DeleteProfileImageAsync(int imageId)
        {
            var image =
                await _context.UserProfileImages
                    .FirstOrDefaultAsync(x => x.Id == imageId);

            if (image == null)
                return;

            var userId = image.UserId;

            var remainingImages =
                await _context.UserProfileImages
                    .Where(x =>
                        x.UserId == userId &&
                        x.Id != imageId)
                    .OrderBy(x => x.SortOrder)
                    .ThenBy(x => x.CreatedAt)
                    .ToListAsync();

            await _fileService.DeleteAsync(
                image.FileName);

            _context.UserProfileImages.Remove(image);

            // ابتدا همه تصاویر باقی‌مانده غیر اصلی
            foreach (var item in remainingImages)
            {
                item.IsPrimary = false;
            }

            // اگر تصویری باقی مانده، اولین تصویر را اصلی کن
            var nextPrimary =
                remainingImages.FirstOrDefault();

            if (nextPrimary != null)
            {
                nextPrimary.IsPrimary = true;
            }

            await _context.SaveChangesAsync();
        }

        public async Task SetPrimaryProfileImageAsync(int imageId)
        {
            var image =
                await _context.UserProfileImages
                    .FirstOrDefaultAsync(x => x.Id == imageId);

            if (image == null)
                return;

            var images =
                await _context.UserProfileImages
                    .Where(x => x.UserId == image.UserId)
                    .ToListAsync();

            // ابتدا همه تصاویر را غیر اصلی کن
            foreach (var item in images)
            {
                item.IsPrimary = false;
            }

            await _context.SaveChangesAsync();

            // حالا تصویر انتخاب شده را اصلی کن
            image.IsPrimary = true;

            await _context.SaveChangesAsync();
        }


        public async Task<(string PhysicalPath, string ContentType)?> GetProfileImageFileAsync(int imageId)
        {
            var image = await _context.UserProfileImages
                .FirstOrDefaultAsync(x => x.Id == imageId);

            if (image == null)
                return null;

            var physicalPath =
                _fileService.GetPhysicalPath(image.FileName);

            if (!File.Exists(physicalPath))
                return null;

            return (
                physicalPath,
                image.ContentType ?? "application/octet-stream"
            );
        }
        public async Task<UserProfileImage> ChangeProfileImageAsync(
    string userId,
    IFormFile file)
        {
            var images =
                await _context.UserProfileImages
                    .Where(x => x.UserId == userId)
                    .ToListAsync();

            // 1. همه تصاویر قبلی را غیر اصلی کن
            foreach (var image in images)
            {
                image.IsPrimary = false;
            }

            await _context.SaveChangesAsync();

            // 2. فایل جدید را ذخیره کن
            var relativePath =
                await _fileService.SaveAsync(
                    file,
                    $"Users/Profile/{userId}");

            var newImage = new UserProfileImage
            {
                UserId = userId,
                FileName = relativePath,
                OriginalFileName = Path.GetFileName(file.FileName),
                ContentType = file.ContentType,
                FileSize = file.Length,
                IsPrimary = true,
                SortOrder = images.Count,
                CreatedAt = DateTime.UtcNow
            };

            _context.UserProfileImages.Add(newImage);

            await _context.SaveChangesAsync();

            return newImage;
        }

        public async Task DeletePrimaryProfileImageAsync(string userId)
        {
            var image =
                await _context.UserProfileImages
                    .FirstOrDefaultAsync(x =>
                        x.UserId == userId &&
                        x.IsPrimary);

            if (image == null)
                return;

            await _fileService.DeleteAsync(
                image.FileName);

            _context.UserProfileImages.Remove(image);

            await _context.SaveChangesAsync();
        }
    }
}