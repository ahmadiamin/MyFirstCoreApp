@model List<ContactListViewModel>
@{
    ViewData["Title"] = "طرف حساب‌ها";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}
<!-- 🆕 فرم جستجو -->
<div class="card card-outline card-info">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-search"></i>
            جستجو و فیلتر
        </h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fa fa-plus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <form asp-area="Contacts" asp-controller="Contacts" asp-action="Index" method="get">
            <div class="row">

                <div class="col-md-4">
                    <div class="form-group">
                        <label>جستجو</label>
                        <input type="text" name="search" value="@ViewBag.Search"
                               class="form-control"
                               placeholder="نام، کد، موبایل، تلفن، کد ملی..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>نوع</label>
                        <select name="type" class="form-control">
                            <option value="">-- همه --</option>
                            <option value="1" selected="@(ViewBag.Type == MyFirstCoreApp.Domain.Enums.ContactType.Customer)">مشتری</option>
                            <option value="2" selected="@(ViewBag.Type == MyFirstCoreApp.Domain.Enums.ContactType.Supplier)">فروشنده</option>
                            <option value="3" selected="@(ViewBag.Type == MyFirstCoreApp.Domain.Enums.ContactType.Both)">مشتری و فروشنده</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>وضعیت</label>
                        <select name="status" class="form-control">
                            <option value="">-- همه --</option>
                            <option value="active" selected="@(ViewBag.Status == "active")">فعال</option>
                            <option value="inactive" selected="@(ViewBag.Status == "inactive")">غیرفعال</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <div>
                            <button type="submit" class="btn btn-info">
                                <i class="fa fa-search"></i>جستجو
                            </button>
                            <a asp-area="Contacts" asp-controller="Contacts" asp-action="Index"
                               class="btn btn-secondary">
                                <i class="fa fa-times"></i> 
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-address-book"></i>
            لیست طرف حساب‌ها
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.Type != null || !string.IsNullOrEmpty(ViewBag.Status as string))
            {
                <small class="text-muted">
                    (نتایج فیلتر: @Model.Count از @ViewBag.TotalCount)
                </small>
            }
        </h3>
        <div class="card-tools">
            <a asp-area="Contacts" asp-controller="Contacts" asp-action="Create"
               class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> طرف حساب جدید
            </a>
        </div>
    </div>
    
    <div class="card-body">
        @if (Model.Any())
        {
            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>نام</th>
                        <th>کد</th>
                        <th>نوع</th>
                        <th>موبایل</th>
                        <th>تلفن</th>
                        <th>مانده</th>
                        <th>وضعیت</th>
                        <th style="width: 120px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>
                                <i class="fa fa-user text-primary"></i>
                                <strong>@item.Name</strong>
                            </td>
                            <td>@item.Code</td>
                            <td>
                                @if (item.ContactType == MyFirstCoreApp.Domain.Enums.ContactType.Customer)
                                {
                                    <span class="badge badge-info">مشتری</span>
                                }
                                else if (item.ContactType == MyFirstCoreApp.Domain.Enums.ContactType.Supplier)
                                {
                                    <span class="badge badge-warning">فروشنده</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">مشتری و فروشنده</span>
                                }
                            </td>
                            <td dir="ltr">@item.Mobile</td>
                            <td dir="ltr">@item.Phone</td>
                            <td>@item.CurrentBalance.ToString("N0")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">غیرفعال</span>
                                }
                            </td>
                            <td>
                                <a asp-area="Contacts" asp-controller="Contacts"
                                   asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary" title="ویرایش">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <a asp-area="Contacts" asp-controller="Contacts"
                                   asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger" title="حذف">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa fa-address-book" style="font-size: 4rem; color: #ccc;"></i>
                <h5 class="mt-3 text-muted">هنوز طرف حسابی ثبت نشده</h5>
                <a asp-area="Contacts" asp-controller="Contacts" asp-action="Create"
                   class="btn btn-primary mt-2">
                    <i class="fa fa-plus"></i> ثبت اولین طرف حساب
                </a>
            </div>
        }
    </div>
</div>