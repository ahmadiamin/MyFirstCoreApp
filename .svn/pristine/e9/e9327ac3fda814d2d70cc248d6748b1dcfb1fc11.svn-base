using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using MyFirstCoreApp.Data;
using MyFirstCoreApp.Models;
using MyFirstCoreApp.Models.ViewModels;

namespace MyFirstCoreApp.Areas.Admin.Controllers
{
    [Area("Admin")]
    public class RolesController : Controller
    {
        private readonly RoleManager<IdentityRole> _roleManager;
        private readonly ApplicationDbContext _context;

        public RolesController(
            RoleManager<IdentityRole> roleManager,
            ApplicationDbContext context)
        {
            _roleManager = roleManager;
            _context = context;
        }

        // GET: /Admin/Roles
        [Authorize(Policy = "Role.View")]
        public async Task<IActionResult> Index()
        {
            var roles = await _roleManager.Roles
                .OrderBy(x => x.Name)
                .Select(role => new RoleListViewModel
                {
                    Id = role.Id,
                    Name = role.Name ?? string.Empty,

                    UserCount = _context.UserRoles
                        .Count(userRole => userRole.RoleId == role.Id),

                    PermissionCount = _context.RolePermissions
                        .Count(rolePermission =>
                            rolePermission.RoleId == role.Id)
                })
                .ToListAsync();

            return View(roles);
        }

        // GET: /Admin/Roles/Create
        [HttpGet]
        [Authorize(Policy = "Role.Create")]
        public IActionResult Create()
        {
            return View();
        }

        // POST: /Admin/Roles/Create
        [HttpPost]
        [ValidateAntiForgeryToken]
        [Authorize(Policy = "Role.Create")]
        public async Task<IActionResult> Create(string name)
        {
            if (string.IsNullOrWhiteSpace(name))
            {
                ModelState.AddModelError(
                    string.Empty,
                    "نام نقش الزامی است.");

                return View();
            }

            var normalizedName = name.Trim();

            if (await _roleManager.RoleExistsAsync(normalizedName))
            {
                ModelState.AddModelError(
                    string.Empty,
                    "این نقش قبلاً وجود دارد.");

                return View();
            }

            var role = new IdentityRole
            {
                Name = normalizedName
            };

            var result = await _roleManager.CreateAsync(role);

            if (result.Succeeded)
            {
                return RedirectToAction(nameof(Index));
            }

            foreach (var error in result.Errors)
            {
                ModelState.AddModelError(
                    string.Empty,
                    error.Description);
            }

            return View();
        }

        // GET: /Admin/Roles/Edit/{id}
        [HttpGet]
        [Authorize(Policy = "Role.Edit")]
        public async Task<IActionResult> Edit(string id)
        {
            if (string.IsNullOrEmpty(id))
                return NotFound();

            var role = await _roleManager.FindByIdAsync(id);

            if (role == null)
                return NotFound();

            var rolePermissionIds = await _context.RolePermissions
                .Where(x => x.RoleId == role.Id)
                .Select(x => x.PermissionId)
                .ToListAsync();

            var permissions = await _context.Permissions
                .Where(x => x.IsActive)
                .OrderBy(x => x.GroupName)
                .ThenBy(x => x.Name)
                .ToListAsync();

            var model = new EditRoleViewModel
            {
                Id = role.Id,
                Name = role.Name ?? string.Empty,

                PermissionGroups = permissions
        .GroupBy(x => x.GroupName ?? "سایر")
        .Select(group => new PermissionGroupViewModel
        {
            GroupName = group.Key,

            Permissions = group
                .Select(permission => new PermissionItemViewModel
                {
                    Id = permission.Id,
                    Name = permission.Name,
                    DisplayName = permission.DisplayName,
                    Selected = rolePermissionIds.Contains(permission.Id)
                })
                .ToList()
        })
        .ToList()
            };

            return View(model);
        }

        // POST: /Admin/Roles/Edit
        [HttpPost]
        [ValidateAntiForgeryToken]
        [Authorize(Policy = "Role.Edit")]
        public async Task<IActionResult> Edit(EditRoleViewModel model)
        {
            if (!ModelState.IsValid)
            {
                await LoadPermissions(model);
                return View(model);
            }

            var role = await _roleManager.FindByIdAsync(model.Id);

            if (role == null)
                return NotFound();

            var normalizedName = model.Name.Trim();

            var existingRole = await _roleManager.FindByNameAsync(normalizedName);

            if (existingRole != null && existingRole.Id != role.Id)
            {
                ModelState.AddModelError(
                    nameof(model.Name),
                    "این نام نقش قبلاً استفاده شده است.");

                await LoadPermissions(model);
                return View(model);
            }

            role.Name = normalizedName;

            var roleResult = await _roleManager.UpdateAsync(role);

            if (!roleResult.Succeeded)
            {
                foreach (var error in roleResult.Errors)
                {
                    ModelState.AddModelError(
                        string.Empty,
                        error.Description);
                }

                await LoadPermissions(model);
                return View(model);
            }

            var selectedPermissionIds = model.PermissionGroups
                .SelectMany(x => x.Permissions)
                .Where(x => x.Selected)
                .Select(x => x.Id)
                .Distinct()
                .ToList();

            var currentPermissionIds = await _context.RolePermissions
                .Where(x => x.RoleId == role.Id)
                .Select(x => x.PermissionId)
                .ToListAsync();

            var permissionsToRemove = currentPermissionIds
                .Except(selectedPermissionIds)
                .ToList();

            if (permissionsToRemove.Count > 0)
            {
                var itemsToRemove = await _context.RolePermissions
                    .Where(x =>
                        x.RoleId == role.Id &&
                        permissionsToRemove.Contains(x.PermissionId))
                    .ToListAsync();

                _context.RolePermissions.RemoveRange(itemsToRemove);
            }

            var permissionsToAdd = selectedPermissionIds
                .Except(currentPermissionIds)
                .ToList();

            foreach (var permissionId in permissionsToAdd)
            {
                _context.RolePermissions.Add(new RolePermission
                {
                    RoleId = role.Id,
                    PermissionId = permissionId
                });
            }

            await _context.SaveChangesAsync();

            return RedirectToAction(nameof(Index));
        }

        private async Task LoadPermissions(EditRoleViewModel model)
        {
            var selectedPermissionIds = await _context.RolePermissions
                .Where(x => x.RoleId == model.Id)
                .Select(x => x.PermissionId)
                .ToListAsync();

            var permissions = await _context.Permissions
                .Where(x => x.IsActive)
                .OrderBy(x => x.GroupName)
                .ThenBy(x => x.Name)
                .ToListAsync();

            model.PermissionGroups = permissions
                .GroupBy(x => x.GroupName ?? "سایر")
                .Select(group => new PermissionGroupViewModel
                {
                    GroupName = group.Key,

                    Permissions = group
                        .Select(permission => new PermissionItemViewModel
                        {
                            Id = permission.Id,
                            Name = permission.Name,
                            DisplayName = permission.DisplayName,
                            Selected = selectedPermissionIds.Contains(permission.Id)
                        })
                        .ToList()
                })
                .ToList();
        }
    }
}