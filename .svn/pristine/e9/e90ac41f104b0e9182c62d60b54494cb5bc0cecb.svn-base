@model MyFirstCoreApp.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "داشبورد";
}

<div class="row">

    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@Model.UserCount</h3>
                <p>کاربران</p>
            </div>
            <div class="icon">
                <i class="fa fa-users"></i>
            </div>
            <a asp-area="Admin"
               asp-controller="Users"
               asp-action="Index"
               class="small-box-footer">
                مشاهده کاربران
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@Model.RoleCount</h3>
                <p>نقش‌ها</p>
            </div>
            <div class="icon">
                <i class="fa fa-user"></i>
            </div>
            <a asp-area="Admin"
               asp-controller="Roles"
               asp-action="Index"
               class="small-box-footer">
                مشاهده نقش‌ها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@Model.PermissionCount</h3>
                <p>دسترسی‌ها</p>
            </div>
            <div class="icon">
                <i class="fa fa-key"></i>
            </div>
            <a asp-area="Admin"
               asp-controller="Permissions"
               asp-action="Index"
               class="small-box-footer">
                مشاهده دسترسی‌ها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@Model.MenuCount</h3>
                <p>منوها</p>
            </div>
            <div class="icon">
                <i class="fa fa-bars"></i>
            </div>
            <a asp-area="Admin"
               asp-controller="Menus"
               asp-action="Index"
               class="small-box-footer">
                مشاهده منوها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

</div>