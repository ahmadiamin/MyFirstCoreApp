@model IEnumerable<MyFirstCoreApp.Models.ViewModels.UserListViewModel>
@inject PermissionService PermissionService
@{
    ViewData["Title"] = "مدیریت کاربران";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>مدیریت کاربران</h2>

    @if (await PermissionService.HasPermissionAsync(User, "User.Create"))
    {
        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Create"
           class="btn btn-primary">
            ایجاد کاربر
        </a>
    }
</div>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>نام و نام خانوادگی</th>
            <th>ایمیل</th>
            <th>نام کاربری</th>
            <th>تلفن</th>
            <th>نقش‌ها</th>
            <th>وضعیت</th>
            <th>عملیات</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.UserName</td>
                <td>@user.PhoneNumber</td>
                <td>
                    @if (user.Roles.Any())
                    {
                        foreach (var role in user.Roles)
                        {
                            <span class="badge bg-secondary me-1">
                                @role
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">بدون نقش</span>
                    }
                </td>
                <td>
                    @if (user.IsActive)
                    {
                        <span class="badge bg-success">فعال</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">غیرفعال</span>
                    }
                </td>
                <td>
                    @if (await PermissionService.HasPermissionAsync(User, "User.Edit"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@user.Id"
                           class="btn btn-sm btn-warning">
                            ویرایش
                        </a>
                    }
                    @if (await PermissionService.HasPermissionAsync(User, "User.Active"))
                    {
                        <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="d-inline">
                            @if (user.IsActive)
                            {
                                <button type="submit" class="btn btn-sm btn-danger">
                                    غیرفعال
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-success">
                                    فعال
                                </button>
                            }
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>