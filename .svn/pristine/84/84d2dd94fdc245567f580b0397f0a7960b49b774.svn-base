@model MyFirstCoreApp.Areas.Accounting.ViewModels.Report.LedgerReportViewModel
@{
    ViewData["Title"] = "گزارش معین";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i>
        @TempData["Error"]
    </div>
}
<div class="card card-outline card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-book"></i>
            گزارش معین
        </h3>
    </div>
    <div class="card-body">
        <form asp-action="Ledger" method="get">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="AccountId">حساب</label>
                        <select asp-for="AccountId" class="form-control select2"
                                asp-items="Model.AccountOptions">
                            <option value="">-- انتخاب حساب --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="FromDate">از تاریخ</label>
                        <input asp-for="FromDate" type="text"
                               class="form-control datepicker"
                               placeholder=""
                               autocomplete="off"
                               dir="ltr" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="ToDate">تا تاریخ</label>
                        <input asp-for="ToDate" type="text"
                               class="form-control datepicker"
                               placeholder=""
                               autocomplete="off"
                               dir="ltr" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fa fa-search"></i> نمایش
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.AccountId.HasValue && Model.Lines.Any())
{
 
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fa fa-university"></i>
                @Model.AccountName
                @if (!string.IsNullOrEmpty(Model.AccountCode))
                {
                    <small class="text-muted">(@Model.AccountCode)</small>
                }
            </h3>
        </div>
        <div class="card-body">

            <!-- مانده اول دوره -->
            <div class="alert alert-info">
                <strong>مانده اول دوره:</strong>
                <span class="persian-number-comma">@Model.OpeningBalance.ToString("N0")</span>
            </div>

            @if (Model.Lines.Any())
            {
                <table class="table table-bordered table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th style="width: 100px;">شماره سند</th>
                            <th style="width: 110px;">تاریخ</th>
                            <th>شرح</th>
                            <th style="width: 120px;">مرجع</th>
                            <th style="width: 130px;">بدهکار</th>
                            <th style="width: 130px;">بستانکار</th>
                            <th style="width: 130px;">مانده</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var i = 1;
                        }
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td class="persian-number">@i</td>
                                <td>
                                    <a asp-controller="Transactions" asp-action="Details"
                                       asp-route-id="@line.TransactionId">
                                        @line.TransactionNumber
                                    </a>
                                </td>
                                <td>@line.DateShamsi</td>
                                <td>@line.Description</td>
                                <td>@line.Reference</td>
                                <td class="persian-number-comma">@(line.Debit > 0 ? line.Debit.ToString("N0") : "")</td>
                                <td class="persian-number-comma">@(line.Credit > 0 ? line.Credit.ToString("N0") : "")</td>
                                <td class="persian-number-comma">@line.RunningBalance.ToString("N0")</td>
                            </tr>
                            i++;
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-light">
                            <th colspan="5" class="text-left">جمع:</th>
                            <th class="persian-number-comma">@Model.TotalDebit.ToString("N0")</th>
                            <th class="persian-number-comma">@Model.TotalCredit.ToString("N0")</th>
                            <th class="persian-number-comma">@Model.ClosingBalance.ToString("N0")</th>
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fa fa-info-circle"></i>
                    تراکنشی در این بازه یافت نشد.
                </div>
            }

            <!-- مانده آخر دوره -->
            <div class="alert alert-success">
                <strong>مانده آخر دوره:</strong>
                <span class="persian-number-comma">@Model.ClosingBalance.ToString("N0")</span>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                dir: 'rtl',
                placeholder: '-- انتخاب کنید --',
                allowClear: true,
                width: '100%',
                language: 'fa'
            });

            $('.datepicker').persianDatepicker({
                format: 'YYYY/MM/DD',
                initialValue: true,               // 🆕
                initialValueType: 'persian',      // 🆕
                autoClose: true,
                observer: true,
                calendar: {
                    persian: {
                        locale: 'fa',
                        showHint: true,
                        leapYearMode: 'algorithmic'
                    }
                },
                toolbox: {
                    calendarSwitch: {
                        enabled: false
                    }
                }
            });
        });
    </script>
}