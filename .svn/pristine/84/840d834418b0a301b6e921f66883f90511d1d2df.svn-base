  </ItemGroup>

  <ItemGroup>
    <None Include="Persistence\Configurations\Banking\PaymentConfiguration.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
