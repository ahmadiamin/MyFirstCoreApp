namespace MyFirstCoreApp.Domain.Enums;

/// <summary>
/// عملیات چک
/// </summary>
public enum ChequeHistoryAction
{
    Created = 1,        // ایجاد
    Deposited = 2,      // به بانک داده شد
    Cleared = 3,        // پاس شد
    Bounced = 4,        // برگشت خورد
    Returned = 5,       // عودت داده شد
    RePresented = 6,    // مجدد ارائه شد
    Cancelled = 7,      // ابطال شد
    Referred = 8,       // ارجاع به صاحب چک
    Cashed = 9,         // نقد شد
    StatusChanged = 10, // تغییر وضعیت
    Note = 11           // یادداشت
}