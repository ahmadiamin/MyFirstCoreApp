@{
    ViewData["Title"] = "طرف حساب‌ها";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-address-book"></i>
            لیست طرف حساب‌ها
        </h3>
        <div class="card-tools">
            <a asp-area="Contacts" asp-controller="Contacts" asp-action="Create"
               class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> طرف حساب جدید
            </a>
        </div>
    </div>
    <div class="card-body">

        <!-- 🆕 جستجو -->
        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                    <input type="text" id="txtSearch"
                           class="form-control"
                           placeholder="جستجو در نام، کد، موبایل، تلفن، کد ملی..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <!-- 🆕 AG Grid -->
        <div id="contactsGrid" class="ag-theme-alpine"
             style="height: 600px; width: 100%;">
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            const columnDefs = [
                AgGridHelper.rowNumberColumn(),

                {
                    field: 'name',
                    headerName: 'نام',
                    flex: 2,
                    minWidth: 200
                },
                {
                    field: 'code',
                    headerName: 'کد',
                    width: 100
                },
                {
                    field: 'contactType',
                    headerName: 'نوع',
                    width: 130
                },
                {
                    field: 'mobile',
                    headerName: 'موبایل',
                    width: 140
                },
                {
                    field: 'phone',
                    headerName: 'تلفن',
                    width: 140
                },
                AgGridHelper.moneyColumn('currentBalance', 'مانده'),
                AgGridHelper.statusColumn('isActive'),
                AgGridHelper.actionColumn(
                    '/Contacts/Contacts/Edit/{id}',
                    '/Contacts/Contacts/Delete/{id}'
                )
            ];

            AgGridHelper.create(
                'contactsGrid',                    // container id
                columnDefs,                        // ستون‌ها
                '/Contacts/Contacts/GetData',      // API URL
                'txtSearch',                       // جستجو input id
                'lblCount'                         // شمارنده label id
            );

        });
    </script>
}