using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace MyFirstCoreApp.Models.Inventory
{
    // تصاویر کالا - یک کالا می‌تواند چند تصویر داشته باشد
    public class ItemImage
    {
        public int Id { get; set; }

        public int ItemId { get; set; }

        [ForeignKey(nameof(ItemId))]
        public Item Item { get; set; }

        [Required, MaxLength(500)]
        public string FilePath { get; set; } // مسیر ذخیره فایل (wwwroot/uploads/items/... یا مسیر ابری)

        public bool IsMain { get; set; } // تصویر اصلی/شاخص کالا برای نمایش در گرید

        public int SortOrder { get; set; }

        public DateTime CreatedAt { get; set; } = DateTime.Now;
    }
}
