@model MyFirstCoreApp.Models.ViewModels.MenuEditViewModel

@{
    ViewData["Title"] = "ایجاد منو";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>ایجاد منو</h1>

        <a asp-area="Admin"
           asp-controller="Menus"
           asp-action="Index"
           class="btn btn-secondary">
            بازگشت
        </a>
    </div>

    <div class="card">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Menus"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Title"
                               class="form-label">
                        </label>

                        <input asp-for="Title"
                               class="form-control" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Url"
                               class="form-label">
                        </label>

                        <input asp-for="Url"
                               class="form-control"
                               placeholder="/Admin/Users" />

                        <span asp-validation-for="Url"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Icon"
                               class="form-label">
                        </label>

                        <input asp-for="Icon"
                               class="form-control"
                               placeholder="bi-people" />

                        <div class="form-text">
                            نام آیکون Bootstrap Icons را وارد کنید.
                            مثال:
                            <code>bi-people</code>
                        </div>

                        <span asp-validation-for="Icon"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ParentId"
                               class="form-label">
                        </label>

                        <select asp-for="ParentId"
                                class="form-select">

                            <option value="">
                                -- منوی ریشه --
                            </option>

                            @foreach (var parent in Model.Parents)
                            {
                                <option value="@parent.Id">
                                    @parent.Title
                                </option>
                            }

                        </select>

                        <span asp-validation-for="ParentId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Permission"
                               class="form-label">
                        </label>

                        <select asp-for="Permission"
                                class="form-select">

                            <option value="">
                                -- بدون محدودیت دسترسی --
                            </option>

                            @foreach (var permission in Model.Permissions)
                            {
                                <option value="@permission.Name">
                                    @(string.IsNullOrWhiteSpace(permission.DisplayName)
                                                                    ? permission.Name
                                                                    : $"{permission.DisplayName} ({permission.Name})")
                            </option>
                                                        }

                        </select>

                        <span asp-validation-for="Permission"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="SortOrder"
                               class="form-label">
                        </label>

                        <input asp-for="SortOrder"
                               type="number"
                               class="form-control"
                               min="1" />

                        <span asp-validation-for="SortOrder"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-3 mb-3 d-flex align-items-center">
                        <div class="form-check mt-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                            </label>

                        </div>
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        ذخیره
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Menus"
                       asp-action="Index"
                       class="btn btn-secondary">
                        انصراف
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
