@model MyFirstCoreApp.Areas.Invoicing.ViewModels.Invoice.InvoiceFormViewModel

<div class="row">
    <div class="col-md-2">
        <div class="form-group">
            <label asp-for="Number"></label>
            <input asp-for="Number" class="form-control" readonly />
        </div>
    </div>

    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="Date"></label>
            <input asp-for="Date" class="form-control datepicker"
                   placeholder="۱۴۰۳/۰۵/۱۵" autocomplete="off" dir="ltr" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="InvoiceType"></label>
            <select asp-for="InvoiceType" class="form-control" asp-items="Model.InvoiceTypeOptions"></select>
            <span asp-validation-for="InvoiceType" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group">
            <label>طرف حساب</label>
            <div id="contactSelect"></div>
            <input type="hidden" name="ContactId" id="ContactId_Hidden" value="@(Model.ContactId ?? 0)" />
            <input type="hidden" name="ContactName" id="ContactName_Hidden" value="@(Model.ContactName ?? "")" />
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group">
            <label asp-for="Description"></label>
            <input asp-for="Description" class="form-control" placeholder="شرح فاکتور" />
        </div>
    </div>
</div>

<hr />

<h5 class="mb-3">
    <i class="fa fa-list"></i>
    اقلام فاکتور
</h5>

<div class="table-responsive">
    <table class="table table-bordered table-striped" id="itemsTable">
        <thead>
            <tr>
                <th style="width: 40px;">#</th>
                <th style="width: 250px;">کالا</th>
                <th style="width: 100px;">تعداد</th>
                <th style="width: 130px;">قیمت واحد</th>
                <th style="width: 100px;">تخفیف %</th>
                <th style="width: 100px;">مالیات %</th>
                <th style="width: 130px;">جمع خط</th>
                <th style="width: 60px;"></th>
            </tr>
        </thead>
        <tbody id="itemsBody">
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr class="item-row">
                    <td class="item-number">@(i + 1)</td>
                    <td>
                        <input type="hidden" name="Items[@i].Id" value="@Model.Items[i].Id" />
                        <select name="Items[@i].ProductId" class="form-control select2 product-select">
                            <option value="">-- انتخاب کالا --</option>
                            @foreach (var opt in Model.Items[i].ProductOptions)
                            {
                                <option value="@opt.Value" selected="@(opt.Value == Model.Items[i].ProductId.ToString())">@opt.Text</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input type="text" name="Items[@i].Quantity"
                               class="form-control persian-number quantity-input"
                               value="@Model.Items[i].Quantity" />
                    </td>
                    <td>
                        <input type="text" name="Items[@i].UnitPrice"
                               class="form-control persian-number persian-number-comma price-input"
                               value="@Model.Items[i].UnitPrice" />
                    </td>
                    <td>
                        <input type="text" name="Items[@i].DiscountPercent"
                               class="form-control persian-number discount-input"
                               value="@Model.Items[i].DiscountPercent" />
                    </td>
                    <td>
                        <input type="text" name="Items[@i].TaxRate"
                               class="form-control persian-number tax-input"
                               value="@Model.Items[i].TaxRate" />
                    </td>
                    <td>
                        <input type="text" name="Items[@i].LineTotal"
                               class="form-control persian-number persian-number-comma line-total"
                               readonly value="@Model.Items[i].LineTotal" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-danger remove-item">
                            <i class="fa fa-times"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<button type="button" class="btn btn-sm btn-success" id="addItem">
    <i class="fa fa-plus"></i> افزودن قلم
</button>

<hr />

<!-- جمع‌ها -->
<div class="row">
    <div class="col-md-offset-6 col-md-6">
        <table class="table table-bordered">
            <tr>
                <th style="width: 150px;">جمع اقلام:</th>
                <td class="text-left">
                    <span id="subTotal" class="persian-number-comma">۰</span>
                </td>
            </tr>
            <tr>
                <th>جمع تخفیف:</th>
                <td class="text-left">
                    <span id="discountAmount" class="persian-number-comma">۰</span>
                </td>
            </tr>
            <tr>
                <th>جمع مالیات:</th>
                <td class="text-left">
                    <span id="taxAmount" class="persian-number-comma">۰</span>
                </td>
            </tr>
            <tr class="bg-info">
                <th>مبلغ نهایی:</th>
                <td class="text-left">
                    <strong id="totalAmount" class="persian-number-comma">۰</strong>
                </td>
            </tr>
        </table>
    </div>
</div>