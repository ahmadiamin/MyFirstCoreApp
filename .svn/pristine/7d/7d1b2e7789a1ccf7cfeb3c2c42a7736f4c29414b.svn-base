@{
    ViewData["Title"] = "پرداخت‌ها";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa-solid fa-triangle-exclamation"></i> @TempData["Error"]
    </div>
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-money-bill-transfer"></i>
            لیست پرداخت‌ها
        </h3>
        <div class="card-tools">
            <div class="btn-group">
                <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-toggle="dropdown">
                    <i class="fa-solid fa-plus"></i> پرداخت جدید
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a class="dropdown-item" asp-action="Create" asp-route-paymentType="1">
                        <i class="fa-solid fa-arrow-down text-success"></i> دریافت از مشتری
                    </a>
                    <a class="dropdown-item" asp-action="Create" asp-route-paymentType="2">
                        <i class="fa-solid fa-arrow-up text-danger"></i> پرداخت به فروشنده
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    </div>
                    <input type="text" id="txtSearch" class="form-control"
                           placeholder="جستجو در شماره، طرف حساب، مرجع..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <div id="paymentsGrid" class="ag-theme-alpine"
             style="height: 600px; width: 100%;">
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            const urlParams = new URLSearchParams(window.location.search);
            const paymentType = urlParams.get('paymentType');

            let dataUrl = '/Banking/Payments/GetData';
            if (paymentType) dataUrl += '?paymentType=' + paymentType;

            const columnDefs = [
                AgGridHelper.rowNumberColumn(),
                AgGridHelper.numberColumn('number', 'شماره', 90),
                {
                    field: 'date',
                    headerName: 'تاریخ',
                    width: 110,
                    valueFormatter: function (params) {
                        if (!params.value) return '';
                        return new Date(params.value).toLocaleDateString('fa-IR');
                    }
                },
                {
                    field: 'paymentTypeName',
                    headerName: 'نوع',
                    width: 100,
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const span = document.createElement('span');
                        span.className = params.data.paymentType === 1 ? 'badge badge-success' : 'badge badge-danger';
                        span.textContent = params.value;
                        return span;
                    }
                },
                { field: 'contactName', headerName: 'طرف حساب', width: 180, flex: 1 },
                { field: 'bankAccountName', headerName: 'حساب بانکی', width: 150 },
                AgGridHelper.moneyColumn('amount', 'مبلغ کل', 140),
                AgGridHelper.moneyColumn('allocatedAmount', 'تخصیص‌یافته', 130),
                {
                    field: 'unallocatedAmount',
                    headerName: 'تخصیص‌نیافته',
                    width: 130,
                    valueFormatter: function (params) {
                        if (!params.value) return '۰';
                        return Number(params.value).toLocaleString('en-US');
                    }
                },
                {
                    field: 'statusName',
                    headerName: 'وضعیت',
                    width: 100,
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const span = document.createElement('span');
                        const s = params.data.status;
                        if (s === 1) span.className = 'badge badge-warning';
                        else if (s === 2) span.className = 'badge badge-success';
                        else span.className = 'badge badge-danger';
                        span.textContent = params.value;
                        return span;
                    }
                },
                {
                    headerName: 'عملیات',
                    colId: 'actions',
                    width: 220,
                    minWidth: 220,
                    sortable: false,
                    filter: false,
                    pinned: 'left',
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const div = document.createElement('div');
                        div.className = 'action-buttons';
                        const d = params.data;

                        // 👁 مشاهده (همیشه)
                        div.appendChild(btnLink(`/Banking/Payments/Details/${d.id}`, 'fa-solid fa-eye', 'outline-info', 'مشاهده'));

                        if (d.status === 1) { // پیش‌نویس
                            // ✅ قطعی
                            div.appendChild(btnWorkflow(d.id, 'post', 'fa-solid fa-circle-check', 'outline-success', 'قطعی کردن'));
                            // ✏ ویرایش
                            div.appendChild(btnLink(`/Banking/Payments/Edit/${d.id}`, 'fa-solid fa-pen-to-square', 'outline-primary', 'ویرایش'));
                            // 🗑 حذف
                            div.appendChild(btnLink(`/Banking/Payments/Delete/${d.id}`, 'fa-solid fa-trash', 'outline-danger', 'حذف'));
                        }
                        else if (d.status === 2) { // قطعی
                            // ↩ برگشت
                            div.appendChild(btnWorkflow(d.id, 'unpost', 'fa-solid fa-rotate-left', 'outline-warning', 'برگشت به پیش‌نویس'));
                        }

                        return div;
                    }
                }
            ];

            AgGridHelper.create('paymentsGrid', columnDefs, dataUrl, 'txtSearch', 'lblCount');

            function btnLink(href, icon, cls, title) {
                const a = document.createElement('a');
                a.href = href;
                a.className = `btn btn-sm btn-${cls} action-icon-btn`;
                a.title = title;
                a.innerHTML = `<i class="${icon}"></i>`;
                return a;
            }

            function btnWorkflow(id, action, icon, cls, title) {
                const a = document.createElement('a');
                a.href = 'javascript:void(0)';
                a.className = `btn btn-sm btn-${cls} action-icon-btn wf-btn`;
                a.dataset.id = id;
                a.dataset.action = action;
                a.title = title;
                a.innerHTML = `<i class="${icon}"></i>`;
                return a;
            }

            $(document).on('click', '.wf-btn', function () {
                const id = $(this).data('id');
                const action = $(this).data('action');
                const token = $('input[name="__RequestVerificationToken"]').val();

                let url = '', confirmMsg = '';
                if (action === 'post') { url = '/Banking/Payments/Post'; confirmMsg = 'قطعی کردن پرداخت؟'; }
                else if (action === 'unpost') { url = '/Banking/Payments/Unpost'; confirmMsg = 'برگشت به پیش‌نویس؟'; }

                if (!confirm(confirmMsg)) return;

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (r) {
                        if (r.success) {
                            alert(r.message || 'انجام شد');
                            location.reload();
                        } else {
                            alert(r.message);
                        }
                    },
                    error: function () { alert('خطا'); }
                });
            });

        });
    </script>
}