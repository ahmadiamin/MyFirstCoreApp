@model MyFirstCoreApp.Domain.Entities.Inventory.Unit
@{
    ViewData["Title"] = "حذف واحد";

    var confirmModel = new MyFirstCoreApp.Models.ViewModels.DeleteConfirmViewModel
    {
        Title = "حذف واحد",
        Message = "آیا از حذف این واحد مطمئن هستید؟",
        Area = "Inventory",
        Controller = "Units",
        Id = Model.Id,
        Items = new()
        {
            new() { Label = "نام واحد", Value = Model.Name?.ToString() },
            new() { Label = "نماد", Value = Model.Symbol?.ToString() },
            new() { Label = "ترتیب", Value = Model.SortOrder.ToString() }
        }
    };
}

<partial name="_DeleteConfirm" model="confirmModel" />