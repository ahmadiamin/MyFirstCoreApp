@{
    ViewData["Title"] = "چک‌ها";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-money-check"></i>
            لیست چک‌ها
        </h3>
        <div class="card-tools">
            <div class="btn-group">
                <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-toggle="dropdown">
                    <i class="fa fa-plus"></i> چک جدید
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a class="dropdown-item" asp-action="Create" asp-route-direction="1">
                        <i class="fa fa-arrow-down text-success"></i> چک دریافتنی
                    </a>
                    <a class="dropdown-item" asp-action="Create" asp-route-direction="2">
                        <i class="fa fa-arrow-up text-danger"></i> چک پرداختنی
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                    </div>
                    <input type="text" id="txtSearch" class="form-control"
                           placeholder="جستجو در شماره چک، بانک، صاحب چک..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <div id="chequesGrid" class="ag-theme-alpine"
             style="height: 600px; width: 100%;">
        </div>

    </div>
</div>
@Html.AntiForgeryToken()
@section Scripts {
    <script>
        // ============================================
        // 🆕 متغیر global برای Grid API
        // ============================================
        let chequesGridApi = null;

        $(document).ready(function () {

            // ============================================
            // ۱. URL با فیلتر جهت
            // ============================================
            const urlParams = new URLSearchParams(window.location.search);
            const direction = urlParams.get('direction');

            let dataUrl = '/Banking/Cheques/GetData';
            if (direction) dataUrl += '?direction=' + direction;

            // ============================================
            // ۲. تعریف ستون‌ها
            // ============================================
            const columnDefs = [
                AgGridHelper.rowNumberColumn(),
                { field: 'chequeNumber', headerName: 'شماره چک', width: 120 },
                {
                    field: 'directionName',
                    headerName: 'جهت',
                    width: 100,
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const span = document.createElement('span');
                        span.className = params.data.direction === 1 ? 'badge badge-success' : 'badge badge-danger';
                        span.textContent = params.value;
                        return span;
                    }
                },
                { field: 'contactName', headerName: 'طرف حساب', width: 180, flex: 1 },
                { field: 'drawerName', headerName: 'صاحب چک', width: 150 },
                { field: 'bankName', headerName: 'بانک', width: 130 },
                AgGridHelper.moneyColumn('amount', 'مبلغ', 140),
                {
                    field: 'dueDate',
                    headerName: 'سررسید',
                    width: 110,
                    valueFormatter: function (params) {
                        if (!params.value) return '';
                        const d = new Date(params.value);
                        return d.toLocaleDateString('fa-IR');
                    }
                },
                {
                    field: 'statusName',
                    headerName: 'وضعیت',
                    width: 120,
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const span = document.createElement('span');
                        const s = params.data.status;
                        if (s === 1) span.className = 'badge badge-primary';
                        else if (s === 2) span.className = 'badge badge-success';
                        else if (s === 3) span.className = 'badge badge-danger';
                        else if (s === 4) span.className = 'badge badge-warning';
                        else if (s === 5) span.className = 'badge badge-info';
                        else if (s === 6) span.className = 'badge badge-dark';
                        else if (s === 7) span.className = 'badge badge-warning';
                        else if (s === 8) span.className = 'badge badge-success';
                        else span.className = 'badge badge-secondary';
                        span.textContent = params.value;
                        return span;
                    }
                },
                {
                    field: 'nextFollowUpDate',
                    headerName: 'پیگیری',
                    width: 110,
                    minWidth: 110,
                    maxWidth: 110,
                    cellRenderer: function (params) {
                        if (!params.value) return '<span class="text-muted">—</span>';
                        const date = new Date(params.value);
                        const today = new Date(); today.setHours(0,0,0,0);
                        const f = new Date(date); f.setHours(0,0,0,0);
                        const diff = Math.ceil((f - today) / (1000*60*60*24));
                        let label = '', cls = 'badge-info';
                        if (diff < 0) { label = `${Math.abs(diff)} روز گذشته`; cls = 'badge-danger'; }
                        else if (diff === 0) { label = 'امروز'; cls = 'badge-warning'; }
                        else if (diff === 1) { label = 'فردا'; cls = 'badge-warning'; }
                        else if (diff <= 7) { label = `${diff} روز آینده`; }
                        else { label = date.toLocaleDateString('fa-IR'); }
                        return `<span class="badge ${cls}" title="${date.toLocaleDateString('fa-IR')}">${label}</span>`;
                    }
                },
                {
                    headerName: 'عملیات',
                    colId: 'actions',
                    width: 280,
                    minWidth: 280,
                    sortable: false,
                    filter: false,
                    pinned: 'left',
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const div = document.createElement('div');
                        div.className = 'action-buttons';
                        const d = params.data;

                        // 👁 مشاهده (همیشه)
                        const viewBtn = document.createElement('a');
                        viewBtn.href = `/Banking/Cheques/Details/${d.id}`;
                        viewBtn.className = 'btn btn-sm btn-outline-info action-icon-btn';
                        viewBtn.title = 'مشاهده';
                        viewBtn.innerHTML = '<i class="fa-solid fa-eye"></i>';
                        div.appendChild(viewBtn);

                        // ✅ قطعی / ↩ برگشت / گردش کار
                        if (d.status === 1) { // در جریان
                            // ✅ پاس
                            const clearedBtn = document.createElement('a');
                            clearedBtn.href = 'javascript:void(0)';
                            clearedBtn.className = 'btn btn-sm btn-outline-success action-icon-btn wf-btn';
                            clearedBtn.dataset.id = d.id;
                            clearedBtn.dataset.action = 'cleared';
                            clearedBtn.title = 'پاس شد';
                            clearedBtn.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
                            div.appendChild(clearedBtn);

                            // ❌ برگشت
                            const bouncedBtn = document.createElement('a');
                            bouncedBtn.href = 'javascript:void(0)';
                            bouncedBtn.className = 'btn btn-sm btn-outline-danger action-icon-btn wf-btn';
                            bouncedBtn.dataset.id = d.id;
                            bouncedBtn.dataset.action = 'bounced';
                            bouncedBtn.title = 'برگشت خورد';
                            bouncedBtn.innerHTML = '<i class="fa-solid fa-circle-xmark"></i>';
                            div.appendChild(bouncedBtn);

                            // 💰 نقد
                            const cashedBtn = document.createElement('a');
                            cashedBtn.href = 'javascript:void(0)';
                            cashedBtn.className = 'btn btn-sm btn-outline-success action-icon-btn wf-btn';
                            cashedBtn.dataset.id = d.id;
                            cashedBtn.dataset.action = 'cashed';
                            cashedBtn.title = 'نقد شد';
                            cashedBtn.innerHTML = '<i class="fa-solid fa-money-bill-wave"></i>';
                            div.appendChild(cashedBtn);

                            // ✏ ویرایش
                            const editBtn = document.createElement('a');
                            editBtn.href = `/Banking/Cheques/Edit/${d.id}`;
                            editBtn.className = 'btn btn-sm btn-outline-primary action-icon-btn';
                            editBtn.title = 'ویرایش';
                            editBtn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
                            div.appendChild(editBtn);

                            // 🗑 حذف
                            const deleteBtn = document.createElement('a');
                            deleteBtn.href = 'javascript:void(0)';
                            deleteBtn.className = 'btn btn-sm btn-outline-danger action-icon-btn delete-btn';
                            deleteBtn.dataset.id = d.id;
                            deleteBtn.dataset.title = d.chequeNumber || '';
                            deleteBtn.dataset.contact = d.contactName || '';
                            deleteBtn.dataset.amount = d.amount || 0;
                            deleteBtn.title = 'حذف';
                            deleteBtn.innerHTML = '<i class="fa-solid fa-trash"></i>';
                            div.appendChild(deleteBtn);
                        }

                        return div;
                    }
                }
            ];

            // ============================================
            // ۳. ساخت Grid
            // ============================================
            chequesGridApi = AgGridHelper.create(
                'chequesGrid',
                columnDefs,
                dataUrl,
                'txtSearch',
                'lblCount'
            );

        });

        // ============================================
        // ۴. رویداد حذف
        // ============================================
        $(document).on('click', '.delete-btn', function () {
            const $btn = $(this);
            const id = $btn.data('id');
            const title = $btn.data('title');
            const contact = $btn.data('contact');
            const amount = $btn.data('amount');

            // 🆕 ساخت items
            const items = [];
            if (title) items.push({ label: 'شماره چک', value: title });
            if (contact) items.push({ label: 'طرف حساب', value: contact });
            if (amount) items.push({ label: 'مبلغ', value: Number(amount).toLocaleString('en-US') + ' ریال' });

            // 🆕 نمایش Modal
            ModalHelper.confirmDelete({
                url: '/Banking/Cheques/Delete',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                title: 'حذف چک شماره ' + title,
                message: 'آیا از حذف این چک مطمئن هستید؟ این عملیات قابل بازگشت نیست.',
                items: items,
                onSuccess: function () {
                    // 🆕 رفرش Grid
                    if (chequesGridApi) {
                        const ds = chequesGridApi.getGridOption('datasource');
                        chequesGridApi.setGridOption('datasource', ds);
                    } else {
                        location.reload();
                    }
                }
            });
        });
    </script>
}