using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;
using MyFirstCoreApp.Models.Invoicing;

namespace MyFirstCoreApp.Models.Inventory
{
    // کالا/خدمت
    public class Item
    {
        public int Id { get; set; }

        [Required, MaxLength(150)]
        public string Title { get; set; }

        [MaxLength(50)]
        public string? Code { get; set; } // کد کالا / SKU (اختیاری)

        public int? ItemCategoryId { get; set; }

        [ForeignKey(nameof(ItemCategoryId))]
        public ItemCategory ItemCategory { get; set; }

        // نوع اندازه‌گیری: مشخص می‌کند کالا تعدادی است یا متراژی/وزنی/حجمی
        [Required]
        public MeasurementType MeasurementType { get; set; } = MeasurementType.Count;

        [Required, MaxLength(30)]
        public string Unit { get; set; } // واحد نمایشی: عدد، متر، کیلوگرم، لیتر و ...

        // آیا مقدار می‌تواند اعشاری باشد؟ (مثلا تعدادی = خیر، متراژی = بله)
        public bool AllowsFraction { get; set; }

        [MaxLength(2000)]
        public string? Description { get; set; }

        public bool IsActive { get; set; } = true;

        public ICollection<InvoiceDetail> InvoiceDetails { get; set; } = new List<InvoiceDetail>();

        public ICollection<ItemImage> Images { get; set; } = new List<ItemImage>();

        public ICollection<ItemSpecification> Specifications { get; set; } = new List<ItemSpecification>();

        [Required, MaxLength(450)]
        public string UserId { get; set; }
    }
}
