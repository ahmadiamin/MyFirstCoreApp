@model MyFirstCoreApp.Models.ViewModels.ModalViewModel

<div class="modal fade" id="@Model.Id" tabindex="-1" role="dialog" aria-labelledby="@(Model.Id)_Label" aria-hidden="true">
    <div class="modal-dialog @Model.Size @(Model.Centered ? "modal-dialog-centered" : "")" role="document">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header @Model.HeaderClass">
                <h5 class="modal-title" id="@(Model.Id)_Label">
                    @if (!string.IsNullOrEmpty(Model.Icon))
                    {
                        <i class="@Model.Icon"></i>
                    }
                    @Model.Title
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="بستن">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body" id="@(Model.Id)_Body">
                @if (Model.IsLoading)
                {
                    <div class="text-center py-4">
                        <i class="fa-solid fa-spinner fa-spin fa-3x text-primary"></i>
                        <p class="mt-3 text-muted">در حال بارگذاری...</p>
                    </div>
                }
                else
                {
                    @Html.Raw(Model.BodyHtml)
                }
            </div>

            <!-- Footer -->
            @if (Model.Buttons != null && Model.Buttons.Any())
            {
                <div class="modal-footer">
                    @foreach (var btn in Model.Buttons)
                    {
                        <button type="button"
                                class="btn @btn.Class"
                                data-dismiss="@(btn.DismissOnClick ? "modal" : "")"
                                data-action="@btn.Action"
                                id="@btn.Id">
                            @if (!string.IsNullOrEmpty(btn.Icon))
                            {
                                <i class="@btn.Icon"></i>
                            }
                            @btn.Text
                        </button>
                    }
                </div>
            }

        </div>
    </div>
</div>