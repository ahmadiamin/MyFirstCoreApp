@{
    ViewData["Title"] = "واحدها";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-balance-scale"></i>
            لیست واحدها
        </h3>
        <div class="card-tools">
            <a asp-area="Inventory" asp-controller="Units" asp-action="Create"
               class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> واحد جدید
            </a>
        </div>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                    </div>
                    <input type="text" id="txtSearch" class="form-control" placeholder="جستجو..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <div id="unitGrid" class="ag-theme-alpine" style="height: 600px; width: 100%;"></div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            const columnDefs = [
                AgGridHelper.rowNumberColumn(),
                        {
            field: 'name',
            headerName: 'نام واحد',
            flex: 2,
            minWidth: 200
        },
        {
            field: 'symbol',
            headerName: 'نماد',
            width: 150
        },
                { field: 'sortOrder', headerName: 'ترتیب', width: 130, type: 'numericColumn' },
                AgGridHelper.statusColumn('isActive'),
                AgGridHelper.actionColumn(
                    '/Inventory/Units/Edit/{id}',
                    '/Inventory/Units/Delete/{id}'
                )
            ];

            AgGridHelper.create(
                'unitGrid',
                columnDefs,
                '/Inventory/Units/GetData',
                'txtSearch',
                'lblCount'
            );

        });
    </script>
}
