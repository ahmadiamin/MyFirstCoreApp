@model List<MyFirstCoreApp.Models.ViewModels.MenuTreeViewModel>

@using MyFirstCoreApp.Authorization
@inject PermissionService PermissionService

@{
    ViewData["Title"] = "مدیریت منوها";
}

<div class="container-fluid">

    
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h1>مدیریت منوها</h1>

        @if (await PermissionService.HasPermissionAsync(User, "Menu.Create"))
        {
            <a asp-area="Admin"
               asp-controller="Menus"
               asp-action="Create"
               class="btn btn-primary">
                ایجاد منو
            </a>
        }

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card">

        <div class="card-body p-0">

            <table class="table table-bordered table-hover mb-0">

                <thead>
                    <tr>
                        <th>عنوان</th>
                        <th>آدرس</th>
                        <th>آیکون</th>
                        <th>دسترسی</th>
                        <th>ترتیب</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <partial name="_MenuRow"
                                 model="item" />
                    }

                </tbody>

            </table>

        </div>

    </div>
    

</div>
