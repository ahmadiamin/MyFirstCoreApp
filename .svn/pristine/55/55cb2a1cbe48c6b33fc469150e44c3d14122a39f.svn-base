using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace MyFirstCoreApp.Models.Inventory
{
    // مشخصات فنی کالا به صورت Key-Value
    // این طراحی چون هر دسته کالا مشخصات متفاوتی دارد (رنگ/سایز برای پوشاک، رم/پردازنده برای لپ‌تاپ)
    // به جای ستون‌های ثابت در جدول Item، این ساختار انعطاف‌پذیر انتخاب شده است.
    public class ItemSpecification
    {
        public int Id { get; set; }

        public int ItemId { get; set; }

        [ForeignKey(nameof(ItemId))]
        public Item Item { get; set; }

        [Required, MaxLength(100)]
        public string Title { get; set; } // مثلا: "رنگ"، "سایز"، "جنس"

        [Required, MaxLength(500)]
        public string Value { get; set; } // مثلا: "قرمز"، "42"، "چوب"

        public int SortOrder { get; set; }
    }
}
