using Microsoft.AspNetCore.Identity;
using MyFirstCoreApp.Models;
using MyFirstCoreApp.Models.ViewModels;

namespace MyFirstCoreApp.Services.Interfaces
{
    public interface IUserService
    {
        Task<List<UserListViewModel>> GetAllAsync();

        Task<ApplicationUser?> GetByIdAsync(
            string id);

        Task<IdentityResult> CreateAsync(
            ApplicationUser user,
            string password);

        Task<List<RoleViewModel>> GetRolesForUserAsync(
            ApplicationUser user);

        Task<List<string>> GetUserRolesAsync(
            ApplicationUser user);

        Task<IdentityResult> UpdateAsync(
            ApplicationUser user);

        Task<IdentityResult> UpdateRolesAsync(
            ApplicationUser user,
            IEnumerable<string> selectedRoles);

        Task<IdentityResult> ToggleActiveAsync(
            ApplicationUser user);

        Task<List<UserProfileImage>> GetProfileImagesAsync(
            string userId);

        Task<UserProfileImage?> GetProfileImageAsync(
            int imageId);

        Task<UserProfileImage> AddProfileImageAsync(
            string userId,
            IFormFile file);

        Task DeleteProfileImageAsync(
            int imageId);

        Task SetPrimaryProfileImageAsync(
            int imageId);
        
        Task<(string PhysicalPath, string ContentType)?> GetProfileImageFileAsync(int imageId);

        Task<UserProfileImage> ChangeProfileImageAsync(
    string userId,
    IFormFile file);

        Task DeletePrimaryProfileImageAsync(string userId);
    }
}