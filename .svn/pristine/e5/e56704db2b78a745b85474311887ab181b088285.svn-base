namespace MyFirstCoreApp.Domain.Enums;

/// <summary>
/// وضعیت چک
/// </summary>
public enum ChequeStatus
{
    // در جریان
    InProgress = 1,

    // نهایی
    Cleared = 2,        // پاس شده
    Bounced = 3,        // برگشت خورده
    Returned = 4,       // عودت داده شده
    RePresented = 5,    // مجدداً ارائه شده
    Cancelled = 6,      // ابطال شده
    Referred = 7,       // ارجاع به صاحب چک
    Cashed = 8          // نقد شده
}