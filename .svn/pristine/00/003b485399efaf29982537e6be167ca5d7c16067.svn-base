@model MyFirstCoreApp.Areas.Banking.ViewModels.Cheque.ChequeFormViewModel

<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="ChequeNumber"></label>
            <input asp-for="ChequeNumber" class="form-control" placeholder="123456" />
            <span asp-validation-for="ChequeNumber" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="Direction"></label>
            <select asp-for="Direction" class="form-control" id="Direction">
                <option value="1">دریافتنی</option>
                <option value="2">پرداختنی</option>
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="Amount"></label>

            <input type="text"
                   id="Amount_Display"
                   class="form-control ltr persian-number persian-number-comma"
                   data-target="Amount_Hidden"
                   value="@Model.Amount"
                   autocomplete="off" />

            <input asp-for="Amount" type="hidden" id="Amount_Hidden" />

            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="ContactId"></label>
            <select asp-for="ContactId" class="form-control select2" asp-items="Model.ContactOptions">
                <option value="">-- انتخاب --</option>
            </select>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="IssueDate"></label>
            <input asp-for="IssueDate" class="form-control datepicker" autocomplete="off" dir="ltr" />
            <span asp-validation-for="IssueDate" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="DueDate"></label>
            <input asp-for="DueDate" class="form-control datepicker" autocomplete="off" dir="ltr" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="InvoiceId"></label>
            <select asp-for="InvoiceId" class="form-control select2" asp-items="Model.InvoiceOptions">
                <option value="">-- بدون فاکتور --</option>
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="BankAccountId"></label>
            <select asp-for="BankAccountId" class="form-control select2" asp-items="Model.BankAccountOptions">
                <option value="">-- انتخاب حساب --</option>
            </select>
        </div>
    </div>
</div>

<hr />
<h5><i class="fa fa-university"></i> اطلاعات بانکی</h5>

<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="BankName"></label>
            <input asp-for="BankName" class="form-control" placeholder="صادرات" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="AccountNumber"></label>
            <input asp-for="AccountNumber" class="form-control ltr" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="BranchCode"></label>
            <input asp-for="BranchCode" class="form-control ltr" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="BranchName"></label>
            <input asp-for="BranchName" class="form-control" />
        </div>
    </div>
</div>

<hr />
<h5><i class="fa fa-user"></i> صاحب چک</h5>

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="DrawerName"></label>
            <input asp-for="DrawerName" class="form-control" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="DrawerNationalId"></label>
            <input asp-for="DrawerNationalId" class="form-control ltr" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
    </div>
</div>