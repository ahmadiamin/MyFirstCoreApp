@model MyFirstCoreApp.Models.ViewModels.MenuTreeViewModel

@using MyFirstCoreApp.Authorization
@inject PermissionService PermissionService

<tr>

    
    <td>
        <div style="padding-right: @(Model.Level * 30)px;">

            @if (Model.Level > 0)
            {
                <span class="text-muted me-2">
                    └─
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Icon))
            {
                <i class="bi @Model.Icon me-1"></i>
            }

            <strong>
                @Model.Title
            </strong>

        </div>
    </td>

    <td>
        @Model.Url
    </td>

    <td>
        @Model.Icon
    </td>

    <td>
        @Model.Permission
    </td>

    <td>
        @Model.SortOrder
    </td>

    <td>
        @if (Model.IsActive)
        {
            <span class="badge bg-success">
                فعال
            </span>
        }
        else
        {
            <span class="badge bg-secondary">
                غیرفعال
            </span>
        }
    </td>

    <td>

        @if (await PermissionService.HasPermissionAsync(User, "Menu.Edit"))
        {
            <a asp-area="Admin"
               asp-controller="Menus"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-sm btn-warning">
                ویرایش
            </a>
        }

        @if (await PermissionService.HasPermissionAsync(User, "Menu.Delete"))
        {
            <a asp-area="Admin"
               asp-controller="Menus"
               asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-sm btn-danger">
                حذف
            </a>
        }

    </td>
    

</tr>

@foreach (var child in Model.Children)
{
    <partial name="_MenuRow"
             model="child" />
}
