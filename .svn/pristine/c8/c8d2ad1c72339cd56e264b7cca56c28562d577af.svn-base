@using DNTPersianUtils.Core
@model MyFirstCoreApp.Domain.Entities.Invoicing.Invoice
@{
    ViewData["Title"] = $"حذف فاکتور شماره {Model.Number}";

    var confirmModel = new MyFirstCoreApp.Models.ViewModels.DeleteConfirmViewModel
    {
        Title = "حذف فاکتور",
        Message = "آیا از حذف این فاکتور مطمئن هستید؟",
        Area = "Invoicing",
        Controller = "Invoices",
        Id = Model.Id,
        Items = new()
        {
            new() { Label = "شماره فاکتور", Value = Model.Number.ToString() },
            new() { Label = "تاریخ", Value = Model.Date.ToShortPersianDateString() },
            new() { Label = "طرف حساب", Value = Model.Contact?.Name },
            new() { Label = "مبلغ کل", Value = Model.TotalAmount.ToString("N0") }
        }
    };
}

<partial name="_DeleteConfirm" model="confirmModel" />