@model MyFirstCoreApp.Domain.Entities.Inventory.Product
@{
    ViewData["Title"] = "حذف کالا";

    var confirmModel = new MyFirstCoreApp.Models.ViewModels.DeleteConfirmViewModel
    {
        Title = "حذف کالا",
        Message = "آیا از حذف این کالا مطمئن هستید؟",
        Area = "Inventory",
        Controller = "Products",
        Id = Model.Id,
        Items = new()
        {
            new() { Label = "نام", Value = Model.Name },
            new() { Label = "کد", Value = Model.Code },
            new() { Label = "قیمت فروش", Value = Model.SalePrice.ToString("N0") }
        }
    };
}

<partial name="_DeleteConfirm" model="confirmModel" />