@model ProductFormViewModel
@{
    ViewData["Title"] = "ویرایش کالا";
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-edit"></i>
            ویرایش کالا
        </h3>
    </div>

    <form asp-area="Inventory" asp-controller="Products" asp-action="Edit"
          asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <partial name="_Form" model="Model" />
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save"></i> ذخیره تغییرات
            </button>
            <a asp-area="Inventory" asp-controller="Products" asp-action="Index" class="btn btn-secondary">
                <i class="fa fa-arrow-right"></i> انصراف
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}