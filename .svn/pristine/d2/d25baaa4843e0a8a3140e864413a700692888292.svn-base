@using MyFirstCoreApp.Areas.Accounting.ViewModels.TransactionGroup
@model TransactionGroupFormViewModel

<div class="row">

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" placeholder="مثلاً حقوق و دستمزد" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="form-control" placeholder="1001" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="ParentId"></label>
            <select asp-for="ParentId" class="form-control">
                <option value="">-- بدون والد --</option>
                @foreach (var opt in Model.ParentOptions)
                {
                    <option value="@opt.Id">@opt.Name</option>
                }
            </select>
            <span asp-validation-for="ParentId" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="SortOrder"></label>
            <input type="text"
                   id="SortOrder_Display"
                   class="form-control persian-number"
                   data-target="SortOrder_Hidden"
                   value="@Model.SortOrder" />
            <input asp-for="SortOrder" type="hidden" id="SortOrder_Hidden" />
            <span asp-validation-for="SortOrder" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group">
            <label>وضعیت</label>
            <div class="custom-control custom-checkbox mt-2">
                <input asp-for="IsActive" class="custom-control-input" id="IsActive" />
                <label asp-for="IsActive" class="custom-control-label" for="IsActive">
                    فعال
                </label>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="3"
                      placeholder="توضیحات اختیاری"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

</div>