using DNTPersianUtils.Core;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Rendering;
using Microsoft.EntityFrameworkCore;
using MyFirstCoreApp.Application.Common.Interfaces;
using MyFirstCoreApp.Application.Common.Models;
using MyFirstCoreApp.Application.Interfaces;
using MyFirstCoreApp.Areas.Banking.ViewModels.Cheque;
using MyFirstCoreApp.Domain.Entities.Banking;
using MyFirstCoreApp.Domain.Enums;
using MyFirstCoreApp.Infrastructure.Persistence;

namespace MyFirstCoreApp.Areas.Banking.Controllers;

[Area("Banking")]
[Authorize]
public class ChequesController : Controller
{
    private readonly ApplicationDbContext _context;
    private readonly ICurrentTenant _currentTenant;
    private readonly IChequeService _chequeService;

    public ChequesController(
        ApplicationDbContext context,
        ICurrentTenant currentTenant,
        IChequeService chequeService)
    {
        _context = context;
        _currentTenant = currentTenant;
        _chequeService = chequeService;
    }

    // ============================================
    // Index
    // ============================================

    [Authorize(Policy = "Cheque.View")]
    public IActionResult Index(ChequeDirection? direction = null)
    {
        ViewBag.Direction = direction;
        return View();
    }

    [HttpPost]
    [Authorize(Policy = "Cheque.View")]
    public async Task<IActionResult> GetData([FromBody] AgGridRequest request, [FromQuery] ChequeDirection? direction = null)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return Json(new { success = false });

        var query = _context.Cheques
            .Include(x => x.Contact)
            .Where(x => x.TenantId == tenantId.Value);

        if (direction.HasValue)
            query = query.Where(x => x.Direction == direction.Value);

        if (!string.IsNullOrWhiteSpace(request.Search))
        {
            var s = request.Search.Trim();
            query = query.Where(x =>
                x.ChequeNumber.Contains(s) ||
                (x.BankName != null && x.BankName.Contains(s)) ||
                (x.DrawerName != null && x.DrawerName.Contains(s)) ||
                (x.Contact != null && x.Contact.Name.Contains(s)));
        }

        var total = await query.CountAsync();

        query = request.SortBy switch
        {
            "chequeNumber" => request.SortDir == "asc" ? query.OrderBy(x => x.ChequeNumber) : query.OrderByDescending(x => x.ChequeNumber),
            "dueDate" => request.SortDir == "asc" ? query.OrderBy(x => x.DueDate) : query.OrderByDescending(x => x.DueDate),
            "amount" => request.SortDir == "asc" ? query.OrderBy(x => x.Amount) : query.OrderByDescending(x => x.Amount),
            _ => query.OrderByDescending(x => x.DueDate)
        };

        var items = await query
            .Skip(request.StartRow)
            .Take(request.EndRow - request.StartRow)
            .Select(x => new
            {
                id = x.Id,
                chequeNumber = x.ChequeNumber,
                direction = (int)x.Direction,
                directionName = x.Direction == ChequeDirection.Received ? "دریافتنی" : "پرداختنی",
                contactName = x.Contact != null ? x.Contact.Name : null,
                drawerName = x.DrawerName,
                bankName = x.BankName,
                amount = x.Amount,
                dueDate = x.DueDate.ToString("yyyy-MM-ddTHH:mm:ss"),
                status = (int)x.Status,
                statusName = GetStatusName(x.Status),
                nextFollowUpDate = x.NextFollowUpDate.HasValue
                    ? x.NextFollowUpDate.Value.ToString("yyyy-MM-ddTHH:mm:ss")
                    : null
            })
            .ToListAsync();

        return Json(new { success = true, rows = items, lastRow = total });
    }

    // ============================================
    // Create
    // ============================================

    [Authorize(Policy = "Cheque.Create")]
    public async Task<IActionResult> Create(ChequeDirection direction = ChequeDirection.Received)
    {
        var model = new ChequeFormViewModel
        {
            Direction = direction,
            IssueDate = DateTime.Now.ToShortPersianDateString(),
            DueDate = DateTime.Now.AddMonths(1).ToShortPersianDateString(),
            ContactOptions = await GetContactOptionsAsync(direction),
            BankAccountOptions = await GetBankAccountOptionsAsync(),
            InvoiceOptions = await GetInvoiceOptionsAsync(direction)
        };
        return View(model);
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Create")]
    public async Task<IActionResult> Create(ChequeFormViewModel model)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return Forbid();

        if (!ModelState.IsValid)
        {
            await ReloadOptionsAsync(model);
            return View(model);
        }

        var cheque = new Cheque
        {
            TenantId = tenantId.Value,
            ChequeNumber = model.ChequeNumber.Trim(),
            Direction = model.Direction,
            Amount = model.Amount,
            IssueDate = ParsePersianDate(model.IssueDate),
            DueDate = ParsePersianDate(model.DueDate),
            ContactId = model.ContactId,
            BankAccountId = model.BankAccountId,
            BankName = model.BankName?.Trim(),
            AccountNumber = model.AccountNumber?.Trim(),
            BranchCode = model.BranchCode?.Trim(),
            BranchName = model.BranchName?.Trim(),
            DrawerName = model.DrawerName?.Trim(),
            DrawerNationalId = model.DrawerNationalId?.Trim(),
            Description = model.Description?.Trim(),
            InvoiceId = model.InvoiceId,
            ImagePath = model.ImagePath
        };

        try
        {
            await _chequeService.CreateAsync(cheque);
            TempData["Success"] = $"چک شماره {cheque.ChequeNumber} با موفقیت ثبت شد.";
            return RedirectToAction(nameof(Index), new { direction = (int)cheque.Direction });
        }
        catch (Exception ex)
        {
            ModelState.AddModelError("", ex.Message);
            await ReloadOptionsAsync(model);
            return View(model);
        }
    }

    // ============================================
    // Edit
    // ============================================

    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> Edit(int id)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return Forbid();

        var entity = await _context.Cheques
            .FirstOrDefaultAsync(c => c.Id == id && c.TenantId == tenantId.Value);

        if (entity == null) return NotFound();

        if (entity.Status != ChequeStatus.InProgress)
        {
            TempData["Error"] = "فقط چک در جریان قابل ویرایش است.";
            return RedirectToAction(nameof(Index));
        }

        var model = new ChequeFormViewModel
        {
            Id = entity.Id,
            ChequeNumber = entity.ChequeNumber,
            Direction = entity.Direction,
            Amount = entity.Amount,
            IssueDate = entity.IssueDate.ToShortPersianDateString(),
            DueDate = entity.DueDate.ToShortPersianDateString(),
            ContactId = entity.ContactId,
            BankAccountId = entity.BankAccountId,
            BankName = entity.BankName,
            AccountNumber = entity.AccountNumber,
            BranchCode = entity.BranchCode,
            BranchName = entity.BranchName,
            DrawerName = entity.DrawerName,
            DrawerNationalId = entity.DrawerNationalId,
            Description = entity.Description,
            InvoiceId = entity.InvoiceId,
            ImagePath = entity.ImagePath,
            ContactOptions = await GetContactOptionsAsync(entity.Direction),
            BankAccountOptions = await GetBankAccountOptionsAsync(),
            InvoiceOptions = await GetInvoiceOptionsAsync(entity.Direction)
        };
        return View(model);
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> Edit(int id, ChequeFormViewModel model)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return Forbid();

        if (id != model.Id) return BadRequest();

        if (!ModelState.IsValid)
        {
            await ReloadOptionsAsync(model);
            return View(model);
        }

        var entity = await _context.Cheques
            .FirstOrDefaultAsync(c => c.Id == id && c.TenantId == tenantId.Value);

        if (entity == null) return NotFound();

        entity.ChequeNumber = model.ChequeNumber.Trim();
        entity.Direction = model.Direction;
        entity.Amount = model.Amount;
        entity.IssueDate = ParsePersianDate(model.IssueDate);
        entity.DueDate = ParsePersianDate(model.DueDate);
        entity.ContactId = model.ContactId;
        entity.BankAccountId = model.BankAccountId;
        entity.BankName = model.BankName?.Trim();
        entity.AccountNumber = model.AccountNumber?.Trim();
        entity.BranchCode = model.BranchCode?.Trim();
        entity.BranchName = model.BranchName?.Trim();
        entity.DrawerName = model.DrawerName?.Trim();
        entity.DrawerNationalId = model.DrawerNationalId?.Trim();
        entity.Description = model.Description?.Trim();
        entity.InvoiceId = model.InvoiceId;
        entity.UpdatedAt = DateTime.UtcNow;

        try
        {
            await _chequeService.UpdateAsync(entity);
            TempData["Success"] = "چک با موفقیت ویرایش شد.";
            return RedirectToAction(nameof(Index), new { direction = (int)entity.Direction });
        }
        catch (Exception ex)
        {
            ModelState.AddModelError("", ex.Message);
            await ReloadOptionsAsync(model);
            return View(model);
        }
    }

    // ============================================
    // Details
    // ============================================

    [Authorize(Policy = "Cheque.View")]
    public async Task<IActionResult> Details(int id)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return Forbid();

        var entity = await _context.Cheques
            .Include(c => c.Contact)
            .Include(c => c.BankAccount)
            .Include(c => c.Invoice)
            .Include(c => c.Transaction)
            .Include(c => c.Histories)
            .FirstOrDefaultAsync(c => c.Id == id && c.TenantId == tenantId.Value);

        if (entity == null) return NotFound();

        return View(entity);
    }

    // ============================================
    // Delete
    // ============================================

    [Authorize(Policy = "Cheque.Delete")]
    public async Task<IActionResult> Delete(int id)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return Forbid();

        var entity = await _context.Cheques
            .Include(c => c.Contact)
            .FirstOrDefaultAsync(c => c.Id == id && c.TenantId == tenantId.Value);

        if (entity == null) return NotFound();

        if (entity.Status != ChequeStatus.InProgress)
        {
            TempData["Error"] = "فقط چک در جریان قابل حذف است.";
            return RedirectToAction(nameof(Index));
        }

        return View(entity);
    }

    [HttpPost, ActionName("Delete")]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Delete")]
    public async Task<IActionResult> DeleteConfirmed(int id)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return Forbid();

        try
        {
            await _chequeService.DeleteAsync(id, tenantId.Value);
            TempData["Success"] = "چک با موفقیت حذف شد.";
        }
        catch (Exception ex)
        {
            TempData["Error"] = ex.Message;
        }

        return RedirectToAction(nameof(Index));
    }

    // ============================================
    // گردش کار
    // ============================================

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> MarkAsDeposited(int id, string? description)
    {
        return await ExecuteWorkflowAsync(id, tenantId => _chequeService.MarkAsDepositedAsync(id, tenantId, description));
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> MarkAsCleared(int id, string? clearedDate, string? bankTrackingNumber)
    {
        return await ExecuteWorkflowAsync(id, tenantId =>
            _chequeService.MarkAsClearedAsync(id, tenantId,
                string.IsNullOrWhiteSpace(clearedDate) ? null : ParsePersianDate(clearedDate),
                bankTrackingNumber));
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> MarkAsBounced(int id, string? bounceReason, string? bouncedDate)
    {
        return await ExecuteWorkflowAsync(id, tenantId =>
            _chequeService.MarkAsBouncedAsync(id, tenantId, bounceReason,
                string.IsNullOrWhiteSpace(bouncedDate) ? null : ParsePersianDate(bouncedDate)));
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> MarkAsReturned(int id, string? description)
    {
        return await ExecuteWorkflowAsync(id, tenantId => _chequeService.MarkAsReturnedAsync(id, tenantId, description));
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> MarkAsRePresented(int id, string newDueDate, string? description)
    {
        return await ExecuteWorkflowAsync(id, tenantId =>
            _chequeService.MarkAsRePresentedAsync(id, tenantId, ParsePersianDate(newDueDate), description));
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> MarkAsCancelled(int id, string? reason)
    {
        return await ExecuteWorkflowAsync(id, tenantId => _chequeService.MarkAsCancelledAsync(id, tenantId, reason));
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> MarkAsReferred(int id, string? description)
    {
        return await ExecuteWorkflowAsync(id, tenantId => _chequeService.MarkAsReferredAsync(id, tenantId, description));
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> MarkAsCashed(int id, string? cashedDate, string? description)
    {
        return await ExecuteWorkflowAsync(id, tenantId =>
            _chequeService.MarkAsCashedAsync(id, tenantId,
                string.IsNullOrWhiteSpace(cashedDate) ? null : ParsePersianDate(cashedDate),
                description));
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    [Authorize(Policy = "Cheque.Edit")]
    public async Task<IActionResult> AddNote(int id, string note)
    {
        return await ExecuteWorkflowAsync(id, tenantId => _chequeService.AddNoteAsync(id, tenantId, note));
    }

    // ============================================
    // Helpers
    // ============================================

    private async Task<IActionResult> ExecuteWorkflowAsync(int id, Func<int, Task> action)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return Json(new { success = false, message = "Tenant not found" });

        try
        {
            await action(tenantId.Value);
            return Json(new { success = true, message = "عملیات با موفقیت انجام شد." });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, message = ex.Message });
        }
    }

    private async Task ReloadOptionsAsync(ChequeFormViewModel model)
    {
        model.ContactOptions = await GetContactOptionsAsync(model.Direction);
        model.BankAccountOptions = await GetBankAccountOptionsAsync();
        model.InvoiceOptions = await GetInvoiceOptionsAsync(model.Direction);
    }

    private async Task<List<SelectListItem>> GetContactOptionsAsync(ChequeDirection direction)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return new();

        var query = _context.Contacts.Where(c => c.TenantId == tenantId.Value && c.IsActive);

        if (direction == ChequeDirection.Received)
            query = query.Where(c => c.ContactType == ContactType.Customer || c.ContactType == ContactType.Both);
        else
            query = query.Where(c => c.ContactType == ContactType.Supplier || c.ContactType == ContactType.Both);

        return await query
            .OrderBy(c => c.Name)
            .Select(c => new SelectListItem { Value = c.Id.ToString(), Text = c.Name })
            .ToListAsync();
    }

    private async Task<List<SelectListItem>> GetBankAccountOptionsAsync()
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return new();

        return await _context.Accounts
            .Where(a => a.TenantId == tenantId.Value && a.IsActive && a.AccountType == AccountType.Bank)
            .OrderBy(a => a.Name)
            .Select(a => new SelectListItem
            {
                Value = a.Id.ToString(),
                Text = a.Name + (a.BankName != null ? $" - {a.BankName}" : "")
            })
            .ToListAsync();
    }

    private async Task<List<SelectListItem>> GetInvoiceOptionsAsync(ChequeDirection direction)
    {
        var tenantId = _currentTenant.TenantId;
        if (!tenantId.HasValue) return new();

        var invoiceType = direction == ChequeDirection.Received ? InvoiceType.Sale : InvoiceType.Purchase;

        return await _context.Invoices
            .Where(i => i.TenantId == tenantId.Value && i.InvoiceType == invoiceType && i.Status == InvoiceStatus.Posted)
            .OrderByDescending(i => i.Date)
            .Select(i => new SelectListItem
            {
                Value = i.Id.ToString(),
                Text = $"فاکتور شماره {i.Number}"
            })
            .ToListAsync();
    }

    private DateTime ParsePersianDate(string persianDate)
    {
        if (string.IsNullOrWhiteSpace(persianDate))
            return DateTime.MinValue;

        try
        {
            persianDate = ToEnglishNumber(persianDate);
            var parts = persianDate.Split('/', '-');
            if (parts.Length != 3) return DateTime.MinValue;

            var year = int.Parse(parts[0]);
            var month = int.Parse(parts[1]);
            var day = int.Parse(parts[2]);

            if (year < 1300 || year > 1500) return DateTime.MinValue;
            if (month < 1 || month > 12) return DateTime.MinValue;
            if (day < 1 || day > 31) return DateTime.MinValue;

            var pc = new System.Globalization.PersianCalendar();
            return pc.ToDateTime(year, month, day, 0, 0, 0, 0);
        }
        catch
        {
            return DateTime.MinValue;
        }
    }

    private string ToEnglishNumber(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        return input
            .Replace("۰", "0").Replace("۱", "1").Replace("۲", "2")
            .Replace("۳", "3").Replace("۴", "4").Replace("۵", "5")
            .Replace("۶", "6").Replace("۷", "7").Replace("۸", "8")
            .Replace("۹", "9");
    }

    private static string GetStatusName(ChequeStatus status)
    {
        return status switch
        {
            ChequeStatus.InProgress => "در جریان",
            ChequeStatus.Cleared => "پاس شده",
            ChequeStatus.Bounced => "برگشت خورده",
            ChequeStatus.Returned => "عودت داده شده",
            ChequeStatus.RePresented => "مجدداً ارائه",
            ChequeStatus.Cancelled => "ابطال شده",
            ChequeStatus.Referred => "ارجاع به صاحب چک",
            ChequeStatus.Cashed => "نقد شده",
            _ => "نامشخص"
        };
    }
}