using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace MyFirstCoreApp.Models.Accounting
{
    // دسته‌بندی حساب‌ها به صورت درختی (مثلا: دارایی > دارایی جاری > بانک)
    public class AccountCategory
    {
        public int Id { get; set; }

        [Required, MaxLength(150)]
        public string Title { get; set; }

        // نوع دسته‌بندی: برای گزارش معین و ترازنامه لازم می‌شود
        public AccountCategoryType Type { get; set; }

        public int? ParentId { get; set; }

        [ForeignKey(nameof(ParentId))]
        public AccountCategory Parent { get; set; }

        public ICollection<AccountCategory> Children { get; set; } = new List<AccountCategory>();

        public ICollection<Account> Accounts { get; set; } = new List<Account>();

        // مالکیت چندمستأجری - هر کاربر دسته‌بندی‌های خودش را دارد
        [Required, MaxLength(450)]
        public string UserId { get; set; }
    }
}
