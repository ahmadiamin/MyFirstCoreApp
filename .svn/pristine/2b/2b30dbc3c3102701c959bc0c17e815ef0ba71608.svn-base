@model MyFirstCoreApp.Models.ViewModels.DeleteConfirmViewModel

<div class="card card-danger">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-trash"></i>
            @Model.Title
        </h3>
    </div>

    <div class="card-body">
        <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle"></i>
            @Model.Message
        </div>

        <dl class="row">
            @foreach (var item in Model.Items)
            {
                <dt class="col-sm-3">@item.Label:</dt>
                <dd class="col-sm-9">@item.Value</dd>
            }
        </dl>
    </div>

    <form asp-area="@Model.Area"
          asp-controller="@Model.Controller"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">
        @Html.AntiForgeryToken()
        <div class="card-footer">
            <button type="submit" class="btn btn-danger">
                <i class="fa fa-trash"></i> حذف
            </button>
            <a asp-area="@Model.Area"
               asp-controller="@Model.Controller"
               asp-action="Index"
               class="btn btn-secondary">
                <i class="fa fa-arrow-right"></i> انصراف
            </a>
        </div>
    </form>
</div>