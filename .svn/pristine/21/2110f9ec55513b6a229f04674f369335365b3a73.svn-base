using MyFirstCoreApp.Domain.Entities.Tenancy;

namespace MyFirstCoreApp.Application.Interfaces;

public interface ITenantService
{
    // CRUD
    Task<Tenant?> GetByIdAsync(int id);
    Task<List<Tenant>> GetUserTenantsAsync(string userId);
    Task<Tenant> CreateAsync(Tenant tenant, string ownerUserId);

    // عضویت
    Task<bool> IsUserMemberAsync(int tenantId, string userId);
    Task<bool> IsUserOwnerAsync(int tenantId, string userId);
    Task AddUserToTenantAsync(int tenantId, string userId, bool isOwner = false, bool isDefault = false);

    // انتخاب پیش‌فرض
    Task SetDefaultTenantAsync(string userId, int tenantId);

    Task<List<UserTenant>> GetUserTenantRelationsAsync(string userId);
}