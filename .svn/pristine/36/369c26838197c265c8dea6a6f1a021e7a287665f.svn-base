@page
@model RegisterConfirmationModel

@{
    ViewData["Title"] = "تأیید حساب کاربری";
}

<div class="row justify-content-center">

    <div class="col-md-7 col-lg-6">

        <div class="card card-primary">

            <div class="card-header text-center">

                <h3 class="card-title float-none">

                    <i class="fa fa-envelope"></i>

                    تأیید حساب کاربری

                </h3>

            </div>

            <div class="card-body text-center">

                <div class="mb-4">

                    <i class="fa fa-envelope text-primary"
                       style="font-size: 64px;">
                    </i>

                </div>

                <h4 class="mb-3">
                    ثبت‌نام شما با موفقیت انجام شد
                </h4>

                <p class="text-muted">

                    یک لینک تأیید به آدرس ایمیل زیر ارسال شده است:

                </p>

                <p class="mb-4">

                    <strong class="text-primary">
                        @Model.Email
                    </strong>

                </p>

                <div class="alert alert-warning text-right">

                    <h6>
                        <i class="fa fa-exclamation-triangle"></i>

                        توجه
                    </h6>

                    <p class="mb-0">

                        برای فعال شدن حساب کاربری،
                        ابتدا باید آدرس ایمیل خود را تأیید کنید.

                        تا زمانی که ایمیل شما تأیید نشده باشد،
                        امکان ورود به سیستم وجود ندارد.

                    </p>

                </div>

                <div class="alert alert-info text-right mt-3">

                    <i class="fa fa-info-circle"></i>

                    لطفاً صندوق ورودی ایمیل خود را بررسی کنید.
                    در صورت عدم دریافت ایمیل، پوشه
                    <strong>Spam</strong>
                    یا
                    <strong>Junk</strong>
                    را نیز بررسی کنید.

                </div>

                <div class="mt-4">

                    <a asp-page="./ResendEmailConfirmation"
                       class="btn btn-primary">

                        <i class="fa fa-paper-plane"></i>

                        ارسال مجدد لینک تأیید

                    </a>

                </div>

                <div class="mt-3">

                    <a asp-page="./Login">

                        <i class="fa fa-sign-in"></i>

                        بازگشت به صفحه ورود

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
