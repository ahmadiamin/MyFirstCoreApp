namespace MyFirstCoreApp.Domain.Enums;

/// <summary>
/// نوع تراکنش
/// </summary>
public enum TransactionType
{
    /// <summary>سند عادی</summary>
    Normal = 1,

    /// <summary>سند افتتاحیه (اول دوره)</summary>
    Opening = 2,

    /// <summary>سند اختتامیه (پایان دوره)</summary>
    Closing = 3,

    /// <summary>سند تعدیلات</summary>
    Adjustment = 4
}