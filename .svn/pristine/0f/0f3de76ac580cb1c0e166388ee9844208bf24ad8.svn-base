using Microsoft.EntityFrameworkCore;
using MyFirstCoreApp.Models.Inventory;

namespace MyFirstCoreApp.Data.ModelConfigurations
{
    public static class InventoryModelConfig
    {
        public static void Configure(ModelBuilder builder)
        {
            // ---------- ItemCategory ----------
            builder.Entity<ItemCategory>()
                .HasOne(c => c.Parent)
                .WithMany(c => c.Children)
                .HasForeignKey(c => c.ParentId)
                .OnDelete(DeleteBehavior.Restrict);

            builder.Entity<ItemCategory>()
                .HasIndex(c => c.UserId);

            // ---------- Item ----------
            builder.Entity<Item>()
                .HasOne(i => i.ItemCategory)
                .WithMany(c => c.Items)
                .HasForeignKey(i => i.ItemCategoryId)
                .OnDelete(DeleteBehavior.SetNull); // حذف دسته‌بندی، کالا را حذف نمی‌کند فقط دسته‌بندی‌اش خالی می‌شود

            builder.Entity<Item>()
                .HasIndex(i => i.UserId);

            builder.Entity<Item>()
                .HasIndex(i => new { i.UserId, i.Code }); // جستجوی سریع بر اساس کد کالا

            builder.Entity<Item>()
                .HasIndex(i => new { i.UserId, i.ItemCategoryId }); // فیلتر کالا بر اساس دسته‌بندی در گرید فاکتور

            // ---------- ItemImage ----------
            builder.Entity<ItemImage>()
                .HasOne(img => img.Item)
                .WithMany(i => i.Images)
                .HasForeignKey(img => img.ItemId)
                .OnDelete(DeleteBehavior.Cascade);

            builder.Entity<ItemImage>()
                .HasIndex(img => img.ItemId);

            // ---------- ItemSpecification ----------
            builder.Entity<ItemSpecification>()
                .HasOne(s => s.Item)
                .WithMany(i => i.Specifications)
                .HasForeignKey(s => s.ItemId)
                .OnDelete(DeleteBehavior.Cascade);

            builder.Entity<ItemSpecification>()
                .HasIndex(s => s.ItemId);
        }
    }
}
