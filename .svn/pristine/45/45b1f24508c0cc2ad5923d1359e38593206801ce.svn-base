@model IEnumerable<MyFirstCoreApp.Models.ViewModels.UserListViewModel>

@using MyFirstCoreApp.Services.Interfaces
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "مدیریت کاربران";
}

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <button type="button"
                    class="close"
                    data-dismiss="alert">
                &times;
            </button>

            <i class="fa fa-check-circle"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <button type="button"
                    class="close"
                    data-dismiss="alert">
                &times;
            </button>

            <i class="fa fa-exclamation-circle"></i>
            @TempData["ErrorMessage"]
        </div>
    }

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-users"></i>
            مدیریت کاربران
        </h3>
        
        <div class="card-tools">
            @if (await PermissionService.HasPermissionAsync(User, "User.Create"))
            {
                <a asp-action="Create" class="btn btn-success btn-sm">
                    <i class="fa fa-plus"></i>
                    کاربر جدید
                </a>
            }
        </div>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead>
                    <tr>
                        <th>نام و نام خانوادگی</th>
                        <th>نام کاربری</th>
                        <th>ایمیل</th>
                        <th>
                            تأیید ایمیل
                        </th>
                        <th>نقش‌ها</th>
                        <th>وضعیت</th>
                        <th style="width: 150px;">عملیات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <i class="fa fa-user text-muted"></i>
                                @user.FullName
                            </td>

                            <td>
                                @user.UserName
                            </td>

                            <td>
                                @user.Email
                            </td>
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <span class="badge badge-success">
                                        تأیید شده
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">
                                        تأیید نشده
                                    </span>
                                    @if (!user.EmailConfirmed)
                                    {
                                        <form asp-action="ResendConfirmationEmail"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-warning btn-sm"
                                                    title="ارسال مجدد لینک تأیید">

                                                <i class="fa fa-paper-plane"></i>
                                                ارسال تأیید

                                            </button>

                                        </form>
                                    }
                                }
                            </td>
                            <td>
                                @if (user.Roles.Any())
                                {
                                    foreach (var role in user.Roles)
                                    {
                                        <span class="badge badge-info">
                                            @role
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">
                                        بدون نقش
                                    </span>
                                }
                            </td>

                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge badge-success">
                                        فعال
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">
                                        غیرفعال
                                    </span>
                                }

                                <form asp-action="ToggleActive"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    @if (user.IsActive)
                                    {
                                        <button type="submit"
                                                class="btn btn-warning btn-sm"
                                                title="غیرفعال کردن"
                                                onclick="return confirm('آیا از غیرفعال کردن این کاربر مطمئن هستید؟');">
                                            <i class="fa fa-close"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-success btn-sm"
                                                title="فعال کردن"
                                                onclick="return confirm('آیا می‌خواهید این کاربر فعال شود؟');">
                                            <i class="fa fa-check"></i>
                                        </button>
                                    }

                                </form>
                            </td>

                            <td>
                                @if (await PermissionService.HasPermissionAsync(User, "User.Edit"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="btn btn-warning btn-sm"
                                       title="ویرایش">
                                        <i class="fa fa-edit"></i>
                                    </a>

                                    <a asp-action="ProfileImages"
                                       asp-route-userId="@user.Id"
                                       class="btn btn-info btn-sm"
                                       title="مدیریت تصاویر">
                                        <i class="fa fa-image"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer text-muted">
        تعداد کاربران:
        <strong>@Model.Count()</strong>
    </div>
</div>