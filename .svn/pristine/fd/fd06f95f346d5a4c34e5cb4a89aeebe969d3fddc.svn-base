<!DOCTYPE html>

<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @ViewData["Title"] - مدیریت کسب و کار ویرا
    </title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/font-awesome/css/all.min.css" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/plugins/bootstrap/css/bootstrap.min.css" />

    <!-- Bootstrap RTL -->
    <link rel="stylesheet" href="~/dist/css/bootstrap-rtl.min.css" />

    <!-- AdminLTE -->
    <link rel="stylesheet" href="~/dist/css/adminlte.css" />

    <!-- Persian AdminLTE custom styles -->
    <link rel="stylesheet" href="~/dist/css/custom-style.css" />

    <!-- Application styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Select2 CSS -->
    <link rel="stylesheet" href="~/plugins/select2/select2.min.css" />

    <!-- Persian Data Picker -->
    <link rel="stylesheet" href="~/dist/css/persian-datepicker.min.css">

    <!-- AG-Grid -->
    <link rel="stylesheet" href="~/plugins/ag-grid/ag-grid.css">
    <link rel="stylesheet" href="~/plugins/ag-grid/ag-theme-alpine.css">

    <!-- MagicSuggest -->
    <link rel="stylesheet" href="~/plugins/magicsuggest/magicsuggest.css" />
</head>


<body class="hold-transition sidebar-mini layout-fixed farsi-digits">

    <div class="wrapper">


        <!-- =========================
             Navbar
             ========================= -->

        <nav class="main-header navbar navbar-expand navbar-white navbar-light">

            <!-- Sidebar Toggle -->

            <ul class="navbar-nav">

                <li class="nav-item">

                    <a class="nav-link"
                       data-widget="pushmenu"
                       href="#"
                       role="button"
                       title="باز و بسته کردن منو">

                        <i class="fa fa-bars"></i>

                    </a>

                </li>

            </ul>


            <!-- User / Login -->

            <ul class="navbar-nav mr-auto">

                <partial name="_LoginPartial" />

            </ul>

        </nav>


        <!-- =========================
             Sidebar
             ========================= -->

        <aside class="main-sidebar sidebar-dark-primary elevation-4">


            <!-- Brand -->

            <a asp-area=""
               asp-controller="Dashboard"
               asp-action="Index"
               class="brand-link">

                <i class="fa fa-cubes brand-image"></i>

                <span class="brand-text font-weight-light">
                    مدیریت کسب و کار ویرا
                </span>

            </a>


            <!-- Sidebar -->

            <div class="sidebar">


                <!-- =========================
                     User Panel
                     ========================= -->
                @await Component.InvokeAsync("UserProfile")


                <!-- =========================
                     Navigation
                     ========================= -->

                <nav class="mt-2">

                    <ul class="nav nav-pills nav-sidebar flex-column"
                        data-widget="treeview"
                        role="menu"
                        data-accordion="false">


                        <!-- Dashboard -->

                        <li class="nav-item">

                            <a asp-area=""
                               asp-controller="Dashboard"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fa fa-dashboard"></i>

                                <p>
                                    داشبورد
                                </p>

                            </a>

                        </li>


                        <!-- Dynamic Menu -->
                        @await Component.InvokeAsync("AdminMenu")

                    </ul>

                </nav>

            </div>

        </aside>


        <!-- =========================
             Content Wrapper
             ========================= -->

        <div class="content-wrapper">

            <!-- Main Content -->

            <section class="content">

                <div class="container-fluid">

                    @RenderBody()

                </div>

            </section>

        </div>


        <!-- =========================
             Footer
             ========================= -->

        <footer class="main-footer">

            <strong>
                مدیریت کسب و کار ویرا
            </strong>

            <div class="float-right d-none d-sm-inline-block">

                <span class="mr-2">
                    سیستم مدیریت
                </span>

                <span>
                    <b>نسخه</b> 1.0
                </span>

            </div>

        </footer>


    </div>


    <!-- =========================
         Scripts
         ========================= -->
    
         <!-- jQuery -->
    <script src="~/plugins/jquery/jquery.min.js"></script>

    <!-- InputMask -->
    <script src="~/plugins/input-mask/jquery.inputmask.js"></script>
    <script src="~/plugins/input-mask/jquery.inputmask.date.extensions.js"></script>
    <script src="~/plugins/input-mask/jquery.inputmask.extensions.js"></script>

    <!-- date-range-picker -->
    <script src="~/plugins/daterangepicker/moment.min.js"></script>
    <script src="~/plugins/daterangepicker/daterangepicker.js"></script>

    <!-- Bootstrap -->
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- AdminLTE -->
    <script src="~/dist/js/adminlte.min.js"></script>

    <!-- Application -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- AG Grid JS -->
    <script src="~/plugins/ag-grid/ag-grid-community.min.js"></script>

    <!-- 🆕 AG Grid Helper -->
    <script src="~/plugins/ag-grid/ag-grid-helper.js"></script>

    <!-- 🆕 Select2 -->
    <script src="~/plugins/select2/select2.full.min.js"></script>
    <script src="~/plugins/select2/i18n/fa.js"></script>

    <!-- Persian Data Picker -->
    <script src="~/dist/js/persian-date.min.js"></script>
    <script src="~/dist/js/persian-datepicker.min.js"></script>

    <!-- MagicSuggest -->
    <script src="~/plugins/magicsuggest/magicsuggest.js"></script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)


</body>

</html>