@model MyFirstCoreApp.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "داشبورد";
}

<div class="container-fluid">

    <div class="mb-4">

        <h3 class="fw-bold mb-1">
            داشبورد
        </h3>

        <div class="text-muted">
            نمای کلی سیستم
        </div>

    </div>


    <div class="row g-4">


        <!-- Users -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="dashboard-card-title">
                                کاربران
                            </div>

                            <p class="dashboard-card-value">
                                @Model.UserCount
                            </p>

                        </div>


                        <div class="dashboard-card-icon
                                    bg-primary-subtle
                                    text-primary">

                            <i class="bi bi-people"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Roles -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="dashboard-card-title">
                                نقش‌ها
                            </div>

                            <p class="dashboard-card-value">
                                @Model.RoleCount
                            </p>

                        </div>


                        <div class="dashboard-card-icon
                                    bg-success-subtle
                                    text-success">

                            <i class="bi bi-person-badge"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Permissions -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="dashboard-card-title">
                                دسترسی‌ها
                            </div>

                            <p class="dashboard-card-value">
                                @Model.PermissionCount
                            </p>

                        </div>


                        <div class="dashboard-card-icon
                                    bg-warning-subtle
                                    text-warning">

                            <i class="bi bi-shield-lock"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Menus -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="dashboard-card-title">
                                منوها
                            </div>

                            <p class="dashboard-card-value">
                                @Model.MenuCount
                            </p>

                        </div>


                        <div class="dashboard-card-icon
                                    bg-info-subtle
                                    text-info">

                            <i class="bi bi-list"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>