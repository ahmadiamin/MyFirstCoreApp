
using Microsoft.AspNetCore.Identity;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using MyFirstCoreApp.Domain.Entities.Identity;

namespace MyFirstCoreApp.Infrastructure.Persistence.Seed
{
    public static class IdentitySeeder
    {
        public static async Task SeedAsync(
            IServiceProvider serviceProvider)
        {
            using var scope = serviceProvider.CreateScope();

            var context = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            var roleManager = scope.ServiceProvider
                .GetRequiredService<RoleManager<IdentityRole>>();

            var userManager = scope.ServiceProvider
                .GetRequiredService<UserManager<ApplicationUser>>();

            var configuration = scope.ServiceProvider
                .GetRequiredService<IConfiguration>();

            await context.Database.MigrateAsync();

            await SeedRolesAsync(roleManager);

            await SeedPermissionsAsync(context);

            await SeedRolePermissionsAsync(
                context,
                roleManager);

            await SeedMenusAsync(context);

            await SeedAdminUserAsync(
                userManager,
                roleManager,
                configuration);

        }

        private static async Task SeedRolesAsync(
            RoleManager<IdentityRole> roleManager)
        {
            string[] roles =
            {
            "Admin",
            "Manager",
            "Operator",
            "User"
        };

            foreach (var roleName in roles)
            {
                if (!await roleManager.RoleExistsAsync(roleName))
                {
                    var result = await roleManager.CreateAsync(
                        new IdentityRole(roleName));

                    if (!result.Succeeded)
                    {
                        throw new Exception(
                            $"خطا در ایجاد Role '{roleName}': " +
                            string.Join(", ",
                                result.Errors.Select(x => x.Description)));
                    }
                }
            }
        }

        private static async Task SeedPermissionsAsync(
            ApplicationDbContext context)
        {
            var permissions = new[]
            {
            // Users
            new Permission
            {
                Name = "User.View",
                DisplayName = "مشاهده کاربران",
                GroupName = "Users",
                IsActive = true
            },
            new Permission
            {
                Name = "User.Create",
                DisplayName = "ایجاد کاربر",
                GroupName = "Users",
                IsActive = true
            },
            new Permission
            {
                Name = "User.Edit",
                DisplayName = "ویرایش کاربر",
                GroupName = "Users",
                IsActive = true
            },
            new Permission
            {
                Name = "User.Delete",
                DisplayName = "حذف کاربر",
                GroupName = "Users",
                IsActive = true
            },

            // Roles
            new Permission
            {
                Name = "Role.View",
                DisplayName = "مشاهده نقش‌ها",
                GroupName = "Roles",
                IsActive = true
            },
            new Permission
            {
                Name = "Role.Create",
                DisplayName = "ایجاد نقش",
                GroupName = "Roles",
                IsActive = true
            },
            new Permission
            {
                Name = "Role.Edit",
                DisplayName = "ویرایش نقش‌ها",
                GroupName = "Roles",
                IsActive = true
            },
            new Permission
            {
                Name = "Role.Delete",
                DisplayName = "حذف نقش‌ها",
                GroupName = "Roles",
                IsActive = true
            },

            // Permissions
            new Permission
            {
                Name = "Permission.View",
                DisplayName = "مشاهده دسترسی‌ها",
                GroupName = "Permissions",
                IsActive = true
            },
            new Permission
            {
                Name = "Permission.Create",
                DisplayName = "ایجاد دسترسی",
                GroupName = "Permissions",
                IsActive = true
            },
            new Permission
            {
                Name = "Permission.Edit",
                DisplayName = "ویرایش دسترسی‌ها",
                GroupName = "Permissions",
                IsActive = true
            },
            new Permission
            {
                Name = "Permission.Delete",
                DisplayName = "حذف دسترسی‌ها",
                GroupName = "Permissions",
                IsActive = true
            },
            new Permission
            {
                Name = "Menu.View",
                DisplayName = "مشاهده منوها",
                GroupName = "منوها",
                IsActive = true
            },

            new Permission
            {
                Name = "Menu.Create",
                DisplayName = "ایجاد منو",
                GroupName = "منوها",
                IsActive = true
            },

            new Permission
            {
                Name = "Menu.Edit",
                DisplayName = "ویرایش منو",
                GroupName = "منوها",
                IsActive = true
            },

            new Permission
            {
                Name = "Menu.Delete",
                DisplayName = "حذف منو",
                GroupName = "منوها",
                IsActive = true
            }
        };

            foreach (var permission in permissions)
            {
                var exists = await context.Permissions
                    .AnyAsync(x => x.Name == permission.Name);

                if (!exists)
                {
                    context.Permissions.Add(permission);
                }
            }

            await context.SaveChangesAsync();
        }

        private static async Task SeedRolePermissionsAsync(
            ApplicationDbContext context,
            RoleManager<IdentityRole> roleManager)
        {
            var adminRole = await roleManager.FindByNameAsync("Admin");

            if (adminRole == null)
                return;

            var allPermissionIds = await context.Permissions
                .Select(x => x.Id)
                .ToListAsync();

            var existingPermissionIds = await context.RolePermissions
                .Where(x => x.RoleId == adminRole.Id)
                .Select(x => x.PermissionId)
                .ToListAsync();

            var permissionsToAdd = allPermissionIds
                .Except(existingPermissionIds)
                .ToList();

            foreach (var permissionId in permissionsToAdd)
            {
                context.RolePermissions.Add(
                    new RolePermission
                    {
                        RoleId = adminRole.Id,
                        PermissionId = permissionId
                    });
            }

            if (permissionsToAdd.Count > 0)
            {
                await context.SaveChangesAsync();
            }
        }

        private static async Task SeedAdminUserAsync(
            UserManager<ApplicationUser> userManager,
            RoleManager<IdentityRole> roleManager,
            IConfiguration configuration)
        {
            var email = configuration["SeedAdmin:Email"];
            var password = configuration["SeedAdmin:Password"];
            var fullName = configuration["SeedAdmin:FullName"];

            if (string.IsNullOrWhiteSpace(email) ||
                string.IsNullOrWhiteSpace(password) ||
                string.IsNullOrWhiteSpace(fullName))
            {
                throw new Exception(
                    "اطلاعات SeedAdmin در User Secrets تنظیم نشده است.");
            }

            var adminRole = await roleManager.FindByNameAsync("Admin");

            if (adminRole == null)
                throw new Exception(
                    "Role 'Admin' پیدا نشد.");

            var user = await userManager.FindByEmailAsync(email);

            if (user == null)
            {
                user = new ApplicationUser
                {
                    FullName = fullName,
                    Email = email,
                    UserName = email,
                    EmailConfirmed = true,
                    IsActive = true
                };

                var result = await userManager.CreateAsync(
                    user,
                    password);

                if (!result.Succeeded)
                {
                    throw new Exception(
                        "خطا در ایجاد Admin User: " +
                        string.Join(", ",
                            result.Errors.Select(x => x.Description)));
                }
            }

            if (!await userManager.IsInRoleAsync(
                    user,
                    "Admin"))
            {
                var result = await userManager.AddToRoleAsync(
                    user,
                    "Admin");

                if (!result.Succeeded)
                {
                    throw new Exception(
                        "خطا در اختصاص Role Admin: " +
                        string.Join(", ",
                            result.Errors.Select(x => x.Description)));
                }
            }
        }

        private static async Task SeedMenusAsync(
            ApplicationDbContext context)
        {
            var menus = new[]
            {
    new Menu
    {
        Title = "کاربران",
        Url = "/Admin/Users",
        Icon = "bi-people",
        Permission = "User.View",
        SortOrder = 1,
        IsActive = true
    },

    new Menu
    {
        Title = "نقش‌ها",
        Url = "/Admin/Roles",
        Icon = "bi-person-badge",
        Permission = "Role.View",
        SortOrder = 2,
        IsActive = true
    },

    new Menu
    {
        Title = "دسترسی‌ها",
        Url = "/Admin/Permissions",
        Icon = "bi-shield-lock",
        Permission = "Permission.View",
        SortOrder = 3,
        IsActive = true
    }
};

            foreach (var menu in menus)
            {
                var exists = await context.Menus
                    .AnyAsync(x => x.Url == menu.Url);

                if (!exists)
                {
                    context.Menus.Add(menu);
                }
            }

            await context.SaveChangesAsync();
        }
    }
}
