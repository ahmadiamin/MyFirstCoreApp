@using MyFirstCoreApp.Areas.Accounting.ViewModels.Account
@model AccountFormViewModel

<div class="row">

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" placeholder="مثلاً بانک صادرات" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="form-control" placeholder="1001" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="AccountCategoryId"></label>
            <select asp-for="AccountCategoryId" class="form-control"
                    asp-items="Model.CategoryOptions">
                <option value="">-- انتخاب دسته --</option>
            </select>
            <span asp-validation-for="AccountCategoryId" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="AccountType"></label>
            <select asp-for="AccountType" class="form-control"
                    asp-items="Model.AccountTypeOptions">
            </select>
            <span asp-validation-for="AccountType" class="text-danger"></span>
        </div>
    </div>

</div>

<hr />

<h5 class="mb-3">
    <i class="fa fa-university"></i>
    اطلاعات بانکی
    <small class="text-muted">(فقط برای حساب‌های بانکی)</small>
</h5>

<div class="row">

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="BankName"></label>
            <input asp-for="BankName" class="form-control" placeholder="صادرات" />
            <span asp-validation-for="BankName" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="AccountNumber"></label>
            <input asp-for="AccountNumber" class="form-control" />
            <span asp-validation-for="AccountNumber" class="text-danger"></span>
        </div>
    </div>

    <!-- شماره کارت -->
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="CardNumber"></label>
            <input asp-for="CardNumber"
                   class="form-control ltr"
                   data-inputmask="'mask': '9999-9999-9999-9999'"
                   data-mask
                   placeholder="0000-0000-0000-0000" />
            <span asp-validation-for="CardNumber" class="text-danger"></span>
        </div>
    </div>

    <!-- شماره شبا -->
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="ShebaNumber"></label>
            <input asp-for="ShebaNumber"
                   class="form-control ltr"
                   data-inputmask="'mask': 'IR99 9999 9999 9999 9999 9999 99'"
                   data-mask
                   placeholder="IR00 0000 0000 0000 0000 0000 00" />
            <span asp-validation-for="ShebaNumber" class="text-danger"></span>
        </div>
    </div>

</div>

<hr />

<h5 class="mb-3">
    <i class="fa fa-money"></i>
    اطلاعات مالی
</h5>

<div class="row">

    <!-- مانده اولیه (با جداکننده سه‌رقمی) -->
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="CurrentBalance"></label>
            <input type="text"
                   id="CurrentBalance_Display"
                   class="form-control ltr persian-number persian-number-comma"
                   data-target="CurrentBalance_Hidden"
                   value="@Model.CurrentBalance" />
            <input asp-for="CurrentBalance" type="hidden" id="CurrentBalance_Hidden" />
            <span asp-validation-for="CurrentBalance" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label>وضعیت</label>
            <div class="custom-control custom-checkbox mt-2">
                <input asp-for="IsDefault" class="custom-control-input" id="IsDefault" />
                <label asp-for="IsDefault" class="custom-control-label" for="IsDefault">
                    حساب پیش‌فرض این نوع
                </label>
            </div>
            <div class="custom-control custom-checkbox mt-2">
                <input asp-for="IsActive" class="custom-control-input" id="IsActive" />
                <label asp-for="IsActive" class="custom-control-label" for="IsActive">
                    فعال
                </label>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

</div>