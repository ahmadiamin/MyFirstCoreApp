using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using MyFirstCoreApp.Domain.Entities.Identity;
using MyFirstCoreApp.Infrastructure.Persistence;
using MyFirstCoreApp.Models.ViewModels;

namespace MyFirstCoreApp.Areas.Admin.Controllers
{
    [Area("Admin")]
    public class MenusController : Controller
    {
        private readonly ApplicationDbContext _context;

        public MenusController(ApplicationDbContext context)
        {
            _context = context;
        }

        [Authorize(Policy = "Menu.View")]
        public async Task<IActionResult> Index()
        {
            var menus = await _context.Menus
                .AsNoTracking()
                .OrderBy(x => x.SortOrder)
                .ToListAsync();

            var lookup = menus.ToLookup(x => x.ParentId);

            List<MenuTreeViewModel> BuildTree(
                int? parentId,
                int level)
            {
                return lookup[parentId]
                    .OrderBy(x => x.SortOrder)
                    .Select(x => new MenuTreeViewModel
                    {
                        Id = x.Id,
                        Title = x.Title,
                        Url = x.Url,
                        Icon = x.Icon,
                        Permission = x.Permission,
                        SortOrder = x.SortOrder,
                        IsActive = x.IsActive,
                        Level = level,
                        Children = BuildTree(x.Id, level + 1)
                    })
                    .ToList();
            }

            var model = BuildTree(null, 0);

            return View(model);
        }

        [Authorize(Policy = "Menu.Create")]
        [HttpGet]
        public async Task<IActionResult> Create()
        {
            var model = new MenuEditViewModel
            {
                SortOrder = 1,
                IsActive = true
            };

            await LoadListsAsync(model);

            return View(model);
        }

        [Authorize(Policy = "Menu.Create")]
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Create(MenuEditViewModel model)
        {
            if (!ModelState.IsValid)
            {
                await LoadListsAsync(model);
                return View(model);
            }

            var menu = new Menu
            {
                Title = model.Title,
                Url = model.Url,
                Icon = model.Icon,
                Permission = model.Permission,
                ParentId = model.ParentId,
                SortOrder = model.SortOrder,
                IsActive = model.IsActive
            };

            _context.Menus.Add(menu);

            await _context.SaveChangesAsync();

            return RedirectToAction(nameof(Index));
        }

        [Authorize(Policy = "Menu.Edit")]
        [HttpGet]
        public async Task<IActionResult> Edit(int id)
        {
            var menu = await _context.Menus
                .FirstOrDefaultAsync(x => x.Id == id);

            if (menu == null)
                return NotFound();

            var model = new MenuEditViewModel
            {
                Id = menu.Id,
                Title = menu.Title,
                Url = menu.Url,
                Icon = menu.Icon,
                Permission = menu.Permission,
                ParentId = menu.ParentId,
                SortOrder = menu.SortOrder,
                IsActive = menu.IsActive
            };

            await LoadListsAsync(model, menu.Id);

            return View(model);
        }

        [Authorize(Policy = "Menu.Edit")]
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Edit(int id, MenuEditViewModel model)
        {
            if (id != model.Id)
                return BadRequest();

            if (model.ParentId == model.Id)
            {
                ModelState.AddModelError(nameof(model.ParentId), "یک منو نمی‌تواند والد خودش باشد.");
            }
            if (await WouldCreateCircularReference(model.Id, model.ParentId))
            {
                ModelState.AddModelError(nameof(model.ParentId), "این منوی والد باعث ایجاد حلقه در ساختار منو می‌شود.");
            }
            var menu = await _context.Menus.FirstOrDefaultAsync(x => x.Id == id);

            if (menu == null)
                return NotFound();

            if (!ModelState.IsValid)
            {
                await LoadListsAsync(model, model.Id);
                return View(model);
            }

            menu.Title = model.Title;
            menu.Url = model.Url;
            menu.Icon = model.Icon;
            menu.Permission = model.Permission;
            menu.ParentId = model.ParentId;
            menu.SortOrder = model.SortOrder;
            menu.IsActive = model.IsActive;
            await _context.SaveChangesAsync();

            return RedirectToAction(nameof(Index));
        }

        private async Task LoadListsAsync(
            MenuEditViewModel model,
            int? currentMenuId = null)
        {
            var query = _context.Menus
                .AsNoTracking()
                .Where(x => x.IsActive);

            if (currentMenuId.HasValue)
            {
                query = query.Where(
                    x => x.Id != currentMenuId.Value);
            }

            model.Parents = await query
                .OrderBy(x => x.Title)
                .Select(x => new MenuParentViewModel
                {
                    Id = x.Id,
                    Title = x.Title
                })
                .ToListAsync();

            model.Permissions = await _context.Permissions
                .AsNoTracking()
                .Where(x => x.IsActive)
                .OrderBy(x => x.GroupName)
                .ThenBy(x => x.DisplayName)
                .Select(x => new MenuPermissionViewModel
                {
                    Name = x.Name,
                    DisplayName = x.DisplayName,
                    GroupName = x.GroupName
                })
                .ToListAsync();
        }
        [Authorize(Policy = "Menu.Delete")]
        [HttpGet]
        public async Task<IActionResult> Delete(int id)
        {
            var menu = await _context.Menus
                .Include(x => x.Parent)
                .Include(x => x.Children)
                .FirstOrDefaultAsync(x => x.Id == id);

            if (menu == null)
                return NotFound();

            if (menu.Children.Any())
            {
                TempData["Error"] =
                    "این منو دارای زیرمنو است و امکان حذف آن وجود ندارد.";

                return RedirectToAction(nameof(Index));
            }

            var model = new MenuListViewModel
            {
                Id = menu.Id,
                Title = menu.Title,
                Url = menu.Url,
                Icon = menu.Icon,
                Permission = menu.Permission,
                ParentTitle = menu.Parent?.Title,
                SortOrder = menu.SortOrder,
                IsActive = menu.IsActive
            };

            return View(model);
        }
        [Authorize(Policy = "Menu.Delete")]
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> DeleteConfirmed(int id)
        {
            var menu = await _context.Menus
                .Include(x => x.Children)
                .FirstOrDefaultAsync(x => x.Id == id);

            if (menu == null)
                return NotFound();

            if (menu.Children.Any())
            {
                TempData["Error"] =
                    "این منو دارای زیرمنو است و امکان حذف آن وجود ندارد.";

                return RedirectToAction(nameof(Index));
            }

            _context.Menus.Remove(menu);

            await _context.SaveChangesAsync();

            TempData["Success"] = "منو با موفقیت حذف شد.";

            return RedirectToAction(nameof(Index));
        }

        private async Task<bool> WouldCreateCircularReference(
    int menuId,
    int? newParentId)
        {
            if (!newParentId.HasValue)
                return false;

            var currentParentId = newParentId;

            while (currentParentId.HasValue)
            {
                if (currentParentId.Value == menuId)
                    return true;

                currentParentId = await _context.Menus
                    .Where(x => x.Id == currentParentId.Value)
                    .Select(x => x.ParentId)
                    .FirstOrDefaultAsync();
            }

            return false;
        }
    }
}