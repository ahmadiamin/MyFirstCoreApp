namespace MyFirstCoreApp.Models.Inventory
{
    public enum MeasurementType
    {
        Count = 1,    // تعدادی (عدد، بسته، جعبه و ...)
        Length = 2,   // طولی/متراژی (متر، سانتی‌متر و ...)
        Area = 3,     // مساحتی (متر مربع)
        Weight = 4,   // وزنی (کیلوگرم، گرم و ...)
        Volume = 5    // حجمی (لیتر و ...)
    }
}
