@model MyFirstCoreApp.Areas.Accounting.ViewModels.Report.DetailedReportViewModel
@{
    ViewData["Title"] = "گزارش تفصیلی";
}

<div class="card card-outline card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-list-ul"></i>
            گزارش تفصیلی
        </h3>
    </div>
    <div class="card-body">
        <form asp-action="Detailed" method="get">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="AccountId">حساب</label>
                        <select asp-for="AccountId" class="form-control select2" asp-items="Model.AccountOptions">
                            <option value="">-- انتخاب حساب --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="ContactId">طرف حساب</label>
                        <select asp-for="ContactId" class="form-control select2" asp-items="Model.ContactOptions">
                            <option value="">-- همه --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="FromDate">از تاریخ</label>
                        <input asp-for="FromDate" class="form-control datepicker" autocomplete="off" dir="ltr" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="ToDate">تا تاریخ</label>
                        <input asp-for="ToDate" class="form-control datepicker" autocomplete="off" dir="ltr" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <div class="custom-control custom-checkbox mt-2">
                            <input asp-for="OnlyPosted" class="custom-control-input" id="OnlyPosted" />
                            <label asp-for="OnlyPosted" class="custom-control-label" for="OnlyPosted">
                                فقط قطعی
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fa-solid fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.AccountId.HasValue)
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fa-solid fa-book"></i>
                @Model.AccountName
                @if (!string.IsNullOrEmpty(Model.AccountCode))
                {
                    <small class="text-muted">(@Model.AccountCode)</small>
                }
                @if (!string.IsNullOrEmpty(Model.AccountTypeName))
                {
                    <span class="badge badge-info">@Model.AccountTypeName</span>
                }
            </h3>
        </div>
        <div class="card-body">

            <div class="alert alert-info">
                <strong>مانده اول دوره:</strong>
                <span class="persian-number-comma">@Model.OpeningBalance.ToString("N0")</span>
            </div>

            @if (Model.Lines.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th style="width: 90px;">شماره سند</th>
                                <th style="width: 100px;">تاریخ</th>
                                <th>شرح</th>
                                <th style="width: 150px;">طرف حساب</th>
                                <th style="width: 130px;">مرجع</th>
                                <th style="width: 130px;">بدهکار</th>
                                <th style="width: 130px;">بستانکار</th>
                                <th style="width: 130px;">مانده</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var i = 1;
                            }
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td class="persian-number">@i</td>
                                    <td>
                                        <a asp-controller="Transactions" asp-action="Details"
                                           asp-route-id="@line.TransactionId">
                                            @line.TransactionNumber
                                        </a>
                                    </td>
                                    <td>@line.DateShamsi</td>
                                    <td>@line.Description</td>
                                    <td>@line.ContactName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(line.Reference))
                                        {
                                            @if (line.ReferenceType == "Invoice" && line.ReferenceId.HasValue)
                                            {
                                                <a asp-area="Invoicing" asp-controller="Invoices" asp-action="Details"
                                                   asp-route-id="@line.ReferenceId" title="مشاهده فاکتور">
                                                    <i class="fa-solid fa-file-invoice"></i> @line.Reference
                                                </a>
                                            }
                                            else if (line.ReferenceType == "Cheque" && line.ReferenceId.HasValue)
                                            {
                                                <a asp-area="Banking" asp-controller="Cheques" asp-action="Details"
                                                   asp-route-id="@line.ReferenceId" title="مشاهده چک">
                                                    <i class="fa-solid fa-money-check"></i> @line.Reference
                                                </a>
                                            }
                                            else if (line.ReferenceType == "Payment" && line.ReferenceId.HasValue)
                                            {
                                                <a asp-area="Banking" asp-controller="Payments" asp-action="Details"
                                                   asp-route-id="@line.ReferenceId" title="مشاهده پرداخت">
                                                    <i class="fa-solid fa-money-bill-transfer"></i> @line.Reference
                                                </a>
                                            }
                                            else
                                            {
                                                @line.Reference
                                            }
                                        }
                                    </td>
                                    <td class="persian-number-comma">@(line.Debit > 0 ? line.Debit.ToString("N0") : "")</td>
                                    <td class="persian-number-comma">@(line.Credit > 0 ? line.Credit.ToString("N0") : "")</td>
                                    <td class="persian-number-comma">@line.RunningBalance.ToString("N0")</td>
                                </tr>
                                i++;
                            }
                        </tbody>
                        <tfoot>
                            <tr class="bg-light">
                                <th colspan="6" class="text-left">جمع:</th>
                                <th class="persian-number-comma">@Model.TotalDebit.ToString("N0")</th>
                                <th class="persian-number-comma">@Model.TotalCredit.ToString("N0")</th>
                                <th class="persian-number-comma">@Model.ClosingBalance.ToString("N0")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fa-solid fa-info-circle"></i>
                    تراکنشی در این بازه یافت نشد.
                </div>
            }

            <div class="alert alert-success">
                <strong>مانده آخر دوره:</strong>
                <span class="persian-number-comma">@Model.ClosingBalance.ToString("N0")</span>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // 🆕 Select2
            $('.select2').select2({
                dir: 'rtl',
                placeholder: '-- انتخاب --',
                allowClear: true,
                width: '100%',
                language: 'fa'
            });

            // 🆕 DatePicker
            $('.datepicker').each(function () {
                var $input = $(this);
                var val = $input.val();

                $input.persianDatepicker({
                    format: 'YYYY/MM/DD',
                    initialValue: !!val,           // 🆕 اگه مقدار داره، true
                    initialValueType: 'persian',    // 🆕 مقدار شمسیه
                    autoClose: true,
                    observer: true,
                    calendar: {
                        persian: { locale: 'fa', showHint: true, leapYearMode: 'algorithmic' }
                    },
                    toolbox: { calendarSwitch: { enabled: false } }
                });
            });
        });
    </script>
}