@model IEnumerable<MyFirstCoreApp.Models.Permission>
@inject PermissionService PermissionService
@{
    ViewData["Title"] = "مدیریت دسترسی‌ها";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>مدیریت دسترسی‌ها</h2>

    @if (await PermissionService.HasPermissionAsync(User, "Permission.Create"))
    {
        <a asp-area="Admin"
           asp-controller="Permissions"
           asp-action="Create"
           class="btn btn-primary">
            ایجاد دسترسی
        </a>
    }
</div>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>گروه</th>
            <th>نام</th>
            <th>عنوان</th>
            <th>وضعیت</th>
            <th style="width: 100px;">عملیات</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var permission in Model)
        {
            <tr>
                <td>@permission.GroupName</td>

                <td>
                    <code>@permission.Name</code>
                </td>

                <td>@permission.DisplayName</td>

                <td>
                    @if (permission.IsActive)
                    {
                        <span class="badge bg-success">
                            فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            غیرفعال
                        </span>
                    }
                </td>

                <td>
                    @if (await PermissionService.HasPermissionAsync(User, "Permission.Edit"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@permission.Id"
                           class="btn btn-sm btn-warning">
                            ویرایش
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>