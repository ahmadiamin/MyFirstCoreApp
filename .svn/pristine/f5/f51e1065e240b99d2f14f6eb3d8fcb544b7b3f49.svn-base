using Microsoft.EntityFrameworkCore;
using MyFirstCoreApp.Application.Interfaces;
using MyFirstCoreApp.Domain.Entities.Accounting;
using MyFirstCoreApp.Domain.Entities.Invoicing;
using MyFirstCoreApp.Domain.Enums;
using MyFirstCoreApp.Infrastructure.Persistence;

namespace MyFirstCoreApp.Infrastructure.Services;

public class InvoiceService : IInvoiceService
{
    private readonly ApplicationDbContext _context;
    private readonly ITransactionService _transactionService;

    public InvoiceService(
        ApplicationDbContext context,
        ITransactionService transactionService)
    {
        _context = context;
        _transactionService = transactionService;
    }

    // ============================================
    // CRUD
    // ============================================

    public async Task<int> GetNextNumberAsync(int tenantId, InvoiceType invoiceType)
    {
        var maxNumber = await _context.Invoices
            .IgnoreQueryFilters()
            .Where(i => i.TenantId == tenantId && i.InvoiceType == invoiceType)
            .MaxAsync(i => (int?)i.Number) ?? 0;

        return maxNumber + 1;
    }

    public async Task<Invoice> CreateAsync(Invoice invoice)
    {
        if (invoice.Items.Count == 0)
            throw new InvalidOperationException("فاکتور باید حداقل یک قلم داشته باشد.");

        CalculateTotals(invoice);

        if (invoice.Number == 0)
            invoice.Number = await GetNextNumberAsync(invoice.TenantId, invoice.InvoiceType);

        // 🆕 ثبت تاریخچه
        _context.Invoices.Add(invoice);
        await _context.SaveChangesAsync();

        // 🆕 History: Created
        await AddHistoryAsync(invoice, null, invoice.Status, "ایجاد فاکتور");

        await _context.SaveChangesAsync();

        return invoice;
    }

    public async Task UpdateAsync(Invoice invoice)
    {
        var existing = await _context.Invoices
            .AsNoTracking()
            .FirstOrDefaultAsync(i => i.Id == invoice.Id);

        if (existing != null && existing.Status == InvoiceStatus.Posted)
            throw new InvalidOperationException("فاکتور قطعی قابل ویرایش نیست.");

        CalculateTotals(invoice);
        invoice.UpdatedAt = DateTime.UtcNow;

        _context.Invoices.Update(invoice);
        await _context.SaveChangesAsync();
    }

    public async Task DeleteAsync(int id, int tenantId)
    {
        var entity = await _context.Invoices
            .FirstOrDefaultAsync(i => i.Id == id && i.TenantId == tenantId);

        if (entity == null) return;

        if (entity.Status == InvoiceStatus.Posted)
            throw new InvalidOperationException("فاکتور قطعی قابل حذف نیست.");

        entity.IsDeleted = true;
        entity.DeletedAt = DateTime.UtcNow;
        await _context.SaveChangesAsync();
    }

    // ============================================
    // Post / Unpost
    // ============================================

    public async Task PostAsync(int invoiceId, int tenantId)
    {
        var invoice = await GetInvoiceWithItemsAsync(invoiceId, tenantId);

        // 🆕 پیش‌فاکتور قابل قطعی نیست
        if (invoice.InvoiceType == InvoiceType.PreInvoice)
            throw new InvalidOperationException("پیش‌فاکتور قابل قطعی کردن نیست. ابتدا آن را به فاکتور تبدیل کنید.");

        if (invoice.Status == InvoiceStatus.Posted)
            throw new InvalidOperationException("فاکتور قبلاً قطعی شده است.");

        // ساخت سند حسابداری
        var transaction = await CreateTransactionFromInvoice(invoice, tenantId);

        invoice.TransactionId = transaction.Id;
        invoice.Status = InvoiceStatus.Posted;
        invoice.UpdatedAt = DateTime.UtcNow;

        await AddHistoryAsync(invoice, InvoiceStatus.Draft, InvoiceStatus.Posted, "قطعی شد");

        await _context.SaveChangesAsync();
    }

    public async Task UnpostAsync(int invoiceId, int tenantId)
    {
        var invoice = await GetInvoiceWithItemsAsync(invoiceId, tenantId);

        if (invoice.Status != InvoiceStatus.Posted)
            throw new InvalidOperationException("فاکتور قطعی نیست.");

        // 🆕 حذف سند حسابداری
        if (invoice.TransactionId.HasValue)
        {
            await _transactionService.DeleteAsync(invoice.TransactionId.Value, tenantId);
            invoice.TransactionId = null;
        }

        invoice.Status = InvoiceStatus.Draft;
        invoice.UpdatedAt = DateTime.UtcNow;

        await AddHistoryAsync(invoice, InvoiceStatus.Posted, InvoiceStatus.Draft, "برگشت به پیش‌نویس");

        await _context.SaveChangesAsync();
    }

    // ============================================
    // 🆕 گردش کار پیش‌فاکتور
    // ============================================

    public async Task MarkAsSentAsync(int invoiceId, int tenantId)
    {
        var invoice = await GetInvoiceAsync(invoiceId, tenantId);

        if (invoice.InvoiceType != InvoiceType.PreInvoice)
            throw new InvalidOperationException("فقط پیش‌فاکتور قابل ارسال است.");

        if (invoice.Status != InvoiceStatus.Draft &&
           invoice.Status != InvoiceStatus.Revised &&
           invoice.Status != InvoiceStatus.Postponed)   // 🆕
            throw new InvalidOperationException("فقط پیش‌فاکتور پیش‌نویس، اصلاح‌شده یا به‌تعویق‌افتاده قابل ارسال است.");

        var oldStatus = invoice.Status;

        invoice.Status = InvoiceStatus.Sent;
        invoice.SentDate = DateTime.UtcNow;
        invoice.LastSentDate = DateTime.UtcNow;
        invoice.UpdatedAt = DateTime.UtcNow;

        await AddHistoryAsync(invoice, oldStatus, InvoiceStatus.Sent, "ارسال به مشتری");

        await _context.SaveChangesAsync();
    }

    public async Task MarkAsRevisedAsync(int invoiceId, int tenantId, string? description)
    {
        var invoice = await GetInvoiceAsync(invoiceId, tenantId);

        if (invoice.InvoiceType != InvoiceType.PreInvoice)
            throw new InvalidOperationException("فقط پیش‌فاکتور قابل اصلاح است.");

        if (invoice.Status != InvoiceStatus.Sent &&
            invoice.Status != InvoiceStatus.Rejected &&
            invoice.Status != InvoiceStatus.Postponed)
            throw new InvalidOperationException("وضعیت فعلی اجازه اصلاح نمی‌دهد.");

        var oldStatus = invoice.Status;

        invoice.Status = InvoiceStatus.Revised;
        invoice.RevisionCount++;
        invoice.UpdatedAt = DateTime.UtcNow;

        await AddHistoryAsync(invoice, oldStatus, InvoiceStatus.Revised,
            description ?? "اصلاح پیش‌فاکتور");

        await _context.SaveChangesAsync();
    }

    public async Task MarkAsApprovedAsync(int invoiceId, int tenantId, string? description)
    {
        var invoice = await GetInvoiceAsync(invoiceId, tenantId);

        if (invoice.InvoiceType != InvoiceType.PreInvoice)
            throw new InvalidOperationException("فقط پیش‌فاکتور قابل تایید است.");

        if (invoice.Status != InvoiceStatus.Sent && invoice.Status != InvoiceStatus.Revised)
            throw new InvalidOperationException("وضعیت فعلی اجازه تایید نمی‌دهد.");

        var oldStatus = invoice.Status;

        invoice.Status = InvoiceStatus.Approved;
        invoice.ApprovedDate = DateTime.UtcNow;
        invoice.CustomerResponse = description;
        invoice.UpdatedAt = DateTime.UtcNow;

        await AddHistoryAsync(invoice, oldStatus, InvoiceStatus.Approved,
            description ?? "تایید مشتری");

        await _context.SaveChangesAsync();
    }

    public async Task MarkAsRejectedAsync(int invoiceId, int tenantId, string? reason)
    {
        var invoice = await GetInvoiceAsync(invoiceId, tenantId);

        if (invoice.InvoiceType != InvoiceType.PreInvoice)
            throw new InvalidOperationException("فقط پیش‌فاکتور قابل رد است.");

        if (invoice.Status != InvoiceStatus.Sent && invoice.Status != InvoiceStatus.Revised)
            throw new InvalidOperationException("وضعیت فعلی اجازه رد نمی‌دهد.");

        var oldStatus = invoice.Status;

        invoice.Status = InvoiceStatus.Rejected;
        invoice.RejectedDate = DateTime.UtcNow;
        invoice.CustomerResponse = reason;
        invoice.UpdatedAt = DateTime.UtcNow;

        await AddHistoryAsync(invoice, oldStatus, InvoiceStatus.Rejected,
            reason ?? "رد مشتری");

        await _context.SaveChangesAsync();
    }

    public async Task MarkAsPostponedAsync(int invoiceId, int tenantId, DateTime nextFollowUpDate, string? reason)
    {
        var invoice = await GetInvoiceAsync(invoiceId, tenantId);

        if (invoice.InvoiceType != InvoiceType.PreInvoice)
            throw new InvalidOperationException("فقط پیش‌فاکتور قابل به تعویق است.");

        if (invoice.Status != InvoiceStatus.Sent && invoice.Status != InvoiceStatus.Revised)
            throw new InvalidOperationException("وضعیت فعلی اجازه به تعویق نمی‌دهد.");

        var oldStatus = invoice.Status;

        invoice.Status = InvoiceStatus.Postponed;
        invoice.NextFollowUpDate = nextFollowUpDate;
        invoice.CustomerResponse = reason;
        invoice.UpdatedAt = DateTime.UtcNow;

        await AddHistoryAsync(invoice, oldStatus, InvoiceStatus.Postponed,
            $"به تعویق افتاد تا {nextFollowUpDate:yyyy/MM/dd} - {reason}");

        await _context.SaveChangesAsync();
    }

    public async Task MarkAsCancelledAsync(int invoiceId, int tenantId, string? reason)
    {
        var invoice = await GetInvoiceAsync(invoiceId, tenantId);

        if (invoice.InvoiceType != InvoiceType.PreInvoice)
            throw new InvalidOperationException("فقط پیش‌فاکتور قابل لغو است.");

        if (invoice.Status == InvoiceStatus.Converted)
            throw new InvalidOperationException("پیش‌فاکتور تبدیل شده قابل لغو نیست.");

        var oldStatus = invoice.Status;

        invoice.Status = InvoiceStatus.Cancelled;
        invoice.UpdatedAt = DateTime.UtcNow;

        await AddHistoryAsync(invoice, oldStatus, InvoiceStatus.Cancelled,
            reason ?? "لغو شد");

        await _context.SaveChangesAsync();
    }

    // ============================================
    // 🆕 تبدیل پیش‌فاکتور به فاکتور
    // ============================================

    public async Task<Invoice> ConvertToInvoiceAsync(int preInvoiceId, int tenantId)
    {
        var preInvoice = await GetInvoiceWithItemsAsync(preInvoiceId, tenantId);

        if (preInvoice.InvoiceType != InvoiceType.PreInvoice)
            throw new InvalidOperationException("این فاکتور، پیش‌فاکتور نیست.");

        if (preInvoice.Status == InvoiceStatus.Converted)
            throw new InvalidOperationException("این پیش‌فاکتور قبلاً تبدیل شده است.");

        // 🆕 فقط پیش‌فاکتور Approved قابل تبدیل
        if (preInvoice.Status != InvoiceStatus.Approved)
            throw new InvalidOperationException("فقط پیش‌فاکتور تایید شده قابل تبدیل به فاکتور است. ابتدا آن را تایید کنید.");

        // ساخت فاکتور فروش جدید
        var saleInvoice = new Invoice
        {
            TenantId = tenantId,
            Number = await GetNextNumberAsync(tenantId, InvoiceType.Sale),
            Date = DateTime.UtcNow,
            InvoiceType = InvoiceType.Sale,
            ContactId = preInvoice.ContactId,
            Status = InvoiceStatus.Draft,
            Description = preInvoice.Description,
            ReferenceInvoiceId = preInvoice.Id,
            SubTotal = preInvoice.SubTotal,
            DiscountAmount = preInvoice.DiscountAmount,
            TaxAmount = preInvoice.TaxAmount,
            TotalAmount = preInvoice.TotalAmount,
            Items = preInvoice.Items.Select(i => new InvoiceItem
            {
                TenantId = tenantId,
                ProductId = i.ProductId,
                Description = i.Description,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice,
                DiscountPercent = i.DiscountPercent,
                TaxRate = i.TaxRate,
                LineTotal = i.LineTotal
            }).ToList()
        };

        _context.Invoices.Add(saleInvoice);
        await _context.SaveChangesAsync();

        // 🆕 پیش‌فاکتور → Converted
        var oldStatus = preInvoice.Status;
        preInvoice.Status = InvoiceStatus.Converted;
        preInvoice.UpdatedAt = DateTime.UtcNow;

        await AddHistoryAsync(preInvoice, oldStatus, InvoiceStatus.Converted,
            $"تبدیل به فاکتور فروش شماره {saleInvoice.Number}");

        await _context.SaveChangesAsync();

        return saleInvoice;
    }

    // ============================================
    // 🆕 Helpers
    // ============================================

    private async Task<Invoice> GetInvoiceAsync(int invoiceId, int tenantId)
    {
        var invoice = await _context.Invoices
            .FirstOrDefaultAsync(i => i.Id == invoiceId && i.TenantId == tenantId);

        if (invoice == null)
            throw new InvalidOperationException("فاکتور پیدا نشد.");

        return invoice;
    }

    private async Task<Invoice> GetInvoiceWithItemsAsync(int invoiceId, int tenantId)
    {
        var invoice = await _context.Invoices
            .Include(i => i.Items)
            .FirstOrDefaultAsync(i => i.Id == invoiceId && i.TenantId == tenantId);

        if (invoice == null)
            throw new InvalidOperationException("فاکتور پیدا نشد.");

        return invoice;
    }

    private async Task AddHistoryAsync(Invoice invoice, InvoiceStatus? from, InvoiceStatus to, string? description)
    {
        var history = new InvoiceHistory
        {
            TenantId = invoice.TenantId,
            InvoiceId = invoice.Id,
            FromStatus = from,
            ToStatus = to,
            Description = description,
            Date = DateTime.UtcNow
        };

        _context.InvoiceHistories.Add(history);
    }

    // ============================================
    // Helpers (قبلی)
    // ============================================

    private void CalculateTotals(Invoice invoice)
    {
        decimal subTotal = 0;
        decimal discountTotal = 0;
        decimal taxTotal = 0;

        foreach (var item in invoice.Items)
        {
            var lineBase = item.Quantity * item.UnitPrice;
            item.DiscountAmount = lineBase * (item.DiscountPercent / 100);
            var afterDiscount = lineBase - item.DiscountAmount;
            item.TaxAmount = afterDiscount * (item.TaxRate / 100);
            item.LineTotal = afterDiscount + item.TaxAmount;

            subTotal += lineBase;
            discountTotal += item.DiscountAmount;
            taxTotal += item.TaxAmount;
        }

        invoice.SubTotal = subTotal;
        invoice.DiscountAmount = discountTotal;
        invoice.TaxAmount = taxTotal;
        invoice.TotalAmount = subTotal - discountTotal + taxTotal;
    }

    private async Task<Transaction> CreateTransactionFromInvoice(Invoice invoice, int tenantId)
    {
        // 🆕 پیش‌فاکتور سند نمی‌سازه
        if (invoice.InvoiceType == InvoiceType.PreInvoice)
            throw new InvalidOperationException("پیش‌فاکتور سند حسابداری نمی‌سازد.");

        var lines = new List<TransactionLine>();

        var invoiceTypeName = invoice.InvoiceType switch
        {
            InvoiceType.Sale => "فروش",
            InvoiceType.Purchase => "خرید",
            InvoiceType.PreInvoice => "پیش‌فاکتور",
            _ => "نامشخص"
        };

        if (invoice.InvoiceType == InvoiceType.Sale)
        {
            var receivableAccount = await GetOrCreateAccountAsync(tenantId, "دریافتنی", AccountType.Receivable);
            var salesAccount = await GetOrCreateAccountAsync(tenantId, "درآمد فروش", AccountType.Income);

            lines.Add(new TransactionLine
            {
                TenantId = tenantId,
                AccountId = receivableAccount.Id,
                ContactId = invoice.ContactId,
                Debit = invoice.TotalAmount,
                Credit = 0,
                Description = $"فاکتور {invoiceTypeName} شماره {invoice.Number}"
            });

            lines.Add(new TransactionLine
            {
                TenantId = tenantId,
                AccountId = salesAccount.Id,
                Debit = 0,
                Credit = invoice.TotalAmount,
                Description = $"فاکتور {invoiceTypeName} شماره {invoice.Number}"
            });
        }
        else if (invoice.InvoiceType == InvoiceType.Purchase)
        {
            var purchaseAccount = await GetOrCreateAccountAsync(tenantId, "خرید کالا", AccountType.Expense);
            var payableAccount = await GetOrCreateAccountAsync(tenantId, "پرداختنی", AccountType.Payable);

            lines.Add(new TransactionLine
            {
                TenantId = tenantId,
                AccountId = purchaseAccount.Id,
                Debit = invoice.TotalAmount,
                Credit = 0,
                Description = $"فاکتور {invoiceTypeName} شماره {invoice.Number}"
            });

            lines.Add(new TransactionLine
            {
                TenantId = tenantId,
                AccountId = payableAccount.Id,
                ContactId = invoice.ContactId,
                Debit = 0,
                Credit = invoice.TotalAmount,
                Description = $"فاکتور {invoiceTypeName} شماره {invoice.Number}"
            });
        }

        var transaction = new Transaction
        {
            TenantId = tenantId,
            Date = invoice.Date,
            Description = $"سند خودکار فاکتور {invoiceTypeName} شماره {invoice.Number}",
            Reference = invoice.Number.ToString(),
            IsPosted = true,
            Lines = lines
        };

        var created = await _transactionService.CreateAsync(transaction);

        created.IsPosted = true;
        await _context.SaveChangesAsync();

        return created;
    }

    private async Task<Account> GetOrCreateAccountAsync(int tenantId, string name, AccountType type)
    {
        var account = await _context.Accounts
            .FirstOrDefaultAsync(a => a.TenantId == tenantId && a.Name == name && a.AccountType == type);

        if (account != null) return account;

        var category = await _context.AccountCategories
            .FirstOrDefaultAsync(c => c.TenantId == tenantId && c.DefaultAccountType == type);

        if (category == null)
        {
            category = new AccountCategory
            {
                TenantId = tenantId,
                Name = $"دسته‌بندی {name}",
                DefaultAccountType = type,
                IsActive = true
            };
            _context.AccountCategories.Add(category);
            await _context.SaveChangesAsync();
        }

        account = new Account
        {
            TenantId = tenantId,
            Name = name,
            AccountType = type,
            AccountCategoryId = category.Id,
            IsActive = true
        };

        _context.Accounts.Add(account);
        await _context.SaveChangesAsync();

        return account;
    }
}