@{
    ViewData["Title"] = "طرف حساب‌ها";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-address-book"></i>
            لیست طرف حساب‌ها
        </h3>
        <div class="card-tools">
            <a asp-area="Contacts" asp-controller="Contacts" asp-action="Create"
               class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> طرف حساب جدید
            </a>
        </div>
    </div>
    <div class="card-body">

        <!-- 🆕 جستجو -->
        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                    <input type="text" id="txtSearch"
                           class="form-control"
                           placeholder="جستجو در نام، کد، موبایل، تلفن، کد ملی..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <!-- 🆕 AG Grid -->
        <div id="contactsGrid" class="ag-theme-alpine"
             style="height: 600px; width: 100%;">
        </div>

    </div>
</div>
@Html.AntiForgeryToken()
@section Scripts {
    <script>
        // ============================================
        // 🆕 متغیر global برای Grid API
        // ============================================
        let contactsGridApi = null;

        $(document).ready(function () {

            // ============================================
            // ۱. تعریف ستون‌ها
            // ============================================
            const columnDefs = [
                AgGridHelper.rowNumberColumn(),
                {
                    field: 'name',
                    headerName: 'نام',
                    flex: 2,
                    minWidth: 200
                },
                {
                    field: 'code',
                    headerName: 'کد',
                    width: 100
                },
                {
                    field: 'contactTypeName',
                    headerName: 'نوع',
                    width: 130,
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const span = document.createElement('span');
                        if (params.data.contactType === 1) span.className = 'badge badge-info';
                        else if (params.data.contactType === 2) span.className = 'badge badge-warning';
                        else span.className = 'badge badge-success';
                        span.textContent = params.value;
                        return span;
                    }
                },
                {
                    field: 'mobile',
                    headerName: 'موبایل',
                    width: 140
                },
                {
                    field: 'phone',
                    headerName: 'تلفن',
                    width: 130
                },
                AgGridHelper.moneyColumn('currentBalance', 'مانده', 130),
                AgGridHelper.statusColumn('isActive'),
                {
                    headerName: 'عملیات',
                    colId: 'actions',
                    width: 185,
                    sortable: false,
                    filter: false,
                    pinned: 'left',
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const div = document.createElement('div');
                        div.className = 'action-buttons';
                        const d = params.data;

                        // ✏ ویرایش
                        const editBtn = document.createElement('a');
                        editBtn.href = `/Contacts/Contacts/Edit/${d.id}`;
                        editBtn.className = 'btn btn-sm btn-outline-primary action-icon-btn';
                        editBtn.title = 'ویرایش';
                        editBtn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
                        div.appendChild(editBtn);

                        if (d.contactType === 1 || d.contactType === 3) {
                            const portalBtn = document.createElement('a');
                            portalBtn.href = `/Contacts/CustomerPortalLinks?contactId=${encodeURIComponent(d.id)}`;
                            portalBtn.className = 'btn btn-sm btn-outline-info action-icon-btn';
                            portalBtn.title = 'لینک پرتال مشتری';
                            portalBtn.innerHTML = '<i class="fa-solid fa-link"></i>';
                            div.appendChild(portalBtn);
                        }

                        // 🗑 حذف
                        const deleteBtn = document.createElement('a');
                        deleteBtn.href = 'javascript:void(0)';
                        deleteBtn.className = 'btn btn-sm btn-outline-danger action-icon-btn delete-btn';
                        deleteBtn.dataset.id = d.id;
                        deleteBtn.dataset.title = d.name || '';
                        deleteBtn.dataset.code = d.code || '';
                        deleteBtn.dataset.mobile = d.mobile || '';
                        deleteBtn.title = 'حذف';
                        deleteBtn.innerHTML = '<i class="fa-solid fa-trash"></i>';
                        div.appendChild(deleteBtn);

                        return div;
                    }
                }
            ];

            // ============================================
            // ۲. ساخت Grid
            // ============================================
            contactsGridApi = AgGridHelper.create(
                'contactsGrid',
                columnDefs,
                '/Contacts/Contacts/GetData',
                'txtSearch',
                'lblCount'
            );

        });

        // ============================================
        // ۳. رویداد حذف
        // ============================================
        $(document).on('click', '.delete-btn', function () {
            const $btn = $(this);
            const id = $btn.data('id');
            const title = $btn.data('title');
            const code = $btn.data('code');
            const mobile = $btn.data('mobile');

            // 🆕 ساخت items
            const items = [];
            if (title) items.push({ label: 'نام', value: title });
            if (code) items.push({ label: 'کد', value: code });
            if (mobile) items.push({ label: 'موبایل', value: mobile });

            // 🆕 نمایش Modal
            ModalHelper.confirmDelete({
                url: '/Contacts/Contacts/Delete',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                title: 'حذف طرف حساب: ' + title,
                message: 'آیا از حذف این طرف حساب مطمئن هستید؟ این عملیات قابل بازگشت نیست.',
                items: items,
                onSuccess: function () {
                    // 🆕 رفرش Grid
                    if (contactsGridApi) {
                        const ds = contactsGridApi.getGridOption('datasource');
                        contactsGridApi.setGridOption('datasource', ds);
                    } else {
                        location.reload();
                    }
                }
            });
        });
    </script>
}
