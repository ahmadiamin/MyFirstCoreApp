@model MyFirstCoreApp.Application.Projects.ProjectDetailsDto
@using MyFirstCoreApp.Application.Common.Utilities
@using MyFirstCoreApp.Domain.Enums
@using System.Text.Json

@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "جزئیات پروژه";

    string GetProjectStatusName(ProjectStatus status) => status switch
    {
        ProjectStatus.Draft => "پیش‌نویس",
        ProjectStatus.Active => "در حال اجرا",
        ProjectStatus.OnHold => "متوقف",
        ProjectStatus.Completed => "تکمیل‌شده",
        ProjectStatus.Cancelled => "لغوشده",
        _ => "نامشخص"
    };

    string GetInvoiceStatusName(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Draft => "پیش‌نویس",
        InvoiceStatus.Sent => "ارسال‌شده",
        InvoiceStatus.Revised => "اصلاح‌شده",
        InvoiceStatus.Approved => "تأییدشده",
        InvoiceStatus.Rejected => "ردشده",
        InvoiceStatus.Postponed => "به‌تعویق‌افتاده",
        InvoiceStatus.Converted => "تبدیل‌شده",
        InvoiceStatus.Cancelled => "لغوشده",
        InvoiceStatus.Posted => "قطعی",
        _ => "نامشخص"
    };

    var projectStatusHistoryJson = JsonSerializer.Serialize(Model.StatusHistories, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });

    var canEditProject = (await AuthorizationService.AuthorizeAsync(User, null, "Project.Edit")).Succeeded;
    var canChangeProjectStatus = (await AuthorizationService.AuthorizeAsync(User, null, "Project.Status.Change")).Succeeded;
    var canManageMembers = (await AuthorizationService.AuthorizeAsync(User, null, "ProjectMember.Manage")).Succeeded;
    var canManageStages = (await AuthorizationService.AuthorizeAsync(User, null, "ProjectStage.Manage")).Succeeded;
    var canChangeStageStatus = (await AuthorizationService.AuthorizeAsync(User, null, "ProjectStage.Status.Change")).Succeeded;
    var canReportStage = (await AuthorizationService.AuthorizeAsync(User, null, "ProjectStage.Report")).Succeeded;
    var canViewInvoices = (await AuthorizationService.AuthorizeAsync(User, null, "Invoice.View")).Succeeded;
    var canViewProjectExpenses = (await AuthorizationService.AuthorizeAsync(User, null, "ProjectExpense.View")).Succeeded;
    var canViewProjectMaterials = (await AuthorizationService.AuthorizeAsync(User, null, "StockMovement.View")).Succeeded;

    var membersJson = JsonSerializer.Serialize(Model.Members, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });

    var stagesJson = JsonSerializer.Serialize(Model.Stages, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <h3 class="card-title mb-2 mb-md-0">
            <i class="fa fa-folder-open"></i>
            جزئیات پروژه: @Model.Title
        </h3>

        <div class="card-tools d-flex flex-wrap">
            @if (canEditProject)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm ml-1 mb-1">
                    <i class="fa fa-edit"></i> ویرایش
                </a>
            }
            @if ((await AuthorizationService.AuthorizeAsync(User, null, "ProjectExpense.View")).Succeeded)
            {
                <a asp-area="Accounting" asp-controller="Expenses" asp-action="Index" asp-route-projectId="@Model.Id" class="btn btn-info btn-sm ml-1 mb-1"><i class="fa fa-money-bill-wave"></i> هزینه‌های پروژه</a>
            }
            @if ((await AuthorizationService.AuthorizeAsync(User, null, "StockMovement.View")).Succeeded)
            {
                <a asp-area="Projects" asp-controller="ProjectMaterials" asp-action="Index" asp-route-projectId="@Model.Id" class="btn btn-success btn-sm ml-1 mb-1"><i class="fa fa-box-open"></i> مصرف اقلام پروژه</a>
            }
            @if (canChangeProjectStatus)
            {
                <a asp-controller="ProjectManagement" asp-action="ChangeProjectStatus"
                   asp-route-projectId="@Model.Id" class="btn btn-warning btn-sm ml-1 mb-1">
                    <i class="fa fa-exchange-alt"></i> تغییر وضعیت پروژه
                </a>
            }
            <a asp-action="Index" class="btn btn-secondary btn-sm mb-1">
                <i class="fa fa-list"></i> بازگشت به فهرست
            </a>
        </div>
    </div>

    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert" aria-label="بستن"><span aria-hidden="true">&times;</span></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="close" data-dismiss="alert" aria-label="بستن"><span aria-hidden="true">&times;</span></button>
            </div>
        }

        <div class="row">
            <div class="col-md-6 mb-3"><strong>عنوان پروژه:</strong> @Model.Title</div>
            <div class="col-md-6 mb-3"><strong>کد پروژه:</strong> <span dir="ltr">@(Model.Code ?? "-")</span></div>
            <div class="col-md-6 mb-3"><strong>طرف حساب:</strong> @(Model.ContactName ?? "-")</div>
            <div class="col-md-6 mb-3"><strong>مدیر پروژه:</strong> @(Model.ProjectManagerName ?? "-")</div>
            <div class="col-md-6 mb-3">
                <strong>وضعیت:</strong>
                <span class="badge badge-info">@GetProjectStatusName(Model.Status)</span>
            </div>
            <div class="col-md-6 mb-3"><strong>تاریخ شروع:</strong> @(PersianDate.Format(Model.StartDate) ?? "-")</div>
            <div class="col-md-6 mb-3"><strong>پایان برنامه‌ریزی‌شده:</strong> @(PersianDate.Format(Model.PlannedEndDate) ?? "-")</div>
            <div class="col-md-6 mb-3"><strong>تاریخ پایان واقعی:</strong> @(PersianDate.Format(Model.ActualEndDate) ?? "-")</div>
            <div class="col-md-12 mb-3"><strong>آدرس:</strong><p class="mb-0">@(Model.Address ?? "-")</p></div>
            <div class="col-md-12 mb-3"><strong>توضیحات:</strong><p class="mb-0">@(Model.Description ?? "-")</p></div>

            @if (canViewProjectExpenses)
            {
                <div class="col-md-4 mb-3">
                    <div class="detail-mobile-card h-100">
                        <strong>جمع هزینه‌های ثبت‌شده</strong>
                        <div class="h4 mt-2 mb-0"><span class="persian-number-comma">@Model.TotalExpenses.ToString("N0")</span> ریال</div>
                        <small class="text-muted">بر اساس هزینه‌های قطعی ثبت‌شده برای این پروژه</small>
                    </div>
                </div>
            }

            @if (canViewProjectMaterials)
            {
                <div class="col-12 mb-3">
                    <div class="detail-mobile-card">
                        <div class="d-flex justify-content-between align-items-center flex-wrap mb-2">
                            <strong><i class="fa fa-box-open"></i> خلاصه مصرف اقلام پروژه</strong>
                            <a asp-area="Projects" asp-controller="ProjectMaterials" asp-action="Index" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-success">مشاهده اسناد مصرف</a>
                        </div>
                        @if (Model.MaterialConsumptions.Count == 0)
                        {
                            <div class="text-muted">هنوز مصرف قطعی ثبت نشده است.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered mb-0">
                                    <thead><tr><th>قلم مصرفی</th><th>کد</th><th>جمع مقدار مصرف‌شده</th></tr></thead>
                                    <tbody>
                                    @foreach (var item in Model.MaterialConsumptions)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>
                                            <td dir="ltr">@(item.ProductCode ?? "—")</td>
                                            <td>@PersianDate.ToPersianDigits(item.TotalQuantity.ToString("0.###")) @item.UnitSymbol</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            <small class="text-muted d-block mt-2">فقط حواله‌های قطعی در این جمع هستند؛ حواله‌های برگشت‌خورده محاسبه نشده‌اند.</small>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.HoldReason))
            {
                <div class="col-md-12 mb-3"><strong>علت توقف:</strong><p class="mb-0">@Model.HoldReason</p></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
            {
                <div class="col-md-12 mb-3"><strong>علت لغو:</strong><p class="mb-0">@Model.CancellationReason</p></div>
            }
        </div>

        <hr />

        @if (canViewInvoices)
        {
            <section class="mb-4">
                <h5 class="mb-3"><i class="fa fa-file-invoice-dollar"></i> اسناد مالی پروژه</h5>
                @if (Model.Invoices.Count == 0)
                {
                    <div class="text-muted">هنوز فاکتوری به این پروژه تخصیص داده نشده است.</div>
                }
                else
                {
                    <div class="row">
                        @foreach (var invoice in Model.Invoices)
                        {
                            var invoiceTypeName = invoice.InvoiceType switch
                            {
                                InvoiceType.PreInvoice => "پیش‌فاکتور",
                                InvoiceType.Sale => "فروش",
                                InvoiceType.Purchase => "خرید",
                                InvoiceType.SalesReturn => "برگشت از فروش",
                                InvoiceType.PurchaseReturn => "برگشت از خرید",
                                _ => "فاکتور"
                            };
                            <div class="col-md-6 col-lg-4 mb-2">
                                <div class="detail-mobile-card h-100">
                                    <div class="d-flex justify-content-between">
                                        <strong>@invoiceTypeName شماره @invoice.Number</strong>
                                        <span class="badge badge-info">@GetInvoiceStatusName(invoice.Status)</span>
                                    </div>
                                    <div class="detail-line">تاریخ: @PersianDate.Format(invoice.Date)</div>
                                    <div class="detail-line">مبلغ تخصیص‌یافته: <span class="persian-number-comma">@invoice.AllocatedAmount.ToString("N0")</span> ریال</div>
                                    @if (invoice.ProjectLineCount > 0)
                                    {
                                        <div class="detail-line">ردیف‌های اختصاص‌یافته: @invoice.ProjectLineCount</div>
                                    }
                                    <a asp-area="Invoicing" asp-controller="Invoices" asp-action="Details"
                                       asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-primary mt-2">
                                        مشاهده فاکتور
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
            <hr />
        }

        <section class="mb-4">
            <h5 class="mb-3"><i class="fa fa-clock-rotate-left"></i> تاریخچه وضعیت پروژه</h5>
            <div id="projectStatusHistory"></div>
        </section>

        <hr />

        <section class="mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                <h5 class="mb-2 mb-md-0"><i class="fa fa-users"></i> اعضای پروژه</h5>
                @if (canManageMembers)
                {
                    <a asp-controller="ProjectManagement" asp-action="AddMember"
                       asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">
                        <i class="fa fa-user-plus"></i> افزودن عضو
                    </a>
                }
            </div>
            <div id="memberCount" class="text-muted small mb-2"></div>
            <div id="membersGrid" class="ag-theme-alpine d-none d-md-block" style="width:100%;height:320px;"></div>
            <div id="mobileMembers" class="d-md-none"></div>
        </section>

        <hr />

        <section>
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                <h5 class="mb-2 mb-md-0"><i class="fa fa-list-check"></i> مراحل پروژه</h5>
                @if (canManageStages)
                {
                    <a asp-controller="ProjectManagement" asp-action="CreateStage"
                       asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">
                        <i class="fa fa-plus"></i> افزودن مرحله
                    </a>
                }
            </div>
            <div id="stageCount" class="text-muted small mb-2"></div>
            <div id="stagesGrid" class="ag-theme-alpine d-none d-md-block" style="width:100%;height:420px;"></div>
            <div id="mobileStages" class="d-md-none"></div>
        </section>
    </div>
</div>

@Html.AntiForgeryToken()

<style>
    .detail-mobile-card {
        border: 1px solid #e3e6ea;
        border-radius: 7px;
        background: #fff;
        margin-bottom: 10px;
        padding: 12px;
        overflow-wrap: anywhere;
    }

        .detail-mobile-card .detail-line {
            color: #626b73;
            font-size: 12px;
            margin-top: 6px;
        }

        .detail-mobile-card .detail-card-title {
            font-weight: 600;
            color: #343a40;
        }

    .stage-history {
        border-top: 1px solid #eee;
        margin-top: 10px;
        padding-top: 8px;
    }

    .stage-history-item {
        background: #f8f9fa;
        border-radius: 5px;
        padding: 8px;
        margin-top: 6px;
        font-size: 12px;
    }

    .detail-actions .btn, .detail-mobile-card .btn {
        margin: 2px;
    }
</style>

@section Scripts {
    <script>
        $(function () {
            const projectId = @Model.Id;
            const memberRows = @Html.Raw(membersJson);
            const stageRows = @Html.Raw(stagesJson);
            const projectStatusHistory = @Html.Raw(projectStatusHistoryJson);

            const permissions = {
                manageMembers: @(canManageMembers ? "true" : "false"),
                manageStages: @(canManageStages ? "true" : "false"),
                changeStageStatus: @(canChangeStageStatus ? "true" : "false"),
                reportStage: @(canReportStage ? "true" : "false")
            };

            const token = $('input[name="__RequestVerificationToken"]').val();

            const projectManagementBase = '/Projects/ProjectManagement';

            function esc(value) {
                return String(value ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function persianNumber(value) {
                if (window.AgGridHelper && typeof AgGridHelper.toPersianNumber === 'function') {
                    return AgGridHelper.toPersianNumber(value);
                }
                return String(value ?? '').replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[Number(d)]);
            }

            function formatDate(value) {
                if (!value) return '-';
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return '-';
                return new Intl.DateTimeFormat('fa-IR', {
                    year: 'numeric', month: '2-digit', day: '2-digit',
                    calendar: 'persian'
                }).format(date);
            }

            function projectStageStatusName(status) {
                return ({
                    1: 'شروع‌نشده',
                    2: 'در حال انجام',
                    3: 'در انتظار',
                    4: 'تکمیل‌شده',
                    5: 'رد شده',
                    6: 'لغوشده'
                })[status] || 'نامشخص';
            }

            function projectStatusName(status) {
                return ({
                    1: 'پیش‌نویس',
                    2: 'در حال اجرا',
                    3: 'متوقف',
                    4: 'تکمیل‌شده',
                    5: 'لغوشده'
                })[status] || 'نامشخص';
            }

            function renderProjectStatusHistory() {
                const host = $('#projectStatusHistory');
                if (!projectStatusHistory.length) {
                    host.html('<div class="text-muted">هنوز تغییری برای وضعیت پروژه ثبت نشده است.</div>');
                    return;
                }

                host.html(projectStatusHistory.map(item => {
                    const changedAt = new Date(item.changedAt);
                    const time = Number.isNaN(changedAt.getTime()) ? '-' :
                        new Intl.DateTimeFormat('fa-IR', { hour: '2-digit', minute: '2-digit' }).format(changedAt);
                    const from = item.previousStatus == null ? '—' : projectStatusName(item.previousStatus);
                    return `<div class="detail-mobile-card">
                        <div class="detail-card-title">${esc(from)} ← ${esc(projectStatusName(item.newStatus))}</div>
                        <div class="detail-line">تاریخ: ${esc(formatDate(item.changedAt))}، ساعت ${esc(time)}</div>
                        <div class="detail-line">ثبت‌کننده: ${esc(item.changedByUserName || '-')}</div>
                        ${item.description ? `<div class="detail-line">توضیحات: ${esc(item.description)}</div>` : ''}
                    </div>`;
                }).join(''));
            }

            function projectStageStatusClass(status) {
                return ({
                    1: 'secondary',
                    2: 'primary',
                    3: 'warning',
                    4: 'success',
                    5: 'info',
                    6: 'danger'
                })[status] || 'secondary';
            }

            function statusBadge(status) {
                return `<span class="badge badge-${projectStageStatusClass(status)}">${projectStageStatusName(status)}</span>`;
            }

            function postForm(action, fields, confirmMessage) {

                function submitForm() {
                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = action;
                    form.style.display = 'none';

                    const allFields = {
                        ...fields,
                        __RequestVerificationToken: token
                    };

                    Object.keys(allFields).forEach(key => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = key;
                        input.value = allFields[key] ?? '';
                        form.appendChild(input);
                    });

                    document.body.appendChild(form);
                    form.submit();
                }

                if (confirmMessage) {
                    ModalHelper.confirm(
                        confirmMessage,
                        submitForm,
                        {
                            title: 'تأیید حذف',
                            icon: 'fa-solid fa-trash',
                            headerClass: 'bg-danger text-white'
                        }
                    );
                } else {
                    submitForm();
                }
            }
            function memberActions(member) {
                if (!permissions.manageMembers) return '';
                return `<a class="btn btn-sm btn-outline-primary"
                            href="${projectManagementBase}/EditMember?memberId=${Number(member.id)}&projectId=${projectId}"
                            title="ویرایش عضو"><i class="fa fa-edit"></i></a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                            onclick="removeProjectMember(${Number(member.id)})" title="حذف عضو">
                            <i class="fa fa-trash"></i>
                        </button>`;
            }

            window.removeProjectMember = function (memberId) {
                postForm(projectManagementBase + '/RemoveMember',
                    { memberId: memberId, projectId: projectId },
                    'عضو از پروژه حذف شود؟');
            };

            function renderMembersMobile() {
                const host = $('#mobileMembers');
                if (!memberRows.length) {
                    host.html('<div class="text-center text-muted py-3">هنوز عضوی برای این پروژه ثبت نشده است.</div>');
                    return;
                }

                host.html(memberRows.map((member, index) => `
                    <div class="detail-mobile-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="detail-card-title">
                                <span class="badge badge-secondary">${persianNumber(index + 1)}</span>
                                ${esc(member.userName)}
                            </div>
                            <div>${memberActions(member)}</div>
                        </div>
                        <div class="detail-line">عنوان شغلی: ${esc(member.jobTitle || '-')}</div>
                        <div class="detail-line">نقش در پروژه: ${esc(member.roleTitle || '-')}</div>
                        <div class="detail-line">توضیحات: ${esc(member.notes || '-')}</div>
                    </div>`).join(''));
            }

            function buildMembersGrid() {
                const columns = [
                    { headerName: '#', width: 70, sortable: false,
                      valueGetter: p => persianNumber(p.node.rowIndex + 1) },
                    { field: 'userName', headerName: 'نام عضو', minWidth: 150, flex: 1 },
                    { field: 'jobTitle', headerName: 'عنوان شغلی', minWidth: 130, flex: 1,
                      valueFormatter: p => p.value || '-' },
                    { field: 'roleTitle', headerName: 'نقش در پروژه', minWidth: 130, flex: 1,
                      valueFormatter: p => p.value || '-' },
                    { field: 'notes', headerName: 'توضیحات', minWidth: 180, flex: 2,
                      valueFormatter: p => p.value || '-' }
                ];

                if (permissions.manageMembers) {
                    columns.push({
                        headerName: 'عملیات', width: 90, sortable: false, filter: false,
                        cellRenderer: p => memberActions(p.data)
                    });
                }

                agGrid.createGrid(document.getElementById('membersGrid'), {
                    columnDefs: columns,
                    rowData: memberRows,
                    enableRtl: true,
                    rowHeight: 45,
                    headerHeight: 45,
                    defaultColDef: {
                        sortable: true, resizable: true,
                        cellStyle: { textAlign: 'right', direction: 'rtl' }
                    },
                    pagination: true,
                    paginationPageSize: 10,
                    paginationPageSizeSelector: [5, 10, 20],
                    localeText: {
                        page: 'صفحه', to: 'تا', of: 'از',
                        next: 'بعدی', last: 'آخر', first: 'اول', previous: 'قبلی',
                        noRowsToShow: 'عضوی برای نمایش وجود ندارد',
                        pageSizeSelectorLabel: 'تعداد در صفحه:'
                    }
                });
            }

            function stageActions(stage) {
                let html = '';
                if (permissions.reportStage) {
                    html += `<a class="btn btn-sm btn-outline-success"
                        href="${projectManagementBase}/CreateStageReport?stageId=${stage.id}&projectId=${projectId}"
                        title="ثبت گزارش اجرا"><i class="fa fa-clipboard-check"></i></a>`;
                }
                if (permissions.changeStageStatus) {
                    html += `<a class="btn btn-sm btn-outline-warning"
                        href="${projectManagementBase}/ChangeStageStatus?id=${stage.id}&projectId=${projectId}"
                        title="تغییر وضعیت"><i class="fa fa-exchange-alt"></i></a>`;
                }
                if (permissions.manageStages) {
                    html += `<a class="btn btn-sm btn-outline-primary"
                        href="${projectManagementBase}/EditStage?id=${stage.id}&projectId=${projectId}"
                        title="ویرایش"><i class="fa fa-edit"></i></a>`;
                    html += `<button type="button" class="btn btn-sm btn-outline-danger"
                        onclick="deleteProjectStage(${Number(stage.id)})" title="حذف">
                        <i class="fa fa-trash"></i></button>`;
                }
                return html;
            }

            window.deleteProjectStage = function (stageId) {
                postForm(projectManagementBase + '/DeleteStage',
                    { id: stageId, projectId: projectId },
                    'این مرحله حذف شود؟');
            };

            function renderHistory(stage) {
                const histories = stage.histories || [];
                if (!histories.length) return '<div class="text-muted small mt-2">تاریخچه‌ای ثبت نشده است.</div>';

                return `<div class="stage-history">
                    <details>
                        <summary class="text-primary" style="cursor:pointer">مشاهده تاریخچه (${persianNumber(histories.length)})</summary>
                        ${histories.map(item => `
                            <div class="stage-history-item">
                                <div><strong>وضعیت:</strong>
                                    ${item.previousStatus ? projectStageStatusName(item.previousStatus) + ' ← ' : ''}
                                    ${projectStageStatusName(item.newStatus)}
                                </div>
                                <div><strong>تاریخ:</strong> ${esc(formatDate(item.changedAt))}</div>
                                <div><strong>توضیحات:</strong> ${esc(item.description || '-')}</div>
                            </div>`).join('')}
                    </details>
                </div>`;
            }

            function renderReports(stage) {
                const reports = stage.reports || [];
                if (!reports.length) return '<div class="text-muted small mt-2">گزارش اجرایی ثبت نشده است.</div>';
                return `<div class="stage-history mt-2">
                    <details>
                        <summary class="text-success" style="cursor:pointer">گزارش‌های اجرا (${persianNumber(reports.length)})</summary>
                        ${reports.map(report => `
                            <div class="stage-history-item">
                                <div><strong>تاریخ:</strong> ${esc(formatDate(report.reportDate))} — <strong>پیشرفت:</strong> ${persianNumber(report.progressPercent)}٪</div>
                                <div><strong>گزارش:</strong> ${esc(report.workSummary || '-')}</div>
                                ${report.reportedByUserName ? `<div><strong>ثبت‌کننده:</strong> ${esc(report.reportedByUserName)}</div>` : ''}
                                ${report.isStopped ? `<div class="text-danger"><strong>توقف:</strong> ${esc(report.stopReason || '-')}</div>` : ''}
                                ${report.nextFollowUpDate ? `<div><strong>پیگیری بعدی:</strong> ${esc(formatDate(report.nextFollowUpDate))}</div>` : ''}
                            </div>`).join('')}
                    </details>
                </div>`;
            }

            function renderStagesMobile() {
                const host = $('#mobileStages');
                if (!stageRows.length) {
                    host.html('<div class="text-center text-muted py-3">هنوز مرحله‌ای برای این پروژه تعریف نشده است.</div>');
                    return;
                }

                host.html(stageRows.slice().sort((a, b) => a.sortOrder - b.sortOrder).map(stage => `
                    <div class="detail-mobile-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="detail-card-title">
                                <span class="badge badge-secondary">${persianNumber(stage.sortOrder)}</span>
                                ${esc(stage.title)}
                            </div>
                            <div class="detail-actions">${stageActions(stage)}</div>
                        </div>
                        <div class="detail-line">مسئول: ${esc(stage.assignedUserName || '-')}</div>
                        <div class="detail-line">وضعیت: ${statusBadge(stage.status)}</div>
                        <div class="detail-line">پیشرفت: ${persianNumber(stage.reports && stage.reports.length ? stage.reports[0].progressPercent : 0)}٪</div>
                        <div class="detail-line">شروع برنامه‌ریزی‌شده: ${esc(formatDate(stage.plannedStartDate))}</div>
                        <div class="detail-line">پایان برنامه‌ریزی‌شده: ${esc(formatDate(stage.plannedEndDate))}</div>
                        <div class="detail-line">مرحله الزامی: ${stage.isRequired ? 'بله' : 'خیر'}</div>
                        ${stage.waitingReason ? `<div class="detail-line">علت انتظار: ${esc(stage.waitingReason)}</div>` : ''}
                        ${stage.nextFollowUpDate ? `<div class="detail-line">تاریخ پیگیری: ${esc(formatDate(stage.nextFollowUpDate))}</div>` : ''}
                        ${stage.notes ? `<div class="detail-line">یادداشت: ${esc(stage.notes)}</div>` : ''}
                        ${renderReports(stage)}
                        ${renderHistory(stage)}
                    </div>`).join(''));
            }

            function buildStagesGrid() {
                const columns = [
                    { headerName: 'ترتیب', field: 'sortOrder', width: 90,
                      valueFormatter: p => persianNumber(p.value) },
                    { field: 'title', headerName: 'عنوان مرحله', minWidth: 170, flex: 1 },
                    { field: 'assignedUserName', headerName: 'مسئول', minWidth: 130, flex: 1,
                      valueFormatter: p => p.value || '-' },
                    { field: 'status', headerName: 'وضعیت', width: 125,
                      cellRenderer: p => statusBadge(p.value) },
                    { headerName: 'پیشرفت', width: 100, sortable: false,
                      valueGetter: p => (p.data.reports && p.data.reports.length ? p.data.reports[0].progressPercent : 0),
                      valueFormatter: p => persianNumber(p.value) + '٪' },
                    { field: 'plannedStartDate', headerName: 'شروع برنامه‌ریزی‌شده', width: 155,
                      valueFormatter: p => formatDate(p.value) },
                    { field: 'plannedEndDate', headerName: 'پایان برنامه‌ریزی‌شده', width: 155,
                      valueFormatter: p => formatDate(p.value) },
                    { field: 'isRequired', headerName: 'الزامی', width: 90,
                      valueFormatter: p => p.value ? 'بله' : 'خیر' },
                    { field: 'waitingReason', headerName: 'علت انتظار', minWidth: 150, flex: 1,
                      valueFormatter: p => p.value || '-' },
                    { field: 'nextFollowUpDate', headerName: 'تاریخ پیگیری', width: 130,
                      valueFormatter: p => formatDate(p.value) },
                    { headerName: 'گزارش اجرا', width: 120, sortable: false,
                      cellRenderer: p => {
                          const count = (p.data.reports || []).length;
                          if (!count) return '-';
                          return `<button type="button" class="btn btn-xs btn-outline-success"
                              onclick="showStageReports(${Number(p.data.id)})">گزارش‌ها (${persianNumber(count)})</button>`;
                      }},
                    { headerName: 'تاریخچه', width: 115, sortable: false,
                      cellRenderer: p => {
                          const count = (p.data.histories || []).length;
                          if (!count) return '-';
                          return `<button type="button" class="btn btn-xs btn-outline-info"
                              onclick="showStageHistory(${Number(p.data.id)})">
                              تاریخچه (${persianNumber(count)})</button>`;
                      }}
                ];

                if (permissions.manageStages || permissions.changeStageStatus || permissions.reportStage) {
                    columns.push({
                        headerName: 'عملیات', width: 185, sortable: false, filter: false,
                        cellRenderer: p => stageActions(p.data)
                    });
                }

                agGrid.createGrid(document.getElementById('stagesGrid'), {
                    columnDefs: columns,
                    rowData: stageRows.slice().sort((a, b) => a.sortOrder - b.sortOrder),
                    enableRtl: true,
                    rowHeight: 48,
                    headerHeight: 48,
                    defaultColDef: {
                        sortable: true, resizable: true,
                        cellStyle: { textAlign: 'right', direction: 'rtl' }
                    },
                    pagination: true,
                    paginationPageSize: 10,
                    paginationPageSizeSelector: [5, 10, 20],
                    localeText: {
                        page: 'صفحه', to: 'تا', of: 'از',
                        next: 'بعدی', last: 'آخر', first: 'اول', previous: 'قبلی',
                        noRowsToShow: 'مرحله‌ای برای نمایش وجود ندارد',
                        pageSizeSelectorLabel: 'تعداد در صفحه:'
                    }
                });
            }

            window.showStageHistory = function (stageId) {
                const stage = stageRows.find(x => Number(x.id) === Number(stageId));
                if (!stage) return;

                const historyHtml = renderHistory(stage);
                const wrapper = document.createElement('div');
                wrapper.innerHTML = historyHtml;
                const details = wrapper.querySelector('details');
                if (details) details.open = true;

                const content = details ? details.parentElement.innerHTML : '<div>تاریخچه‌ای ثبت نشده است.</div>';

                if (window.Swal) {
                    Swal.fire({
                        title: 'تاریخچه مرحله',
                        html: content,
                        confirmButtonText: 'بستن',
                        width: 650
                    });
                } else {
                    window.alert((stage.histories || []).map(h =>
                        `${projectStageStatusName(h.newStatus)} - ${h.description || ''}`
                    ).join('\n') || 'تاریخچه‌ای ثبت نشده است.');
                }
            };

            window.showStageReports = function (stageId) {
                const stage = stageRows.find(x => Number(x.id) === Number(stageId));
                if (!stage) return;
                const wrapper = document.createElement('div');
                wrapper.innerHTML = renderReports(stage);
                const details = wrapper.querySelector('details');
                if (details) details.open = true;
                const content = details ? details.parentElement.innerHTML : '<div>گزارشی ثبت نشده است.</div>';
                if (window.Swal) {
                    Swal.fire({ title: 'گزارش‌های اجرای مرحله', html: content, confirmButtonText: 'بستن', width: 700 });
                } else {
                    window.alert((stage.reports || []).map(r => `${r.progressPercent}% - ${r.workSummary}`).join('\n') || 'گزارشی ثبت نشده است.');
                }
            };

            $('#memberCount').text('تعداد اعضا: ' + persianNumber(memberRows.length));
            $('#stageCount').text('تعداد مراحل: ' + persianNumber(stageRows.length));

            renderProjectStatusHistory();
            renderMembersMobile();
            renderStagesMobile();

            if (window.matchMedia('(min-width: 768px)').matches) {
                buildMembersGrid();
                buildStagesGrid();
            }
        });
    </script>
}
