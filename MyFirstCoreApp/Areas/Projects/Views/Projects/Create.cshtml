@model MyFirstCoreApp.Areas.Projects.ViewModels.Project.ProjectFormViewModel

@{
    ViewData["Title"] = "ایجاد پروژه";
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-plus"></i>
            ایجاد پروژه جدید
        </h3>
    </div>

    <form asp-area="Projects" asp-controller="Projects"
          asp-action="Create" method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <partial name="_Form" model="Model" />
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save"></i> ذخیره
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa fa-arrow-right"></i> انصراف
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            $('.select2').select2({
                width: '100%',
                dir: 'rtl',
                language: 'fa',
                placeholder: 'انتخاب کنید',
                allowClear: true
            });
        });
        $('.datepicker').persianDatepicker({
            format: 'YYYY/MM/DD',
            initialValue: true,
            initialValueType: 'persian',
            autoClose: true,
            observer: true,
            calendar: {
                persian: {
                    locale: 'fa',
                    showHint: true,
                    leapYearMode: 'algorithmic'
                }
            },
            toolbox: {
                calendarSwitch: {
                    enabled: false
                }
            }
        });
    </script>
}