@model MyFirstCoreApp.Areas.Projects.ViewModels.Project.ProjectStageStatusFormViewModel

@using MyFirstCoreApp.Domain.Enums

@{
    ViewData["Title"] = "تغییر وضعیت مرحله";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">تغییر وضعیت مرحله</h3>
    </div>

    <form asp-action="ChangeStageStatus" method="post">
        <div class="card-body">
            <input asp-for="ProjectId" type="hidden" />
            <input asp-for="ProjectStageId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="NewStatus"></label>
                <select asp-for="NewStatus" class="form-control select2">
                    <option value="1">شروع‌نشده</option>
                    <option value="2">در حال انجام</option>
                    <option value="3">در انتظار</option>
                    <option value="4">تکمیل‌شده</option>
                    <option value="5">ردشده / انجام‌نشده</option>
                    <option value="6">لغوشده</option>
                </select>                <span asp-validation-for="NewStatus" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <hr />

            <p class="text-muted">
                در صورت انتخاب وضعیت «در انتظار»، ثبت علت انتظار و تاریخ پیگیری الزامی است.
            </p>

            <div class="form-group">
                <label asp-for="WaitingReason"></label>
                <textarea asp-for="WaitingReason" class="form-control" rows="2"></textarea>
                <span asp-validation-for="WaitingReason" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NextFollowUpDate"></label>
                <input asp-for="NextFollowUpDate"
                       type="text"
                       class="form-control persian-datepicker"
                       autocomplete="off"
                       placeholder="۱۴۰۵/۰۱/۱۵" />
                <span asp-validation-for="NextFollowUpDate" class="text-danger"></span>
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-exchange-alt"></i>
                ثبت وضعیت جدید
            </button>

            <a asp-controller="Projects"
               asp-action="Details"
               asp-route-id="@Model.ProjectId"
               class="btn btn-secondary">
                انصراف
            </a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            $('.select2').select2({
                width: '100%',
                dir: 'rtl',
                language: 'fa',
                placeholder: 'انتخاب کنید',
                allowClear: true
            });

            $('.persian-datepicker').persianDatepicker({
                format: 'YYYY/MM/DD',
                initialValue: false,
                initialValueType: 'persian',
                autoClose: true,
                observer: true,
                calendar: {
                    persian: {
                        locale: 'fa',
                        showHint: true,
                        leapYearMode: 'algorithmic'
                    }
                },
                toolbox: {
                    calendarSwitch: {
                        enabled: false
                    }
                }
            });
        });
    </script>
}