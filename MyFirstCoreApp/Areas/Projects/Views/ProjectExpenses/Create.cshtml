@model MyFirstCoreApp.Areas.Projects.ViewModels.ProjectExpenseFormViewModel
@{ ViewData["Title"] = "ثبت هزینه"; }

<div class="card">
    <div class="card-header"><h3>ثبت هزینه</h3></div>
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="Create" method="post">
            <div class="row">
                <div class="form-group col-md-3">
                    <label asp-for="DateText">تاریخ</label>
                    <input asp-for="DateText" class="form-control datepicker" autocomplete="off" placeholder="۱۴۰۵/۰۱/۱۵" dir="ltr" />
                    <span asp-validation-for="DateText" class="text-danger"></span>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ProjectId">پروژه (اختیاری)</label>
                    <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-control select2"><option value="">بدون پروژه</option></select>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ContactId">فروشنده / طلبکار (اختیاری)</label>
                    <select asp-for="ContactId" asp-items="ViewBag.Contacts" class="form-control select2"><option value="">انتخاب نشده</option></select>
                    <small class="form-text text-muted">شخص یا شرکتی که هزینه بابت اوست؛ پول از این طرف‌حساب برداشت نمی‌شود. پرداخت واقعی بعداً از صندوق یا بانک ثبت می‌شود.</small>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ExpenseAccountId">طبقه‌بندی هزینه</label>
                    <select asp-for="ExpenseAccountId" asp-items="ViewBag.ExpenseAccounts" class="form-control select2"></select>
                    <small class="form-text text-muted">این حساب محل ثبت بدهکار هزینه است. برای هزینه‌های معمول، «هزینه‌های عمومی» را انتخاب کنید.</small>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="AmountText">مبلغ (ریال)</label>
                    <input asp-for="AmountText" type="text" inputmode="numeric" autocomplete="off" dir="ltr" placeholder="مثلاً ۱,۵۰۰,۰۰۰" class="form-control persian-number persian-number-comma" />
                    <span asp-validation-for="AmountText" class="text-danger"></span>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="Reference">شماره مرجع</label><input asp-for="Reference" class="form-control" />
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Description">شرح</label><input asp-for="Description" class="form-control" />
                </div>
            </div>
            <button class="btn btn-success">ثبت هزینه و سند حسابداری</button>
            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary">بازگشت</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $('.select2').select2({ width: '100%', dir: 'rtl', language: 'fa', placeholder: 'انتخاب کنید', allowClear: true });
            $('.datepicker').each(function () {
                var $input = $(this), value = $input.val();
                $input.persianDatepicker({
                    format: 'YYYY/MM/DD', initialValue: false, autoClose: true, observer: true,
                    calendar: { persian: { locale: 'fa', showHint: true, leapYearMode: 'algorithmic' } },
                    toolbox: { calendarSwitch: { enabled: false } }
                });
                if (value) $input.persianDatepicker('setDate', value);
            });
        });
    </script>
}
