@model MyFirstCoreApp.Areas.Invoicing.ViewModels.Invoice.InvoiceFormViewModel
@{
    ViewData["Title"] = "ویرایش فاکتور";
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-edit"></i>
            ویرایش فاکتور شماره @Model.Number
        </h3>
    </div>

    <form asp-area="Invoicing" asp-controller="Invoices" asp-action="Edit"
          asp-route-id="@Model.Id" method="post" id="invoiceForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Number" />

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <partial name="_Form" model="Model" />
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save"></i> ذخیره تغییرات
            </button>
            <a asp-action="Index"
               asp-route-invoiceType="@((int)Model.InvoiceType)"
               class="btn btn-secondary">
                <i class="fa-solid fa-arrow-right"></i> انصراف
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ============================================
        // 🆕 چک تکراری بودن کالا
        // ============================================
        function isProductDuplicate(productId, currentIndex) {
            if (!productId || productId == 0 || productId == '0') return false;
            var productIdStr = productId.toString();
            var isDup = false;
            $('.product-magicsuggest').each(function () {
                var idx = $(this).data('index');
                if (idx == currentIndex) return;
                var otherId = $('#ProductId_Hidden_' + idx).val();
                if (otherId && otherId !== '' && otherId !== '0' && otherId.toString() === productIdStr) {
                    isDup = true;
                    return false;
                }
            });
            return isDup;
        }

        // ============================================
        // 🆕 محاسبه جمع‌ها
        // ============================================
        function updateTotals() {
            let subTotal = 0, discountTotal = 0, taxTotal = 0;

            $('#itemsBody tr.item-row').each(function () {
                const $row = $(this);
                const qty = parseFloat(toEnglishNumber($row.find('.quantity-input').val()).replace(/,/g, '')) || 0;
                const price = parseFloat(toEnglishNumber($row.find('.price-input').val()).replace(/,/g, '')) || 0;
                const discount = parseFloat(toEnglishNumber($row.find('.discount-input').val()).replace(/,/g, '')) || 0;
                const tax = parseFloat(toEnglishNumber($row.find('.tax-input').val()).replace(/,/g, '')) || 0;

                const lineBase = Math.round(qty * price);
                const discountAmount = Math.round(lineBase * discount / 100);
                const afterDiscount = lineBase - discountAmount;
                const taxAmount = Math.round(afterDiscount * tax / 100);

                const lineTotal = afterDiscount + taxAmount;

                $row.find('.line-total').val(formatNumberWithComma(lineTotal.toFixed(0)));

                subTotal += lineBase;
                discountTotal += discountAmount;
                taxTotal += taxAmount;
            });

            const totalAmount = subTotal - discountTotal + taxTotal;

            $('#subTotal').text(formatNumberWithComma(subTotal.toFixed(0)));
            $('#discountAmount').text(formatNumberWithComma(discountTotal.toFixed(0)));
            $('#taxAmount').text(formatNumberWithComma(taxTotal.toFixed(0)));
            $('#totalAmount').text(formatNumberWithComma(totalAmount.toFixed(0)));
        }

        // ============================================
        // 🆕 راه‌اندازی MagicSuggest کالا برای یه ردیف
        // ============================================
                function initProductMagicSuggestForRow(index, initialId, initialName, initialTrackInventory) {
            var containerId = 'product_ms_' + index;
            var $container = $('.product-magicsuggest[data-index="' + index + '"]');

            if ($container.data('ms-initialized') === true) {
                return;
            }

            $container.data('ms-initialized', true);

            var $row = $container.closest('tr');

            $container.empty();
            $container.append(
                $('<div id="' + containerId + '" class="magicsuggest-container"></div>')
            );

            $container.append(`
                <div class="new-product-service-option mt-2" style="display:none;">
                    <label class="mb-0">
                        <input type="checkbox"
                               class="is-service-checkbox"
                               name="Items[${index}].IsService"
                               value="true" />
                        <span class="text-info">
                            این قلم خدماتی است (بدون کنترل موجودی انبار)
                        </span>
                    </label>
                </div>
            `);

            $container.find('.is-service-checkbox')
                .prop('checked', $container.data('is-service') === true);

            var invoiceType = @((int)Model.InvoiceType);
            var showStock = false;
            var ms = null;
            var currentQuery = '';

            function updateStockDisplay(item) {
                var $stock = $row.find('.product-stock');

                if (!showStock ||
                    !item ||
                    item.trackInventory === false ||
                    item.stock === null ||
                    item.stock === undefined) {
                    $stock.empty();
                    return;
                }

                $stock.text(
                    'موجودی: ' + formatNumberWithComma(String(item.stock))
                );
            }

            function loadProducts(query) {
                var selectedWarehouseId = $row.find('.warehouse-select').val();

                $.ajax({
                    url: '/Invoicing/Invoices/SearchProducts',
                    type: 'GET',
                    data: {
                        q: query || '',
                        invoiceType: invoiceType,
                        warehouseId: selectedWarehouseId || null
                    },
                    success: function (r) {
                        if (!r.success) return;

                        showStock = r.showStock === true;

                        var data = r.data.map(function (p) {
                            return {
                                id: p.id,
                                name: p.name,
                                code: p.code,
                                salePrice: p.salePrice,
                                unitName: p.unitName,
                                taxRate: p.taxRate,
                                trackInventory: p.trackInventory,
                                stock: p.stock
                            };
                        });

                        if (!ms) {
                            ms = $('#' + containerId).magicSuggest({
                                data: data,
                                valueField: 'id',
                                displayField: 'name',
                                allowFreeEntries: true,
                                maxSelection: 1,
                                resultAsString: false,
                                useCommaKey: false,

                                selectionRenderer: function (item) {
                                    return item.name;
                                },

                                renderer: function (item) {
                                    var txt = item.name;

                                    if (item.code) {
                                        txt += ' <small style="color:#666;">(' +
                                            item.code + ')</small>';
                                    }

                                    if (item.unitName) {
                                        txt += ' <small style="color:#007bff;">[' +
                                            item.unitName + ']</small>';
                                    }

                                    if (showStock &&
                                        item.trackInventory !== false &&
                                        item.stock !== null &&
                                        item.stock !== undefined) {
                                        txt += ' <small style="color:#28a745; margin-right:5px;">موجودی: ' +
                                            formatNumberWithComma(String(item.stock)) +
                                            '</small>';
                                    }

                                    return txt;
                                },

                                placeholder: 'نام کالا را تایپ کنید...',
                                noSuggestionText: 'موردی یافت نشد. Enter بزنید تا جدید اضافه شود.',
                                minChars: 0,
                                typeDelay: 200,
                                maxSuggestions: 50,

                                maxSelectionRenderer: function () {
                                    return 'فقط یک کالا می‌توانید انتخاب کنید.';
                                }
                            });

                            $container.data('magicSuggest', ms);

                            $(ms).on('selectionchange', function () {
                                var selection = ms.getSelection();
                                var $serviceOption = $container.find('.new-product-service-option');
                                var $serviceCheckbox = $container.find('.is-service-checkbox');

                                if (selection && selection.length > 0) {
                                    var item = selection[0];

                                    var isNewProduct =
                                        item.isNewProduct === true ||
                                        item.trackInventory === undefined;

                                    $serviceOption.toggle(isNewProduct);

                                    if (!isNewProduct) {
                                        $serviceCheckbox.prop('checked', false);
                                    }

                                    var isService = isNewProduct && $serviceCheckbox.is(':checked');

                                    var tracksInventory = isNewProduct
                                        ? !isService
                                        : item.trackInventory !== false;

                                    $row.find('.warehouse-picker').toggle(tracksInventory);
                                    $row.find('.warehouse-not-applicable').toggle(!tracksInventory);

                                    if (!tracksInventory) {
                                        $row.find('.warehouse-select')
                                            .val('')
                                            .trigger('change.select2');
                                    }

                                    if (!isNewProduct) {
                                        if (isProductDuplicate(item.id, index)) {
                                            alert('این کالا قبلاً در فاکتور ثبت شده است.');

                                            ms.clear();

                                            $('#ProductId_Hidden_' + index).val('0');
                                            $('#ProductName_Hidden_' + index).val('');

                                            updateStockDisplay(null);
                                            return;
                                        }

                                        $('#ProductId_Hidden_' + index).val(item.id);
                                        $('#ProductName_Hidden_' + index).val(item.name);

                                        if (item.salePrice !== undefined && item.salePrice !== null) {
                                            $row.find('.price-input').val(
                                                formatNumberWithComma(item.salePrice.toString())
                                            );
                                        }

                                        if (item.taxRate !== undefined && item.taxRate !== null) {
                                            $row.find('.tax-input').val(item.taxRate);
                                        }

                                        updateStockDisplay(item);
                                        updateTotals();
                                    } else {
                                        $('#ProductId_Hidden_' + index).val('0');
                                        $('#ProductName_Hidden_' + index).val(item.name);

                                        updateStockDisplay(null);
                                    }
                                } else {
                                    $('#ProductId_Hidden_' + index).val('');
                                    $('#ProductName_Hidden_' + index).val('');

                                    $serviceOption.hide();
                                    $serviceCheckbox.prop('checked', false);

                                    $row.find('.warehouse-picker').show();
                                    $row.find('.warehouse-not-applicable').hide();

                                    updateStockDisplay(null);
                                }
                            });

                            // انتخاب کالای اولیه در حالت ویرایش
                            if (initialId && initialId > 0 && initialName) {
                                var initialProduct = data.find(function (p) {
                                    return p.id.toString() === initialId.toString();
                                });

                                var tracksInventory =
                                    initialTrackInventory === true ||
                                    initialTrackInventory === 'true' ||
                                    initialTrackInventory === 'True' ||
                                    initialTrackInventory === '1';

                                ms.addToSelection([
                                    initialProduct || {
                                        id: initialId,
                                        name: initialName,
                                        trackInventory: tracksInventory
                                    }
                                ]);
                            }

                            // وضعیت خدماتی
                            $container.off('change', '.is-service-checkbox');

                            $container.on('change', '.is-service-checkbox', function () {
                                var isService = $(this).is(':checked');

                                $container.data('is-service', isService);

                                $row.find('.warehouse-picker').toggle(!isService);
                                $row.find('.warehouse-not-applicable').toggle(isService);

                                if (isService) {
                                    $row.find('.warehouse-select')
                                        .val('')
                                        .trigger('change.select2');

                                    updateStockDisplay(null);
                                } else {
                                    loadProducts(currentQuery);
                                }
                            });

                            // ثبت کالای جدید با Enter
                            $(ms).on('keydown', function (e) {
                                if (e.key === 'Enter' || e.keyCode === 13) {
                                    var inputEl = $('#' + containerId).find('input')[0];
                                    var text = inputEl && inputEl.value
                                        ? inputEl.value.trim()
                                        : '';

                                    if (text) {
                                        var selection = ms.getSelection();
                                        var isDuplicate = selection.some(function (i) {
                                            return i.name === text;
                                        });

                                        if (!isDuplicate) {
                                            e.preventDefault();
                                            e.stopPropagation();

                                            inputEl.value = '';

                                            ms.addToSelection([{
                                                id: 0,
                                                name: text,
                                                isNewProduct: true
                                            }]);

                                            return false;
                                        }
                                    }
                                }
                            });

                            // جست‌وجوی پویا با متن تایپ‌شده
                            var searchTimeout;

                            $(ms).on('keyup', function (e) {
                                if (e.key === 'Enter' || e.keyCode === 13) return;

                                clearTimeout(searchTimeout);

                                searchTimeout = setTimeout(function () {
                                    var inputEl = $('#' + containerId).find('input')[0];

                                    currentQuery = inputEl && inputEl.value
                                        ? inputEl.value.trim()
                                        : '';

                                    loadProducts(currentQuery);
                                }, 300);
                            });

                            // تغییر انبار همین ردیف
                            $row.off('change.productStock', '.warehouse-select');

                            $row.on('change.productStock', '.warehouse-select', function () {
                                loadProducts(currentQuery);
                            });
                        } else {
                            ms.setData(data);

                            // پس از تغییر انبار، موجودی کالای انتخاب‌شده را به‌روز کن
                            var selectedId = $('#ProductId_Hidden_' + index).val();

                            if (selectedId && selectedId !== '0') {
                                var selectedProduct = data.find(function (p) {
                                    return p.id.toString() === selectedId.toString();
                                });

                                updateStockDisplay(selectedProduct);
                            }
                        }
                    }
                });
            }

            currentQuery = initialId && initialId > 0
                ? initialName
                : '';

            loadProducts(currentQuery);
        }

        $(document).ready(function () {

            // ============================================
            // ۱. Select2
            // ============================================
            function initSelect2(selector) {
                $(selector).each(function () {
                    var $el = $(this);
                    if ($el.data('select2')) return;  // قبلاً init شده
                    $el.select2({
                        dir: 'rtl',
                        placeholder: '-- انتخاب کنید --',
                        allowClear: true,
                        width: '100%',
                        language: 'fa'
                    });
                });
            }

            // 🆕 هر دو نوع select را init کن
            initSelect2('select.select2');
            initSelect2('select.warehouse-select');

            // ============================================
            // ۲. DatePicker
            // ============================================
            $('.datepicker').persianDatepicker({
                format: 'YYYY/MM/DD',
                initialValueType: 'persian',
                initialValue: true,
                autoClose: true,
                observer: true,
                calendar: {
                    persian: { locale: 'fa', showHint: true, leapYearMode: 'algorithmic' }
                },
                toolbox: { calendarSwitch: { enabled: false } }
            });

            // ============================================
            // ۳. MagicSuggest طرف حساب
            // ============================================
            var contactType = @((int)(Model.InvoiceType == InvoiceType.Purchase ? ContactType.Supplier : ContactType.Customer));
            var msContact;

            $.ajax({
                url: '/Invoicing/Invoices/SearchContacts',
                type: 'GET',
                data: { type: contactType },
                success: function (r) {
                    var initialData = r.data.map(function (c) {
                        return { id: c.id, name: c.name, mobile: c.mobile };
                    });

                    msContact = $('#contactSelect').magicSuggest({
                        data: initialData,
                        valueField: 'id',
                        displayField: 'name',
                        allowFreeEntries: true,
                        maxSelection: 1,
                        resultAsString: false,
                        useCommaKey: false,

                        selectionRenderer: function (item) { return item.name; },
                        renderer: function (item) {
                            if (item.mobile) {
                                return item.name + ' <small style="color: #000; direction: ltr; unicode-bidi: embed; display: inline-block; font-weight: 500;">' + item.mobile + '</small>';
                            }
                            return item.name;
                        },
                        placeholder: 'نام طرف حساب را تایپ کنید یا انتخاب کنید...',
                        noSuggestionText: 'موردی یافت نشد. Enter بزنید تا جدید اضافه شود.',
                        minChars: 0,
                        typeDelay: 200,
                        maxSuggestions: 50,
                        maxSelectionRenderer: function () {
                            return 'فقط یک مورد می‌توانید انتخاب کنید.';
                        }
                    });

                    var initialContactId = @(Model.ContactId ?? 0);
                    var initialContactName = '@Html.Raw((Model.ContactName ?? "").Replace("'", "\\'"))';

                    if (initialContactId && initialContactId > 0 && initialContactName) {
                        msContact.addToSelection([{ id: initialContactId, name: initialContactName }]);
                    }

                    $(msContact).on('selectionchange', function () {
                        var selection = msContact.getSelection();
                        if (selection && selection.length > 0) {
                            var item = selection[0];
                            if (item.id && item.id > 0) {
                                $('#ContactId_Hidden').val(item.id);
                                $('#ContactName_Hidden').val(item.name);
                            } else {
                                $('#ContactId_Hidden').val('0');
                                $('#ContactName_Hidden').val(item.name);
                            }
                        } else {
                            $('#ContactId_Hidden').val('');
                            $('#ContactName_Hidden').val('');
                        }
                    });

                    $(msContact).on('keydown', function (e) {
                        if (e.key === 'Enter' || e.keyCode === 13) {
                            var inputEl = $('#contactSelect').find('input')[0];
                            var text = inputEl && inputEl.value ? inputEl.value.trim() : '';
                            if (text) {
                                var selection = msContact.getSelection();
                                var isDuplicate = selection.some(function (i) { return i.name === text; });
                                if (!isDuplicate) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    inputEl.value = '';
                                    msContact.addToSelection([{ id: 0, name: text, isNewProduct: true }]);
                                    return false;
                                }
                            }
                        }
                    });

                    var searchTimeout;
                    $(msContact).on('keyup', function (e) {
                        if (e.key === 'Enter' || e.keyCode === 13) return;
                        clearTimeout(searchTimeout);
                        searchTimeout = setTimeout(function () {
                            var inputEl = $('#contactSelect').find('input')[0];
                            var query = inputEl && inputEl.value ? inputEl.value.trim() : '';
                            $.ajax({
                                url: '/Invoicing/Invoices/SearchContacts',
                                type: 'GET',
                                data: { q: query, type: contactType },
                                success: function (r) {
                                    var data = r.data.map(function (c) {
                                        return { id: c.id, name: c.name, mobile: c.mobile };
                                    });
                                    msContact.setData(data);
                                }
                            });
                        }, 300);
                    });
                }
            });

            // ============================================
            // ۴. راه‌اندازی MagicSuggest برای خطوط اولیه
            // ============================================
            $('.product-magicsuggest').each(function () {
                var idx = $(this).data('index');
                var initId = $(this).data('initial-id');
                var initName = $(this).data('initial-name');
                var initTrackInventory = $(this).data('initial-track-inventory');
                initProductMagicSuggestForRow(idx, initId, initName, initTrackInventory);
            });

            // ============================================
            // ۵. خطوط پویا
            // ============================================
            let itemIndex = @Model.Items.Count;

            $('#addItem').on('click', function () {
                var newIndex = itemIndex;

                var newRow = `
            <tr class="item-row">
                <td class="item-number" data-label="#">${newIndex + 1}</td>
                <td data-label="کالا">
                <div class="product-magicsuggest magicsuggest-container"
                        data-index="${newIndex}"
                        data-initial-id="0"
                        data-initial-name=""></div>

                <div class="product-stock text-muted small mt-1"></div>
                    <input type="hidden" name="Items[${newIndex}].ProductId"
                           id="ProductId_Hidden_${newIndex}" value="0" />
                    <input type="hidden" name="Items[${newIndex}].ProductName"
                           id="ProductName_Hidden_${newIndex}" value="" />
                </td>
                <td class="warehouse-cell" data-label="انبار">
                    <span class="warehouse-picker">
                    <select name="Items[${newIndex}].WarehouseId" class="form-control warehouse-select select2">
                        ${$('#warehouseOptionsTemplate').html()}
                    </select>
                    </span>
                    <span class="warehouse-not-applicable" style="display:none">—</span>
                </td>
                <td data-label="تعداد">
                    <input type="text" name="Items[${newIndex}].Quantity"
                           class="form-control persian-number quantity-input" value="۱"
                           inputmode="decimal" />
                </td>
                <td data-label="قیمت واحد">
                    <input type="text" name="Items[${newIndex}].UnitPrice"
                           class="form-control persian-number persian-number-comma price-input" value="۰"
                           inputmode="numeric" />
                </td>
                <td data-label="تخفیف %">
                    <input type="text" name="Items[${newIndex}].DiscountPercent"
                           class="form-control persian-number discount-input" value="۰"
                           inputmode="numeric" />
                </td>
                <td data-label="مالیات %">
                    <input type="text" name="Items[${newIndex}].TaxRate"
                           class="form-control persian-number tax-input" value="۰"
                           inputmode="numeric" />
                </td>
                <td data-label="جمع خط">
                    <input type="text" name="Items[${newIndex}].LineTotal"
                           class="form-control persian-number persian-number-comma line-total" readonly value="۰" />
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-danger remove-item">
                        <i class="fa fa-times"></i>
                    </button>
                </td>
            </tr>
        `;

                $('#itemsBody').append(newRow);

                // 🆕 init select2 برای ردیف جدید
                initSelect2($('#itemsBody tr.item-row:last select.warehouse-select'));

                itemIndex++;
                renumberItems();
                updateTotals();

                initProductMagicSuggestForRow(newIndex, 0, '');
            });

            $(document).on('click', '.remove-item', function () {
                if ($('#itemsBody tr.item-row').length <= 1) {
                    alert('حداقل یک قلم لازم است.');
                    return;
                }
                $(this).closest('tr').remove();
                renumberItems();
                updateTotals();
            });

            function renumberItems() {
                $('#itemsBody tr.item-row').each(function (i) {
                    var $row = $(this);

                    $row.find('.item-number').text(i + 1);

                    $row.find('[name^="Items["]').each(function () {
                        var $inp = $(this);
                        var name = $inp.attr('name');
                        var newName = name.replace(/^Items\[\d+\]/, 'Items[' + i + ']');
                        $inp.attr('name', newName);
                    });

                    var $pid = $row.find('input[id^="ProductId_Hidden_"]');
                    var $pname = $row.find('input[id^="ProductName_Hidden_"]');
                    if ($pid.length) {
                        $pid.attr('id', 'ProductId_Hidden_' + i);
                    }
                    if ($pname.length) {
                        $pname.attr('id', 'ProductName_Hidden_' + i);
                    }

                    var $ms = $row.find('.product-magicsuggest');
                    if ($ms.length) {
                        var oldIndex = $ms.data('index');
                        if (oldIndex != i) {
                            $ms.removeData('ms-initialized');
                            $ms.empty();

                            var currentProductId = $row.find('input[id^="ProductId_Hidden_"]').val() || 0;
                            var currentProductName = $row.find('input[id^="ProductName_Hidden_"]').val() || '';
                            var currentIsService = $row.find('.is-service-checkbox').is(':checked');

                            $ms.attr('data-index', i);
                            $ms.data('index', i);
                            $ms.data('initial-id', currentProductId);
                            $ms.data('initial-name', currentProductName);

                            var currentTrackInventory = $ms.data('initial-track-inventory');
                            $ms.data('is-service', currentIsService);
                            initProductMagicSuggestForRow(i, currentProductId, currentProductName, currentTrackInventory);
                        } else {
                            $ms.attr('data-index', i);
                        }
                    }
                });
            }

            $(document).on('input change keyup paste', '.quantity-input, .price-input, .discount-input, .tax-input', updateTotals);
            updateTotals();

            // ============================================
            // ۶. 🆕 انتخاب خودکار مقدار در فوکوس (برای موبایل)
            // ============================================
            $(document).on('focus', '.quantity-input, .price-input, .discount-input, .tax-input, .line-total', function () {
                var $this = $(this);
                setTimeout(function () {
                    try { $this.select(); } catch (e) { /* ignore */ }
                }, 10);
            });

            // 🆕 اگر کاربر فیلد را خالی گذاشت، مقدار پیش‌فرض برگردد
            $(document).on('blur', '.quantity-input, .price-input, .discount-input, .tax-input', function () {
                var $this = $(this);
                var val = $this.val();
                if (!val || val.trim() === '') {
                    if ($this.hasClass('quantity-input')) {
                        $this.val('۱');
                    } else {
                        $this.val('۰');
                    }
                    updateTotals();
                }
            });

            // ============================================
            // ۷. Submit
            // ============================================
            $('#invoiceForm').on('submit', function () {
                $('.persian-number').each(function () {
                    const $input = $(this);
                    let val = $input.val();
                    if (val) {
                        val = toEnglishNumber(val).replace(/,/g, '');
                        $input.val(val);
                    }
                });

                $('select.select2').each(function () {
                    if ($(this).data('select2')) {
                        $(this).trigger('change.select2');
                    }
                });

                var contactId = $('#ContactId_Hidden').val();
                var contactName = $('#ContactName_Hidden').val();
                if ((!contactId || contactId === '') && contactName) {
                    $('#ContactId_Hidden').val('0');
                }
            });

        });

        function toggleDueDate() {
            $('#dueDateGroup').toggle($('#InvoiceType').val() !== '1');
        }
        $('#InvoiceType').on('change', toggleDueDate);
        toggleDueDate();
    </script>
}