@model MyFirstCoreApp.Areas.Invoicing.ViewModels.InvoiceReturn.InvoiceReturnViewModel

@{
    ViewData["Title"] = Model.ReturnTypeName;
}

<div class="card card-warning">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-rotate-left"></i>
            @Model.ReturnTypeName از فاکتور شماره @Model.OriginalInvoiceNumber
        </h3>
    </div>

    <form asp-area="Invoicing"
          asp-controller="Invoices"
          asp-action="Return"
          method="post"
          id="invoiceReturnForm">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="OriginalInvoiceId" />

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-4 col-6 mb-3">
                    <div class="form-group mb-0">
                        <label>فاکتور اصلی</label>
                        <input class="form-control bg-light"
                               value="شماره @Model.OriginalInvoiceNumber"
                               readonly />
                    </div>
                </div>

                <div class="col-md-4 col-6 mb-3">
                    <div class="form-group mb-0">
                        <label>طرف حساب</label>
                        <input class="form-control bg-light"
                               value="@Model.ContactName"
                               readonly />
                    </div>
                </div>

                <div class="col-md-4 col-12 mb-3">
                    <div class="form-group mb-0">
                        <label asp-for="Date"></label>
                        <input asp-for="Date"
                               class="form-control datepicker"
                               placeholder="۱۴۰۳/۰۵/۱۵"
                               autocomplete="off"
                               dir="ltr" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-12 mb-3">
                    <div class="form-group mb-0">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="2"
                                  placeholder="شرح برگشت (اختیاری)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">
                    <i class="fa fa-list"></i>
                    اقلام قابل برگشت
                </h5>

                <span class="badge badge-info">@Model.Items.Count قلم</span>
            </div>

            <div class="alert alert-info py-2">
                مقدار برگشتی را فقط برای کالاهایی که قصد برگشت آن‌ها را دارید وارد کنید.
                مقدار واردشده نباید از مانده قابل برگشت بیشتر باشد.
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:45px;">#</th>
                            <th>کالا</th>
                            <th class="text-center">تعداد فاکتور</th>
                            <th class="text-center">برگشت قبلی</th>
                            <th class="text-center">مانده قابل برگشت</th>
                            <th style="width:190px;">مقدار برگشتی</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (var i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <td class="text-center persian-number">
                                    @(i + 1)
                                </td>

                                <td>
                                    @Model.Items[i].ProductName
                                    <input type="hidden"
                                           asp-for="Items[i].OriginalInvoiceItemId" />
                                </td>

                                <td class="text-center persian-number">
                                    @Model.Items[i].OriginalQuantity.ToString("0.###")
                                </td>

                                <td class="text-center persian-number">
                                    @Model.Items[i].ReturnedQuantity.ToString("0.###")
                                </td>

                                <td class="text-center persian-number font-weight-bold">
                                    @Model.Items[i].RemainingQuantity.ToString("0.###")
                                </td>

                                <td>
                                    <input asp-for="Items[i].ReturnQuantity"
                                           type="number"
                                           class="form-control form-control-sm return-quantity"
                                           min="0"
                                           max="@Model.Items[i].RemainingQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           step="0.001"
                                           inputmode="decimal"
                                           dir="ltr"
                                           aria-label="مقدار برگشتی برای @Model.Items[i].ProductName" />

                                    <span asp-validation-for="Items[i].ReturnQuantity"
                                          class="text-danger"></span>

                                    <small class="text-muted">
                                        حداکثر:
                                        @Model.Items[i].RemainingQuantity.ToString("0.###")
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <small class="text-muted">
                قیمت واحد، تخفیف و مالیات از فاکتور اصلی برداشته می‌شود.
                فقط مقدار برگشتی را وارد کنید.
            </small>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-warning" id="btnCreateReturn">
                <i class="fa fa-save"></i>
                ثبت پیش‌نویس برگشت
            </button>

            <a asp-action="Details"
               asp-route-id="@Model.OriginalInvoiceId"
               class="btn btn-secondary">
                <i class="fa fa-times"></i>
                انصراف
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const form = document.getElementById('invoiceReturnForm');
            if (!form) return;

            const inputs = form.querySelectorAll('.return-quantity');

            // کنترل مقدار ورودی هنگام تایپ
            inputs.forEach(function (input) {
                input.addEventListener('input', function () {
                    const max = Number(input.max);
                    const value = Number(input.value);

                    if (input.value.trim() === '') return;

                    if (Number.isFinite(value)) {
                        if (value > max) {
                            input.value = max;
                        } else if (value < 0) {
                            input.value = 0;
                        }
                    }
                });
            });

            // اعتبارسنجی قبل از ارسال فرم
            form.addEventListener('submit', function (event) {
                let hasQuantity = false;
                let hasInvalidQuantity = false;

                inputs.forEach(function (input) {
                    const value = input.value.trim() === ''
                        ? 0
                        : Number(input.value);

                    const max = Number(input.max);

                    if (Number.isFinite(value) && value > 0) {
                        hasQuantity = true;
                    }

                    if (!Number.isFinite(value) ||
                        value < 0 ||
                        value > max) {

                        hasInvalidQuantity = true;
                        input.classList.add('is-invalid');
                    } else {
                        input.classList.remove('is-invalid');
                    }
                });

                if (!hasQuantity) {
                    event.preventDefault();
                    alert('برای حداقل یک قلم، مقدار برگشتی وارد کنید.');
                    return;
                }

                if (hasInvalidQuantity) {
                    event.preventDefault();
                    alert('مقدار برگشتی باید بین صفر و مانده قابل برگشت باشد.');
                }
            });
        })();
    </script>
}