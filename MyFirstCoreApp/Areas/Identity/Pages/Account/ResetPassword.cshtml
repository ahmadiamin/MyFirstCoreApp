@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "تغییر کلمه عبور";
}

<div class="row justify-content-center">

    <div class="col-md-6 col-lg-5">

        <div class="card card-primary">

            <div class="card-header text-center">

                <h3 class="card-title float-none">

                    <i class="fa fa-lock"></i>

                    تغییر کلمه عبور

                </h3>

            </div>

            <div class="card-body">

                <p class="text-center text-muted mb-4">
                    رمز عبور جدید خود را وارد کنید.
                </p>

                <form method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <input asp-for="Input.Code"
                           type="hidden" />


                    <!-- Email -->

                    <div class="form-group">

                        <label asp-for="Input.Email">
                            ایمیل
                        </label>

                        <div class="input-group">

                            <div class="input-group-prepend">

                                <span class="input-group-text">
                                    <i class="fa fa-envelope"></i>
                                </span>

                            </div>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="email"
                                   placeholder="ایمیل خود را وارد کنید" />

                        </div>

                        <span asp-validation-for="Input.Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Password -->

                    <div class="form-group">

                        <label asp-for="Input.Password">
                            رمز عبور جدید
                        </label>

                        <div class="input-group">

                            <div class="input-group-prepend">

                                <span class="input-group-text">
                                    <i class="fa fa-lock"></i>
                                </span>

                            </div>

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="رمز عبور جدید" />

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Confirm Password -->

                    <div class="form-group">

                        <label asp-for="Input.ConfirmPassword">
                            تکرار رمز عبور
                        </label>

                        <div class="input-group">

                            <div class="input-group-prepend">

                                <span class="input-group-text">
                                    <i class="fa fa-lock"></i>
                                </span>

                            </div>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="تکرار رمز عبور" />

                        </div>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <button type="submit"
                            class="btn btn-primary btn-block">

                        <i class="fa fa-save"></i>

                        تغییر رمز عبور

                    </button>


                    <div class="text-center mt-3">

                        <a asp-page="./Login">

                            <i class="fa fa-arrow-right"></i>

                            بازگشت به صفحه ورود

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}