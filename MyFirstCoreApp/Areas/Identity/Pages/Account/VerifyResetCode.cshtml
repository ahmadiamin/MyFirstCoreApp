@page
@model VerifyResetCodeModel

@{
    ViewData["Title"] = "تأیید کد بازیابی";
    var resendMessage = TempData["OtpResendMessage"] as string;
    var resendAccepted = TempData["OtpResendAccepted"] as bool?;
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card card-primary">

            <div class="card-header text-center">
                <h3 class="card-title float-none">
                    <i class="fa fa-mobile"></i>
                    تأیید کد بازیابی
                </h3>
            </div>

            <div class="card-body">

                <p class="text-center text-muted mb-4">
                    کد شش‌رقمی ارسال‌شده به شماره زیر را وارد کنید.
                </p>

                @if (!string.IsNullOrWhiteSpace(resendMessage))
                {
                    <div class="alert @(resendAccepted == true ? "alert-success" : "alert-warning")"
                         role="alert">
                        @resendMessage
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="form-group">
                        <label>شماره موبایل</label>

                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="fa fa-phone"></i>
                                </span>
                            </div>

                            <input class="form-control"
                                   value="@Model.Mobile"
                                   readonly />
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Code">
                            کد تأیید پیامک‌شده
                        </label>

                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="fa fa-key"></i>
                                </span>
                            </div>

                            <input asp-for="Input.Code"
                                   class="form-control text-center"
                                   placeholder="کد ۶ رقمی"
                                   maxlength="6"
                                   autocomplete="one-time-code"
                                   inputmode="numeric"
                                   dir="ltr" />
                        </div>

                        <span asp-validation-for="Input.Code"
                              class="text-danger">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary btn-block">
                        <i class="fa fa-check"></i>
                        تأیید کد
                    </button>
                </form>

                <hr />

                <form method="post" asp-page-handler="Resend">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-secondary btn-block">
                        <i class="fa fa-refresh"></i>
                        ارسال مجدد کد
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a asp-page="./ForgotPassword">
                        <i class="fa fa-arrow-right"></i>
                        بازگشت
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}