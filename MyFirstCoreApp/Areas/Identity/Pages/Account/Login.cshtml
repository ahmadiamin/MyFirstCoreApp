@page
@model LoginModel

@{
    ViewData["Title"] = "ورود";
}

<div class="row justify-content-center">

    <div class="col-md-6 col-lg-5">

        <div class="card card-primary">

            <!-- Header -->
            <div class="card-header text-center">

                <h3 class="card-title float-none">
                    <i class="fa fa-sign-in"></i>
                    ورود به سیستم
                </h3>

            </div>

            <!-- Body -->
            <div class="card-body">

                <p class="text-center text-muted mb-4">
                    برای ورود به حساب کاربری خود اطلاعات زیر را وارد کنید.
                </p>

                <form id="account"
                      method="post">

                    <!-- Validation -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                        @if (Model.EmailNotConfirmed)
                        {
                            <div class="alert alert-warning text-right">

                                <i class="fa fa-envelope"></i>

                                <strong>
                                    راه تأیید حساب شما کامل نشده است.
                                </strong>

                                <p class="mb-2 mt-2">
                                    برای ورود به سیستم ابتدا آدرس ایمیل خود را تأیید کنید.
                                </p>

                                <a asp-page="./ResendEmailConfirmation"
                                   asp-route-email="@Model.Input.Email"
                                   class="btn btn-warning btn-sm">

                                    <i class="fa fa-paper-plane"></i>

                                    ارسال مجدد لینک تأیید

                                </a>

                            </div>
                        }
                        @if (Model.PhoneNotConfirmed)
                        {
                            <div class="alert alert-warning text-right">
                                <i class="fa fa-mobile-alt"></i>
                                شماره موبایل شما هنوز تأیید نشده است.
                                <a asp-page="./ConfirmPhone" asp-route-userId="@Model.ConfirmationUserId" class="btn btn-warning btn-sm mr-2">
                                    ادامه تأیید موبایل
                                </a>
                            </div>
                        }
                    </div>


                    <!-- Email -->
                    <div class="form-group">

                        <label asp-for="Input.Email">
                            ایمیل یا موبایل
                        </label>

                        <div class="input-group">

                            <div class="input-group-prepend">

                                <span class="input-group-text">
                                    <i class="fa fa-envelope"></i>
                                </span>

                            </div>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   aria-required="true"
                                   placeholder="ایمیل یا موبایل (برای پیامک، با 09)" />

                        </div>

                        <span asp-validation-for="Input.Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Password -->
                    <div class="form-group">

                        <label asp-for="Input.Password">
                            رمز عبور
                        </label>

                        <div class="input-group">

                            <div class="input-group-prepend">

                                <span class="input-group-text">
                                    <i class="fa fa-lock"></i>
                                </span>

                            </div>

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   aria-required="true"
                                   placeholder="رمز عبور خود را وارد کنید" />

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Remember Me -->
                    <div class="form-group">

                        <div class="custom-control custom-checkbox">

                            <input asp-for="Input.RememberMe"
                                   class="custom-control-input"
                                   id="rememberMe" />

                            <label asp-for="Input.RememberMe"
                                   class="custom-control-label"
                                   for="rememberMe">

                                مرا به خاطر بسپار

                            </label>

                        </div>

                    </div>


                    <!-- Login -->
                    <button id="login-submit"
                            type="submit"
                            class="btn btn-primary btn-block">

                        <i class="fa fa-sign-in"></i>
                        ورود

                    </button>


                    <!-- Links -->
                    <div class="text-center mt-3">

                        <p>
                            <a id="forgot-password"
                               asp-page="./ForgotPassword">

                                <i class="fa fa-question-circle"></i>
                                رمز عبور خود را فراموش کرده‌اید؟

                            </a>
                        </p>

                        <p>
                            حساب کاربری ندارید؟

                            <a asp-page="./Register"
                               asp-route-returnUrl="@Model.ReturnUrl">

                                ثبت نام کنید

                            </a>
                        </p>

                        <p>
                            <a id="resend-confirmation"
                               asp-page="./ResendEmailConfirmation">

                                <i class="fa fa-envelope"></i>
                                ارسال مجدد تأیید ایمیل

                            </a>
                        </p>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
