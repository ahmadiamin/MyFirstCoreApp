@page
@model ResetPasswordByOtpModel

@{
    ViewData["Title"] = "تعیین رمز عبور جدید";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card card-primary">

            <div class="card-header text-center">
                <h3 class="card-title float-none">
                    <i class="fa fa-lock"></i>
                    تعیین رمز عبور جدید
                </h3>
            </div>

            <div class="card-body">

                <p class="text-center text-muted mb-4">
                    کد بازیابی شما تأیید شده است.
                    اکنون رمز عبور جدید خود را وارد کنید.
                </p>

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.NewPassword">
                            رمز عبور جدید
                        </label>

                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="fa fa-lock"></i>
                                </span>
                            </div>

                            <input asp-for="Input.NewPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="رمز عبور جدید را وارد کنید" />
                        </div>

                        <span asp-validation-for="Input.NewPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword">
                            تکرار رمز عبور جدید
                        </label>

                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="fa fa-lock"></i>
                                </span>
                            </div>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="رمز عبور را مجدداً وارد کنید" />
                        </div>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary btn-block">
                        <i class="fa fa-check"></i>
                        ثبت رمز عبور جدید
                    </button>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}