@model List<MyFirstCoreApp.Areas.Accounting.ViewModels.FiscalYear.FiscalYearListItemViewModel>
@{
    ViewData["Title"] = "سال‌های مالی";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-calendar"></i>
            سال‌های مالی
        </h3>
        <div class="card-tools">
            <a asp-area="Accounting" asp-controller="FiscalYears" asp-action="Create"
               class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> سال مالی جدید
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>شروع</th>
                    <th>پایان</th>
                    <th>تعداد سند</th>
                    <th>وضعیت</th>
                    <th style="width: 260px">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var year in Model)
                {
                    <tr>
                        <td>
                            @year.Name
                            @if (year.IsCurrent)
                            {
                                <span class="badge badge-info mr-1">جاری</span>
                            }
                        </td>
                        <td dir="ltr" class="text-right">@year.StartDate</td>
                        <td dir="ltr" class="text-right">@year.EndDate</td>
                        <td>@year.TransactionCount</td>
                        <td>
                            @if (year.IsClosed)
                            {
                                <span class="badge badge-secondary" title="بسته‌شده در @year.ClosedAt">
                                    <i class="fa fa-lock"></i> بسته
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-success">
                                    <i class="fa fa-unlock"></i> باز
                                </span>
                            }
                        </td>
                        <td>
                            @if (!year.IsClosed)
                            {
                                <a asp-action="Edit" asp-route-id="@year.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-edit"></i> ویرایش
                                </a>

                                <form asp-action="Close" asp-route-id="@year.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('بعد از بستن، ثبت یا تغییر سند در این سال ممکن نیست. ادامه می‌دهید؟');">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">
                                        <i class="fa fa-lock"></i> بستن
                                    </button>
                                </form>

                                @if (year.TransactionCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@year.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('این سال مالی حذف شود؟');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa fa-trash"></i> حذف
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                <form asp-action="Reopen" asp-route-id="@year.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('این سال مالی دوباره باز شود؟');">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa fa-unlock"></i> باز کردن
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted p-4">
                            هنوز سال مالی تعریف نشده است. با ثبت اولین سند، سال مالی همان تاریخ خودکار ساخته می‌شود،
                            یا همین حالا یکی تعریف کنید.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted">
        <i class="fa fa-info-circle"></i>
        هر سند در سالی قرار می‌گیرد که تاریخ سند در بازه‌ی آن است. در سال بسته ثبت، ویرایش، قطعی‌کردن و حذف سند ممکن نیست.
    </div>
</div>
