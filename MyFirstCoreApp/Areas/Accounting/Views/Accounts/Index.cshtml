@{
    ViewData["Title"] = "حساب‌ها";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-university"></i>
            لیست حساب‌ها
        </h3>
        <div class="card-tools">
            <a asp-area="Accounting" asp-controller="Accounts" asp-action="Create"
               class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> حساب جدید
            </a>
        </div>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                    </div>
                    <input type="text" id="txtSearch" class="form-control"
                           placeholder="جستجو در نام، کد، بانک..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <div id="accountsGrid" class="ag-theme-alpine"
             style="height: 600px; width: 100%;">
        </div>

    </div>
</div>
@Html.AntiForgeryToken()
@section Scripts {
    <script>
        // ============================================
        // 🆕 متغیر global برای Grid API
        // ============================================
        let accountsGridApi = null;

        $(document).ready(function () {

            // ============================================
            // ۱. تعریف ستون‌ها
            // ============================================
            const columnDefs = [
                AgGridHelper.rowNumberColumn(),
                {
                    field: 'name',
                    headerName: 'نام',
                    flex: 2,
                    minWidth: 200
                },
                {
                    field: 'code',
                    headerName: 'کد',
                    width: 100
                },
                {
                    field: 'categoryName',
                    headerName: 'دسته',
                    width: 130
                },
                {
                    field: 'accountTypeName',
                    headerName: 'نوع',
                    width: 100
                },
                {
                    field: 'bankName',
                    headerName: 'بانک',
                    width: 120
                },
                {
                    field: 'accountNumber',
                    headerName: 'شماره حساب',
                    width: 150
                },
                AgGridHelper.moneyColumn('currentBalance', 'مانده', 140),
                {
                    headerName: 'پیش‌فرض',
                    field: 'isDefault',
                    width: 90,
                    sortable: false,
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        if (params.value) {
                            const span = document.createElement('span');
                            span.className = 'badge badge-info';
                            span.textContent = 'پیش‌فرض';
                            return span;
                        }
                        return '';
                    }
                },
                AgGridHelper.statusColumn('isActive'),
                {
                    headerName: 'عملیات',
                    colId: 'actions',
                    width: 150,
                    sortable: false,
                    filter: false,
                    pinned: 'left',
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const div = document.createElement('div');
                        div.className = 'action-buttons';
                        const d = params.data;

                        // ✏ ویرایش
                        const editBtn = document.createElement('a');
                        editBtn.href = `/Accounting/Accounts/Edit/${d.id}`;
                        editBtn.className = 'btn btn-sm btn-outline-primary action-icon-btn';
                        editBtn.title = 'ویرایش';
                        editBtn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
                        div.appendChild(editBtn);

                        // 🗑 حذف
                        const deleteBtn = document.createElement('a');
                        deleteBtn.href = 'javascript:void(0)';
                        deleteBtn.className = 'btn btn-sm btn-outline-danger action-icon-btn delete-btn';
                        deleteBtn.dataset.id = d.id;
                        deleteBtn.dataset.title = d.name || '';
                        deleteBtn.dataset.code = d.code || '';
                        deleteBtn.dataset.category = d.categoryName || '';
                        deleteBtn.title = 'حذف';
                        deleteBtn.innerHTML = '<i class="fa-solid fa-trash"></i>';
                        div.appendChild(deleteBtn);

                        return div;
                    }
                }
            ];

            // ============================================
            // ۲. ساخت Grid
            // ============================================
            accountsGridApi = AgGridHelper.create(
                'accountsGrid',
                columnDefs,
                '/Accounting/Accounts/GetData',
                'txtSearch',
                'lblCount'
            );

        });

        // ============================================
        // ۳. رویداد حذف
        // ============================================
        $(document).on('click', '.delete-btn', function () {
            const $btn = $(this);
            const id = $btn.data('id');
            const title = $btn.data('title');
            const code = $btn.data('code');
            const category = $btn.data('category');

            // 🆕 ساخت items
            const items = [];
            if (title) items.push({ label: 'نام', value: title });
            if (code) items.push({ label: 'کد', value: code });
            if (category) items.push({ label: 'دسته', value: category });

            // 🆕 نمایش Modal
            ModalHelper.confirmDelete({
                url: '/Accounting/Accounts/Delete',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                title: 'حذف حساب: ' + title,
                message: 'آیا از حذف این حساب مطمئن هستید؟ این عملیات قابل بازگشت نیست.',
                items: items,
                onSuccess: function () {
                    // 🆕 رفرش Grid
                    if (accountsGridApi) {
                        const ds = accountsGridApi.getGridOption('datasource');
                        accountsGridApi.setGridOption('datasource', ds);
                    } else {
                        location.reload();
                    }
                }
            });
        });
    </script>
}