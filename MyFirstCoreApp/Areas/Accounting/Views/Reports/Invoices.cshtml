@model MyFirstCoreApp.Areas.Accounting.ViewModels.Report.InvoiceReportViewModel
@{
    ViewData["Title"] = "گزارش فاکتورها";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title"><i class="fa fa-filter"></i> فیلتر</h3>
    </div>
    <form method="get" asp-area="Accounting" asp-controller="Reports" asp-action="Invoices">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>نوع</label>
                        <select name="invoiceType" class="form-control select2"
                                asp-for="InvoiceType" asp-items="Model.InvoiceTypeOptions">
                            <option value="">همه</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>وضعیت</label>
                        <select name="status" class="form-control select2"
                                asp-for="Status" asp-items="Model.StatusOptions">
                            <option value="">همه</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>طرف حساب</label>
                        <select name="contactId" class="form-control select2"
                                asp-for="ContactId" asp-items="Model.ContactOptions">
                            <option value="">همه</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="onlyOpen" name="onlyOpen" value="true"
                                   @(Model.OnlyOpen ? "checked" : "") />
                            <label class="custom-control-label" for="onlyOpen">فقط دارای باقی‌مانده</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>از تاریخ</label>
                        <input type="text" name="fromDate" value="@Model.FromDate" class="form-control datepicker" autocomplete="off" dir="ltr" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>تا تاریخ</label>
                        <input type="text" name="toDate" value="@Model.ToDate" class="form-control datepicker" autocomplete="off" dir="ltr" />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> نمایش گزارش</button>
        </div>
    </form>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="info-box">
            <span class="info-box-icon bg-info"><i class="fa fa-file-invoice"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">تعداد فاکتور</span>
                <span class="info-box-number">@Model.Count.ToString("N0")</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="info-box">
            <span class="info-box-icon bg-primary"><i class="fa fa-coins"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">جمع مبلغ</span>
                <span class="info-box-number">@Model.TotalAmount.ToString("N0")</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="info-box">
            <span class="info-box-icon bg-success"><i class="fa fa-check"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">پرداخت‌شده + تخفیف تسویه</span>
                <span class="info-box-number">@((Model.TotalPaid + Model.TotalSettlementDiscount).ToString("N0"))</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="info-box">
            <span class="info-box-icon bg-warning"><i class="fa fa-hourglass-half"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">باقی‌مانده</span>
                <span class="info-box-number">@Model.TotalRemaining.ToString("N0")</span>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped mb-0">
            <thead>
                <tr>
                    <th>شماره</th>
                    <th>نوع</th>
                    <th>تاریخ</th>
                    <th>طرف حساب</th>
                    <th>وضعیت</th>
                    <th class="text-left">مبلغ</th>
                    <th class="text-left">پرداخت‌شده</th>
                    <th class="text-left">تخفیف تسویه</th>
                    <th class="text-left">باقی‌مانده</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>
                            <a asp-area="Invoicing" asp-controller="Invoices" asp-action="Details" asp-route-id="@row.Id">@row.Number</a>
                        </td>
                        <td>@row.InvoiceTypeName</td>
                        <td dir="ltr" class="text-right">@row.DateShamsi</td>
                        <td>@row.ContactName</td>
                        <td>@row.StatusName</td>
                        <td class="text-left">@row.TotalAmount.ToString("N0")</td>
                        <td class="text-left">@row.PaidAmount.ToString("N0")</td>
                        <td class="text-left">@row.SettlementDiscount.ToString("N0")</td>
                        <td class="text-left @(row.RemainingAmount > 0 ? "text-danger font-weight-bold" : "")">@row.RemainingAmount.ToString("N0")</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted p-4">فاکتوری با این فیلتر پیدا نشد.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer clearfix">
            <ul class="pagination pagination-sm m-0 float-right">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.Page) <= 2)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-area="Accounting" asp-controller="Reports" asp-action="Invoices"
                               asp-route-invoiceType="@Model.InvoiceType"
                               asp-route-status="@Model.Status"
                               asp-route-contactId="@Model.ContactId"
                               asp-route-fromDate="@Model.FromDate"
                               asp-route-toDate="@Model.ToDate"
                               asp-route-onlyOpen="@Model.OnlyOpen"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    else if (Math.Abs(p - Model.Page) == 3)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
            </ul>
            <span class="text-muted">صفحه @Model.Page از @Model.TotalPages</span>
        </div>
    }
</div>

@section Scripts {
    <script>
                $(document).ready(function () {
            // Select2
            $('.select2').select2({
                dir: 'rtl',
                placeholder: '-- انتخاب --',
                allowClear: true,
                width: '100%',
                language: 'fa'
            });

            // DatePicker
            $('.datepicker').each(function () {
                var $input = $(this);
                var val = $input.val();

                $input.persianDatepicker({
                    format: 'YYYY/MM/DD',
                    initialValue: !!val,
                    initialValueType: 'persian',
                    autoClose: true,
                    observer: true,
                    calendar: {
                        persian: { locale: 'fa', showHint: true, leapYearMode: 'algorithmic' }
                    },
                    toolbox: { calendarSwitch: { enabled: false } }
                });
            });
        });
    </script>
}
