@using DNTPersianUtils.Core
@using MyFirstCoreApp.Application.Common.Utilities
@model MyFirstCoreApp.Domain.Entities.Accounting.Transaction
@{
    ViewData["Title"] = $"مشاهده سند شماره {Model.Number}";
}

<div class="card card-info">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-file-text"></i>
            مشاهده سند شماره @Model.Number
        </h3>
        <div class="card-tools">
            @if (Model.IsPosted)
            {
                <span class="badge badge-success">
                    <i class="fa fa-check"></i> قطعی
                </span>
            }
            else
            {
                <span class="badge badge-warning">
                    <i class="fa fa-clock"></i> پیش‌نویس
                </span>
            }
        </div>
    </div>

    <div class="card-body">
        <!-- اطلاعات سند -->
        <div class="row">
            <div class="col-md-3">
                <strong>شماره سند:</strong>
                <span class="persian-number">@Model.Number</span>
            </div>
            <div class="col-md-3">
                <strong>تاریخ:</strong>
                <span>@PersianDate.Format(Model.Date)</span>
            </div>
            <div class="col-md-3">
                <strong>گروه:</strong>
                <span>@Model.TransactionGroup?.Name</span>
            </div>
            <div class="col-md-3">
                <strong>مرجع:</strong>
                <span>@Model.Reference</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="row mt-2">
                <div class="col-md-12">
                    <strong>شرح:</strong>
                    <span>@Model.Description</span>
                </div>
            </div>
        }

        <hr />

        <!-- خطوط سند -->
        <h5>
            <i class="fa fa-list"></i>
            خطوط سند
        </h5>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th style="width: 40px;">#</th>
                    <th>حساب</th>
                    <th>طرف حساب</th>
                    <th>بدهکار</th>
                    <th>بستانکار</th>
                    <th>شرح</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var i = 1;
                }
                @foreach (var line in Model.Lines.OrderBy(l => l.LineNumber))
                {
                    <tr>
                        <td class="persian-number">@i</td>
                        <td>@line.Account?.Name</td>
                        <td>@line.Contact?.Name</td>
                        <td class="persian-number-comma">@line.Debit.ToString("N0")</td>
                        <td class="persian-number-comma">@line.Credit.ToString("N0")</td>
                        <td>@line.Description</td>
                    </tr>
                    i++;
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-left">مجموع:</th>
                    <th class="persian-number-comma">@Model.Lines.Sum(l => l.Debit).ToString("N0")</th>
                    <th class="persian-number-comma">@Model.Lines.Sum(l => l.Credit).ToString("N0")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa fa-arrow-right"></i> بازگشت
        </a>

        @if (!Model.IsPosted)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fa fa-edit"></i> ویرایش
            </a>

            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                <i class="fa fa-trash"></i> حذف
            </a>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}