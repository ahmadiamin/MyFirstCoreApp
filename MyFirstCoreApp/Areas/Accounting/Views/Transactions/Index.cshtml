@{
    ViewData["Title"] = "اسناد حسابداری";
}

<style>
    #transactionsGrid.ag-theme-alpine {
        --ag-font-size: 13px;
        width: 100%;
    }

    @@media (max-width: 767.98px) {
        #transactionsGrid.ag-theme-alpine {
            --ag-font-size: 12px;
        }
    }

    .action-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
        justify-content: flex-start;
        align-items: center;
    }

        .action-buttons .btn {
            padding: 3px 6px;
            line-height: 1;
        }

    .ag-right-aligned-header .ag-header-cell-label {
        justify-content: flex-end;
    }

    .tx-card {
        border: 1px solid #e3e3e3;
        border-radius: 6px;
        background: #fff;
        margin-bottom: 8px;
        padding: 10px;
    }

        .tx-card .title {
            font-weight: 600;
            font-size: 14px;
        }

        .tx-card .row-line {
            font-size: 12px;
            color: #6c757d;
            margin-top: 3px;
            word-break: break-all;
        }

        .tx-card .amount {
            font-weight: 600;
            color: #0d6efd;
            margin-top: 4px;
            font-size: 13px;
        }

        .tx-card .actions {
            margin-top: 8px;
        }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-file-text"></i>
            لیست اسناد حسابداری
        </h3>
        <div class="card-tools">
            <a asp-area="Accounting" asp-controller="Transactions" asp-action="Create"
               class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> سند جدید
            </a>
        </div>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                    </div>
                    <input type="text" id="txtSearch" class="form-control"
                           placeholder="جستجو در شماره، شرح، مرجع..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <!-- دسکتاپ: AG Grid -->
        <div id="transactionsGrid" class="ag-theme-alpine d-none d-md-block"
             style="height: 600px; width: 100%;">
        </div>

        <!-- موبایل: کارت‌ها -->
        <div id="mobileTransactions" class="d-md-none"></div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            var gridApi = null;
            var allRows = [];

            // ============================================
            // ۱. ستون‌ها
            // ============================================
            const columnDefs = [
                {
                    headerName: '#',
                    colId: '#',
                    width: 60,
                    sortable: false,
                    filter: false,
                    resizable: false,
                    valueGetter: function (params) {
                        var page = gridApi ? gridApi.paginationGetCurrentPage() : 0;
                        var size = gridApi ? gridApi.paginationGetPageSize() : 20;
                        return toPersianDigits(page * size + params.node.rowIndex + 1);
                    },
                    cellStyle: { textAlign: 'center', direction: 'ltr' }
                },
                {
                    field: 'number',
                    headerName: 'شماره',
                    width: 90,
                    cellStyle: { textAlign: 'center' },
                    valueFormatter: function (p) {
                        return p.value != null ? toPersianDigits(p.value) : '';
                    }
                },
                { field: 'date', headerName: 'تاریخ', width: 110,
                    cellStyle: { textAlign: 'center' } },
                { field: 'description', headerName: 'شرح', flex: 2, minWidth: 200 },
                { field: 'groupName', headerName: 'گروه', width: 130 },
                { field: 'reference', headerName: 'مرجع', width: 120,
                    cellStyle: { direction: 'ltr', textAlign: 'right' } },
                {
                    field: 'totalAmount',
                    headerName: 'مبلغ',
                    width: 140,
                    cellStyle: { textAlign: 'left', direction: 'ltr' },
                    valueFormatter: function (p) {
                        if (p.value == null) return '';
                        var n = Number(p.value);
                        if (isNaN(n)) return p.value;
                        return toPersianDigits(n.toLocaleString('en-US'));
                    }
                },
                {
                    headerName: 'وضعیت',
                    field: 'isPosted',
                    width: 100,
                    sortable: false,
                    cellRenderer: function (p) {
                        return p.value
                            ? '<span class="badge badge-success">قطعی</span>'
                            : '<span class="badge badge-warning">پیش‌نویس</span>';
                    }
                },
                {
                    headerName: 'عملیات',
                    colId: 'actions',
                    width: 200,
                    sortable: false,
                    filter: false,
                    pinned: 'left',
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        return '<div class="action-buttons">' + buildActionButtons(params.data) + '</div>';
                    }
                }
            ];

            // ============================================
            // ۲. دکمه‌های عملیات (مشترک دسکتاپ/موبایل)
            // ============================================
            function buildActionButtons(d) {
                var html = '';

                // 👁 مشاهده (همیشه)
                html += '<a href="/Accounting/Transactions/Details/' + d.id + '" ' +
                        'class="btn btn-sm btn-outline-info action-icon-btn" title="مشاهده">' +
                        '<i class="fa-solid fa-eye"></i></a>';

                // سند خودکار؟
                var isAuto = d.referenceType && d.referenceType !== '';

                if (!isAuto) {
                    // ✅ قطعی / ↩ برگشت
                    if (!d.isPosted) {
                        html += '<a href="javascript:void(0)" ' +
                                'class="btn btn-sm btn-outline-success action-icon-btn post-btn" ' +
                                'data-id="' + d.id + '" title="قطعی کردن">' +
                                '<i class="fa-solid fa-circle-check"></i></a>';
                    } else {
                        html += '<a href="javascript:void(0)" ' +
                                'class="btn btn-sm btn-outline-warning action-icon-btn unpost-btn" ' +
                                'data-id="' + d.id + '" title="برگشت به پیش‌نویس">' +
                                '<i class="fa-solid fa-rotate-left"></i></a>';
                    }

                    // ✏ ویرایش (فقط پیش‌نویس)
                    if (!d.isPosted) {
                        html += '<a href="/Accounting/Transactions/Edit/' + d.id + '" ' +
                                'class="btn btn-sm btn-outline-primary action-icon-btn" title="ویرایش">' +
                                '<i class="fa-solid fa-pen-to-square"></i></a>';
                    }

                    // 🗑 حذف (فقط پیش‌نویس)
                    if (!d.isPosted) {
                        html += '<a href="javascript:void(0)" ' +
                                'class="btn btn-sm btn-outline-danger action-icon-btn delete-btn" ' +
                                'data-id="' + d.id + '" ' +
                                'data-title="' + escapeAttr(d.number) + '" ' +
                                'data-desc="' + escapeAttr(d.description) + '" ' +
                                'data-amount="' + (d.totalAmount || 0) + '" ' +
                                'title="حذف">' +
                                '<i class="fa-solid fa-trash"></i></a>';
                    }
                } else {
                    // سند خودکار
                    html += '<span class="badge badge-secondary" ' +
                            'title="سند خودکار - از صفحه‌ی مربوطه مدیریت کنید">' +
                            '<i class="fa-solid fa-lock"></i> خودکار</span>';
                }

                return html;
            }

            function escapeAttr(s) {
                return (s == null ? '' : String(s))
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            // ============================================
            // ۳. ساخت Grid
            // ============================================
            function buildGrid() {
                if (gridApi) return;

                var gridOptions = {
                    columnDefs: columnDefs,
                    enableRtl: true,
                    defaultColDef: {
                        sortable: true,
                        filter: false,
                        resizable: true,
                        cellStyle: { textAlign: 'right', direction: 'rtl' },
                        headerClass: 'ag-right-aligned-header'
                    },
                    pagination: true,
                    paginationPageSize: 20,
                    paginationPageSizeSelector: [10, 20, 50, 100],
                    localeText: {
                        page: 'صفحه', to: 'تا', of: 'از', next: 'بعدی', last: 'آخر',
                        first: 'اول', previous: 'قبلی', loadingOoo: 'در حال بارگذاری...',
                        noRowsToShow: 'داده‌ای برای نمایش نیست',
                        pageSizeSelectorLabel: 'تعداد در صفحه:'
                    },
                    onPaginationChanged: function () {
                        if (gridApi) gridApi.refreshCells({ columns: ['#'], force: true });
                    }
                };

                var gridDiv = document.getElementById('transactionsGrid');
                gridApi = agGrid.createGrid(gridDiv, gridOptions);
                loadData();
            }

            // ============================================
            // ۴. بارگذاری داده
            // ============================================
            function loadData() {
                var request = {
                    startRow: 0,
                    endRow: 10000,
                    search: ($('#txtSearch').val() || '').trim(),
                    sortBy: null,
                    sortDir: null
                };

                if (gridApi) {
                    try {
                        var state = gridApi.getColumnState() || [];
                        var sorted = state.filter(function (c) { return c.sort; });
                        if (sorted.length) {
                            request.sortBy = sorted[0].colId;
                            request.sortDir = sorted[0].sort;
                        }
                    } catch (e) { /* ignore */ }
                }

                $.ajax({
                    url: '/Accounting/Transactions/GetData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(request),
                    success: function (result) {
                        var rows = [];
                        var total = 0;
                        if (Array.isArray(result)) {
                            rows = result;
                            total = result.length;
                        } else if (result && Array.isArray(result.rows)) {
                            rows = result.rows;
                            total = result.lastRow || rows.length;
                        } else if (result && Array.isArray(result.data)) {
                            rows = result.data;
                            total = result.total || rows.length;
                        }

                        allRows = rows;

                        if (gridApi) {
                            gridApi.setGridOption('rowData', allRows);
                            setTimeout(function () {
                                gridApi.refreshCells({ columns: ['#'], force: true });
                            }, 50);
                        }

                        $('#lblCount').text('تعداد: ' + toPersianDigits(total));

                        if (isMobile()) {
                            renderMobileList(allRows);
                        }
                    },
                    error: function (xhr) {
                        console.error('GetData error:', xhr.status, xhr.responseText);
                        $('#lblCount').text('خطا در بارگذاری (کد ' + xhr.status + ')');
                    }
                });
            }

            // ============================================
            // ۵. جستجو
            // ============================================
            var searchTimer = null;
            $('#txtSearch').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () {
                    loadData();
                }, 300);
            });

            // ============================================
            // ۶. موبایل
            // ============================================
            function renderMobileList(rows) {
                var container = document.getElementById('mobileTransactions');
                var html = '';

                if (!rows || !rows.length) {
                    container.innerHTML = '<div class="text-center text-muted py-4">' +
                        '<i class="fa fa-info-circle fa-2x mb-2"></i><br/>داده‌ای برای نمایش نیست</div>';
                    return;
                }

                rows.forEach(function (d, index) {
                    var amountHtml = '';
                    if (d.totalAmount != null) {
                        var n = Number(d.totalAmount);
                        var formatted = isNaN(n) ? d.totalAmount : n.toLocaleString('en-US');
                        amountHtml = '<div class="amount">مبلغ: ' + toPersianDigits(formatted) + ' ریال</div>';
                    }

                    html += '<div class="tx-card">' +
                        '<div class="d-flex justify-content-between align-items-start">' +
                            '<div class="title">' +
                                '<span class="badge badge-secondary ml-1">' + toPersianDigits(index + 1) + '</span>' +
                                '<i class="fa fa-file-text text-muted ml-1"></i>' +
                                'سند ' + toPersianDigits(d.number || '') +
                            '</div>' +
                            (d.isPosted
                                ? '<span class="badge badge-success">قطعی</span>'
                                : '<span class="badge badge-warning">پیش‌نویس</span>') +
                        '</div>' +
                        (d.date ? '<div class="row-line">تاریخ: ' + d.date + '</div>' : '') +
                        (d.description ? '<div class="row-line">' + d.description + '</div>' : '') +
                        (d.groupName ? '<div class="row-line">گروه: ' + d.groupName + '</div>' : '') +
                        (d.reference ? '<div class="row-line">مرجع: <span dir="ltr">' + d.reference + '</span></div>' : '') +
                        amountHtml +
                        '<div class="actions">' + buildActionButtons(d) + '</div>' +
                    '</div>';
                });

                container.innerHTML = html;
            }

            // ============================================
            // ۷. ابزار
            // ============================================
            function toPersianDigits(n) {
                return String(n).replace(/\d/g, function (d) {
                    return '۰۱۲۳۴۵۶۷۸۹'[d];
                });
            }

            function isMobile() {
                return window.matchMedia('(max-width: 767.98px)').matches;
            }

            // ============================================
            // ۸. سوئیچ دسکتاپ/موبایل
            // ============================================
            function applyLayout() {
                var gridDiv = document.getElementById('transactionsGrid');
                var mobileDiv = document.getElementById('mobileTransactions');

                if (isMobile()) {
                    gridDiv.classList.add('d-none');
                    mobileDiv.classList.remove('d-md-none');
                    if (!allRows.length) loadData();
                    else renderMobileList(allRows);
                } else {
                    gridDiv.classList.remove('d-none');
                    mobileDiv.classList.add('d-md-none');
                    if (!gridApi) buildGrid();
                }
            }

            // ============================================
            // ۹. حذف با Modal
            // ============================================
            $(document).on('click', '.delete-btn', function () {
                var $btn = $(this);
                var id = $btn.data('id');
                var title = $btn.data('title');
                var desc = $btn.data('desc');
                var amount = $btn.data('amount');

                var items = [];
                if (title) items.push({ label: 'شماره سند', value: title });
                if (desc) items.push({ label: 'شرح', value: desc });
                if (amount) {
                    var n = Number(amount);
                    items.push({ label: 'مبلغ', value: (isNaN(n) ? amount : n.toLocaleString('en-US')) + ' ریال' });
                }

                ModalHelper.confirmDelete({
                    url: '/Accounting/Transactions/Delete',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    title: 'حذف سند شماره ' + title,
                    message: 'آیا از حذف این سند مطمئن هستید؟ این عملیات قابل بازگشت نیست.',
                    items: items,
                    onSuccess: function () {
                        loadData();
                    }
                });
            });

            // ============================================
            // ۱۰. قطعی کردن
            // ============================================
            $(document).on('click', '.post-btn', function () {
                var id = $(this).data('id');

                ModalHelper.confirm(
                    'آیا از قطعی کردن این سند مطمئن هستید؟',
                    function () {
                        $.ajax({
                            url: '/Accounting/Transactions/Post',
                            type: 'POST',
                            data: {
                                id: id,
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (r) {
                                if (r.success) {
                                    ModalHelper.success(r.message || 'سند قطعی شد.', {
                                        onClose: function () { loadData(); }
                                    });
                                } else {
                                    ModalHelper.error(r.message);
                                }
                            },
                            error: function (xhr) {
                                ModalHelper.error('خطا در قطعی کردن (کد ' + xhr.status + ')');
                            }
                        });
                    },
                    { title: 'قطعی کردن سند', icon: 'fa-solid fa-circle-check' }
                );
            });

            // ============================================
            // ۱۱. برگشت به پیش‌نویس
            // ============================================
            $(document).on('click', '.unpost-btn', function () {
                var id = $(this).data('id');

                ModalHelper.confirm(
                    'آیا از برگشت این سند به پیش‌نویس مطمئن هستید؟',
                    function () {
                        $.ajax({
                            url: '/Accounting/Transactions/Unpost',
                            type: 'POST',
                            data: {
                                id: id,
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (r) {
                                if (r.success) {
                                    ModalHelper.success(r.message || 'سند به پیش‌نویس برگشت.', {
                                        onClose: function () { loadData(); }
                                    });
                                } else {
                                    ModalHelper.error(r.message);
                                }
                            },
                            error: function (xhr) {
                                ModalHelper.error('خطا در برگشت سند (کد ' + xhr.status + ')');
                            }
                        });
                    },
                    { title: 'برگشت سند', icon: 'fa-solid fa-rotate-left' }
                );
            });

            // ============================================
            // ۱۲. شروع
            // ============================================
            applyLayout();

            var mql = window.matchMedia('(max-width: 767.98px)');
            mql.addEventListener('change', applyLayout);

        });
    </script>
}