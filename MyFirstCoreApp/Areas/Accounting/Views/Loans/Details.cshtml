@using MyFirstCoreApp.Domain.Enums
@model MyFirstCoreApp.Areas.Accounting.ViewModels.Loan.LoanDetailsViewModel
@{
    ViewData["Title"] = "قرض شماره " + Model.Loan.Number;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card card-outline @(Model.Loan.IsGiven ? "card-success" : "card-warning")">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fa fa-handshake"></i>
                    @(Model.Loan.IsGiven ? "قرض داده‌شده به" : "قرض گرفته‌شده از") @Model.Loan.ContactName
                </h3>
                <div class="card-tools">
                    <a asp-action="Index" class="btn btn-sm btn-secondary"><i class="fa fa-arrow-right"></i> لیست</a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">شماره سند</dt>
                    <dd class="col-sm-9">@Model.Loan.Number</dd>
                    <dt class="col-sm-3">تاریخ</dt>
                    <dd class="col-sm-9" dir="ltr">@Model.Loan.Date</dd>
                    <dt class="col-sm-3">مبلغ</dt>
                    <dd class="col-sm-9">@Model.Loan.Amount.ToString("N0") ریال</dd>
                    <dt class="col-sm-3">بازپرداخت‌شده</dt>
                    <dd class="col-sm-9">@Model.Loan.Repaid.ToString("N0") ریال</dd>
                    <dt class="col-sm-3">باقی‌مانده</dt>
                    <dd class="col-sm-9 font-weight-bold @(Model.Loan.Remaining > 0 ? "text-danger" : "text-success")">@Model.Loan.Remaining.ToString("N0") ریال</dd>
                    <dt class="col-sm-3">توضیحات</dt>
                    <dd class="col-sm-9">@Model.Loan.Description</dd>
                </dl>
            </div>
            @if (!Model.Repayments.Any())
            {
                <div class="card-footer">
                    <form asp-action="Delete" asp-route-id="@Model.Loan.Id" method="post"
                          onsubmit="return confirm('این قرض حذف شود؟');">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i> حذف قرض</button>
                    </form>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title"><i class="fa fa-rotate-left"></i> بازپرداخت‌ها</h3></div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr><th>شماره سند</th><th>تاریخ</th><th class="text-left">مبلغ</th><th>توضیحات</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var repayment in Model.Repayments)
                        {
                            <tr>
                                <td>@repayment.Number</td>
                                <td dir="ltr" class="text-right">@repayment.Date</td>
                                <td class="text-left">@repayment.Amount.ToString("N0")</td>
                                <td>@repayment.Description</td>
                                <td class="text-left">
                                    <form asp-action="DeleteRepayment" asp-route-id="@repayment.Id" asp-route-loanId="@Model.Loan.Id" method="post"
                                          class="d-inline" onsubmit="return confirm('این بازپرداخت حذف شود؟');">
                                        <button type="submit" class="btn btn-xs btn-outline-danger" title="حذف"><i class="fa fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5" class="p-0 border-top-0">
                                    @await Component.InvokeAsync("Attachments", new { entityType = AttachmentEntityType.Transaction, entityId = repayment.Id })
                                </td>
                            </tr>
                        }
                        @if (!Model.Repayments.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted p-3">هنوز بازپرداختی ثبت نشده است.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        @if (Model.Loan.Remaining > 0)
        {
            <div class="card card-primary card-outline">
                <div class="card-header"><h3 class="card-title"><i class="fa fa-plus"></i> ثبت بازپرداخت</h3></div>
                <form asp-action="Repay" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LoanId" value="@Model.Loan.Id" />
                    <div class="card-body">
                        <div class="form-group">
                            <label>حساب بانک/صندوق</label>
                            <select name="AccountId" asp-items="Model.AccountOptions" class="form-control select2" required>
                                <option value="">-- انتخاب --</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>مبلغ (ریال)</label>
                            <input name="AmountText" value="@Model.RepayForm.AmountText" class="form-control ltr persian-number persian-number-comma" dir="ltr" autocomplete="off" required />
                        </div>
                        <div class="form-group">
                            <label>تاریخ</label>
                            <input name="Date" value="@Model.RepayForm.Date" class="form-control datepicker" dir="ltr" autocomplete="off" required />
                        </div>
                        <div class="form-group">
                            <label>توضیحات</label>
                            <input name="Description" class="form-control" maxlength="500" />
                        </div>
                        <div class="form-group">
                            <label>رسید (اختیاری)</label>
                            <input type="file" name="Receipt" class="form-control-file" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary btn-block"><i class="fa fa-save"></i> ثبت بازپرداخت</button>
                    </div>
                </form>
            </div>
        }

        <div class="mt-3">
            @* رسید خودِ قرض *@
            @await Component.InvokeAsync("Attachments", new { entityType = AttachmentEntityType.Transaction, entityId = Model.Loan.Id })
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.datepicker').each(function () {
                var $input = $(this);
                var val = $input.val();
                $input.persianDatepicker({
                    format: 'YYYY/MM/DD', initialValue: false, autoClose: true, observer: true,
                    calendar: { persian: { locale: 'fa', showHint: true, leapYearMode: 'algorithmic' } },
                    toolbox: { calendarSwitch: { enabled: false } }
                });
                if (val) $input.persianDatepicker('setDate', val);
            });

            // Select2
            $('.select2').select2({
                dir: 'rtl',
                placeholder: '-- انتخاب --',
                allowClear: true,
                width: '100%',
                language: 'fa'
            });
        });
    </script>
}