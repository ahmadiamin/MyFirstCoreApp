@model MyFirstCoreApp.Models.ViewModels.EditRoleViewModel

@{
    ViewData["Title"] = "ویرایش نقش";
}

<div class="card card-primary">

    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-user"></i>
            ویرایش نقش
        </h3>
    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="form-group">

                <label asp-for="Name">
                    نام نقش
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="نام نقش" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>

            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h4 class="mb-0">
                    <i class="fa fa-key"></i>
                    دسترسی‌ها
                </h4>

            </div>

            @for (int groupIndex = 0;
                        groupIndex < Model.PermissionGroups.Count;
                        groupIndex++)
            {
                var group = Model.PermissionGroups[groupIndex];

                <div class="card card-outline card-secondary mb-3 permission-group">

                    <div class="card-header">

                        <h3 class="card-title">
                            <i class="fa fa-folder-open"></i>
                            @group.GroupName
                        </h3>

                        <div class="card-tools">

                            <button type="button"
                                    class="btn btn-primary btn-sm select-all"
                                    data-group="@groupIndex">
                                <i class="fa fa-check-square-o"></i>
                                انتخاب همه
                            </button>

                            <button type="button"
                                    class="btn btn-secondary btn-sm deselect-all"
                                    data-group="@groupIndex">
                                <i class="fa fa-square-o"></i>
                                لغو همه
                            </button>

                        </div>

                    </div>

                    <div class="card-body">

                        <div class="row">

                            @for (int permissionIndex = 0;
                                                    permissionIndex < group.Permissions.Count;
                                                    permissionIndex++)
                            {
                                var permission =
                                group.Permissions[permissionIndex];

                                <div class="col-md-6 col-lg-4 mb-3">

                                    <div class="custom-control custom-checkbox">

                                        <input type="hidden"
                                               asp-for="PermissionGroups[groupIndex].Permissions[permissionIndex].Id" />

                                        <input type="hidden"
                                               asp-for="PermissionGroups[groupIndex].Permissions[permissionIndex].Name" />

                                        <input type="hidden"
                                               asp-for="PermissionGroups[groupIndex].Permissions[permissionIndex].DisplayName" />

                                        <input type="checkbox"
                                               asp-for="PermissionGroups[groupIndex].Permissions[permissionIndex].Selected"
                                               class="custom-control-input permission-checkbox"
                                               data-group="@groupIndex"
                                               id="permission_@(groupIndex)_@(permissionIndex)" />

                                        <label class="custom-control-label"
                                               for="permission_@(groupIndex)_@(permissionIndex)">
                                            @(permission.DisplayName ?? permission.Name)
                                        </label>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

        <div class="card-footer">

            <button type="submit"
                    class="btn btn-primary">
                <i class="fa fa-save"></i>
                ذخیره
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="fa fa-arrow-right"></i>
                انصراف
            </a>

        </div>

    </form>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".select-all").forEach(function (button) {

                button.addEventListener("click", function () {

                    const group = this.closest(".permission-group");

                    if (!group)
                        return;

                    group.querySelectorAll(".permission-checkbox")
                        .forEach(function (checkbox) {
                            checkbox.checked = true;
                        });
                });
            });

            document.querySelectorAll(".deselect-all").forEach(function (button) {

                button.addEventListener("click", function () {

                    const group = this.closest(".permission-group");

                    if (!group)
                        return;

                    group.querySelectorAll(".permission-checkbox")
                        .forEach(function (checkbox) {
                            checkbox.checked = false;
                        });
                });
            });

        });
    </script>

}