@model IEnumerable<MyFirstCoreApp.Models.ViewModels.RoleListViewModel>
@using MyFirstCoreApp.Services.Interfaces
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "مدیریت نقش‌ها";
}

<div class="card card-primary">

    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-users"></i>
            مدیریت نقش‌ها
        </h3>

        <div class="card-tools">
            @if (await PermissionService.HasPermissionAsync(User, "Role.Create"))
            {
                <a asp-area="Admin"
                   asp-controller="Roles"
                   asp-action="Create"
                   class="btn btn-success btn-sm">

                    <i class="fa fa-plus"></i>
                    ایجاد نقش
                </a>
            }
        </div>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover table-striped mb-0">

                <thead>
                    <tr>
                        <th>نام نقش</th>
                        <th>تعداد کاربران</th>
                        <th>تعداد دسترسی‌ها</th>
                        <th style="width: 120px;">عملیات</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var role in Model)
                    {
                        <tr>

                            <td>
                                <i class="fa fa-user text-muted"></i>
                                <strong>@role.Name</strong>
                            </td>

                            <td>
                                <span class="badge badge-info">
                                    @role.UserCount
                                </span>
                            </td>

                            <td>
                                <span class="badge badge-primary">
                                    @role.PermissionCount
                                </span>
                            </td>

                            <td>

                                @if (await PermissionService.HasPermissionAsync(
                                                            User,
                                                            "Role.Edit"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@role.Id"
                                       class="btn btn-warning btn-sm"
                                       title="ویرایش">

                                        <i class="fa fa-edit"></i>
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="card-footer text-muted">

        تعداد نقش‌ها:
        <strong>@Model.Count()</strong>

    </div>

</div>