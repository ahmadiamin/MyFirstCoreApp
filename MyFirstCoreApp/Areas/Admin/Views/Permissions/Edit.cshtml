@model MyFirstCoreApp.Domain.Entities.Identity.Permission

@{
    ViewData["Title"] = "ویرایش دسترسی";
}

<div class="card card-primary">

    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-key"></i>
            ویرایش دسترسی
        </h3>
    </div>

    <form asp-area="Admin"
          asp-controller="Permissions"
          asp-action="Edit"
          method="post">

        <input asp-for="Id" type="hidden" />

        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row">

                <div class="col-md-6">

                    <div class="form-group">

                        <label asp-for="Name">
                            نام دسترسی
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group">

                        <label asp-for="DisplayName">
                            عنوان
                        </label>

                        <input asp-for="DisplayName"
                               class="form-control" />

                        <span asp-validation-for="DisplayName"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group">

                        <label asp-for="GroupName">
                            گروه
                        </label>

                        <input asp-for="GroupName"
                               class="form-control" />

                        <span asp-validation-for="GroupName"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group">

                        <label>
                            وضعیت
                        </label>

                        <div class="custom-control custom-checkbox mt-2">

                            <input asp-for="IsActive"
                                   class="custom-control-input"
                                   id="IsActive" />

                            <label asp-for="IsActive"
                                   class="custom-control-label"
                                   for="IsActive">
                                فعال
                            </label>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="card-footer">

            <button type="submit"
                    class="btn btn-primary">

                <i class="fa fa-save"></i>
                ذخیره

            </button>

            <a asp-area="Admin"
               asp-controller="Permissions"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="fa fa-arrow-right"></i>
                انصراف

            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}