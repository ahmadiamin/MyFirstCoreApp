@model MyFirstCoreApp.Models.ViewModels.MenuEditViewModel

@{
    ViewData["Title"] = "ایجاد منو";
}

<div class="card card-primary">

    <div class="card-header">

        <h3 class="card-title">
            <i class="fa fa-bars"></i>
            ایجاد منو
        </h3>

        <div class="card-tools">
            <a asp-area="Admin"
               asp-controller="Menus"
               asp-action="Index"
               class="btn btn-secondary btn-sm">

                <i class="fa fa-arrow-right"></i>
                بازگشت

            </a>
        </div>

    </div>

    <form asp-area="Admin"
          asp-controller="Menus"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <!-- عنوان -->
                <div class="col-md-6">
                    <div class="form-group">

                        <label asp-for="Title"></label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="عنوان منو" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>
                </div>

                <!-- آدرس -->
                <div class="col-md-6">
                    <div class="form-group">

                        <label asp-for="Url"></label>

                        <input asp-for="Url"
                               class="form-control"
                               placeholder="/Admin/Users" />

                        <span asp-validation-for="Url"
                              class="text-danger">
                        </span>

                    </div>
                </div>

                <!-- آیکون -->
                <div class="col-md-6">
                    <div class="form-group">

                        <label asp-for="Icon"></label>

                        <input asp-for="Icon"
                               class="form-control"
                               placeholder="fa fa-users" />

                        <small class="form-text text-muted">
                            کلاس آیکون Font Awesome را وارد کنید.
                            مثال:
                            <code>fa fa-users</code>
                        </small>

                        <span asp-validation-for="Icon"
                              class="text-danger">
                        </span>

                    </div>
                </div>

                <!-- منوی والد -->
                <div class="col-md-6">
                    <div class="form-group">

                        <label asp-for="ParentId"></label>

                        <select asp-for="ParentId"
                                class="form-control select2">

                            <option value="">
                                -- منوی ریشه --
                            </option>

                            @foreach (var parent in Model.Parents)
                            {
                                <option value="@parent.Id">
                                    @parent.Title
                                </option>
                            }

                        </select>

                        <span asp-validation-for="ParentId"
                              class="text-danger">
                        </span>

                    </div>
                </div>

                <!-- دسترسی -->
                <div class="col-md-6">
                    <div class="form-group">

                        <label asp-for="Permission"></label>

                        <select asp-for="Permission"
                                class="form-control select2">

                            <option value="">
                                -- بدون محدودیت دسترسی --
                            </option>

                            @foreach (var permission in Model.Permissions)
                            {
                                <option value="@permission.Name">
                                    @(string.IsNullOrWhiteSpace(permission.DisplayName)
                                                                    ? permission.Name
                                                                    : $"{permission.DisplayName} ({permission.Name})")
                            </option>
                                                        }

                        </select>

                        <span asp-validation-for="Permission"
                              class="text-danger">
                        </span>

                    </div>
                </div>

                <!-- ترتیب -->
                <div class="col-md-3">
                    <div class="form-group">

                        <label asp-for="SortOrder"></label>

                        <input asp-for="SortOrder"
                               type="number"
                               class="form-control"
                               min="1" />

                        <span asp-validation-for="SortOrder"
                              class="text-danger">
                        </span>

                    </div>
                </div>

                <!-- وضعیت -->
                <div class="col-md-3">

                    <div class="form-group">

                        <label>وضعیت</label>

                        <div class="custom-control custom-checkbox mt-2">

                            <input asp-for="IsActive"
                                   class="custom-control-input"
                                   id="IsActive" />

                            <label asp-for="IsActive"
                                   class="custom-control-label">
                            </label>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="card-footer">

            <button type="submit"
                    class="btn btn-primary">

                <i class="fa fa-save"></i>
                ذخیره

            </button>

            <a asp-area="Admin"
               asp-controller="Menus"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="fa fa-times"></i>
                انصراف

            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $('.select2').select2({
                width: '100%',
                dir: 'rtl',
                language: 'fa',
                placeholder: 'انتخاب کنید',
                allowClear: true
            });
        });
    </script>
}