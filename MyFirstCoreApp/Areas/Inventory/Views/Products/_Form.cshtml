@model ProductFormViewModel

<div class="row">

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" placeholder="مثلاً لپ‌تاپ ایسوس" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="form-control" placeholder="1001" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Barcode"></label>
            <input asp-for="Barcode" class="form-control ltr" placeholder="1234567890123" />
            <span asp-validation-for="Barcode" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="UnitId"></label>
            <select asp-for="UnitId" class="form-control select2" asp-items="Model.UnitOptions">
                <option value="">-- انتخاب واحد --</option>
            </select>
            <span asp-validation-for="UnitId" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="ProductCategoryId"></label>
            <select asp-for="ProductCategoryId" class="form-control select2" asp-items="Model.CategoryOptions">
                <option value="">-- بدون دسته --</option>
            </select>
            <span asp-validation-for="ProductCategoryId" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="TaxRate"></label>

            <input type="text"
                   id="TaxRate_Display"
                   class="form-control ltr persian-number"
                   data-target="TaxRate_Hidden"
                   value="@Model.TaxRate"
                   autocomplete="off" />

            <input asp-for="TaxRate" type="hidden" id="TaxRate_Hidden" />

            <span asp-validation-for="TaxRate" class="text-danger"></span>
        </div>
    </div>

    <!-- قیمت خرید -->
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="LastPurchasePrice"></label>

            <input type="text"
                   id="LastPurchasePrice_Display"
                   class="form-control ltr persian-number persian-number-comma"
                   data-target="LastPurchasePrice_Hidden"
                   value="@Model.LastPurchasePrice"
                   autocomplete="off" />

            <input asp-for="LastPurchasePrice" type="hidden" id="LastPurchasePrice_Hidden" />

            <span asp-validation-for="LastPurchasePrice" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="SalePrice"></label>

            <input type="text"
                   id="SalePrice_Display"
                   class="form-control ltr persian-number persian-number-comma"
                   data-target="SalePrice_Hidden"
                   value="@Model.SalePrice"
                   autocomplete="off" />

            <input asp-for="SalePrice" type="hidden" id="SalePrice_Hidden" />

            <span asp-validation-for="SalePrice" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="MinimumStock"></label>
            <input asp-for="MinimumStock" type="number" min="0" step="0.001" class="form-control ltr" />
            <span asp-validation-for="MinimumStock" class="text-danger"></span>
            <small class="form-text text-muted">خالی بگذارید تا هشدار حداقل موجودی غیرفعال باشد.</small>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label>وضعیت</label>
            <div class="custom-control custom-checkbox mt-2">
                <input asp-for="IsActive" class="custom-control-input" id="IsActive" />
                <label asp-for="IsActive" class="custom-control-label" for="IsActive">
                    فعال
                </label>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label>کنترل انبار</label>
            <div class="custom-control custom-checkbox mt-2">
                <input asp-for="TrackInventory" class="custom-control-input" id="TrackInventory" />
                <label asp-for="TrackInventory" class="custom-control-label" for="TrackInventory">
                    آیا موجودی در انبار کنترل شود؟
                </label>
            </div>
        </div>
    </div>

    @if (Model.Id == 0)
    {
        <div id="openingStockSection"
             class="col-md-12"
             style="display:@(Model.TrackInventory ? "block" : "none")">

            <div class="card card-outline card-info mt-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa fa-warehouse"></i>
                        موجودی اولیه کالا
                    </h3>
                </div>

                <div class="card-body">
                    <div class="alert alert-info">
                        در صورت داشتن موجودی از این کالا، اطلاعات آن را وارد کنید.
                        ثبت موجودی اولیه اختیاری است.
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="OpeningWarehouseId"></label>

                                <select asp-for="OpeningWarehouseId"
                                        asp-items="Model.WarehouseOptions"
                                        class="form-control select2">
                                    <option value="">-- انتخاب انبار --</option>
                                </select>

                                <span asp-validation-for="OpeningWarehouseId"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="OpeningQuantity"></label>

                                <input asp-for="OpeningQuantity"
                                       type="number"
                                       min="0"
                                       step="0.001"
                                       class="form-control ltr"
                                       placeholder="مثلاً 25" />

                                <span asp-validation-for="OpeningQuantity"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="OpeningUnitCost"></label>

                                <input asp-for="OpeningUnitCost"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control ltr"
                                       placeholder="مثلاً 1500000" />

                                <span asp-validation-for="OpeningUnitCost"
                                      class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <small class="text-muted">
                        بهای تمام‌شده برای محاسبات ارزش موجودی استفاده می‌شود.
                        در صورت نداشتن اطلاعات بهای تمام‌شده، می‌توانید صفر وارد کنید.
                    </small>
                </div>
            </div>
        </div>
    }
</div>
