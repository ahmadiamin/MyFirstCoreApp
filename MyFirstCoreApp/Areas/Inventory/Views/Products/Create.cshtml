@model ProductFormViewModel
@{
    ViewData["Title"] = "ایجاد کالا";
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-plus"></i>
            ایجاد کالا
        </h3>
    </div>

    <form asp-area="Inventory" asp-controller="Products" asp-action="Create" method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <partial name="_Form" model="Model" />
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save"></i> ذخیره
            </button>
            <a asp-area="Inventory" asp-controller="Products" asp-action="Index" class="btn btn-secondary">
                <i class="fa fa-arrow-right"></i> انصراف
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

           // ============================================
           // select2
           // ============================================
           $('.select2').select2({
               width: '100%',
               dir: 'rtl',
               language: 'fa',
               placeholder: 'انتخاب کنید',
               allowClear: true
           });
        });

        document.addEventListener("DOMContentLoaded", function () {
            const productType = document.getElementById("ProductType");

            const openingStockSection =
                document.getElementById("openingStockSection");

            if (!productType || !openingStockSection)
                return;

            function toggleOpeningStock(updateSaleability) {
                openingStockSection.style.display = productType.value === "2" ? "none" : "block";
                const isSaleable = document.getElementById("IsSaleable");
                if (updateSaleability && isSaleable)
                    isSaleable.checked = productType.value === "1" || productType.value === "2";
            }

            productType.addEventListener("change", function () { toggleOpeningStock(true); });

            toggleOpeningStock();
        });
    </script>
}
