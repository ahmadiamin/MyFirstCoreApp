@using MyFirstCoreApp.Domain.Enums
@model MyFirstCoreApp.Areas.Inventory.ViewModels.StockMovementReports.StockMovementReportViewModel
@{
    ViewData["Title"] = "گزارش گردش انبار";
}

<style>
    #movementGrid.ag-theme-alpine {
        --ag-font-size: 13px;
        width: 100%;
    }

    @@media (max-width: 767.98px) {
        #movementGrid.ag-theme-alpine {
            --ag-font-size: 12px;
        }
    }

    .ag-right-aligned-header .ag-header-cell-label {
        justify-content: flex-end;
    }

    .movement-card {
        border: 1px solid #e3e3e3;
        border-radius: 6px;
        background: #fff;
        margin-bottom: 8px;
        padding: 10px;
    }

    .movement-card .title {
        font-weight: 600;
        font-size: 14px;
    }

    .movement-card .row-line {
        font-size: 12px;
        color: #6c757d;
        margin-top: 3px;
        word-break: break-all;
    }
</style>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-arrow-right-arrow-left"></i> گزارش گردش اسناد انبار
        </h3>
    </div>
    <div class="card-body">

        <!-- ==========================================
             فرم فیلتر
             ========================================== -->
        <form asp-area="Inventory" asp-controller="StockMovementReports" asp-action="Index" method="get">
            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            <div class="row">
                <div class="col-md-6 col-lg-3 col-12 mb-2">
                    <label asp-for="WarehouseId">انبار</label>
                    <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-control select2">
                        <option value="">همهٔ انبارها</option>
                    </select>
                </div>
                <div class="col-md-6 col-lg-3 col-12 mb-2">
                    <label asp-for="ProductId">کالا</label>
                    <select asp-for="ProductId" asp-items="Model.Products" class="form-control select2">
                        <option value="">همهٔ کالاها</option>
                    </select>
                </div>
                <div class="col-md-6 col-lg-2 col-6 mb-2">
                    <label asp-for="MovementType">نوع گردش</label>
                    <select asp-for="MovementType" class="form-control select2">
                        <option value="">همه</option>
                        <option value="@((int)StockMovementType.Opening)">افتتاحیه</option>
                        <option value="@((int)StockMovementType.Receipt)">رسید</option>
                        <option value="@((int)StockMovementType.Issue)">حواله خروج</option>
                        <option value="@((int)StockMovementType.Transfer)">انتقال</option>
                    </select>
                </div>
                <div class="col-md-6 col-lg-2 col-6 mb-2">
                    <label asp-for="Status">وضعیت</label>
                    <select asp-for="Status" class="form-control select2">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="@((int)StockMovementStatus.Draft)">پیش‌نویس</option>
                        <option value="@((int)StockMovementStatus.Posted)">قطعی</option>
                        <option value="@((int)StockMovementStatus.Cancelled)">لغوشده</option>
                    </select>
                </div>
                <div class="col-md-6 col-lg-2 col-6 mb-2">
                    <label asp-for="FromDate">از تاریخ</label>
                    <input asp-for="FromDate" class="form-control datepicker" autocomplete="off" dir="ltr" />
                </div>
                <div class="col-md-6 col-lg-2 col-6 mb-2">
                    <label asp-for="ToDate">تا تاریخ</label>
                    <input asp-for="ToDate" class="form-control datepicker" autocomplete="off" dir="ltr" />
                </div>
            </div>

            <div class="d-flex flex-wrap mb-2" style="gap:8px">
                <button type="submit" name="search" value="true" class="btn btn-primary">
                    <i class="fa fa-search"></i> نمایش گزارش
                </button>
                @if (Model.HasSearched && Model.Rows.Count > 0)
                {
                    <button type="button" class="btn btn-outline-success"
                            data-csv-table="stockMovementReportTable"
                            data-csv-filename="گزارش-گردش-انبار.csv">
                        <i class="fa fa-file-csv"></i> خروجی Excel (CSV)
                    </button>
                }
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-eraser"></i> پاک‌کردن فیلترها
                </a>
            </div>
        </form>

        @if (Model.HasSearched)
        {
            <hr />

            <div class="alert alert-info">
                <i class="fa fa-info-circle"></i>
                اسناد پیش‌نویس و لغوشده نیز در صورت انتخاب «همه وضعیت‌ها» نمایش داده می‌شوند؛ فقط اسناد قطعی‌شده در موجودی اثر دارند.
            </div>

            <!-- دسکتاپ: AG Grid -->
            <div id="movementGrid" class="ag-theme-alpine d-none d-md-block"
                 style="height: 550px; width: 100%;">
            </div>

            <!-- جدول مخفی برای CSV -->
            <div class="d-none">
                <table id="stockMovementReportTable">
                    <thead>
                        <tr>
                            <th>شماره</th>
                            <th>تاریخ</th>
                            <th>نوع</th>
                            <th>مبدأ</th>
                            <th>مقصد</th>
                            <th>اقلام</th>
                            <th>وضعیت</th>
                            <th>شرح</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.Number</td>
                                <td>@row.Date</td>
                                <td>@row.MovementType</td>
                                <td>@row.SourceWarehouse</td>
                                <td>@row.DestinationWarehouse</td>
                                <td>@row.ItemsSummary</td>
                                <td>@row.Status</td>
                                <td>@row.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- موبایل: کارت‌ها -->
            <div id="mobileMovements" class="d-md-none"></div>

            <div class="text-muted mt-2">
                <i class="fa fa-info-circle"></i>
                تعداد اسناد: <strong class="persian-number">@Model.Rows.Count</strong>
            </div>

            @if (ViewData["HasMoreRows"] is true)
            {
                <div class="text-warning mt-2">
                    <i class="fa fa-exclamation-triangle"></i>
                    حداکثر ۵۰۰ سند اخیر نمایش داده شده‌اند؛ برای نتیجهٔ کامل‌تر فیلترها را محدود کنید.
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_CsvExportScripts" />

    <script>
        $(function () {

            // ============================================
            // select2 + datepicker
            // ============================================
            $('.select2').select2({
                width: '100%',
                dir: 'rtl',
                language: 'fa',
                allowClear: true
            });

            $('.datepicker').persianDatepicker({
                format: 'YYYY/MM/DD',
                initialValue: true,
                initialValueType: 'persian',
                autoClose: true,
                observer: true,
                calendar: { persian: { locale: 'fa', showHint: true, leapYearMode: 'algorithmic' } },
                toolbox: { calendarSwitch: { enabled: false } }
            });

            // ============================================
            // داده‌ها
            // ============================================
            var movementsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Rows.Select(r => new {
                    number = r.Number,
                    date = r.Date,
                    movementType = r.MovementType,
                    sourceWarehouse = r.SourceWarehouse,
                    destinationWarehouse = r.DestinationWarehouse,
                    itemsSummary = r.ItemsSummary,
                    status = r.Status,
                    description = r.Description
                }),
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }));

            var showGrid = @(Model.HasSearched && Model.Rows.Count > 0 ? "true" : "false");

            var gridApi = null;

            // ============================================
            // ابزار
            // ============================================
            function toPersianDigits(n) {
                return String(n).replace(/\d/g, function (d) {
                    return '۰۱۲۳۴۵۶۷۸۹'[d];
                });
            }

            function isMobile() {
                return window.matchMedia('(max-width: 767.98px)').matches;
            }

            function statusBadgeClass(status) {
                if (status === 'قطعی') return 'badge-success';
                if (status === 'پیش‌نویس') return 'badge-warning';
                return 'badge-secondary';
            }

            // ============================================
            // ستون‌ها
            // ============================================
            const columnDefs = [
                {
                    headerName: '#',
                    colId: '#',
                    width: 60,
                    sortable: false,
                    filter: false,
                    resizable: false,
                    valueGetter: function (params) {
                        var page = gridApi ? gridApi.paginationGetCurrentPage() : 0;
                        var size = gridApi ? gridApi.paginationGetPageSize() : 20;
                        return toPersianDigits(page * size + params.node.rowIndex + 1);
                    },
                    cellStyle: { textAlign: 'center', direction: 'ltr' }
                },
                {
                    field: 'number',
                    headerName: 'شماره',
                    width: 100,
                    cellStyle: { textAlign: 'center', direction: 'ltr' },
                    valueFormatter: function (p) {
                        return p.value != null ? toPersianDigits(p.value) : '';
                    }
                },
                {
                    field: 'date',
                    headerName: 'تاریخ',
                    width: 110,
                    cellStyle: { textAlign: 'center', direction: 'ltr' }
                },
                { field: 'movementType', headerName: 'نوع', width: 110 },
                { field: 'sourceWarehouse', headerName: 'مبدأ', minWidth: 140, flex: 1 },
                { field: 'destinationWarehouse', headerName: 'مقصد', minWidth: 140, flex: 1 },
                {
                    field: 'itemsSummary',
                    headerName: 'اقلام',
                    minWidth: 180,
                    flex: 2,
                    tooltipValueGetter: function (p) { return p.value; }
                },
                {
                    headerName: 'وضعیت',
                    field: 'status',
                    width: 110,
                    cellRenderer: function (p) {
                        if (!p.value) return '';
                        return '<span class="badge ' + statusBadgeClass(p.value) + '">' + p.value + '</span>';
                    }
                },
                { field: 'description', headerName: 'شرح', minWidth: 150, flex: 1 }
            ];

            // ============================================
            // ساخت Grid
            // ============================================
            function buildGrid() {
                if (gridApi) return;

                var gridOptions = {
                    columnDefs: columnDefs,
                    rowData: movementsData,
                    enableRtl: true,
                    defaultColDef: {
                        sortable: true,
                        filter: false,
                        resizable: true,
                        cellStyle: { textAlign: 'right', direction: 'rtl' },
                        headerClass: 'ag-right-aligned-header'
                    },
                    pagination: true,
                    paginationPageSize: 20,
                    paginationPageSizeSelector: [10, 20, 50, 100],
                    localeText: {
                        page: 'صفحه', to: 'تا', of: 'از', next: 'بعدی', last: 'آخر',
                        first: 'اول', previous: 'قبلی', loadingOoo: 'در حال بارگذاری...',
                        noRowsToShow: 'سندی با فیلترهای انتخاب‌شده پیدا نشد.',
                        pageSizeSelectorLabel: 'تعداد در صفحه:'
                    },
                    onPaginationChanged: function () {
                        if (gridApi) gridApi.refreshCells({ columns: ['#'], force: true });
                    }
                };

                var gridDiv = document.getElementById('movementGrid');
                gridApi = agGrid.createGrid(gridDiv, gridOptions);
            }

            // ============================================
            // موبایل
            // ============================================
            function renderMobileList(rows) {
                var container = document.getElementById('mobileMovements');
                var html = '';

                if (!rows || !rows.length) {
                    container.innerHTML = '<div class="text-center text-muted py-4">' +
                        '<i class="fa fa-info-circle fa-2x mb-2"></i><br/>' +
                        'سندی با فیلترهای انتخاب‌شده پیدا نشد.</div>';
                    return;
                }

                rows.forEach(function (r, index) {
                    var statusCls = statusBadgeClass(r.status);

                    html += '<div class="movement-card">' +
                        '<div class="d-flex justify-content-between align-items-start">' +
                            '<div class="title">' +
                                '<span class="badge badge-secondary ml-1">' + toPersianDigits(index + 1) + '</span>' +
                                '<i class="fa-solid fa-arrow-right-arrow-left text-muted ml-1"></i>' +
                                'سند ' + toPersianDigits(r.number || '') +
                            '</div>' +
                            (r.status
                                ? '<span class="badge ' + statusCls + '">' + r.status + '</span>'
                                : '') +
                        '</div>' +
                        (r.date ? '<div class="row-line">تاریخ: <span dir="ltr">' + r.date + '</span></div>' : '') +
                        (r.movementType ? '<div class="row-line">نوع: ' + r.movementType + '</div>' : '') +
                        (r.sourceWarehouse ? '<div class="row-line">مبدأ: ' + r.sourceWarehouse + '</div>' : '') +
                        (r.destinationWarehouse ? '<div class="row-line">مقصد: ' + r.destinationWarehouse + '</div>' : '') +
                        (r.itemsSummary ? '<div class="row-line">اقلام: ' + r.itemsSummary + '</div>' : '') +
                        (r.description ? '<div class="row-line">شرح: ' + r.description + '</div>' : '') +
                    '</div>';
                });

                container.innerHTML = html;
            }

            // ============================================
            // سوئیچ دسکتاپ/موبایل
            // ============================================
            function applyLayout() {
                var gridDiv = document.getElementById('movementGrid');
                var mobileDiv = document.getElementById('mobileMovements');

                if (!gridDiv || !mobileDiv) return;

                if (isMobile()) {
                    gridDiv.classList.add('d-none');
                    mobileDiv.classList.remove('d-md-none');
                    renderMobileList(movementsData);
                } else {
                    gridDiv.classList.remove('d-none');
                    mobileDiv.classList.add('d-md-none');
                    if (!gridApi) buildGrid();
                }
            }

            // ============================================
            // شروع
            // ============================================
            if (showGrid) {
                applyLayout();
                var mql = window.matchMedia('(max-width: 767.98px)');
                mql.addEventListener('change', applyLayout);
            }

        });
    </script>
}