@{
    ViewData["Title"] = "دسته‌بندی کالاها";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-folder-open"></i>
            لیست دسته‌بندی کالاها
        </h3>
        <div class="card-tools">
            <a asp-area="Inventory" asp-controller="ProductCategories" asp-action="Create"
               class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> دسته‌بندی کالا جدید
            </a>
        </div>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                    </div>
                    <input type="text" id="txtSearch" class="form-control" placeholder="جستجو..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <div id="productCategoryGrid" class="ag-theme-alpine" style="height: 600px; width: 100%;"></div>

    </div>
</div>
@Html.AntiForgeryToken()
@section Scripts {
    <script>
        // ============================================
        // 🆕 متغیر global برای Grid API
        // ============================================
        let productCategoriesGridApi = null;

        $(document).ready(function () {

            // ============================================
            // ۱. تعریف ستون‌ها
            // ============================================
            const columnDefs = [
                AgGridHelper.rowNumberColumn(),
                {
                    field: 'name',
                    headerName: 'نام',
                    flex: 2,
                    minWidth: 200
                },
                {
                    field: 'code',
                    headerName: 'کد',
                    width: 120
                },
                AgGridHelper.numberColumn('sortOrder', 'ترتیب', 100),
                AgGridHelper.statusColumn('isActive'),
                {
                    headerName: 'عملیات',
                    colId: 'actions',
                    width: 150,
                    sortable: false,
                    filter: false,
                    pinned: 'left',
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const div = document.createElement('div');
                        div.className = 'action-buttons';
                        const d = params.data;

                        // ✏ ویرایش
                        const editBtn = document.createElement('a');
                        editBtn.href = `/Inventory/ProductCategories/Edit/${d.id}`;
                        editBtn.className = 'btn btn-sm btn-outline-primary action-icon-btn';
                        editBtn.title = 'ویرایش';
                        editBtn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
                        div.appendChild(editBtn);

                        // 🗑 حذف
                        const deleteBtn = document.createElement('a');
                        deleteBtn.href = 'javascript:void(0)';
                        deleteBtn.className = 'btn btn-sm btn-outline-danger action-icon-btn delete-btn';
                        deleteBtn.dataset.id = d.id;
                        deleteBtn.dataset.title = d.name || '';
                        deleteBtn.dataset.code = d.code || '';
                        deleteBtn.title = 'حذف';
                        deleteBtn.innerHTML = '<i class="fa-solid fa-trash"></i>';
                        div.appendChild(deleteBtn);

                        return div;
                    }
                }
            ];

            // ============================================
            // ۲. ساخت Grid
            // ============================================
            productCategoriesGridApi = AgGridHelper.create(
                'productCategoryGrid',
                columnDefs,
                '/Inventory/ProductCategories/GetData',
                'txtSearch',
                'lblCount'
            );

        });

        // ============================================
        // ۳. رویداد حذف
        // ============================================
        $(document).on('click', '.delete-btn', function () {
            const $btn = $(this);
            const id = $btn.data('id');
            const title = $btn.data('title');
            const code = $btn.data('code');

            // 🆕 ساخت items
            const items = [];
            if (title) items.push({ label: 'نام', value: title });
            if (code) items.push({ label: 'کد', value: code });

            // 🆕 نمایش Modal
            ModalHelper.confirmDelete({
                url: '/Inventory/ProductCategories/Delete',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                title: 'حذف دسته‌بندی کالا: ' + title,
                message: 'آیا از حذف این دسته‌بندی مطمئن هستید؟ این عملیات قابل بازگشت نیست.',
                items: items,
                onSuccess: function () {
                    // 🆕 رفرش Grid
                    if (productCategoriesGridApi) {
                        const ds = productCategoriesGridApi.getGridOption('datasource');
                        productCategoriesGridApi.setGridOption('datasource', ds);
                    } else {
                        location.reload();
                    }
                }
            });
        });
    </script>
}