@{
    ViewData["Title"] = "انبارها";
}

<style>
    #warehousesGrid.ag-theme-alpine {
        --ag-font-size: 13px;
        width: 100%;
    }

    @@media (max-width: 767.98px) {
        #warehousesGrid.ag-theme-alpine {
            --ag-font-size: 12px;
        }
    }

    .action-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
        justify-content: flex-start;
        align-items: center;
    }

        .action-buttons .btn {
            padding: 3px 6px;
            line-height: 1;
        }

    .ag-right-aligned-header .ag-header-cell-label {
        justify-content: flex-end;
    }

    .wh-card {
        border: 1px solid #e3e3e3;
        border-radius: 6px;
        background: #fff;
        margin-bottom: 8px;
        padding: 10px;
    }

        .wh-card .name {
            font-weight: 600;
            font-size: 14px;
        }

        .wh-card .row-line {
            font-size: 12px;
            color: #6c757d;
            margin-top: 3px;
            word-break: break-all;
        }

        .wh-card .actions {
            margin-top: 8px;
        }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa-solid fa-triangle-exclamation"></i> @TempData["Error"]
    </div>
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fa-solid fa-warehouse"></i> فهرست انبارها</h3>
        <div class="card-tools">
            <a asp-area="Inventory" asp-controller="StockTransfers" asp-action="Index"
               class="btn btn-outline-primary btn-sm mb-1">
                <i class="fa-solid fa-right-left"></i> انتقال بین انبارها
            </a>
            <a asp-area="Inventory" asp-controller="Warehouses" asp-action="Create"
               class="btn btn-primary btn-sm mb-1">
                <i class="fa-solid fa-plus"></i> انبار جدید
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    </div>
                    <input type="text" id="txtSearch" class="form-control"
                           placeholder="جستجو در کد، نام یا آدرس انبار..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <!-- دسکتاپ: AG Grid -->
        <div id="warehousesGrid" class="ag-theme-alpine d-none d-md-block"
             style="height: 600px; width: 100%;">
        </div>

        <!-- موبایل: کارت‌ها -->
        <div id="mobileWarehouses" class="d-md-none"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            var gridApi = null;
            var allRows = [];

            // ============================================
            // ۱. ستون‌ها
            // ============================================
            const columnDefs = [
                {
                    headerName: '#',
                    colId: '#',
                    width: 60,
                    sortable: false,
                    filter: false,
                    resizable: false,
                    valueGetter: function (params) {
                        var page = gridApi ? gridApi.paginationGetCurrentPage() : 0;
                        var size = gridApi ? gridApi.paginationGetPageSize() : 20;
                        return toPersianDigits(page * size + params.node.rowIndex + 1);
                    },
                    cellStyle: { textAlign: 'center', direction: 'ltr' }
                },
                { field: 'code', headerName: 'کد انبار', minWidth: 130, flex: 1,
                    cellStyle: { direction: 'ltr', textAlign: 'right' } },
                { field: 'name', headerName: 'نام انبار', minWidth: 200, flex: 2 },
                { field: 'address', headerName: 'آدرس', minWidth: 180, flex: 2 },
                {
                    field: 'isDefault',
                    headerName: 'پیش‌فرض',
                    width: 120,
                    cellRenderer: function (p) {
                        return p.value
                            ? '<span class="badge badge-primary">پیش‌فرض</span>'
                            : '<span class="text-muted">—</span>';
                    }
                },
                {
                    field: 'isActive',
                    headerName: 'وضعیت',
                    width: 100,
                    cellRenderer: function (p) {
                        return p.value
                            ? '<span class="badge badge-success">فعال</span>'
                            : '<span class="badge badge-danger">غیرفعال</span>';
                    }
                },
                {
                    headerName: 'عملیات',
                    colId: 'actions',
                    width: 130,
                    sortable: false,
                    filter: false,
                    pinned: 'left',
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        return '<div class="action-buttons">' + buildActionButtons(params.data) + '</div>';
                    }
                }
            ];

            // ============================================
            // ۲. دکمه‌های عملیات (مشترک دسکتاپ/موبایل)
            // ============================================
            function buildActionButtons(d) {
                var html = '';

                html += '<a href="/Inventory/Warehouses/Edit/' + d.id + '" ' +
                        'class="btn btn-sm btn-outline-primary action-icon-btn" title="ویرایش">' +
                        '<i class="fa-solid fa-pen-to-square"></i></a>';

                html += '<a href="javascript:void(0)" ' +
                        'class="btn btn-sm btn-outline-danger action-icon-btn delete-warehouse-btn" ' +
                        'data-id="' + d.id + '" ' +
                        'data-title="' + escapeAttr(d.name) + '" ' +
                        'data-code="' + escapeAttr(d.code) + '" ' +
                        'title="حذف">' +
                        '<i class="fa-solid fa-trash"></i></a>';

                return html;
            }

            function escapeAttr(s) {
                return (s == null ? '' : String(s))
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            // ============================================
            // ۳. ساخت Grid (دسکتاپ)
            // ============================================
            function buildGrid() {
                if (gridApi) return;

                var gridOptions = {
                    columnDefs: columnDefs,
                    enableRtl: true,
                    defaultColDef: {
                        sortable: true,
                        filter: false,
                        resizable: true,
                        cellStyle: { textAlign: 'right', direction: 'rtl' },
                        headerClass: 'ag-right-aligned-header'
                    },
                    pagination: true,
                    paginationPageSize: 20,
                    paginationPageSizeSelector: [10, 20, 50, 100],
                    localeText: {
                        page: 'صفحه', to: 'تا', of: 'از', next: 'بعدی', last: 'آخر',
                        first: 'اول', previous: 'قبلی', loadingOoo: 'در حال بارگذاری...',
                        noRowsToShow: 'داده‌ای برای نمایش نیست',
                        pageSizeSelectorLabel: 'تعداد در صفحه:'
                    },
                    onPaginationChanged: function () {
                        if (gridApi) gridApi.refreshCells({ columns: ['#'], force: true });
                    }
                };

                var gridDiv = document.getElementById('warehousesGrid');
                gridApi = agGrid.createGrid(gridDiv, gridOptions);
                loadData();
            }

            // ============================================
            // ۴. بارگذاری داده
            // ============================================
            function loadData() {
                var request = {
                    startRow: 0,
                    endRow: 10000,
                    search: ($('#txtSearch').val() || '').trim(),
                    sortBy: null,
                    sortDir: null
                };

                if (gridApi) {
                    try {
                        var state = gridApi.getColumnState() || [];
                        var sorted = state.filter(function (c) { return c.sort; });
                        if (sorted.length) {
                            request.sortBy = sorted[0].colId;
                            request.sortDir = sorted[0].sort;
                        }
                    } catch (e) { /* ignore */ }
                }

                $.ajax({
                    url: '/Inventory/Warehouses/GetData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(request),
                    success: function (result) {
                        var rows = [];
                        var total = 0;
                        if (Array.isArray(result)) {
                            rows = result;
                            total = result.length;
                        } else if (result && Array.isArray(result.rows)) {
                            rows = result.rows;
                            total = result.lastRow || rows.length;
                        } else if (result && Array.isArray(result.data)) {
                            rows = result.data;
                            total = result.total || rows.length;
                        }

                        allRows = rows;

                        if (gridApi) {
                            gridApi.setGridOption('rowData', allRows);
                            setTimeout(function () {
                                gridApi.refreshCells({ columns: ['#'], force: true });
                            }, 50);
                        }

                        $('#lblCount').text('تعداد: ' + toPersianDigits(total));

                        if (isMobile()) {
                            renderMobileList(allRows);
                        }
                    },
                    error: function (xhr) {
                        console.error('GetData error:', xhr.status, xhr.responseText);
                        $('#lblCount').text('خطا در بارگذاری (کد ' + xhr.status + ')');
                    }
                });
            }

            // ============================================
            // ۵. جستجو
            // ============================================
            var searchTimer = null;
            $('#txtSearch').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () {
                    loadData();
                }, 300);
            });

            // ============================================
            // ۶. موبایل
            // ============================================
            function renderMobileList(rows) {
                var container = document.getElementById('mobileWarehouses');
                var html = '';

                if (!rows || !rows.length) {
                    container.innerHTML = '<div class="text-center text-muted py-4">' +
                        '<i class="fa fa-info-circle fa-2x mb-2"></i><br/>داده‌ای برای نمایش نیست</div>';
                    return;
                }

                rows.forEach(function (d, index) {
                    html += '<div class="wh-card">' +
                        '<div class="d-flex justify-content-between align-items-start">' +
                            '<div class="name">' +
                                '<span class="badge badge-secondary ml-1">' + toPersianDigits(index + 1) + '</span>' +
                                '<i class="fa-solid fa-warehouse text-muted ml-1"></i>' +
                                (d.name || '') +
                            '</div>' +
                            '<div>' +
                                (d.isDefault
                                    ? '<span class="badge badge-primary ml-1">پیش‌فرض</span>'
                                    : '') +
                                (d.isActive
                                    ? '<span class="badge badge-success">فعال</span>'
                                    : '<span class="badge badge-danger">غیرفعال</span>') +
                            '</div>' +
                        '</div>' +
                        (d.code ? '<div class="row-line">کد انبار: <span dir="ltr">' + d.code + '</span></div>' : '') +
                        (d.address ? '<div class="row-line">آدرس: ' + d.address + '</div>' : '') +
                        '<div class="actions">' + buildActionButtons(d) + '</div>' +
                    '</div>';
                });

                container.innerHTML = html;
            }

            // ============================================
            // ۷. ابزار
            // ============================================
            function toPersianDigits(n) {
                return String(n).replace(/\d/g, function (d) {
                    return '۰۱۲۳۴۵۶۷۸۹'[d];
                });
            }

            function isMobile() {
                return window.matchMedia('(max-width: 767.98px)').matches;
            }

            // ============================================
            // ۸. سوئیچ دسکتاپ/موبایل
            // ============================================
            function applyLayout() {
                var gridDiv = document.getElementById('warehousesGrid');
                var mobileDiv = document.getElementById('mobileWarehouses');

                if (isMobile()) {
                    gridDiv.classList.add('d-none');
                    mobileDiv.classList.remove('d-md-none');
                    if (!allRows.length) loadData();
                    else renderMobileList(allRows);
                } else {
                    gridDiv.classList.remove('d-none');
                    mobileDiv.classList.add('d-md-none');
                    if (!gridApi) buildGrid();
                }
            }

            // ============================================
            // ۹. حذف با Modal
            // ============================================
            $(document).on('click', '.delete-warehouse-btn', function () {
                var $btn = $(this);
                var id = $btn.data('id');
                var title = $btn.data('title');
                var code = $btn.data('code');

                var items = [];
                if (code) items.push({ label: 'کد انبار', value: code });
                if (title) items.push({ label: 'نام انبار', value: title });

                ModalHelper.confirmDelete({
                    url: '/Inventory/Warehouses/Delete',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    title: 'حذف انبار: ' + title,
                    message: 'اگر انبار در گردش‌های انبار استفاده شده باشد، حذف نمی‌شود. ادامه می‌دهید؟',
                    items: items,
                    onSuccess: function () {
                        loadData();
                    }
                });
            });

            // ============================================
            // ۱۰. شروع
            // ============================================
            applyLayout();

            var mql = window.matchMedia('(max-width: 767.98px)');
            mql.addEventListener('change', applyLayout);

        });
    </script>
}