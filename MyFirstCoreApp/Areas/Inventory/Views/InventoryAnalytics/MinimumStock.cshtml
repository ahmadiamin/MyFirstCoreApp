@model IReadOnlyList<MyFirstCoreApp.Application.Inventory.InventoryAlertDto>
@{
    ViewData["Title"] = "هشدار حداقل موجودی";
}
<div class="card">
    <div class="card-header"><h3 class="card-title">هشدار حداقل موجودی</h3></div>
    <div class="card-body">
        <p class="text-muted">موجودی هر کالا در همهٔ انبارها با حداقل تعیین‌شده در فرم کالا مقایسه می‌شود.</p>
        @if (Model.Count > 0)
        {
            <button type="button" class="btn btn-outline-success mb-3" data-csv-table="minimumStockTable" data-csv-filename="هشدار-حداقل-موجودی.csv"><i class="fa fa-file-csv"></i> خروجی Excel (CSV)</button>
        }
        <div class="table-responsive"><table id="minimumStockTable" class="table table-bordered table-striped">
            <thead><tr><th>کد</th><th>کالا</th><th>موجودی کل</th><th>حداقل</th><th>کسری</th><th>واحد</th></tr></thead>
            <tbody>
            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted">کالایی زیر حداقل موجودی نیست.</td></tr> }
            @foreach (var row in Model)
            {
                <tr><td>@(row.ProductCode ?? "—")</td><td>@row.ProductName</td><td class="text-right">@row.CurrentStock.ToString("N3")</td><td class="text-right">@row.MinimumStock.ToString("N3")</td><td class="text-right text-danger">@row.Shortage.ToString("N3")</td><td>@row.UnitName</td></tr>
            }
            </tbody>
        </table></div>
    </div>
</div>
@section Scripts {
    <partial name="_CsvExportScripts" />
}
