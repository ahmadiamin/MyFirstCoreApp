@model IReadOnlyList<MyFirstCoreApp.Application.Inventory.CompanyAssetListItemDto>
@using MyFirstCoreApp.Application.Common.Utilities
@using MyFirstCoreApp.Domain.Enums

@{
    ViewData["Title"] = "ابزار و دارایی‌های شرکت";
    string TypeName(ProductType type) => type == ProductType.Tool ? "ابزار" : "دارایی ثابت";
    string StatusName(CompanyAssetStatus status) => status switch
    {
        CompanyAssetStatus.Assigned => "تحویل‌شده",
        CompanyAssetStatus.Maintenance => "در تعمیر",
        CompanyAssetStatus.Retired => "از رده خارج",
        _ => "موجود"
    };
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <h3 class="card-title"><i class="fa fa-toolbox"></i> ابزار و دارایی‌های شرکت</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i> ثبت مورد جدید</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">هنوز ابزار یا دارایی موردی ثبت نشده است.</div>
        }
        else
        {
            <div class="table-responsive d-none d-md-block">
                <table class="table table-bordered table-hover">
                    <thead><tr><th>شناسه</th><th>قلم</th><th>نوع</th><th>شماره سریال</th><th>وضعیت</th><th>مسئول فعلی</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td dir="ltr">@item.AssetTag</td>
                            <td>@item.ProductName</td>
                            <td>@TypeName(item.ProductType)</td>
                            <td dir="ltr">@(item.SerialNumber ?? "—")</td>
                            <td>@StatusName(item.Status)</td>
                            <td>@(item.AssignedUserName ?? "—")</td>
                            <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="fa fa-eye"></i> جزئیات</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-md-none">
                @foreach (var item in Model)
                {
                    <div class="card mb-2">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong>@item.ProductName</strong>
                                <span class="badge badge-info">@StatusName(item.Status)</span>
                            </div>
                            <div class="text-muted mt-1" dir="ltr">@item.AssetTag @(item.SerialNumber ?? "")</div>
                            <div class="mt-2">نوع: @TypeName(item.ProductType)</div>
                            <div>تحویل‌گیرنده: @(item.AssignedUserName ?? "—")</div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info mt-2"><i class="fa fa-eye"></i> جزئیات</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
