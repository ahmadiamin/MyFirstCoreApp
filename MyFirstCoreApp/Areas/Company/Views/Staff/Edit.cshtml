@model MyFirstCoreApp.Areas.Company.ViewModels.StaffEditViewModel
@{
    ViewData["Title"] = "ویرایش مشخصات و سمت";
}

<div class="card card-primary">
    <div class="card-header"><h3 class="card-title"><i class="fa fa-user-edit"></i> @ViewData["Title"] <small dir="ltr">(@Model.Email)</small></h3></div>
    <form asp-area="Company" asp-controller="Staff" asp-action="Edit" asp-route-id="@Model.UserId" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="IsOwner" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-3"><div class="form-group"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div></div>
                <div class="col-md-3"><div class="form-group"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div></div>
                <div class="col-md-3"><div class="form-group"><label asp-for="JobTitle"></label><input asp-for="JobTitle" class="form-control" /></div></div>
                <div class="col-md-3"><div class="form-group"><label asp-for="InternalPhone"></label><input asp-for="InternalPhone" class="form-control" dir="ltr" /><span asp-validation-for="InternalPhone" class="text-danger"></span></div></div>
            </div>

            @if (Model.IsOwner)
            {
                <div class="alert alert-info"><i class="fa fa-crown"></i> مالک شرکت همه‌ی دسترسی‌ها را دارد و سمت نمی‌گیرد.</div>
            }
            else
            {
                <partial name="_RolePicker" model="@(new MyFirstCoreApp.Areas.Company.ViewModels.RolePickerViewModel { RoleOptions = Model.RoleOptions, SelectedRoleIds = Model.SelectedRoleIds })" />
            }
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> ذخیره</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fa fa-arrow-right"></i> انصراف</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
