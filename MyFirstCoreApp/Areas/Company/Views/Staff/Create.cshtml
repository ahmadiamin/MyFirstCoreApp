@model MyFirstCoreApp.Areas.Company.ViewModels.StaffCreateViewModel
@{
    ViewData["Title"] = "فرد جدید";
}

<div class="card card-primary">
    <div class="card-header"><h3 class="card-title"><i class="fa fa-user-plus"></i> @ViewData["Title"]</h3></div>
    <form asp-area="Company" asp-controller="Staff" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="alert alert-info py-2">
                <i class="fa fa-sms"></i>
                کارمند با <b>شماره‌ی موبایل</b> وارد می‌شود. رمز را شما نمی‌دهید: کد تعیین رمز به همین شماره پیامک می‌شود
                و کارمند خودش رمز می‌گذارد. اگر این شماره از قبل حساب دارد (مثلاً مدیر کسب‌وکار دیگری است)، همان حساب به شرکت شما اضافه می‌شود.
            </div>

            <div class="row">
                <div class="col-md-3"><div class="form-group"><label asp-for="Mobile"></label><input asp-for="Mobile" class="form-control" dir="ltr" autocomplete="off" placeholder="09121234567" /><span asp-validation-for="Mobile" class="text-danger"></span></div></div>
                <div class="col-md-3"><div class="form-group"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div></div>
                <div class="col-md-3"><div class="form-group"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div></div>
                <div class="col-md-3"><div class="form-group"><label asp-for="InternalPhone"></label><input asp-for="InternalPhone" class="form-control" dir="ltr" placeholder="مثلاً 101" /><span asp-validation-for="InternalPhone" class="text-danger"></span></div></div>
            </div>
            <div class="row">
                <div class="col-md-4"><div class="form-group"><label asp-for="JobTitle"></label><input asp-for="JobTitle" class="form-control" placeholder="مثلاً منشی" /></div></div>
            </div>

            <partial name="_RolePicker" model="@(new MyFirstCoreApp.Areas.Company.ViewModels.RolePickerViewModel { RoleOptions = Model.RoleOptions, SelectedRoleIds = Model.SelectedRoleIds })" />
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> ثبت</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fa fa-arrow-right"></i> انصراف</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}