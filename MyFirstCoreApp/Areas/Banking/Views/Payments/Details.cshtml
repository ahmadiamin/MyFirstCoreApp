@using DNTPersianUtils.Core
@using MyFirstCoreApp.Application.Common.Utilities
@model MyFirstCoreApp.Domain.Entities.Banking.Payment
@{
    ViewData["Title"] = $"مشاهده پرداخت {Model.Number}";
    var isReceived = Model.PaymentType == MyFirstCoreApp.Domain.Enums.PaymentType.Received;
}

<style>
    .payment-details .info-box {
        border: 1px solid #e3e3e3;
        border-radius: 6px;
        padding: 10px 12px;
        background: #fafafa;
        height: 100%;
    }

        .payment-details .info-box .label {
            font-size: 12px;
            color: #6c757d;
            margin-bottom: 2px;
        }

        .payment-details .info-box .value {
            font-weight: 600;
            font-size: 14px;
            word-break: break-all;
        }

            .payment-details .info-box .value.money {
                direction: ltr;
                text-align: right;
                font-family: inherit;
            }

    .payment-details table.allocations-table {
        font-size: 13px;
    }

        .payment-details table.allocations-table th,
        .payment-details table.allocations-table td {
            vertical-align: middle;
            white-space: nowrap;
        }

    .payment-details .mobile-allocations .alloc-card {
        border: 1px solid #e3e3e3;
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 8px;
        background: #fff;
    }

        .payment-details .mobile-allocations .alloc-card .row-line {
            font-size: 12px;
            color: #6c757d;
            margin-top: 3px;
        }

        .payment-details .mobile-allocations .alloc-card .amount {
            font-weight: 600;
            color: #0d6efd;
            font-size: 13px;
            margin-top: 4px;
        }

    @@media (max-width: 767.98px) {
        .payment-details .card-body {
            padding: 10px;
        }
    }
</style>

<div class="card card-info payment-details">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-money-bill-transfer"></i>
            @(isReceived ? "دریافت" : "پرداخت") شماره @Model.Number
        </h3>
        <div class="card-tools">
            <span class="badge @(isReceived ? "badge-success" : "badge-danger")">
                @(isReceived ? "دریافت" : "پرداخت")
            </span>
            <span class="badge @(Model.Status == MyFirstCoreApp.Domain.Enums.PaymentStatus.Posted ? "badge-success" : "badge-warning")">
                @(Model.Status == MyFirstCoreApp.Domain.Enums.PaymentStatus.Posted ? "قطعی" : "پیش‌نویس")
            </span>
        </div>
    </div>

    <div class="card-body">

        <!-- اطلاعات اصلی -->
        <div class="row">
            <div class="col-md-3 col-6 mb-2">
                <div class="info-box">
                    <div class="label">شماره</div>
                    <div class="value persian-number">@Model.Number</div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <div class="info-box">
                    <div class="label">تاریخ</div>
                    <div class="value">@PersianDate.Format(Model.Date)</div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <div class="info-box">
                    <div class="label">طرف حساب</div>
                    <div class="value">@Model.Contact?.Name</div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <div class="info-box">
                    <div class="label">حساب بانکی</div>
                    <div class="value">@Model.BankAccount?.Name</div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <div class="info-box">
                    <div class="label">روش پرداخت</div>
                    <div class="value">@GetMethodName(Model.PaymentMethod)</div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <div class="info-box">
                    <div class="label">مبلغ کل</div>
                    <div class="value money persian-number-comma">
                        @Model.Amount.ToString("N0") <small class="text-muted">ریال</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <div class="info-box">
                    <div class="label">تخصیص‌یافته</div>
                    <div class="value money persian-number-comma">
                        @Model.AllocatedAmount.ToString("N0") <small class="text-muted">ریال</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <div class="info-box">
                    <div class="label">تخصیص‌نیافته</div>
                    <div class="value money persian-number-comma">
                        @Model.UnallocatedAmount.ToString("N0") <small class="text-muted">ریال</small>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Reference))
            {
                <div class="col-12 mb-2">
                    <div class="info-box">
                        <div class="label">مرجع</div>
                        <div class="value" dir="ltr" style="text-align:right;">@Model.Reference</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="col-12 mb-2">
                    <div class="info-box">
                        <div class="label">توضیحات</div>
                        <div class="value">@Model.Description</div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TransactionId.HasValue)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check"></i> سند حسابداری:
                <a asp-area="Accounting" asp-controller="Transactions" asp-action="Details" asp-route-id="@Model.TransactionId">
                    مشاهده
                </a>
            </div>
        }

        <hr />

        <h5 class="mb-3">
            <i class="fa-solid fa-list"></i> تخصیص‌ها به فاکتورها
            <span class="badge badge-secondary mr-1">@Model.Allocations.Count()</span>
        </h5>

        @if (Model.Allocations.Any())
        {
            <!-- دسکتاپ: جدول -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-sm table-bordered allocations-table mb-0">
                    <thead>
                        <tr>
                            <th style="width: 40px;" class="text-center">#</th>
                            <th>فاکتور</th>
                            <th>تاریخ</th>
                            <th class="text-left">مبلغ کل</th>
                            <th class="text-left">مبلغ تخصیص</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var i = 1;
                        }
                        @foreach (var a in Model.Allocations.OrderBy(x => x.Invoice.Date))
                        {
                            <tr>
                                <td class="text-center persian-number">@i</td>
                                <td>
                                    <a asp-area="Invoicing" asp-controller="Invoices" asp-action="Details" asp-route-id="@a.InvoiceId">
                                        فاکتور شماره @a.Invoice.Number
                                    </a>
                                </td>
                                <td dir="ltr" class="text-right">@a.Invoice.Date.ToShortPersianDateString()</td>
                                <td class="text-left persian-number-comma">@a.Invoice.TotalAmount.ToString("N0")</td>
                                <td class="text-left persian-number-comma">@a.Amount.ToString("N0")</td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- موبایل: کارت‌ها -->
            <div class="mobile-allocations d-md-none">
                @{
                    var j = 1;
                }
                @foreach (var a in Model.Allocations.OrderBy(x => x.Invoice.Date))
                {
                    <div class="alloc-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong>
                                <span class="badge badge-secondary ml-1">@j</span>
                                <a asp-area="Invoicing" asp-controller="Invoices" asp-action="Details" asp-route-id="@a.InvoiceId">
                                    فاکتور @a.Invoice.Number
                                </a>
                            </strong>
                        </div>
                        <div class="row-line">تاریخ: <span dir="ltr">@a.Invoice.Date.ToShortPersianDateString()</span></div>
                        <div class="row-line">مبلغ کل: <span dir="ltr" class="persian-number-comma">@a.Invoice.TotalAmount.ToString("N0")</span></div>
                        <div class="amount persian-number-comma" dir="ltr">
                            مبلغ تخصیص: @a.Amount.ToString("N0")
                        </div>
                    </div>
                    j++;
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-3">
                <i class="fa fa-info-circle"></i>
                تخصیصی ثبت نشده است.
            </div>
        }
    </div>

    <div class="card-footer">
        <a asp-action="Index"
           asp-route-paymentType="@((int)Model.PaymentType)"
           class="btn btn-secondary">
            <i class="fa-solid fa-arrow-right"></i> بازگشت
        </a>
        @if (Model.Status == MyFirstCoreApp.Domain.Enums.PaymentStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fa-solid fa-pen-to-square"></i> ویرایش
            </a>
        }
    </div>
</div>

@functions {
    string GetMethodName(MyFirstCoreApp.Domain.Enums.PaymentMethod m) => m switch
    {
        MyFirstCoreApp.Domain.Enums.PaymentMethod.Cash => "نقد",
        MyFirstCoreApp.Domain.Enums.PaymentMethod.BankTransfer => "انتقال بانکی",
        MyFirstCoreApp.Domain.Enums.PaymentMethod.Card => "کارت به کارت",
        MyFirstCoreApp.Domain.Enums.PaymentMethod.Cheque => "چک",
        MyFirstCoreApp.Domain.Enums.PaymentMethod.Pos => "کارتخوان",
        MyFirstCoreApp.Domain.Enums.PaymentMethod.Internet => "اینترنت",
        _ => "سایر"
    };
}