@model MyFirstCoreApp.Areas.Banking.ViewModels.Payment.PaymentFormViewModel
@{
    ViewData["Title"] = "ویرایش پرداخت";
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-pen-to-square"></i>
            ویرایش پرداخت
        </h3>
    </div>

    <form asp-area="Banking" asp-controller="Payments" asp-action="Edit"
          asp-route-id="@Model.Id" method="post" id="paymentForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Number" />
        <input type="hidden" asp-for="PaymentType" id="PaymentType_Hidden" />

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <partial name="_Form" model="Model" />
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i> ذخیره تغییرات
            </button>
            <a asp-action="Index" asp-route-paymentType="@((int)Model.PaymentType)" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-right"></i> انصراف
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {

            // ============================================
            // 🆕 متغیرهای Global
            // ============================================
            let currentInvoices = [];
            let isInitialLoad = true;   // 🆕 فلگ برای بارگذاری اولیه

            // ============================================
            // ۱. DatePicker
            // ============================================
            $('.datepicker').each(function () {
                var $input = $(this);
                var val = $input.val();
                $input.persianDatepicker({
                    format: 'YYYY/MM/DD', initialValue: false, autoClose: true, observer: true,
                    calendar: { persian: { locale: 'fa', showHint: true, leapYearMode: 'algorithmic' } },
                    toolbox: { calendarSwitch: { enabled: false } }
                });
                if (val) $input.persianDatepicker('setDate', val);
            });

            // ============================================
            // ۲. Select2
            // ============================================
            $('select.select2').select2({
                dir: 'rtl', placeholder: '-- انتخاب --', allowClear: true, width: '100%', language: 'fa'
            });

            // ============================================
            // ۳. updateTotals
            // ============================================
            function updateTotals() {
                let amount = parseFloat($('#Amount_Hidden').val()) || 0;
                if (isNaN(amount)) amount = 0;

                let total = 0;
                $('.allocation-amount').each(function () {
                    const v = $(this).val();
                    const num = parseFloat(toEnglishNumber(v).replace(/,/g, '')) || 0;
                    total += num;
                });

                const remaining = amount - total;
                $('#totalAmount').text(formatNumberWithComma(amount.toString()));
                $('#totalAllocated').text(formatNumberWithComma(total.toString()));
                $('#remainingAmount').text(formatNumberWithComma(remaining.toString()));

                if (remaining < 0) $('#remainingAmount').addClass('text-danger');
                else $('#remainingAmount').removeClass('text-danger');
            }

            // ============================================
            // ۴. syncAmount
            // ============================================
            function syncAmount() {
                var displayVal = $('#Amount_Display').val();
                var hiddenVal = toEnglishNumber(displayVal).replace(/,/g, '').split('.')[0];
                $('#Amount_Hidden').val(hiddenVal);

                // 🆕 اگه بارگذاری اولیه نیست و فاکتورها لود شدن → دوباره تخصیص بده
                if (!isInitialLoad && currentInvoices.length > 0) {
                    renderAllocations(currentInvoices);
                } else {
                    updateTotals();
                }
            }

            // ============================================
            // ۵. renderAllocations (خودکار تخصیص می‌ده)
            // ============================================
            function renderAllocations(invoices) {
                currentInvoices = invoices;
                const tbody = $('#allocationsBody');
                tbody.empty();

                if (invoices.length === 0) {
                    tbody.append('<tr><td colspan="6" class="text-center text-muted">فاکتور بازی وجود ندارد.</td></tr>');
                    updateTotals();
                    return;
                }

                // 🆕 تخصیص خودکار از صفر
                let amountToAllocate = parseFloat($('#Amount_Hidden').val()) || 0;
                if (isNaN(amountToAllocate)) amountToAllocate = 0;

                let remainingToAllocate = amountToAllocate;
                let html = '';

                invoices.forEach(function (inv, idx) {
                    let allocate = 0;
                    if (remainingToAllocate > 0) {
                        allocate = Math.min(remainingToAllocate, inv.remaining);
                        remainingToAllocate -= allocate;
                    }

                    html += '<tr class="allocation-row" data-invoice-id="' + inv.id + '">';
                    html += '  <td class="text-center">' + (idx + 1) + '</td>';
                    html += '  <td>فاکتور شماره ' + inv.number;
                    html += '    <input type="hidden" name="Allocations[' + idx + '].InvoiceId" value="' + inv.id + '" />';
                    html += '  </td>';
                    html += '  <td>' + (inv.dateShamsi || '—') + '</td>';
                    html += '  <td class="persian-number-comma">' + Number(inv.total).toLocaleString('en-US') + '</td>';
                    html += '  <td class="persian-number-comma text-warning">' + Number(inv.remaining).toLocaleString('en-US') + '</td>';
                    html += '  <td><input type="text" name="Allocations[' + idx + '].Amount" class="form-control form-control-sm allocation-amount persian-number persian-number-comma" data-remaining="' + inv.remaining + '" value="' + (allocate > 0 ? formatNumberWithComma(allocate.toString()) : '0') + '" /></td>';
                    html += '</tr>';
                });

                tbody.html(html);
                updateTotals();
            }

            // ============================================
            // ۶. رویدادها
            // ============================================

            // 🆕 تایپ مبلغ کل
            $(document).on('input', '#Amount_Display', function () {
                isInitialLoad = false;   // 🆕 دیگه بارگذاری اولیه نیست
                var val = $(this).val();
                if (val) {
                    var formatted = formatNumberWithComma(toEnglishNumber(val).replace(/,/g, '').split('.')[0]);
                    $(this).val(formatted);
                }
                syncAmount();
            });

            // 🆕 تایپ مبلغ تخصیص
            $(document).on('input', '.allocation-amount', function () {
                var val = $(this).val();
                if (val) {
                    $(this).val(formatNumberWithComma(toEnglishNumber(val).replace(/,/g, '').split('.')[0]));
                }
                updateTotals();
            });

            // 🆕 تغییر طرف حساب
            $('#ContactId').on('change', function () {
                const contactId = $(this).val();
                const paymentType = $('#PaymentType_Hidden').val();

                if (!contactId) {
                    $('#allocationsBody').empty();
                    currentInvoices = [];
                    updateTotals();
                    return;
                }

                $.ajax({
                    url: '/Banking/Payments/GetInvoices',
                    type: 'GET',
                    data: { contactId: contactId, paymentType: paymentType },
                    success: function (r) {
                        if (r.success) {
                            isInitialLoad = false;   // 🆕
                            renderAllocations(r.data);
                        }
                    }
                });
            });

            // ============================================
            // ۷. Submit
            // ============================================
            $('#paymentForm').on('submit', function () {
                $('.persian-number').each(function () {
                    const $input = $(this);
                    let val = $input.val();
                    if (val) {
                        val = toEnglishNumber(val).replace(/,/g, '').split('.')[0];
                        $input.val(val);
                    }
                });
            });

            // ============================================
            // ۸. بارگذاری اولیه (مقادیر از _Form.cshtml)
            // ============================================
            // مقادیر اولیه از _Form.cshtml اومدن
            // فقط updateTotals صدا بزن
            isInitialLoad = true;
            updateTotals();

            // 🆕 بعد از ۱۰۰ میلی‌ثانیه، مقادیر فعلی رو ذخیره کن (برای رندر مجدد)
            setTimeout(function () {
                // مقادیر فعلی جدول رو ذخیره کن
                $('#allocationsBody tr.allocation-row').each(function () {
                    const invId = $(this).data('invoice-id');
                    const amountText = $(this).find('.allocation-amount').val();
                    const amount = parseFloat(toEnglishNumber(amountText).replace(/,/g, '')) || 0;
                    const invoiceNumberText = $(this).find('td:eq(1)').text().trim();
                    const invoiceNumber = parseInt(invoiceNumberText.replace(/\D/g, '')) || 0;
                    const invoiceTotal = parseFloat(toEnglishNumber($(this).find('td:eq(3)').text()).replace(/,/g, '')) || 0;
                    const invoiceRemaining = parseFloat(toEnglishNumber($(this).find('td:eq(4)').text()).replace(/,/g, '')) || 0;

                    currentInvoices.push({
                        id: invId,
                        number: invoiceNumber,
                        total: invoiceTotal,
                        remaining: invoiceRemaining,
                        date: new Date().toISOString()
                    });
                });
            }, 100);

        });
    </script>
}