@model MyFirstCoreApp.Areas.Banking.ViewModels.Payment.PaymentFormViewModel
@{
    ViewData["Title"] = Model.PaymentType == MyFirstCoreApp.Domain.Enums.PaymentType.Received
        ? "ثبت دریافت"
        : "ثبت پرداخت";
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-money-bill-transfer"></i>
            @ViewData["Title"]
        </h3>
    </div>

    <form asp-area="Banking" asp-controller="Payments" asp-action="Create" method="post" id="paymentForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Number" />
        <input type="hidden" asp-for="PaymentType" id="PaymentType_Hidden" />

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <partial name="_Form" model="Model" />
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i> ذخیره
            </button>
            <a asp-action="Index" asp-route-paymentType="@((int)Model.PaymentType)" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-right"></i> انصراف
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
        // 🆕 متغیر global
        let currentInvoices = [];
            // ============================================
            // ۱. DatePicker
            // ============================================
            $('.datepicker').each(function () {
                var $input = $(this);
                var val = $input.val();
                $input.persianDatepicker({
                    format: 'YYYY/MM/DD',
                    initialValue: false,
                    autoClose: true,
                    observer: true,
                    calendar: { persian: { locale: 'fa', showHint: true, leapYearMode: 'algorithmic' } },
                    toolbox: { calendarSwitch: { enabled: false } }
                });
                if (val) $input.persianDatepicker('setDate', val);
            });

            // ============================================
            // ۲. Select2
            // ============================================
            $('select.select2').select2({
                dir: 'rtl',
                placeholder: '-- انتخاب --',
                allowClear: true,
                width: '100%',
                language: 'fa'
            });

            // ============================================
            // ۳. توابع کمکی
            // ============================================

            // 🆕 محاسبه مجموع
            function updateTotals() {
                let amount = parseFloat($('#Amount_Hidden').val()) || 0;
                if (isNaN(amount)) amount = 0;

                let total = 0;
                $('.allocation-amount').each(function () {
                    const v = $(this).val();
                    const num = parseFloat(toEnglishNumber(v).replace(/,/g, '')) || 0;
                    total += num;
                });

                const remaining = amount - total;

                $('#totalAmount').text(formatNumberWithComma(amount.toString()));
                $('#totalAllocated').text(formatNumberWithComma(total.toString()));
                $('#remainingAmount').text(formatNumberWithComma(remaining.toString()));

                if (remaining < 0) {
                    $('#remainingAmount').addClass('text-danger');
                } else {
                    $('#remainingAmount').removeClass('text-danger');
                }
            }

            // 🆕 sync Amount
            function syncAmount() {
                var displayVal = $('#Amount_Display').val();
                var hiddenVal = toEnglishNumber(displayVal).replace(/,/g, '').split('.')[0];
                $('#Amount_Hidden').val(hiddenVal);

                // 🆕 اگه فاکتورها لود شدن، دوباره تخصیص بده
                if (currentInvoices.length > 0) {
                    renderAllocations(currentInvoices);
                } else {
                    updateTotals();
                }
            }

            // 🆕 رندر جدول تخصیص‌ها
            function renderAllocations(invoices) {
                currentInvoices = invoices;
                const tbody = $('#allocationsBody');
                tbody.empty();

                if (invoices.length === 0) {
                    tbody.append('<tr><td colspan="6" class="text-center text-muted">فاکتور بازی وجود ندارد.</td></tr>');
                    updateTotals();
                    return;
                }

                let amountToAllocate = parseFloat($('#Amount_Hidden').val()) || 0;
                if (isNaN(amountToAllocate)) amountToAllocate = 0;

                let remainingToAllocate = amountToAllocate;
                let html = '';

                invoices.forEach(function (inv, idx) {
                    let allocate = 0;
                    if (remainingToAllocate > 0) {
                        allocate = Math.min(remainingToAllocate, inv.remaining);
                        remainingToAllocate -= allocate;
                    }

                    // 🆕 تاریخ امن
                    const displayDate = inv.dateShamsi || '—';

                    html += '<tr class="allocation-row" data-invoice-id="' + inv.id + '">';
                    html += '  <td class="text-center">' + (idx + 1) + '</td>';
                    html += '  <td>فاکتور شماره ' + inv.number;
                    html += '    <input type="hidden" name="Allocations[' + idx + '].InvoiceId" value="' + inv.id + '" />';
                    html += '  </td>';
                    html += '  <td>' + displayDate + '</td>';
                    html += '  <td class="persian-number-comma">' + Number(inv.total).toLocaleString('en-US') + '</td>';
                    html += '  <td class="persian-number-comma text-warning">' + Number(inv.remaining).toLocaleString('en-US') + '</td>';
                    html += '  <td><input type="text" name="Allocations[' + idx + '].Amount" class="form-control form-control-sm allocation-amount persian-number persian-number-comma" data-remaining="' + inv.remaining + '" value="' + (allocate > 0 ? formatNumberWithComma(allocate.toString()) : '0') + '" /></td>';
                    html += '</tr>';
                });

                tbody.html(html);
                updateTotals();
            }
            // ============================================
            // ۴. رویدادها
            // ============================================

            // 🆕 تایپ مبلغ کل
            $(document).on('input', '#Amount_Display', function () {
                var val = $(this).val();
                if (val) {
                    var formatted = formatNumberWithComma(toEnglishNumber(val).replace(/,/g, '').split('.')[0]);
                    $(this).val(formatted);
                }
                syncAmount();
            });

            // 🆕 تایپ مبلغ تخصیص
            $(document).on('input', '.allocation-amount', function () {
                var val = $(this).val();
                if (val) {
                    $(this).val(formatNumberWithComma(toEnglishNumber(val).replace(/,/g, '').split('.')[0]));
                }
                updateTotals();
            });

            // 🆕 تغییر طرف حساب
            $('#ContactId').on('change', function () {
                const contactId = $(this).val();
                const paymentType = $('#PaymentType_Hidden').val();

                if (!contactId) {
                    $('#allocationsBody').empty();
                    updateTotals();
                    return;
                }

                $.ajax({
                    url: '/Banking/Payments/GetInvoices',
                    type: 'GET',
                    data: { contactId: contactId, paymentType: paymentType },
                    success: function (r) {
                        console.log('Invoices from server:', r.data);   // 🆕 چک کن
                        if (r.success) renderAllocations(r.data);
                    }
                });
            });

            // 🆕 Submit
            $('#paymentForm').on('submit', function () {
                syncAmount();

                $('.persian-number').each(function () {
                    const $input = $(this);
                    let val = $input.val();
                    if (val) {
                        val = toEnglishNumber(val).replace(/,/g, '').split('.')[0];
                        $input.val(val);
                    }
                });

                console.log('=== SUBMIT ===');
                console.log('Amount:', $('#Amount_Hidden').val());
                $('input[name^="Allocations"]').each(function () {
                    console.log($(this).attr('name'), '=', $(this).val());
                });
            });
            // ============================================
            // پرداخت با چک
            // ============================================
            const currentPaymentId = @Model.Id;

            function isChequeMethod() { return $('#PaymentMethod').val() === '4'; }

            function toggleChequeUi() {
                const cheque = isChequeMethod();
                $('#chequeRow').toggle(cheque);
                $('#bankAccountGroup').toggle(!cheque);
                $('#Amount_Display').prop('readonly', cheque && !!$('#ChequeId').val());
            }

            function loadCheques() {
                const $select = $('#ChequeId');
                const selected = $select.data('selected') || $select.val();
                const contactId = $('#ContactId').val();
                const paymentType = $('#PaymentType_Hidden').val() || $('#PaymentType').val();

                $select.empty().append('<option value="">-- انتخاب چک --</option>');
                if (!isChequeMethod() || !contactId) return;

                $.get('/Banking/Payments/GetCheques',
                    { contactId: contactId, paymentType: paymentType, paymentId: currentPaymentId },
                    function (r) {
                        if (!r.success) return;
                        r.data.forEach(function (c) {
                            $select.append('<option value="' + c.id + '" data-amount="' + c.amount + '">' +
                                c.chequeNumber + ' — ' + Number(c.amount).toLocaleString('en-US') +
                                ' ریال — سررسید ' + c.dueDateShamsi + '</option>');
                        });
                        if (selected) $select.val(String(selected));
                        toggleChequeUi();
                    });
            }

            $('#PaymentMethod').on('change', function () { toggleChequeUi(); loadCheques(); });
            $('#ContactId').on('change', loadCheques);
            $('#ChequeId').on('change', function () {
                const amount = $(this).find(':selected').data('amount');
                if (amount) {
                    $('#Amount_Display').val(formatNumberWithComma(String(amount)));
                    syncAmount();
                }
                toggleChequeUi();
            });

            toggleChequeUi();
            loadCheques();
            // ============================================
            // ۵. بارگذاری اولیه
            // ============================================
            syncAmount();

        });
    </script>
}