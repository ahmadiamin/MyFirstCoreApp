@model MyFirstCoreApp.Areas.Banking.ViewModels.Payment.PaymentFormViewModel

<div class="row">
    <div class="col-md-2">
        <div class="form-group">
            <label asp-for="Number"></label>
            <input asp-for="Number" class="form-control" readonly />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="Date"></label>
            <input asp-for="Date" class="form-control datepicker" autocomplete="off" dir="ltr" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="PaymentType"></label>
            <select asp-for="PaymentType" class="form-control" id="PaymentType">
                <option value="1">دریافت از مشتری</option>
                <option value="2">پرداخت به فروشنده</option>
            </select>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label asp-for="ContactId"></label>
            <select asp-for="ContactId" id="ContactId" class="form-control select2" asp-items="Model.ContactOptions">
                <option value="">-- انتخاب طرف حساب --</option>
            </select>
            <span asp-validation-for="ContactId" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3" id="bankAccountGroup">
        <div class="form-group">
            <label asp-for="BankAccountId"></label>
            <select asp-for="BankAccountId" class="form-control select2" asp-items="Model.BankAccountOptions">
                <option value="">-- انتخاب حساب --</option>
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="PaymentMethod"></label>
            <select asp-for="PaymentMethod" class="form-control">
                <option value="1">نقد</option>
                <option value="2">انتقال بانکی</option>
                <option value="3">کارت به کارت</option>
                <option value="4">چک</option>
                <option value="99">سایر</option>
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="Amount"></label>

            <input type="text" id="Amount_Display"
                   class="form-control ltr persian-number persian-number-comma"
                   data-target="Amount_Hidden"
                   value="@Model.Amount" autocomplete="off" />

            <input asp-for="Amount" type="hidden" id="Amount_Hidden" /> 

            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="Reference"></label>
            <input asp-for="Reference" class="form-control" />
        </div>
    </div>
</div>
<partial name="_ChequePicker" model="Model" />
<hr />
<h5><i class="fa-solid fa-list"></i> تخصیص به فاکتورها</h5>

<div class="table-responsive">
    <table class="table table-bordered table-striped" id="allocationsTable">
        <thead>
            <tr>
                <th style="width: 40px;">#</th>
                <th>فاکتور</th>
                <th style="width: 110px;">تاریخ</th>
                <th style="width: 130px;">مبلغ کل</th>
                <th style="width: 130px;">باقی‌مانده</th>
                <th style="width: 160px;">مبلغ تخصیص</th>
            </tr>
        </thead>
        <tbody id="allocationsBody">
            @for (int i = 0; i < Model.Allocations.Count; i++)
            {
                <tr class="allocation-row" data-invoice-id="@Model.Allocations[i].InvoiceId">
                    <td class="text-center">@(i + 1)</td>
                    <td>
                        فاکتور شماره @Model.Allocations[i].InvoiceNumber
                        <input type="hidden" name="Allocations[@i].InvoiceId" value="@Model.Allocations[i].InvoiceId" />
                        <input type="hidden" name="Allocations[@i].Id" value="@Model.Allocations[i].Id" />
                    </td>
                    <td>@Model.Allocations[i].InvoiceDate</td>
                    <td class="persian-number-comma">@Model.Allocations[i].InvoiceTotal.ToString("N0")</td>
                    <td class="persian-number-comma text-warning">@Model.Allocations[i].InvoiceRemaining.ToString("N0")</td>
                    <td>
                        <input type="text" name="Allocations[@i].Amount"
                               class="form-control form-control-sm allocation-amount persian-number persian-number-comma"
                               data-remaining="@Model.Allocations[i].InvoiceRemaining"
                               value="@Model.Allocations[i].Amount" />
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="bg-light">
                <th colspan="5" class="text-left">مبلغ کل پرداخت:</th>
                <th id="totalAmount" class="persian-number-comma">۰</th>
            </tr>
            <tr class="bg-light">
                <th colspan="5" class="text-left">مجموع تخصیص:</th>
                <th id="totalAllocated" class="persian-number-comma">۰</th>
            </tr>
            <tr class="bg-info">
                <th colspan="5" class="text-left">مانده (تخصیص‌نیافته):</th>
                <th id="remainingAmount" class="persian-number-comma">۰</th>
            </tr>
        </tfoot>
    </table>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
    </div>
</div>