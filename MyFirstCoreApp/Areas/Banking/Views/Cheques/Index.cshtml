                            { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                            { text: 'نقد شد', class: 'btn-success', icon: 'fa-solid fa-check', action: 'confirm' }
                        ],
                        onShow: function () { initDatePickerInModal(); },
                        onConfirm: function () {
                            sendChequeRequest('/Banking/Cheques/MarkAsCashed', {
