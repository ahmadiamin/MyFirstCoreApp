@{
    // 🆕 تشخیص جهت از URL
    var directionParam = Context.Request.Query["direction"].ToString();
    var isReceived = directionParam == "1";
    var pageTitle = isReceived ? "چک‌های دریافتنی" : "چک‌های پرداختنی";
    ViewData["Title"] = pageTitle;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-money-check"></i>
            لیست @pageTitle
        </h3>
        <div class="card-tools">
            @if (isReceived)
            {
                <a asp-action="Create" asp-route-direction="1" class="btn btn-success btn-sm">
                    <i class="fa-solid fa-plus"></i> چک دریافتنی
                </a>
            }
            else
            {
                <a asp-action="Create" asp-route-direction="2" class="btn btn-danger btn-sm">
                    <i class="fa-solid fa-plus"></i> چک پرداختنی
                </a>
            }
        </div>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                    </div>
                    <input type="text" id="txtSearch" class="form-control"
                           placeholder="جستجو در شماره چک، بانک، صاحب چک..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <div id="chequesGrid" class="ag-theme-alpine"
             style="height: 600px; width: 100%;">
        </div>

    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // ============================================
        // 🆕 متغیر global برای Grid API
        // ============================================
        let chequesGridApi = null;

        $(document).ready(function () {

            // ============================================
            // ۱. URL با فیلتر جهت
            // ============================================
            const urlParams = new URLSearchParams(window.location.search);
            const direction = urlParams.get('direction');

            let dataUrl = '/Banking/Cheques/GetData';
            if (direction) dataUrl += '?direction=' + direction;

            // ============================================
            // ۲. تعریف ستون‌ها
            // ============================================
            const columnDefs = [
                AgGridHelper.rowNumberColumn(),
                { field: 'chequeNumber', headerName: 'شماره چک', width: 120 },
                {
                    field: 'directionName',
                    headerName: 'جهت',
                    width: 100,
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const span = document.createElement('span');
                        span.className = params.data.direction === 1 ? 'badge badge-success' : 'badge badge-danger';
                        span.textContent = params.value;
                        return span;
                    }
                },
                { field: 'contactName', headerName: 'طرف حساب', width: 180, flex: 1 },
                { field: 'drawerName', headerName: 'صاحب چک', width: 150 },
                { field: 'bankName', headerName: 'بانک', width: 130 },
                AgGridHelper.moneyColumn('amount', 'مبلغ', 140),
                {
                    field: 'dueDate',
                    headerName: 'سررسید',
                    width: 110,
                    valueFormatter: function (params) {
                        if (!params.value) return '';
                        const d = new Date(params.value);
                        return d.toLocaleDateString('fa-IR');
                    }
                },
                {
                    field: 'statusName',
                    headerName: 'وضعیت',
                    width: 120,
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const span = document.createElement('span');
                        const s = params.data.status;
                        if (s === 1) span.className = 'badge badge-primary';
                        else if (s === 2) span.className = 'badge badge-success';
                        else if (s === 3) span.className = 'badge badge-danger';
                        else if (s === 4) span.className = 'badge badge-warning';
                        else if (s === 5) span.className = 'badge badge-info';
                        else if (s === 6) span.className = 'badge badge-dark';
                        else if (s === 7) span.className = 'badge badge-warning';
                        else if (s === 8) span.className = 'badge badge-success';
                        else span.className = 'badge badge-secondary';
                        span.textContent = params.value;
                        return span;
                    }
                },
                {
                    field: 'nextFollowUpDate',
                    headerName: 'پیگیری',
                    width: 110,
                    minWidth: 110,
                    maxWidth: 110,
                    cellRenderer: function (params) {
                        if (!params.value) return '<span class="text-muted">—</span>';
                        const date = new Date(params.value);
                        const today = new Date(); today.setHours(0,0,0,0);
                        const f = new Date(date); f.setHours(0,0,0,0);
                        const diff = Math.ceil((f - today) / (1000*60*60*24));
                        let label = '', cls = 'badge-info';
                        if (diff < 0) { label = `${Math.abs(diff)} روز گذشته`; cls = 'badge-danger'; }
                        else if (diff === 0) { label = 'امروز'; cls = 'badge-warning'; }
                        else if (diff === 1) { label = 'فردا'; cls = 'badge-warning'; }
                        else if (diff <= 7) { label = `${diff} روز آینده`; }
                        else { label = date.toLocaleDateString('fa-IR'); }
                        return `<span class="badge ${cls}" title="${date.toLocaleDateString('fa-IR')}">${label}</span>`;
                    }
                },
                {
                    headerName: 'عملیات',
                    colId: 'actions',
                    width: 300,
                    minWidth: 300,
                    sortable: false,
                    filter: false,
                    pinned: 'left',
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        const div = document.createElement('div');
                        div.className = 'action-buttons';
                        const d = params.data;

                        // 👁 مشاهده (همیشه)
                        const viewBtn = document.createElement('a');
                        viewBtn.href = `/Banking/Cheques/Details/${d.id}`;
                        viewBtn.className = 'btn btn-sm btn-outline-info action-icon-btn';
                        viewBtn.title = 'مشاهده';
                        viewBtn.innerHTML = '<i class="fa-solid fa-eye"></i>';
                        div.appendChild(viewBtn);

                        // ============================================
                        // در جریان (Status=1)
                        // ============================================
                        if (d.status === 1) {
                            // ✅ پاس
                            const clearedBtn = document.createElement('a');
                            clearedBtn.href = 'javascript:void(0)';
                            clearedBtn.className = 'btn btn-sm btn-outline-success action-icon-btn wf-btn';
                            clearedBtn.dataset.id = d.id;
                            clearedBtn.dataset.action = 'cleared';
                            clearedBtn.title = 'پاس شد';
                            clearedBtn.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
                            div.appendChild(clearedBtn);

                            // ❌ برگشت
                            const bouncedBtn = document.createElement('a');
                            bouncedBtn.href = 'javascript:void(0)';
                            bouncedBtn.className = 'btn btn-sm btn-outline-danger action-icon-btn wf-btn';
                            bouncedBtn.dataset.id = d.id;
                            bouncedBtn.dataset.action = 'bounced';
                            bouncedBtn.title = 'برگشت خورد';
                            bouncedBtn.innerHTML = '<i class="fa-solid fa-circle-xmark"></i>';
                            div.appendChild(bouncedBtn);

                            // 💰 نقد
                            const cashedBtn = document.createElement('a');
                            cashedBtn.href = 'javascript:void(0)';
                            cashedBtn.className = 'btn btn-sm btn-outline-success action-icon-btn wf-btn';
                            cashedBtn.dataset.id = d.id;
                            cashedBtn.dataset.action = 'cashed';
                            cashedBtn.title = 'نقد شد';
                            cashedBtn.innerHTML = '<i class="fa-solid fa-money-bill-wave"></i>';
                            div.appendChild(cashedBtn);

                            // 📥 ارائه به بانک
                            const depositedBtn = document.createElement('a');
                            depositedBtn.href = 'javascript:void(0)';
                            depositedBtn.className = 'btn btn-sm btn-outline-secondary action-icon-btn wf-btn';
                            depositedBtn.dataset.id = d.id;
                            depositedBtn.dataset.action = 'deposited';
                            depositedBtn.title = 'ارائه به بانک';
                            depositedBtn.innerHTML = '<i class="fa-solid fa-building-columns"></i>';
                            div.appendChild(depositedBtn);

                            // ✏ ویرایش
                            const editBtn = document.createElement('a');
                            editBtn.href = `/Banking/Cheques/Edit/${d.id}`;
                            editBtn.className = 'btn btn-sm btn-outline-primary action-icon-btn';
                            editBtn.title = 'ویرایش';
                            editBtn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
                            div.appendChild(editBtn);

                            // 🗑 حذف
                            const deleteBtn = document.createElement('a');
                            deleteBtn.href = 'javascript:void(0)';
                            deleteBtn.className = 'btn btn-sm btn-outline-danger action-icon-btn delete-btn';
                            deleteBtn.dataset.id = d.id;
                            deleteBtn.dataset.title = d.chequeNumber || '';
                            deleteBtn.dataset.contact = d.contactName || '';
                            deleteBtn.dataset.amount = d.amount || 0;
                            deleteBtn.title = 'حذف';
                            deleteBtn.innerHTML = '<i class="fa-solid fa-trash"></i>';
                            div.appendChild(deleteBtn);
                        }
                        // ============================================
                        // برگشت خورده (Status=3)
                        // ============================================
                        else if (d.status === 3) {
                            // 🔄 ارائه مجدد
                            const representedBtn = document.createElement('a');
                            representedBtn.href = 'javascript:void(0)';
                            representedBtn.className = 'btn btn-sm btn-outline-primary action-icon-btn wf-btn';
                            representedBtn.dataset.id = d.id;
                            representedBtn.dataset.action = 'represented';
                            representedBtn.title = 'ارائه مجدد';
                            representedBtn.innerHTML = '<i class="fa-solid fa-rotate-right"></i>';
                            div.appendChild(representedBtn);

                            // ↩ عودت به مشتری
                            const returnedBtn = document.createElement('a');
                            returnedBtn.href = 'javascript:void(0)';
                            returnedBtn.className = 'btn btn-sm btn-outline-warning action-icon-btn wf-btn';
                            returnedBtn.dataset.id = d.id;
                            returnedBtn.dataset.action = 'returned';
                            returnedBtn.title = 'عودت به مشتری';
                            returnedBtn.innerHTML = '<i class="fa-solid fa-rotate-left"></i>';
                            div.appendChild(returnedBtn);

                            // ⚖ ارجاع به صاحب چک
                            const referredBtn = document.createElement('a');
                            referredBtn.href = 'javascript:void(0)';
                            referredBtn.className = 'btn btn-sm btn-outline-warning action-icon-btn wf-btn';
                            referredBtn.dataset.id = d.id;
                            referredBtn.dataset.action = 'referred';
                            referredBtn.title = 'ارجاع به صاحب چک';
                            referredBtn.innerHTML = '<i class="fa-solid fa-gavel"></i>';
                            div.appendChild(referredBtn);
                        }
                        // ============================================
                        // ✅ پاس شده (Status=2)
                        // ============================================
                        else if (d.status === 2) {
                            // ↩ برگشت از پاس
                            const unclearBtn = document.createElement('a');
                            unclearBtn.href = 'javascript:void(0)';
                            unclearBtn.className = 'btn btn-sm btn-outline-warning action-icon-btn wf-btn';
                            unclearBtn.dataset.id = d.id;
                            unclearBtn.dataset.action = 'unclear';
                            unclearBtn.title = 'برگشت از پاس';
                            unclearBtn.innerHTML = '<i class="fa-solid fa-rotate-left"></i>';
                            div.appendChild(unclearBtn);
                        }
                        // ============================================
                        // 💰 نقد شده (Status=8)
                        // ============================================
                        else if (d.status === 8) {
                            // ↩ برگشت از نقد
                            const uncashBtn = document.createElement('a');
                            uncashBtn.href = 'javascript:void(0)';
                            uncashBtn.className = 'btn btn-sm btn-outline-warning action-icon-btn wf-btn';
                            uncashBtn.dataset.id = d.id;
                            uncashBtn.dataset.action = 'uncash';
                            uncashBtn.title = 'برگشت از نقد';
                            uncashBtn.innerHTML = '<i class="fa-solid fa-rotate-left"></i>';
                            div.appendChild(uncashBtn);
                        }
                        return div;
                    }
                }
            ];

            // ============================================
            // ۳. ساخت Grid
            // ============================================
            chequesGridApi = AgGridHelper.create(
                'chequesGrid',
                columnDefs,
                dataUrl,
                'txtSearch',
                'lblCount'
            );

        });

        // ============================================
        // ۴. رویداد حذف
        // ============================================
        $(document).on('click', '.delete-btn', function () {
            const $btn = $(this);
            const id = $btn.data('id');
            const title = $btn.data('title');
            const contact = $btn.data('contact');
            const amount = $btn.data('amount');

            const items = [];
            if (title) items.push({ label: 'شماره چک', value: title });
            if (contact) items.push({ label: 'طرف حساب', value: contact });
            if (amount) items.push({ label: 'مبلغ', value: Number(amount).toLocaleString('en-US') + ' ریال' });

            ModalHelper.confirmDelete({
                url: '/Banking/Cheques/Delete',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                title: 'حذف چک شماره ' + title,
                message: 'آیا از حذف این چک مطمئن هستید؟',
                items: items,
                onSuccess: function () {
                    if (chequesGridApi) {
                        const ds = chequesGridApi.getGridOption('datasource');
                        chequesGridApi.setGridOption('datasource', ds);
                    } else {
                        location.reload();
                    }
                }
            });
        });

        // ============================================
        // ۵. رویدادهای گردش کار
        // ============================================
        $(document).on('click', '.wf-btn', function () {
            const id = $(this).data('id');
            const action = $(this).data('action');
            handleChequeWorkflow(id, action);
        });

        function handleChequeWorkflow(id, action) {
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (action === 'cleared') {
                // ✅ پاس
                ModalHelper.show({
                    title: 'پاس کردن چک',
                    icon: 'fa-solid fa-circle-check',
                    headerClass: 'bg-success text-white',
                    body: `
                        <div class="form-group">
                            <label>تاریخ پاس (اختیاری):</label>
                            <input type="text" id="clearedDate" class="form-control datepicker" placeholder="مثلاً 1405/07/18" autocomplete="off" dir="ltr" />
                            <small class="form-text text-muted">اگر خالی باشد، تاریخ امروز ثبت می‌شود.</small>
                        </div>
                        <div class="form-group">
                            <label>شماره پیگیری بانک (اختیاری):</label>
                            <input type="text" id="bankTrackingNumber" class="form-control" />
                        </div>
                    `,
                    buttons: [
                        { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                        { text: 'پاس شد', class: 'btn-success', icon: 'fa-solid fa-check', action: 'confirm' }
                    ],
                    onConfirm: function () {
                        const clearedDate = $('#clearedDate').val();
                        const bankTrackingNumber = $('#bankTrackingNumber').val();

                        sendChequeRequest('/Banking/Cheques/MarkAsCleared', {
                            id: id,
                            clearedDate: clearedDate,
                            bankTrackingNumber: bankTrackingNumber,
                            __RequestVerificationToken: token
                        }, 'چک پاس شد');
                    }
                });
            }
            else if (action === 'bounced') {
                // ❌ برگشت
                ModalHelper.show({
                    title: 'برگشت چک',
                    icon: 'fa-solid fa-circle-xmark',
                    headerClass: 'bg-danger text-white',
                    body: `
                        <div class="form-group">
                            <label>دلیل برگشت:</label>
                            <input type="text" id="bounceReason" class="form-control" placeholder="مثلاً موجودی کافی نبود" />
                        </div>
                        <div class="form-group">
                            <label>تاریخ برگشت (اختیاری):</label>
                            <input type="text" id="bouncedDate" class="form-control datepicker" placeholder="مثلاً 1405/07/18" autocomplete="off" dir="ltr" />
                            <small class="form-text text-muted">اگر خالی باشد، تاریخ امروز ثبت می‌شود.</small>
                        </div>
                    `,
                    buttons: [
                        { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                        { text: 'برگشت خورد', class: 'btn-danger', icon: 'fa-solid fa-check', action: 'confirm' }
                    ],
                    onConfirm: function () {
                        const bounceReason = $('#bounceReason').val();
                        const bouncedDate = $('#bouncedDate').val();

                        if (!bounceReason) {
                            ModalHelper.error('دلیل برگشت الزامی است.');
                            return;
                        }

                        sendChequeRequest('/Banking/Cheques/MarkAsBounced', {
                            id: id,
                            bounceReason: bounceReason,
                            bouncedDate: bouncedDate,
                            __RequestVerificationToken: token
                        }, 'چک برگشت خورد');
                    }
                });
            }
            else if (action === 'cashed') {
                // 💰 نقد
                ModalHelper.show({
                    title: 'نقد کردن چک',
                    icon: 'fa-solid fa-money-bill-wave',
                    headerClass: 'bg-success text-white',
                    body: `
                        <div class="form-group">
                            <label>تاریخ نقد (اختیاری):</label>
                            <input type="text" id="cashedDate" class="form-control datepicker" placeholder="مثلاً 1405/07/18" autocomplete="off" dir="ltr" />
                            <small class="form-text text-muted">اگر خالی باشد، تاریخ امروز ثبت می‌شود.</small>
                        </div>
                        <div class="form-group">
                            <label>توضیحات (اختیاری):</label>
                            <input type="text" id="cashedDesc" class="form-control" />
                        </div>
                    `,
                    buttons: [
                        { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                        { text: 'نقد شد', class: 'btn-success', icon: 'fa-solid fa-check', action: 'confirm' }
                    ],
                    onConfirm: function () {
                        sendChequeRequest('/Banking/Cheques/MarkAsCashed', {
                            id: id,
                            cashedDate: $('#cashedDate').val(),
                            description: $('#cashedDesc').val(),
                            __RequestVerificationToken: token
                        }, 'چک نقد شد');
                    }
                });
            }
            else if (action === 'deposited') {
                // 📥 ارائه به بانک
                ModalHelper.confirm(
                    'آیا چک به بانک ارائه شد؟',
                    function () {
                        sendChequeRequest('/Banking/Cheques/MarkAsDeposited', {
                            id: id,
                            description: 'ارائه به بانک',
                            __RequestVerificationToken: token
                        }, 'چک به بانک ارائه شد');
                    },
                    { title: 'ارائه به بانک', icon: 'fa-solid fa-building-columns', headerClass: 'bg-secondary text-white' }
                );
            }
            else if (action === 'represented') {
                // 🔄 ارائه مجدد
                ModalHelper.show({
                    title: 'ارائه مجدد چک',
                    icon: 'fa-solid fa-rotate-right',
                    headerClass: 'bg-primary text-white',
                    body: `
                        <div class="form-group">
                            <label>تاریخ سررسید جدید:</label>
                            <input type="text" id="newDueDate" class="form-control datepicker" placeholder="مثلاً 1405/09/15" autocomplete="off" dir="ltr" />
                        </div>
                        <div class="form-group">
                            <label>توضیحات (اختیاری):</label>
                            <input type="text" id="representedDesc" class="form-control" />
                        </div>
                    `,
                    buttons: [
                        { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                        { text: 'ارائه مجدد', class: 'btn-primary', icon: 'fa-solid fa-check', action: 'confirm' }
                    ],
                    onConfirm: function () {
                        const newDueDate = $('#newDueDate').val();
                        if (!newDueDate) {
                            ModalHelper.error('تاریخ سررسید جدید الزامی است.');
                            return;
                        }
                        sendChequeRequest('/Banking/Cheques/MarkAsRePresented', {
                            id: id,
                            newDueDate: newDueDate,
                            description: $('#representedDesc').val(),
                            __RequestVerificationToken: token
                        }, 'چک مجدداً ارائه شد');
                    }
                });
            }
            else if (action === 'returned') {
                // ↩ عودت
                ModalHelper.show({
                    title: 'عودت چک به مشتری',
                    icon: 'fa-solid fa-rotate-left',
                    headerClass: 'bg-warning text-white',
                    body: `
                        <div class="form-group">
                            <label>توضیحات (اختیاری):</label>
                            <input type="text" id="returnedDesc" class="form-control" />
                        </div>
                    `,
                    buttons: [
                        { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                        { text: 'عودت', class: 'btn-warning', icon: 'fa-solid fa-check', action: 'confirm' }
                    ],
                    onConfirm: function () {
                        sendChequeRequest('/Banking/Cheques/MarkAsReturned', {
                            id: id,
                            description: $('#returnedDesc').val(),
                            __RequestVerificationToken: token
                        }, 'چک به مشتری عودت داده شد');
                    }
                });
            }
            else if (action === 'referred') {
                // ⚖ ارجاع
                ModalHelper.show({
                    title: 'ارجاع به صاحب چک',
                    icon: 'fa-solid fa-gavel',
                    headerClass: 'bg-warning text-white',
                    body: `
                        <div class="form-group">
                            <label>توضیحات:</label>
                            <input type="text" id="referredDesc" class="form-control" />
                        </div>
                    `,
                    buttons: [
                        { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                        { text: 'ارجاع', class: 'btn-warning', icon: 'fa-solid fa-check', action: 'confirm' }
                    ],
                    onConfirm: function () {
                        sendChequeRequest('/Banking/Cheques/MarkAsReferred', {
                            id: id,
                            description: $('#referredDesc').val(),
                            __RequestVerificationToken: token
                        }, 'چک به صاحب چک ارجاع شد');
                    }
                });
            }
            else if (action === 'unclear') {
            // ↩ برگشت از پاس
            ModalHelper.show({
                title: 'برگشت از پاس',
                icon: 'fa-solid fa-rotate-left',
                headerClass: 'bg-warning text-white',
                body: `
                    <div class="alert alert-warning">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        با برگشت از پاس، سند حسابداری حذف می‌شود و چک به وضعیت «در جریان» برمی‌گردد.
                    </div>
                    <div class="form-group">
                        <label>دلیل برگشت:</label>
                        <input type="text" id="unclearReason" class="form-control" placeholder="مثلاً اشتباه پاس شده" />
                    </div>
                `,
                buttons: [
                    { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                    { text: 'برگشت', class: 'btn-warning', icon: 'fa-solid fa-rotate-left', action: 'confirm' }
                ],
                onConfirm: function () {
                    sendChequeRequest('/Banking/Cheques/Unclear', {
                        id: id,
                        reason: $('#unclearReason').val(),
                        __RequestVerificationToken: token
                    }, 'چک به وضعیت در جریان برگشت');
                }
            });
        }
            else if (action === 'uncash') {
            // ↩ برگشت از نقد
            ModalHelper.show({
                title: 'برگشت از نقد',
                icon: 'fa-solid fa-rotate-left',
                headerClass: 'bg-warning text-white',
                body: `
                    <div class="alert alert-warning">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        با برگشت از نقد، سند حسابداری حذف می‌شود و چک به وضعیت «در جریان» برمی‌گردد.
                    </div>
                    <div class="form-group">
                        <label>دلیل برگشت:</label>
                        <input type="text" id="uncashReason" class="form-control" placeholder="مثلاً اشتباه نقد شده" />
                    </div>
                `,
                buttons: [
                    { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                    { text: 'برگشت', class: 'btn-warning', icon: 'fa-solid fa-rotate-left', action: 'confirm' }
                ],
                onConfirm: function () {
                    sendChequeRequest('/Banking/Cheques/Uncash', {
                        id: id,
                        reason: $('#uncashReason').val(),
                        __RequestVerificationToken: token
                    }, 'چک به وضعیت در جریان برگشت');
                }
            });
        }
        }

        function sendChequeRequest(url, data, successMsg) {
            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                success: function (r) {
                    if (r.success) {
                        ModalHelper.success(r.message || successMsg, {
                            onClose: function () {
                                if (chequesGridApi) {
                                    const ds = chequesGridApi.getGridOption('datasource');
                                    chequesGridApi.setGridOption('datasource', ds);
                                } else {
                                    location.reload();
                                }
                            }
                        });
                    } else {
                        ModalHelper.error(r.message);
                    }
                },
                error: function () {
                    ModalHelper.error('خطا در ارتباط با سرور');
                }
            });
        }
    </script>
}