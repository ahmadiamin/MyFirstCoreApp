@{
    // 🆕 تشخیص جهت از URL
    var directionParam = Context.Request.Query["direction"].ToString();
    var isReceived = directionParam == "1";
    var pageTitle = isReceived ? "چک‌های دریافتنی" : "چک‌های پرداختنی";
    ViewData["Title"] = pageTitle;
}

<style>
    #chequesGrid.ag-theme-alpine {
        --ag-font-size: 13px;
        width: 100%;
    }

    @@media (max-width: 767.98px) {
        #chequesGrid.ag-theme-alpine {
            --ag-font-size: 12px;
        }
    }

    .action-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
        justify-content: flex-start;
        align-items: center;
    }

        .action-buttons .btn {
            padding: 3px 6px;
            line-height: 1;
        }

    .ag-right-aligned-header .ag-header-cell-label {
        justify-content: flex-end;
    }

    .cheque-card {
        border: 1px solid #e3e3e3;
        border-radius: 6px;
        background: #fff;
        margin-bottom: 8px;
        padding: 10px;
    }

        .cheque-card .title {
            font-weight: 600;
            font-size: 14px;
        }

        .cheque-card .row-line {
            font-size: 12px;
            color: #6c757d;
            margin-top: 3px;
            word-break: break-all;
        }

        .cheque-card .amount {
            font-weight: 600;
            color: #0d6efd;
            font-size: 13px;
            margin-top: 4px;
        }

        .cheque-card .followup {
            font-size: 12px;
            margin-top: 4px;
        }

        .cheque-card .actions {
            margin-top: 8px;
        }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-money-check"></i>
            لیست @pageTitle
        </h3>
        <div class="card-tools">
            @if (isReceived)
            {
                <a asp-action="Create" asp-route-direction="1" class="btn btn-success btn-sm">
                    <i class="fa-solid fa-plus"></i> چک دریافتنی
                </a>
            }
            else
            {
                <a asp-action="Create" asp-route-direction="2" class="btn btn-danger btn-sm">
                    <i class="fa-solid fa-plus"></i> چک پرداختنی
                </a>
            }
        </div>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                    </div>
                    <input type="text" id="txtSearch" class="form-control"
                           placeholder="جستجو در شماره چک، بانک، صاحب چک..." />
                </div>
            </div>
            <div class="col-md-7 text-left">
                <span class="text-muted" id="lblCount"></span>
            </div>
        </div>

        <!-- دسکتاپ: AG Grid -->
        <div id="chequesGrid" class="ag-theme-alpine d-none d-md-block"
             style="height: 600px; width: 100%;">
        </div>

        <!-- موبایل: کارت‌ها -->
        <div id="mobileCheques" class="d-md-none"></div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            var gridApi = null;
            var allRows = [];

            // ============================================
            // ۱. URL با فیلتر جهت
            // ============================================
            var urlParams = new URLSearchParams(window.location.search);
            var directionFilter = urlParams.get('direction') || '';

            // ============================================
            // ۲. ستون‌ها
            // ============================================
            const columnDefs = [
                {
                    headerName: '#',
                    colId: '#',
                    width: 60,
                    sortable: false,
                    filter: false,
                    resizable: false,
                    valueGetter: function (params) {
                        var page = gridApi ? gridApi.paginationGetCurrentPage() : 0;
                        var size = gridApi ? gridApi.paginationGetPageSize() : 20;
                        return toPersianDigits(page * size + params.node.rowIndex + 1);
                    },
                    cellStyle: { textAlign: 'center', direction: 'ltr' }
                },
                {
                    field: 'chequeNumber',
                    headerName: 'شماره چک',
                    width: 120,
                    cellStyle: { direction: 'ltr', textAlign: 'right' }
                },
                {
                    field: 'directionName',
                    headerName: 'جهت',
                    width: 100,
                    cellRenderer: function (p) {
                        var cls = p.data.direction === 1 ? 'badge-success' : 'badge-danger';
                        return '<span class="badge ' + cls + '">' + (p.value || '') + '</span>';
                    }
                },
                { field: 'contactName', headerName: 'طرف حساب', width: 180, flex: 1 },
                { field: 'drawerName', headerName: 'صاحب چک', width: 150 },
                { field: 'bankName', headerName: 'بانک', width: 130 },
                {
                    field: 'amount',
                    headerName: 'مبلغ',
                    width: 140,
                    cellStyle: { textAlign: 'left', direction: 'ltr' },
                    valueFormatter: function (p) {
                        return p.value != null ? toPersianDigits(Number(p.value).toLocaleString('en-US')) : '';
                    }
                },
                {
                    field: 'dueDateShamsi',
                    colId: 'dueDate',
                    headerName: 'سررسید',
                    width: 110,
                    cellStyle: { direction: 'ltr', textAlign: 'right' }
                },
                {
                    field: 'statusName',
                    headerName: 'وضعیت',
                    width: 120,
                    cellRenderer: function (p) {
                        var cls = 'badge-secondary';
                        var s = p.data.status;
                        if (s === 1) cls = 'badge-primary';
                        else if (s === 2) cls = 'badge-success';
                        else if (s === 3) cls = 'badge-danger';
                        else if (s === 4) cls = 'badge-warning';
                        else if (s === 5) cls = 'badge-info';
                        else if (s === 6) cls = 'badge-dark';
                        else if (s === 7) cls = 'badge-warning';
                        else if (s === 8) cls = 'badge-success';
                        return '<span class="badge ' + cls + '">' + (p.value || '') + '</span>';
                    }
                },
                {
                    field: 'nextFollowUpDate',
                    headerName: 'پیگیری',
                    width: 110,
                    minWidth: 110,
                    maxWidth: 110,
                    cellRenderer: function (p) {
                        return buildFollowUpHtml(p.data);
                    }
                },
                {
                    headerName: 'عملیات',
                    colId: 'actions',
                    width: 340,
                    minWidth: 340,
                    sortable: false,
                    filter: false,
                    pinned: 'left',
                    cellRenderer: function (params) {
                        if (!params.data) return '';
                        return '<div class="action-buttons">' + buildActionButtons(params.data) + '</div>';
                    }
                }
            ];

            // ============================================
            // ۳. ساخت دکمه‌های عملیات (مشترک دسکتاپ/موبایل)
            // ============================================
            function buildActionButtons(d) {
                var html = '';

                // 👁 مشاهده
                html += '<a href="/Banking/Cheques/Details/' + d.id + '" ' +
                        'class="btn btn-sm btn-outline-info action-icon-btn" title="مشاهده">' +
                        '<i class="fa-solid fa-eye"></i></a>';

                // 📱 پیامک یادآوری
                if (d.status === 1 || d.status === 3) {
                    html += '<button type="button" ' +
                            'class="btn btn-sm btn-outline-info action-icon-btn cheque-reminder-btn" ' +
                            'data-id="' + d.id + '" title="ارسال پیامک یادآوری">' +
                            '<i class="fa-solid fa-comment-sms"></i></button>';
                }

                // در جریان (Status=1)
                if (d.status === 1) {
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-success action-icon-btn wf-btn" ' +
                            'data-id="' + d.id + '" data-action="cleared" title="پاس شد">' +
                            '<i class="fa-solid fa-circle-check"></i></a>';
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-danger action-icon-btn wf-btn" ' +
                            'data-id="' + d.id + '" data-action="bounced" title="برگشت خورد">' +
                            '<i class="fa-solid fa-circle-xmark"></i></a>';
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-success action-icon-btn wf-btn" ' +
                            'data-id="' + d.id + '" data-action="cashed" title="نقد شد">' +
                            '<i class="fa-solid fa-money-bill-wave"></i></a>';
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-secondary action-icon-btn wf-btn" ' +
                            'data-id="' + d.id + '" data-action="deposited" title="ارائه به بانک">' +
                            '<i class="fa-solid fa-building-columns"></i></a>';
                    html += '<a href="/Banking/Cheques/Edit/' + d.id + '" ' +
                            'class="btn btn-sm btn-outline-primary action-icon-btn" title="ویرایش">' +
                            '<i class="fa-solid fa-pen-to-square"></i></a>';
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-danger action-icon-btn delete-btn" ' +
                            'data-id="' + d.id + '" ' +
                            'data-title="' + escapeAttr(d.chequeNumber) + '" ' +
                            'data-contact="' + escapeAttr(d.contactName) + '" ' +
                            'data-amount="' + (d.amount || 0) + '" ' +
                            'title="حذف">' +
                            '<i class="fa-solid fa-trash"></i></a>';
                }
                // برگشت خورده (Status=3)
                else if (d.status === 3) {
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-primary action-icon-btn wf-btn" ' +
                            'data-id="' + d.id + '" data-action="represented" title="ارائه مجدد">' +
                            '<i class="fa-solid fa-rotate-right"></i></a>';
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-warning action-icon-btn wf-btn" ' +
                            'data-id="' + d.id + '" data-action="returned" title="عودت به مشتری">' +
                            '<i class="fa-solid fa-rotate-left"></i></a>';
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-warning action-icon-btn wf-btn" ' +
                            'data-id="' + d.id + '" data-action="referred" title="ارجاع به صاحب چک">' +
                            '<i class="fa-solid fa-gavel"></i></a>';
                }
                // پاس شده (Status=2)
                else if (d.status === 2) {
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-warning action-icon-btn wf-btn" ' +
                            'data-id="' + d.id + '" data-action="unclear" title="برگشت از پاس">' +
                            '<i class="fa-solid fa-rotate-left"></i></a>';
                }
                // نقد شده (Status=8)
                else if (d.status === 8) {
                    html += '<a href="javascript:void(0)" ' +
                            'class="btn btn-sm btn-outline-warning action-icon-btn wf-btn" ' +
                            'data-id="' + d.id + '" data-action="uncash" title="برگشت از نقد">' +
                            '<i class="fa-solid fa-rotate-left"></i></a>';
                }

                return html;
            }

            function escapeAttr(s) {
                return (s == null ? '' : String(s))
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function buildFollowUpHtml(d) {
                if (!d.nextFollowUpDate) return '<span class="text-muted">—</span>';

                var parts = d.nextFollowUpDate.split('-').map(Number);
                var target = new Date(parts[0], parts[1] - 1, parts[2]);
                var today = new Date(); today.setHours(0, 0, 0, 0);
                var diff = Math.round((target - today) / 86400000);
                var shamsi = d.nextFollowUpShamsi || '';
                var label, cls = 'badge-info';

                if (diff < 0) { label = Math.abs(diff) + ' روز گذشته'; cls = 'badge-danger'; }
                else if (diff === 0) { label = 'امروز'; cls = 'badge-warning'; }
                else if (diff === 1) { label = 'فردا'; cls = 'badge-warning'; }
                else if (diff <= 7) { label = diff + ' روز آینده'; }
                else { label = shamsi; }

                return '<span class="badge ' + cls + '" title="' + shamsi + '">' + label + '</span>';
            }

            // ============================================
            // ۴. ساخت Grid
            // ============================================
            function buildGrid() {
                if (gridApi) return;

                var gridOptions = {
                    columnDefs: columnDefs,
                    enableRtl: true,
                    defaultColDef: {
                        sortable: true,
                        filter: false,
                        resizable: true,
                        cellStyle: { textAlign: 'right', direction: 'rtl' },
                        headerClass: 'ag-right-aligned-header'
                    },
                    pagination: true,
                    paginationPageSize: 20,
                    paginationPageSizeSelector: [10, 20, 50, 100],
                    localeText: {
                        page: 'صفحه', to: 'تا', of: 'از', next: 'بعدی', last: 'آخر',
                        first: 'اول', previous: 'قبلی', loadingOoo: 'در حال بارگذاری...',
                        noRowsToShow: 'داده‌ای برای نمایش نیست',
                        pageSizeSelectorLabel: 'تعداد در صفحه:'
                    },
                    onPaginationChanged: function () {
                        if (gridApi) gridApi.refreshCells({ columns: ['#'], force: true });
                    }
                };

                var gridDiv = document.getElementById('chequesGrid');
                gridApi = agGrid.createGrid(gridDiv, gridOptions);
                loadData();
            }

            // ============================================
            // ۵. بارگذاری داده
            // ============================================
                    function loadData() {
            var request = {
                startRow: 0,
                endRow: 10000,
                search: ($('#txtSearch').val() || '').trim(),
                sortBy: null,
                sortDir: null
            };

            if (gridApi) {
                try {
                    var state = gridApi.getColumnState() || [];
                    var sorted = state.filter(function (c) { return c.sort; });
                    if (sorted.length) {
                        request.sortBy = sorted[0].colId;
                        request.sortDir = sorted[0].sort;
                    }
                } catch (e) { /* ignore */ }
            }

            // 🆕 direction به‌عنوان query string
            var url = '/Banking/Cheques/GetData';
            if (directionFilter) {
                url += '?direction=' + encodeURIComponent(directionFilter);
            }

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(request),
                success: function (result) {
                    var rows = [];
                    var total = 0;
                    if (Array.isArray(result)) {
                        rows = result;
                        total = result.length;
                    } else if (result && Array.isArray(result.rows)) {
                        rows = result.rows;
                        total = result.lastRow || rows.length;
                    } else if (result && Array.isArray(result.data)) {
                        rows = result.data;
                        total = result.total || rows.length;
                    }

                    allRows = rows;

                    if (gridApi) {
                        gridApi.setGridOption('rowData', allRows);
                        setTimeout(function () {
                            gridApi.refreshCells({ columns: ['#'], force: true });
                        }, 50);
                    }

                    $('#lblCount').text('تعداد: ' + toPersianDigits(total));

                    if (isMobile()) {
                        renderMobileList(allRows);
                    }
                },
                error: function (xhr) {
                    console.error('GetData error:', xhr.status, xhr.responseText);
                    $('#lblCount').text('خطا در بارگذاری (کد ' + xhr.status + ')');
                }
            });
        }

            // ============================================
            // ۶. جستجو
            // ============================================
            var searchTimer = null;
            $('#txtSearch').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () {
                    loadData();
                }, 300);
            });

            // ============================================
            // ۷. موبایل
            // ============================================
            function renderMobileList(rows) {
                var container = document.getElementById('mobileCheques');
                var html = '';

                if (!rows || !rows.length) {
                    container.innerHTML = '<div class="text-center text-muted py-4">' +
                        '<i class="fa fa-info-circle fa-2x mb-2"></i><br/>داده‌ای برای نمایش نیست</div>';
                    return;
                }

                rows.forEach(function (d, index) {
                    var directionCls = d.direction === 1 ? 'badge-success' : 'badge-danger';

                    var statusCls = 'badge-secondary';
                    var s = d.status;
                    if (s === 1) statusCls = 'badge-primary';
                    else if (s === 2) statusCls = 'badge-success';
                    else if (s === 3) statusCls = 'badge-danger';
                    else if (s === 4) statusCls = 'badge-warning';
                    else if (s === 5) statusCls = 'badge-info';
                    else if (s === 6) statusCls = 'badge-dark';
                    else if (s === 7) statusCls = 'badge-warning';
                    else if (s === 8) statusCls = 'badge-success';

                    var amountStr = toPersianDigits(Number(d.amount || 0).toLocaleString('en-US'));

                    html += '<div class="cheque-card">' +
                        '<div class="d-flex justify-content-between align-items-start">' +
                            '<div class="title">' +
                                '<span class="badge badge-secondary ml-1">' + toPersianDigits(index + 1) + '</span>' +
                                '<i class="fa-solid fa-money-check text-muted ml-1"></i>' +
                                'چک ' + toPersianDigits(d.chequeNumber || '') +
                            '</div>' +
                            '<div>' +
                                '<span class="badge ' + directionCls + ' ml-1">' + (d.directionName || '') + '</span>' +
                                '<span class="badge ' + statusCls + '">' + (d.statusName || '') + '</span>' +
                            '</div>' +
                        '</div>' +
                        (d.contactName ? '<div class="row-line">طرف حساب: ' + d.contactName + '</div>' : '') +
                        (d.drawerName ? '<div class="row-line">صاحب چک: ' + d.drawerName + '</div>' : '') +
                        (d.bankName ? '<div class="row-line">بانک: ' + d.bankName + '</div>' : '') +
                        (d.dueDateShamsi ? '<div class="row-line">سررسید: <span dir="ltr">' + d.dueDateShamsi + '</span></div>' : '') +
                        '<div class="amount">مبلغ: ' + amountStr + ' ریال</div>' +
                        '<div class="followup">پیگیری: ' + buildFollowUpHtml(d) + '</div>' +
                        '<div class="actions">' + buildActionButtons(d) + '</div>' +
                    '</div>';
                });

                container.innerHTML = html;
            }

            // ============================================
            // ۸. ابزار
            // ============================================
            function toPersianDigits(n) {
                return String(n).replace(/\d/g, function (d) {
                    return '۰۱۲۳۴۵۶۷۸۹'[d];
                });
            }

            function isMobile() {
                return window.matchMedia('(max-width: 767.98px)').matches;
            }

            // ============================================
            // ۹. سوئیچ دسکتاپ/موبایل
            // ============================================
            function applyLayout() {
                var gridDiv = document.getElementById('chequesGrid');
                var mobileDiv = document.getElementById('mobileCheques');

                if (isMobile()) {
                    gridDiv.classList.add('d-none');
                    mobileDiv.classList.remove('d-md-none');
                    if (!allRows.length) loadData();
                    else renderMobileList(allRows);
                } else {
                    gridDiv.classList.remove('d-none');
                    mobileDiv.classList.add('d-md-none');
                    if (!gridApi) buildGrid();
                }
            }

            // ============================================
            // ۱۰. حذف
            // ============================================
            $(document).on('click', '.delete-btn', function () {
                var $btn = $(this);
                var id = $btn.data('id');
                var title = $btn.data('title');
                var contact = $btn.data('contact');
                var amount = $btn.data('amount');

                var items = [];
                if (title) items.push({ label: 'شماره چک', value: title });
                if (contact) items.push({ label: 'طرف حساب', value: contact });
                if (amount) items.push({ label: 'مبلغ', value: Number(amount).toLocaleString('en-US') + ' ریال' });

                ModalHelper.confirmDelete({
                    url: '/Banking/Cheques/Delete',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    title: 'حذف چک شماره ' + title,
                    message: 'آیا از حذف این چک مطمئن هستید؟',
                    items: items,
                    onSuccess: function () { loadData(); }
                });
            });

            // ============================================
            // ۱۱. رویدادهای گردش کار
            // ============================================
            $(document).on('click', '.wf-btn', function () {
                var id = $(this).data('id');
                var action = $(this).data('action');
                handleChequeWorkflow(id, action);
            });

            $(document).on('click', '.cheque-reminder-btn', function () {
                var id = $(this).data('id');
                ModalHelper.show({
                    title: 'ارسال پیامک یادآوری',
                    icon: 'fa-solid fa-comment-sms',
                    body: '<p>پیامک با مقادیر همین چک، بدون زمان‌بندی، به موبایل شرکت ارسال شود؟</p>',
                    buttons: [
                        { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                        { text: 'ارسال پیامک', class: 'btn-info', icon: 'fa-solid fa-paper-plane', action: 'confirm' }
                    ],
                    onConfirm: function () {
                        sendChequeRequest('/Banking/Cheques/SendReminderSms', {
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        }, 'پیامک یادآوری ارسال شد');
                    }
                });
            });

            function handleChequeWorkflow(id, action) {
                var token = $('input[name="__RequestVerificationToken"]').val();

                if (action === 'cleared') {
                    ModalHelper.show({
                        title: 'پاس کردن چک',
                        icon: 'fa-solid fa-circle-check',
                        headerClass: 'bg-success text-white',
                        body: '<div class="form-group">' +
                                '<label>تاریخ پاس (اختیاری):</label>' +
                                '<input type="text" id="clearedDate" class="form-control datepicker" placeholder="مثلاً 1405/07/18" autocomplete="off" dir="ltr" />' +
                                '<small class="form-text text-muted">اگر خالی باشد، تاریخ امروز ثبت می‌شود.</small>' +
                              '</div>' +
                              '<div class="form-group">' +
                                '<label>شماره پیگیری بانک (اختیاری):</label>' +
                                '<input type="text" id="bankTrackingNumber" class="form-control" />' +
                              '</div>',
                        buttons: [
                            { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                            { text: 'پاس شد', class: 'btn-success', icon: 'fa-solid fa-check', action: 'confirm' }
                        ],
                        onShow: function () { initDatePickerInModal(); },
