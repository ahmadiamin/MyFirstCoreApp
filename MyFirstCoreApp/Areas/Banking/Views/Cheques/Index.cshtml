                            { text: 'ارجاع', class: 'btn-warning', icon: 'fa-solid fa-check', action: 'confirm' }
                        ],
                        onConfirm: function () {
                            sendChequeRequest('/Banking/Cheques/MarkAsReferred', {
                                id: id,
                                description: $('#referredDesc').val(),
                                __RequestVerificationToken: token
                            }, 'چک به صاحب چک ارجاع شد');
                        }
                    });
                }
                else if (action === 'unclear') {
                    ModalHelper.show({
                        title: 'برگشت از پاس',
                        icon: 'fa-solid fa-rotate-left',
                        headerClass: 'bg-warning text-white',
                        body: '<div class="alert alert-warning">' +
                                '<i class="fa-solid fa-triangle-exclamation"></i> ' +
                                'با برگشت از پاس، سند حسابداری حذف می‌شود و چک به وضعیت «در جریان» برمی‌گردد.' +
                              '</div>' +
                              '<div class="form-group">' +
                                '<label>دلیل برگشت:</label>' +
                                '<input type="text" id="unclearReason" class="form-control" placeholder="مثلاً اشتباه پاس شده" />' +
                              '</div>',
                        buttons: [
                            { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                            { text: 'برگشت', class: 'btn-warning', icon: 'fa-solid fa-rotate-left', action: 'confirm' }
                        ],
                        onConfirm: function () {
                            sendChequeRequest('/Banking/Cheques/Unclear', {
                                id: id,
                                reason: $('#unclearReason').val(),
                                __RequestVerificationToken: token
                            }, 'چک به وضعیت در جریان برگشت');
                        }
                    });
                }
                else if (action === 'uncash') {
                    ModalHelper.show({
                        title: 'برگشت از نقد',
                        icon: 'fa-solid fa-rotate-left',
                        headerClass: 'bg-warning text-white',
                        body: '<div class="alert alert-warning">' +
                                '<i class="fa-solid fa-triangle-exclamation"></i> ' +
                                'با برگشت از نقد، سند حسابداری حذف می‌شود و چک به وضعیت «در جریان» برمی‌گردد.' +
                              '</div>' +
                              '<div class="form-group">' +
                                '<label>دلیل برگشت:</label>' +
                                '<input type="text" id="uncashReason" class="form-control" placeholder="مثلاً اشتباه نقد شده" />' +
                              '</div>',
                        buttons: [
                            { text: 'انصراف', class: 'btn-secondary', icon: 'fa-solid fa-times', dismiss: true },
                            { text: 'برگشت', class: 'btn-warning', icon: 'fa-solid fa-rotate-left', action: 'confirm' }
                        ],
                        onConfirm: function () {
                            sendChequeRequest('/Banking/Cheques/Uncash', {
                                id: id,
                                reason: $('#uncashReason').val(),
                                __RequestVerificationToken: token
                            }, 'چک به وضعیت در جریان برگشت');
                        }
                    });
                }
            }

            // ============================================
            // ۱۲. PersianDatePicker داخل Modal
            // ============================================
            function initDatePickerInModal() {
                setTimeout(function () {
                    $('#generalModal .datepicker').each(function () {
                        var $input = $(this);
                        if ($input.data('persianDatepicker')) return;
                        $input.persianDatepicker({
                            format: 'YYYY/MM/DD',
                            initialValue: false,
                            autoClose: true,
                            observer: true,
                            calendar: { persian: { locale: 'fa', showHint: true, leapYearMode: 'algorithmic' } },
                            toolbox: { calendarSwitch: { enabled: false } }
                        });
                    });
                }, 100);
            }

            // ============================================
            // ۱۳. ارسال درخواست
            // ============================================
            function sendChequeRequest(url, data, successMsg) {
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: data,
                    success: function (r) {
                        if (r.success) {
                            ModalHelper.success(r.message || successMsg, {
                                onClose: function () { loadData(); }
                            });
                        } else {
                            ModalHelper.error(r.message);
                        }
                    },
                    error: function () {
                        ModalHelper.error('خطا در ارتباط با سرور');
                    }
                });
            }

            // ============================================
            // ۱۴. شروع
            // ============================================
            applyLayout();

            var mql = window.matchMedia('(max-width: 767.98px)');
            mql.addEventListener('change', applyLayout);

        });
    </script>
}