                        onShow: function () { initDatePickerInModal(); },
                        onConfirm: function () {
                            var bounceReason = $('#bounceReason').val();
                            if (!bounceReason) {
                                ModalHelper.error('دلیل برگشت الزامی است.');
                                return;
                            }
                            sendChequeRequest('/Banking/Cheques/MarkAsBounced', {
                                id: id,
                                bounceReason: bounceReason,
                                bouncedDate: $('#bouncedDate').val(),
                                __RequestVerificationToken: token
