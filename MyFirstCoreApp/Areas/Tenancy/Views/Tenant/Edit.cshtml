@model MyFirstCoreApp.Areas.Tenancy.ViewModels.CreateTenantViewModel
@{
    ViewData["Title"] = "ویرایش شرکت";
}

<div class="card card-outline card-info">
    <div class="card-header">
        <h3 class="card-title"><i class="fa fa-images"></i> لوگو، مهر و امضای شرکت</h3>
    </div>
    <div class="card-body">
        <p class="text-muted">تصاویر فقط برای قالب چاپ رسمی فاکتور استفاده می‌شوند. فرمت‌های JPG، PNG و WEBP با حداکثر حجم ۵ مگابایت مجاز هستند.</p>
        @if (ViewBag.IsCurrentTenant == true)
        {
        <div class="row">
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <h6>لوگوی شرکت</h6>
                    @if (Model.LogoAttachmentId.HasValue)
                    {
                        <img src="@Url.Action("BrandingImage", "Tenant", new { area = "Tenancy", id = ViewBag.TenantId, kind = "logo" })"
                             alt="لوگوی شرکت" class="img-fluid mb-3" style="max-height:120px; object-fit:contain;" />
                    }
                    else
                    {
                        <div class="text-muted small mb-3">لوگویی ثبت نشده است.</div>
                    }
                    <form asp-area="Tenancy" asp-controller="Tenant" asp-action="UploadBranding"
                          asp-route-id="@ViewBag.TenantId" asp-route-kind="logo"
                          method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="file" name="file" class="form-control-file mb-2" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required />
                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa fa-upload"></i> بارگذاری لوگو</button>
                    </form>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <h6>مهر شرکت</h6>
                    @if (Model.StampAttachmentId.HasValue)
                    {
                        <img src="@Url.Action("BrandingImage", "Tenant", new { area = "Tenancy", id = ViewBag.TenantId, kind = "stamp" })"
                             alt="مهر شرکت" class="img-fluid mb-3" style="max-height:120px; object-fit:contain;" />
                    }
                    else
                    {
                        <div class="text-muted small mb-3">مهری ثبت نشده است.</div>
                    }
                    <form asp-area="Tenancy" asp-controller="Tenant" asp-action="UploadBranding"
                          asp-route-id="@ViewBag.TenantId" asp-route-kind="stamp"
                          method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="file" name="file" class="form-control-file mb-2" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required />
                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa fa-upload"></i> بارگذاری مهر</button>
                    </form>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <h6>امضای مجاز</h6>
                    @if (Model.SignatureAttachmentId.HasValue)
                    {
                        <img src="@Url.Action("BrandingImage", "Tenant", new { area = "Tenancy", id = ViewBag.TenantId, kind = "signature" })"
                             alt="امضای مجاز" class="img-fluid mb-3" style="max-height:120px; object-fit:contain;" />
                    }
                    else
                    {
                        <div class="text-muted small mb-3">امضایی ثبت نشده است.</div>
                    }
                    <form asp-area="Tenancy" asp-controller="Tenant" asp-action="UploadBranding"
                          asp-route-id="@ViewBag.TenantId" asp-route-kind="signature"
                          method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="file" name="file" class="form-control-file mb-2" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required />
                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa fa-upload"></i> بارگذاری امضا</button>
                    </form>
                </div>
            </div>
        </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                برای مشاهده و مدیریت تصاویر، ابتدا همین شرکت را به‌عنوان شرکت فعال انتخاب کنید.
            </div>
        }
    </div>
</div>

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-edit"></i>
            ویرایش شرکت
        </h3>
    </div>

    <form asp-area="Tenancy" asp-controller="Tenant" asp-action="Edit"
          asp-route-id="@ViewBag.TenantId" method="post">
        @Html.AntiForgeryToken()

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Phone"></label>
                        <input asp-for="Phone" class="form-control ltr" dir="ltr" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="LegalName"></label>
                        <input asp-for="LegalName" class="form-control" />
                        <span asp-validation-for="LegalName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="NationalId"></label>
                        <input asp-for="NationalId" class="form-control ltr" dir="ltr" />
                        <span asp-validation-for="NationalId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="EconomicCode"></label>
                        <input asp-for="EconomicCode" class="form-control ltr" dir="ltr" maxlength="14" inputmode="numeric" />
                        <span asp-validation-for="EconomicCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="RegistrationNumber"></label>
                        <input asp-for="RegistrationNumber" class="form-control" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PostalCode"></label>
                        <input asp-for="PostalCode" class="form-control ltr" dir="ltr" />
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Address"></label>
                        <input asp-for="Address" class="form-control" dir="ltr" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <hr />
            <h5><i class="fa fa-sms"></i> تنظیمات پیامک پرتال مشتری</h5>
            <p class="text-muted">کلید API فقط هنگام ثبت یا جایگزینی ارسال می‌شود و پس از ذخیره قابل مشاهده نیست. برای حفظ کلید فعلی، این فیلد را خالی بگذارید.</p>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="SmsApiKeyInput">کلید API ثابت FarazSMS</label>
                        <input asp-for="SmsApiKeyInput" type="password" class="form-control ltr" dir="ltr" autocomplete="new-password" />
                        <span asp-validation-for="SmsApiKeyInput" class="text-danger"></span>
                        <small class="form-text text-muted">وضعیت: @(Model.SmsApiKeyConfigured ? "کلید ثبت شده است" : "کلیدی ثبت نشده است")</small>
                    </div>
                    @if (Model.SmsApiKeyConfigured)
                    {
                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <input asp-for="ClearSmsApiKey" class="custom-control-input" id="ClearSmsApiKey" />
                                <label asp-for="ClearSmsApiKey" class="custom-control-label" for="ClearSmsApiKey">پاک‌کردن کلید ذخیره‌شده</label>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="SmsLineNumber">شماره خط ارسال</label>
                        <input asp-for="SmsLineNumber" class="form-control ltr" dir="ltr" placeholder="90008361" />
                        <span asp-validation-for="SmsLineNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PortalLinkPatternCode">کد پترن پیامک لینک پرتال</label>
                        <input asp-for="PortalLinkPatternCode" class="form-control" dir="ltr" placeholder="کد پترن پیامک لینک پرتال" />
                        <span asp-validation-for="PortalLinkPatternCode" class="text-danger"></span>
                        <small class="form-text text-muted">
                            در پنل FarazSMS یک الگوی پیامک بسازید با متغیر %code%. مثال: @($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/customer-portal/%code%")
                        </small>
                    </div>
                </div>
            </div>

            <hr />
            <h5><i class="fa fa-bell"></i> یادآوری پیامکی سررسید چک‌ها</h5>
            <p class="text-muted">این یادآوری‌ها برای شرکت شما ارسال می‌شوند؛ شماره موبایل طرف حسابِ چک گیرندهٔ پیامک نیست. زمان بر اساس ساعت ایران است و پیامک‌ها با schedule به FarazSMS سپرده می‌شوند.</p>
            <div class="row">
                <div class="col-md-4">
                    <div class="custom-control custom-checkbox mb-3">
                        <input asp-for="SmsChequeReminderEnabled" class="custom-control-input" />
                        <label asp-for="SmsChequeReminderEnabled" class="custom-control-label">فعال‌سازی یادآوری سررسید</label>
                    </div>
                    <div class="custom-control custom-checkbox mb-2">
                        <input asp-for="SmsChequeReminderDayBeforeEnabled" class="custom-control-input" />
                        <label asp-for="SmsChequeReminderDayBeforeEnabled" class="custom-control-label">ارسال یک روز قبل</label>
                    </div>
                    <div class="custom-control custom-checkbox mb-2">
                        <input asp-for="SmsChequeReminderDueDayEnabled" class="custom-control-input" />
                        <label asp-for="SmsChequeReminderDueDayEnabled" class="custom-control-label">ارسال در روز سررسید</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="SmsChequeReminderTime">ساعت ارسال (به وقت ایران)</label>
                        <input asp-for="SmsChequeReminderTime" type="time" class="form-control ltr" dir="ltr" />
                        <span asp-validation-for="SmsChequeReminderTime" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SmsChequeReminderMobile">موبایل خود شرکت برای دریافت یادآوری‌ها</label>
                        <input asp-for="SmsChequeReminderMobile" class="form-control ltr" dir="ltr"
                               inputmode="tel" placeholder="09120000000" />
                        <span asp-validation-for="SmsChequeReminderMobile" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="SmsChequeReminderPatternCode">
                            کد الگوی پیامک یادآوری چک در FarazSMS
                        </label>

                        <input asp-for="SmsChequeReminderPatternCode"
                               class="form-control ltr"
                               dir="ltr" />

                        <span asp-validation-for="SmsChequeReminderPatternCode"
                              class="text-danger"></span>

                        <small class="form-text text-muted">
                            در پنل FarazSMS یک الگوی پیامک بسازید با متغیرهای var1, var2, var3 و var4
                        </small>
                    </div>
                </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save"></i> ذخیره تغییرات
            </button>
            <a asp-area="Tenancy" asp-controller="Tenant" asp-action="Index"
               class="btn btn-secondary">
                <i class="fa fa-arrow-right"></i> انصراف
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
