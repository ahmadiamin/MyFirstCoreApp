@model MyFirstCoreApp.Application.Security.LoginCapacityInfo
@using MyFirstCoreApp.Application.Security
@{
    ViewData["Title"] = "ورود با چه سمتی؟";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="text-center mb-4">
            <h3>با چه سمتی وارد می‌شوید؟</h3>
            <p class="text-muted">شما هم مدیر یک کسب‌وکار هستید و هم در جای دیگری کارمند. بعداً می‌توانید سمت را عوض کنید.</p>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card card-success card-outline h-100">
                    <div class="card-body text-center">
                        <i class="fa fa-crown fa-3x text-success mb-3"></i>
                        <h4>مدیر کسب‌وکار</h4>
                        <ul class="list-unstyled text-muted">
                            @foreach (var tenant in Model.OwnerTenants)
                            {
                                <li>@tenant.Name</li>
                            }
                        </ul>
                    </div>
                    <div class="card-footer">
                        <form asp-area="Tenancy" asp-controller="Capacity" asp-action="Choose" method="post">
                            <input type="hidden" name="capacity" value="@((int)LoginCapacity.Owner)" />
                            <button type="submit" class="btn btn-success btn-block">ورود به‌عنوان مدیر</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card card-primary card-outline h-100">
                    <div class="card-body text-center">
                        <i class="fa fa-user-tie fa-3x text-primary mb-3"></i>
                        <h4>کارمند</h4>
                        <ul class="list-unstyled text-muted">
                            @foreach (var tenant in Model.EmployeeTenants)
                            {
                                <li>@tenant.Name</li>
                            }
                        </ul>
                    </div>
                    <div class="card-footer">
                        <form asp-area="Tenancy" asp-controller="Capacity" asp-action="Choose" method="post">
                            <input type="hidden" name="capacity" value="@((int)LoginCapacity.Employee)" />
                            <button type="submit" class="btn btn-primary btn-block">ورود به‌عنوان کارمند</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>