@model MyFirstCoreApp.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "داشبورد";
}

<!-- هدر شرکت -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card card-primary card-outline">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">
                            <i class="fa fa-building"></i>
                            @Model.TenantName
                        </h4>
                        @if (!string.IsNullOrEmpty(Model.TenantLegalName))
                        {
                            <small class="text-muted">@Model.TenantLegalName</small>
                        }
                    </div>
                    <div>
                        @if (Model.IsTenantOwner)
                        {
                            <span class="badge badge-success">
                                <i class="fa fa-crown"></i>
                                مالک شرکت
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- آمار کاربران و دسترسی‌ها -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@Model.UserCount</h3>
                <p>کاربران</p>
            </div>
            <div class="icon">
                <i class="fa fa-users"></i>
            </div>
            <a asp-area="Admin"
               asp-controller="Users"
               asp-action="Index"
               class="small-box-footer">
                مشاهده کاربران
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@Model.RoleCount</h3>
                <p>نقش‌ها</p>
            </div>
            <div class="icon">
                <i class="fa fa-user"></i>
            </div>
            <a asp-area="Admin"
               asp-controller="Roles"
               asp-action="Index"
               class="small-box-footer">
                مشاهده نقش‌ها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@Model.PermissionCount</h3>
                <p>دسترسی‌ها</p>
            </div>
            <div class="icon">
                <i class="fa fa-key"></i>
            </div>
            <a asp-area="Admin"
               asp-controller="Permissions"
               asp-action="Index"
               class="small-box-footer">
                مشاهده دسترسی‌ها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@Model.MenuCount</h3>
                <p>منوها</p>
            </div>
            <div class="icon">
                <i class="fa fa-bars"></i>
            </div>
            <a asp-area="Admin"
               asp-controller="Menus"
               asp-action="Index"
               class="small-box-footer">
                مشاهده منوها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>
</div>

<!-- آمار حسابداری -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-primary">
            <div class="inner">
                <h3>@Model.ContactCount</h3>
                <p>طرف حساب‌ها</p>
            </div>
            <div class="icon">
                <i class="fa fa-address-book"></i>
            </div>
            <a asp-area="Accounting"
               asp-controller="Contacts"
               asp-action="Index"
               class="small-box-footer">
                مشاهده طرف حساب‌ها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-secondary">
            <div class="inner">
                <h3>@Model.ProductCount</h3>
                <p>کالاها</p>
            </div>
            <div class="icon">
                <i class="fa fa-cube"></i>
            </div>
            <a asp-area="Inventory"
               asp-controller="Products"
               asp-action="Index"
               class="small-box-footer">
                مشاهده کالاها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-orange">
            <div class="inner">
                <h3>@Model.InvoiceCount</h3>
                <p>فاکتورها</p>
            </div>
            <div class="icon">
                <i class="fa fa-file-text"></i>
            </div>
            <a asp-area="Invoicing"
               asp-controller="Invoices"
               asp-action="Index"
               class="small-box-footer">
                مشاهده فاکتورها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-teal">
            <div class="inner">
                <h3>@Model.ChequeCount</h3>
                <p>چک‌ها</p>
            </div>
            <div class="icon">
                <i class="fa fa-money"></i>
            </div>
            <a asp-area="Banking"
               asp-controller="Cheques"
               asp-action="Index"
               class="small-box-footer">
                مشاهده چک‌ها
                <i class="fa fa-arrow-circle-left"></i>
            </a>
        </div>
    </div>
</div>