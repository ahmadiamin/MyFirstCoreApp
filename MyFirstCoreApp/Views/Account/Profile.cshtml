@model MyFirstCoreApp.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "پروفایل من";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa fa-check-circle"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa fa-exclamation-circle"></i>
        @TempData["Error"]
    </div>
}

<div class="card card-primary">

    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-user"></i>
            پروفایل من
        </h3>
    </div>

    <div class="card-body">

        <!-- تصویر پروفایل -->
        <div class="text-center mb-4">

            @if (Model.PrimaryImageId.HasValue)
            {
                <img id="profileImagePreview"
                     src="@Url.Action(
                                           "ProfileImage",
                                           "Users",
                                           new
                                           {
                                               area = "Admin",
                                               id = Model.PrimaryImageId.Value
                                           })"
                 class="img-circle elevation-2"
                 alt="تصویر پروفایل"
                 style="width:120px;height:120px;object-fit:cover;" />
                        }
            else
            {
                <div id="profileImagePreview"
                     class="user-avatar elevation-2"
                     style="width:120px;
                    height:120px;
                    margin:auto;
                    border-radius:50%;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    background:#6c757d;
                    color:white;
                    font-size:50px;">

                    <i class="fa fa-user"></i>

                </div>
            }
            <div class="mt-3">

                <form asp-action="ChangeProfileImage"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <input type="file"
                           id="profileImageInput"
                           name="file"
                           class="form-control mb-2"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <button type="submit"
                            class="btn btn-info">
                        <i class="fa fa-camera"></i>
                        تغییر تصویر
                    </button>

                </form>

                @if (Model.PrimaryImageId.HasValue)
                {
                    <form asp-action="RemoveProfileImage"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('آیا از حذف تصویر پروفایل مطمئن هستید؟');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">
                            <i class="fa fa-trash"></i>
                            حذف تصویر
                        </button>

                    </form>
                }

            </div>

        </div>

        <hr />

        <!-- اطلاعات پروفایل -->
        <form asp-action="Profile" method="post">

            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="FullName"></label>

                <input asp-for="FullName"
                       class="form-control" />

                <span asp-validation-for="FullName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>نام کاربری</label>

                <input asp-for="UserName"
                       class="form-control"
                       readonly />
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>

                <input asp-for="Email"
                       class="form-control" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>

                <input asp-for="PhoneNumber"
                       class="form-control" />

                <span asp-validation-for="PhoneNumber"
                      class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PasswordChangedAt"></label>

                <input class="form-control"
                       value="@(Model.PasswordChangedAt.HasValue
                                      ? Model.PasswordChangedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                      : "تاکنون ثبت نشده است")"
                       readonly />
            </div>
            <button type="submit"
                    class="btn btn-primary">
                <i class="fa fa-save"></i>
                ذخیره تغییرات
            </button>
            <a asp-action="ChangePassword"
               class="btn btn-warning">
                <i class="fa fa-key"></i>
                تغییر رمز عبور
            </a>

        </form>

    </div>
</div>

<div class="card card-danger mt-4">

    <div class="card-header">
        <h3 class="card-title">
            <i class="fa fa-shield-alt"></i>
            امنیت حساب
        </h3>
    </div>

    <div class="card-body">

        <p class="text-muted">
            با استفاده از این گزینه، تمام نشست‌های فعال حساب شما
            در دستگاه‌های دیگر منقضی می‌شوند.
        </p>

        <form asp-action="SignOutOtherSessions"
              method="post"
              onsubmit="return confirm('آیا مطمئن هستید که می‌خواهید از سایر دستگاه‌ها خارج شوید؟');">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger">
                <i class="fa fa-sign-out-alt"></i>
                خروج از سایر دستگاه‌ها
            </button>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document
            .getElementById('profileImageInput')
            .addEventListener('change', function (event) {

                const file = event.target.files[0];

                if (!file)
                    return;

                const reader = new FileReader();

                reader.onload = function (e) {

                    const preview =
                        document.getElementById('profileImagePreview');

                    if (preview.tagName === 'IMG') {

                        preview.src = e.target.result;

                    } else {

                        const img =
                            document.createElement('img');

                        img.id = 'profileImagePreview';
                        img.src = e.target.result;
                        img.className =
                            'img-circle elevation-2';
                        img.alt = 'تصویر پروفایل';

                        img.style.width = '120px';
                        img.style.height = '120px';
                        img.style.objectFit = 'cover';

                        preview.replaceWith(img);
                    }
                };

                reader.readAsDataURL(file);
            });
    </script>
}